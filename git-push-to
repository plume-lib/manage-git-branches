#!/bin/sh

# Pushes one git repository into another, from local clones.  Fails if the
# resulting merge does not compile.  If more than two repositories are given,
# each is pushed into the next in turn.
#
# Usage:
#   git-push-to [OPTIONS] FROM_DIR TO_DIR ...
#   git-push-to [OPTIONS] [ORG:]BRANCH [ORG:]BRANCH ...
#
# OPTIONS are [--nocompile] [--no-pull-first] [--rebase | --squash]
# [--llm | --no-llm] [--claude | --codex] [--summary FILE].
#
# Each argument names the top level of a working tree.
# Each may be absolute directory names or relative to the current directory.
# The "--nocompile" option skips the compilation step.
# The "--no-pull-first" option skips pulling the first directory from its
# remote, so that the chain merges the commit that the first directory already
# has; see "Several chains" below.
# The "--rebase" option rebases each branch onto the previous one after
# pushing, and the "--squash" option makes each branch a single commit on top
# of the previous one; see "Rebasing" below.  `git-rebase-to` is a shorthand
# for "--rebase".  By default, this script asks an AI agent to resolve merge
# conflicts and to fix a failed build; "--no-llm" prevents that.  See "Asking
# an AI agent" below.
# The "--summary FILE" option appends to FILE a line for each thing that a
# person should look at after the run; `resolve-conflicts` combines these
# lines into its own summary.  They are each change by an AI agent to review
# (see "Asking an AI agent" below), as in
#   in /home/me/myrepo-branch-feature: claude also changed: README.md
# each merge left in progress and each agent session that can be continued,
# which are also noted in AGENT-TODO.md, and, if a push or rebase fails, the
# step that failed, as in
#   failed to push myrepo-branch-main into myrepo-branch-feature, while building
# The same information is printed as diagnostics, along with the details of
# each failure.
#
# Alternately, each argument may be a slug of the form ORG:BRANCH, which names
# a directory in the current directory:  PROJECT-fork-ORG-branch-BRANCH, or
# PROJECT-fork-ORG if that directory has BRANCH checked out and the former
# does not exist.  If there is no clone PROJECT-fork-ORG and ORG owns the
# upstream repository of the clone PROJECT, as typetools owns
# typetools/checker-framework, then ORG:BRANCH names what -:BRANCH names,
# described below.  A "/" in BRANCH is written as "-" in the directory name, as
# `git-new-branch` does.  Every PROJECT that has a directory for any of the
# slugs gets its own chain, made of the slugs' directories that exist for that
# PROJECT.  For example,
# `git-push-to typetools:master mernst:feature` is equivalent to
#   git-push-to checker-framework-fork-typetools-branch-master \
#               checker-framework-fork-mernst-branch-feature
# and, if stubparser-fork-mernst-branch-feature exists but no stubparser
# directory for typetools:master does, a PROJECT with a single directory has
# nothing to push and is skipped.  Slugs and directories cannot be mixed.
#
# A slug may also be just BRANCH, which matches every ORG.  Then each PROJECT
# and ORG gets its own chain, so a chain never goes from one ORG's BRANCH to
# another ORG's BRANCH.  A slug BRANCH also names PROJECT-branch-BRANCH, a
# directory whose name has no ORG, as `git-new-branch` creates from a clone
# PROJECT, or the clone PROJECT itself if it has BRANCH checked out and the
# former does not exist; those directories form one more chain for each
# PROJECT.  The slug -:BRANCH, whose ORG is "-", names only such a directory.
# For example, `git-push-to main feature` pushes PROJECT-fork-ORG-branch-main
# into PROJECT-fork-ORG-branch-feature for each PROJECT and ORG.  A slug ORG:BRANCH in the same command belongs to every
# chain of its PROJECT:  `git-push-to typetools:master master feature` pushes
# typetools's master into each ORG's master, then that into ORG's feature.
# An argument without ":" that is not a directory is a slug BRANCH only if
# some directory in the current directory matches it; otherwise it is
# reported as a missing directory.
#
# This script does the following:
#  * pull FROM_DIR and TO_DIR from their remotes,
#  * merge FROM_DIR's branch into TO_DIR,
#  * build TO_DIR using `compile-project` (see its documentation),
#    (Skips the compilation step if environment variable
#    MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT is set.)
#  * push TO_DIR to its remote if the build succeeds.
#
# If more than two directories are supplied, the procedure is performed on each
# pair of adjacent directories in turn.  With "--no-pull-first", the first
# directory, which is FROM_DIR of the first pair only, is not pulled.

# Several chains
#
# A run that updates several chains, each of which starts with the same
# directory, such as a working copy of the upstream default branch, pulls that
# directory only for the first chain.  So every chain merges the same commit
# of it, even if its remote changes during the run.  Otherwise, a branch could
# merge a newer upstream commit than a branch that it builds on has; the next
# merge of the latter branch into the former would then be a criss-cross
# merge, which has several merge bases.
#
# This script does so for the chains of slugs:  each chain whose first
# directory an earlier chain of the same run pulled is pushed as with
# "--no-pull-first".  A chain that fails before it pulls its first directory,
# as when the fetch fails, does not count, so a later chain pulls the
# directory.  `resolve-conflicts`, and the commands that `pr-status` prints,
# run each chain with a separate run of this script; they pass
# "--no-pull-first" for each such chain.  Given directories, this script
# exits with status 2, rather than 1, if it fails before it pulls the first
# directory, which it pulls unless "--no-pull-first" is given, so that
# `resolve-conflicts` can tell whether the chain pulled it.
#
# Without the pull, this script still stops if a merge is in progress in the
# first directory, or if it has unmerged files, as `git pull` would.

# Rebasing
#
# With "--rebase", after every pair has been pushed, each directory's branch
# except the first is rebased onto the previous directory's branch, in order,
# and is force-pushed if the rebase changed it.  This is useful for a stack of
# pull requests, each of whose base is the previous one:  the branches'
# histories become linear, so each pull request shows only its own commits.
#
# The rebase replays only the branch's own commits:  those that are not in the
# previous branch as it was when the branch was merged from it, nor in any
# former head of the previous branch that its reflog records.  So when a
# branch is rebased onto a previous branch that was itself rebased, in this run
# or earlier, the previous branch's old commits are not replayed a second
# time.  Merge commits are dropped.
#
# The rebase resolves every conflict in favor of the commit being replayed.
# This loses no information:  the pushes above already merged the previous
# branch into this one, so the branch's content before the rebase is the
# content that it should have afterward.  If the replayed commits do not
# reproduce that content exactly -- for example, because a conflict resolution
# in a merge commit was dropped -- the rebase adds one more commit that
# restores it.  Thus the rebase never changes the content of any branch.
#
# With "--squash", each branch becomes a single commit on top of the previous
# branch, with the same content as before.  Its message consists of the
# messages of the branch's own commits.

# Conflicts
#
# Suppose that TO_DIR's branch merged an earlier version of a pull request,
# whose branch then changed again before GitHub squash-merged the pull
# request into the upstream repository's default branch.  Then the squash
# commit and TO_DIR's branch contain different versions of the same changes,
# and merging FROM_DIR's branch, if it contains the squash commit, conflicts
# wherever they differ, even in binary files.  When the merge of FROM_DIR's
# branch would have conflicts, this script first merges into TO_DIR the pull
# request's final version, from the upstream repository's ref
# `refs/pull/N/head`, and then the squash commit, if neither merge has
# conflicts, if they change the merge of FROM_DIR's branch only in files that
# the pull request changes or that conflict either way, and if they leave
# that merge fewer conflicts; `merge_landed_pr_heads` in common-functions.sh
# says how.
#
# When the merge of FROM_DIR's branch into TO_DIR has conflicts that
# `git rerere` or an AI agent (see below) resolves, this script checks the
# resolution; `resolve_merge_conflicts` in common-functions.sh describes the
# check.  Otherwise, this script stops with the merge still in progress, for
# the user to finish or to abort with `git merge --abort`.  Whenever this
# script stops with a merge in progress, it appends an entry that says so to
# the file AGENT-TODO.md at the top level of the working tree (see "Asking an
# AI agent" below), unless the file already has one for that merge.
#
# A merge can already be in progress when this script starts, as one is
# after this script stopped as just described.  In each directory except the
# first, before pulling it, this script finishes such a merge:  it runs
# `git rerere`, which applies any resolution recorded since the merge stopped,
# such as one recorded in another working tree of the same repository; it
# resolves the remaining conflicts in the same way as above, asking the AI
# agent about those that `git rerere` does not resolve; and it commits the
# merge with the merge's own message.  The merge commit is pushed along with
# the rest of the directory's branch, once the build succeeds.  This script
# does not touch the merge, but stops, in these cases:
#  * A process of Claude Code or of Codex (a process whose command name is
#    "claude" or "codex") is working in the directory, as when you are
#    resolving the conflicts in a session that this script printed a command
#    to resume.  This script also stops if it cannot read the current
#    directory of such a process.  On a system that has neither /proc nor
#    `lsof`, this script
#    cannot tell whether such a process is working in the directory; it says
#    so, and finishes the merge.
#  * No conflicted file remains, as when you have resolved and staged the
#    conflicts but not committed the merge.
#  * A conflicted file changed after git, `git rerere`, and this script left
#    it, as when this script rejected an AI agent's work, whose edits remain,
#    or when you have begun to resolve the conflicts.
# A merge in progress in the first directory makes this script stop.
#
# A hook, such as one that runs a formatter, can reject a commit that this
# script makes, of a merge or of a fix to the build, after changing files
# that the commit changes.  The hook is the pre-commit hook, or the
# pre-merge-commit hook for a merge without conflicts.  Then this script
# stages the hook's changes and commits once more, with `git commit`,
# provided that
#  * the working tree had no unstaged changes before the commit or the merge;
#  * the hook staged nothing, and created or deleted no untracked file; and
#  * the hook only modified files that the commit changes.
# Before committing once more, this script builds a fix to the build again,
# and it runs a pre-merge-commit hook again; `git commit` runs the pre-commit
# hook.  If a condition does not hold, or if the build, the hook, or the
# second commit fails, this script stops, with the merge still in progress or
# the fix staged.

# Asking an AI agent
#
# Unless "--no-llm" is given, this script asks an AI agent for help:  Claude
# (`claude -p`) by default, or Codex (`codex exec`) with "--codex".  The
# options "--llm", "--claude", and "--codex" each override an earlier
# "--no-llm", and "--no-llm" overrides any of them that precedes it.
# "--llm" turns on the agent that the last "--claude" or "--codex" chose.
# If the agent cannot be run because its command is not on the PATH, this
# script acts as it does with "--no-llm".  So it does if the agent is not
# ready to run:  before it first asks the agent to resolve a merge's
# conflicts or to fix a build, this script asks the agent for a one-word
# reply, which fails if the agent is not logged in, has reached a usage
# limit, or cannot reach its service.
# The agent runs in a sandbox, which requires a recent version of it:
# Claude Code with the `--restricted` option and the setting
# `permissions.blockReadsOutsideWorkingDirectories`, or Codex with permission
# profiles (the setting `default_permissions`).  Claude Code 2.1.316 and
# Codex 0.165.0 work.  The sandbox lets the agent read every file of the
# working tree, including ignored files such as `.env`, and the repository.
#
# When a merge has conflicts that `git rerere` does not resolve, the agent
# resolves them, and this script checks its resolution as described above.
# That applies to the merge of FROM_DIR's branch into TO_DIR, and to the
# merges of the pulls that update FROM_DIR and TO_DIR from their remotes.
# The pull of TO_DIR merges even if `pull.rebase` is set; a pull of FROM_DIR
# that rebases, as `pull.rebase` can make it do, is not resolved.  If the
# agent fails, this script stops with the merge still in progress.
#
# An agent that fails, other than by running out of time, without changing
# HEAD, the index, or any file, did nothing that anyone must review, and it
# might succeed if it runs again, as when its service was briefly
# unavailable.  This script runs it again, up to 2 more times, each after a
# pause of $MANAGE_GIT_BRANCHES_LLM_RETRY_PAUSE seconds, 60 by default.  That
# applies to resolving conflicts and to fixing a build.
#
# The agent's instructions consist of the file merge-conflict-instructions.md,
# which also suits a merge that you resolve yourself or with an agent
# interactively, followed by rules specific to this script.  The agent is
# told to examine every change of both sides of the merge, and to combine
# them; it takes either side's version only if the other side's changes are
# already present in it or are obsolete.  It can edit any part of any
# file that git tracks, not only the conflict regions, because git's
# automatic merge of the rest can combine changes that do not fit together,
# such as a call to a method that the other side renamed.  It can also
# delete files, but it cannot create one:  a command that it runs can create
# files as a side effect, which would then be committed.  It cannot change a
# hook in the working tree, as with `core.hooksPath` ".githooks", unless the
# hook has conflicts, because this script's commit would run it outside the
# agent's sandbox.  It can, however, change a tracked file that a hook or the
# build reads or runs, such as prek.toml or a Makefile, and this script's
# commit and build then run that code outside the sandbox; the agent that
# fixes a failed build can do the same.  This script rejects any file that the
# agent changed that contains a conflict marker line that git's merge did not
# put there.  It accepts a resolution of a file that is identical to either
# side's version of the file; merge-conflict-instructions.md says when one is
# correct.
# Whether or not it accepts the agent's work, it lists the files outside the
# conflicted ones that the agent changed, each conflicted file in which the
# agent changed text outside the conflict regions, each resolution by
# `git rerere` that the agent changed, and each resolution by the agent that
# is identical to either side's version, apart from whitespace and blank
# lines, so that you can review them.  Whether or not it accepts the agent's
# work, it keeps `git rerere` from recording each such one-sided resolution,
# even if you commit the merge later, and removes rerere's record of the
# conflict:  the side's version also drops the other side's changes outside
# the conflict regions, so a later merge with the same conflicts would
# reject the replayed resolution.
#
# When the build of TO_DIR fails, and a merge on TO_DIR's branch might have
# broken it, the agent edits files to fix it, without building; then this
# script builds again.  The agent gets up to 3 attempts.  When the build
# succeeds, this script commits the agent's changes on top of the merges, as
# "Fix the build after merging ...", and pushes.  If the build still fails,
# this script stops, with the agent's changes staged but not committed.
# A merge might have broken the build if TO_DIR's branch has a merge commit
# that is in the history of none of the remote branches that TO_DIR's branch
# and FROM_DIR's branch push to and pull from and of the heads that the pulls
# of TO_DIR and FROM_DIR fetched, and that combined changes (its tree differs
# from each of its parents' trees), and if TO_DIR's tree differs from those
# commits' trees.  A remote branch, or a fetched head, counts only if its
# repository is not in the local file system, such as one on GitHub, or is a
# bare repository without a linked worktree, because the branches of another
# repository, such as another working clone, need not have been built.
# That merge commit can be the merge of FROM_DIR's branch, the merge that the
# pull of TO_DIR or of FROM_DIR made, or a merge that an earlier run made but
# did not push, as when its build failed; so a rerun after a failed build
# asks the agent too.
# If there is no such merge commit, as after a pull that only fast-forwarded
# TO_DIR's branch, the agent would merely work around a failure that no
# merge caused, so it is not asked.
#
# When the agent fails to resolve the conflicts or to fix the build, or when
# this script rejects its work, this script prints a command such as
#   cd DIR && claude --resume 1e55b89c-cfb5-468f-a783-cb104201809b
# or
#   cd DIR && codex resume 01a19ac9-dab5-7570-93b6-6ba41bf65093
# that continues the agent's session interactively, or one such command for
# each of the agent's attempts to fix the build.  In the resumed session,
# you can ask the agent about its work, or tell it to finish in a way that
# its instructions forbade, such as by creating a file.
# Then commit the merge or the fix yourself, and run this script again.
# This script also appends the command to the file AGENT-TODO.md at
# the top level of the working tree, where you are less likely to overlook
# it; delete the entry once you have dealt with it.  When the agent could not
# resolve the conflicts, the entry also tells an AI agent that reads it to
# ask a person for help with them.  But when the agent was not ready to run,
# or failed each time without changing anything and then was not ready to
# run, the entry instead says that running this script again, once the agent
# can run, asks the agent to do its task again; for a merge in progress in the
# first directory, whose pull such a merge makes this script refuse, the entry
# says to abort the merge first.  The resumed
# session runs with your usual permissions, not in the sandbox, and it
# contains the text of the merged changes, which can include instructions
# from other people.

# Here is an example of use.
#
# Suppose you have 3 branches named "part1", "part2", and "part3".  Each one
# contains the changes in the previous part, plus more.  Each branch is
# checked out in its own directory.  To keep all of these branches in sync,
# whenever you make a change to any branch (including to the main branch), run
# the following command:
#
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part1 \
#     MYDIR/myrepo-branch-part2 \
#     MYDIR/myrepo-branch-part3
#
# This helps to ensure that you will resolve each merge conflict just once.
#
# The history of the branches will contain many merges (most of which will be
# clean merges that do not require your attention).  If you squash-and-merge
# your pull requests, the branch history will not be reflected in your final
# repository.

# Here is a more complex example of use.
#
# Suppose you have a branch named "allchanges".  It contains a main set of
# changes, but also two sets of independent changes that should be
# pull-requested separately.  The first part of the changes consists of 3
# subparts that build upon one another, and the second part of the changes
# consists of 2 subparts that build upon one another.
#
# So, you have the following branches.
#  * allchanges
#     * part1   -- a subset of "allchanges"
#        * part1-step1  -- a subset of "part1-step2"
#        * part1-step2  -- a subset of "part1"
#     * part2   -- a subset of "allchanges"
#        * part2-step1  -- a subset of "part2"
#
# You would make 6 pull requests, in order to make each one address just one
# concern.  This makes the pull requests easier to review, and it makes the
# version control history easier to understand.
#
# Assume that you have each of these branches checked out in its own directory.
# To keep all of these branches in sync, whenever you make a change to any
# branch (including to the main branch), you would run the following commands:
#
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part1-step1 \
#     MYDIR/myrepo-branch-part1-step2 \
#     MYDIR/myrepo-branch-part1 \
#     MYDIR/myrepo-branch-allchanges && \
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part2-step1 \
#     MYDIR/myrepo-branch-part2 \
#     MYDIR/myrepo-branch-allchanges

nocompile=0
# 1 if the first directory of a chain is not pulled; see "Several chains".
no_pull_first=0
rebase=0
squash=0
# The file that `append_summary` in common-functions.sh appends to, or empty.
summary_file=''

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"
# This script runs git in directories other than the current one, such as in
# `agent_processes_in`, where an inherited $GIT_DIR would override `git -C`.
unset_git_location_variables

## Returns 0 if the given directory is the top level of a working tree whose
## branch still exists in its remote.  Otherwise, prints a diagnostic and
## returns 1.  Only status 1 from `is_deleted_branch` means "the branch still
## exists"; any other status is a reason not to proceed, because treating it
## as success would silently disable this check.
##
## Call the function of common-functions.sh rather than running the
## `is-deleted-branch` command, which is a wrapper around it.  One process for
## the whole run is what keeps this check from asking a remote the same
## question twice.  In a chain of directories, each middle directory is the
## TO_DIR of one call and the FROM_DIR of the next, so it is checked twice;
## and in this package's workflow every directory of the chain is a clone of
## one upstream, so one `git ls-remote` answers for the whole chain.
check_branch_exists() {
  is_deleted_branch "$1"
  is_deleted_status=$?
  case "${is_deleted_status}" in
    0)
      echo "${SCRIPT_NAME}: is a deleted branch: $1" >&2
      return 1
      ;;
    1) ;;
    2)
      # Status 2 also means a bare repository or a subdirectory of a working
      # tree, so do not say merely "not a git working tree", which would send
      # a user who is in such a directory looking for the wrong problem.
      report_not_working_tree_top "$1"
      return 1
      ;;
    3)
      # HEAD is detached, no remote can be determined for the branch, the
      # branch has no upstream configuration and nothing shows that it was
      # ever pushed, or the remote could not be contacted.
      # Whether the branch still exists is unknown.
      echo "${SCRIPT_NAME}: cannot tell whether the branch still exists in its remote: $1" >&2
      return 1
      ;;
    *)
      # `is_deleted_branch` answers only 0, 1, 2, or 3.  Any other status
      # means it could not answer at all, which must not be treated as "the
      # branch still exists".
      echo "${SCRIPT_NAME}: is_deleted_branch returned status ${is_deleted_status} on: $1" >&2
      return 1
      ;;
  esac
  return 0
}

## Prints the absolute pathname of the given directory, with symbolic links
## resolved.  Prints nothing and returns nonzero if the directory cannot be
## canonicalized, which the callers below diagnose.
## `realpath` would be simpler, but POSIX added it only in 2024 and some systems
## still lack it, whereas `cd` and `pwd -P` are portable.  `cd` writes its own
## diagnostic when it fails; discard it, because the callers below write a
## better one.
absolute_path() {
  (CDPATH='' cd -- "$1" && pwd -P) 2> /dev/null
}

## Fetches the given branch of the given directory into the current directory,
## which is the top level of a working tree, and sets ${fetched_head} to the
## commit that it fetched.  The directory is an absolute pathname.  Returns 1,
## after printing a diagnostic, on failure.
fetch_branch() {
  fetch_from_absolute="$1"
  fetch_from_branch="$2"

  # Fetch from a relative pathname, so that the pathname that `git fetch`
  # records in FETCH_HEAD does not embed this machine's directory layout.
  # `relative-path` is a portable version of `realpath --relative-to`, whose
  # `--relative-to` option the BSD and macOS versions of `realpath` lack.
  if ! fetch_from_relative="$("${SCRIPT_DIR}"/relative-path "$(pwd)" "${fetch_from_absolute}")"; then
    echo "${SCRIPT_NAME}: cannot express ${fetch_from_absolute} relative to $(pwd)" >&2
    return 1
  fi
  # `git fetch` parses a colon in a bare pathname as an scp-style URL.
  case "${fetch_from_relative}" in
    ./* | ../* | .) ;;
    *) fetch_from_relative="./${fetch_from_relative}" ;;
  esac

  # Name the branch as well as the repository, rather than fetching the
  # pathname alone.  `git fetch PATH` brings over whatever FROM_DIR's HEAD
  # points at, whereas `git fetch PATH BRANCH` brings over the branch that
  # `check_upstream` determined and `check_branch_exists` validated.  If
  # FROM_DIR's HEAD moved in between, the one-operand form merges or rebases
  # onto something that this script never checked.
  #
  # Spell the branch as `refs/heads/BRANCH` rather than as a bare name.
  # `git fetch` resolves a bare name by trying `refs/BRANCH` and
  # `refs/tags/BRANCH` before `refs/heads/BRANCH` -- the same collision that
  # `check_upstream` contends with above, where a tag and the branch share a
  # name.  Given a bare name, such a tag is fetched in place of the branch:
  # silently, and with exit status 0, because merging the tag is a perfectly
  # good merge as far as git is concerned.  The full refname admits no such
  # ambiguity.
  #
  # ${fetch_from_branch} is not empty:  `check_upstream` leaves it empty for a
  # detached HEAD and for a directory that is not a working tree, and
  # `check_branch_exists` refuses both before this function is called.
  if ! git fetch -q -- "${fetch_from_relative}" "refs/heads/${fetch_from_branch}"; then
    echo "${SCRIPT_NAME}: problem fetching ${fetch_from_absolute} into $(pwd)" >&2
    return 1
  fi
  if ! fetched_head="$(git rev-parse --verify --quiet FETCH_HEAD)"; then
    echo "${SCRIPT_NAME}: cannot read FETCH_HEAD after fetching ${fetch_from_absolute} into $(pwd)" >&2
    return 1
  fi
  return 0
}

## Usage: agent_processes_in DIRECTORY
## Prints, one per line, the process id and command name, such as
## "4242 claude", of each process of the current user that runs an AI agent
## and whose current directory is in the working tree whose top level is
## DIRECTORY, an absolute pathname with symbolic links resolved.  A process
## runs an AI agent if its command name is "claude" or "codex", as for Claude
## Code and Codex installed as native executables.  A process whose current
## directory is in another working tree nested in DIRECTORY, such as one in
## DIRECTORY/.claude/worktrees/NAME, is not printed.  Neither is a process
## that is this script or an ancestor of it, such as a Claude Code session
## that ran this script.  Returns 1, after printing a diagnostic, if the
## system has neither /proc nor `lsof`, so that the current directories of
## processes cannot be read.  Returns 2, after printing a diagnostic for each,
## if the current directory of some such process that is still running cannot
## be read, so that whether it works in DIRECTORY is unknown; it still prints
## the processes that it found in DIRECTORY.
agent_processes_in() {
  if [ -d /proc/self ]; then
    agent_processes_via=proc
  elif command -v lsof > /dev/null 2>&1; then
    agent_processes_via=lsof
  else
    echo "${SCRIPT_NAME}: cannot tell whether an AI agent is working in $1, because this system has neither /proc nor lsof" >&2
    return 1
  fi
  # The process ids of this shell and its ancestors, each followed by a blank.
  agent_processes_ancestors=' '
  agent_processes_pid=$$
  while [ -n "${agent_processes_pid}" ] && [ "${agent_processes_pid}" -gt 1 ]; do
    agent_processes_ancestors="${agent_processes_ancestors}${agent_processes_pid} "
    agent_processes_pid="$(ps -o ppid= -p "${agent_processes_pid}" 2> /dev/null | tr -d ' ')"
  done
  # On macOS, `ps` prints a command name as the executable's full pathname,
  # which can contain blanks.
  # The loop runs in an explicit subshell, so that its exit status is the
  # pipeline's even in a shell that runs a pipeline's last command in the
  # current shell.
  ps -U "$(id -u)" -o pid= -o comm= | (
    agent_processes_status=0
    while read -r agent_processes_pid agent_processes_command; do
      case "${agent_processes_command##*/}" in
        claude | codex) ;;
        *) continue ;;
      esac
      case "${agent_processes_ancestors}" in
        *" ${agent_processes_pid} "*) continue ;;
      esac
      if [ "${agent_processes_via}" = proc ]; then
        agent_processes_cwd="$(readlink "/proc/${agent_processes_pid}/cwd" 2> /dev/null)"
      else
        agent_processes_cwd="$(lsof -a -p "${agent_processes_pid}" -d cwd -Fn 2> /dev/null | sed -n -e 's/^n//p')"
      fi
      if [ -z "${agent_processes_cwd}" ]; then
        # A process that has exited since `ps` listed it, or a zombie, has no
        # current directory and works nowhere.  For any other process, the
        # lookup failed, and the process might be working in the directory.
        case "$(ps -o stat= -p "${agent_processes_pid}" 2> /dev/null | tr -d ' ')" in
          '' | Z*) continue ;;
        esac
        echo "${SCRIPT_NAME}: cannot read the current directory of ${agent_processes_command##*/} (process ${agent_processes_pid})" >&2
        agent_processes_status=2
        continue
      fi
      case "${agent_processes_cwd}" in
        "$1" | "$1"/*) ;;
        *) continue ;;
      esac
      # The test above is cheap; this one excludes a nested working tree.
      if agent_processes_top="$(git -C "${agent_processes_cwd}" rev-parse --show-toplevel 2> /dev/null)" \
        && [ "$(physical_path "${agent_processes_top}" 2> /dev/null)" = "$1" ]; then
        printf '%s %s\n' "${agent_processes_pid}" "${agent_processes_command##*/}"
      fi
    done
    exit "${agent_processes_status}"
  )
}

## Usage: finish_merge_in_progress DIRECTORY
## If a merge is in progress in DIRECTORY, the top level of a working tree and
## the current directory, resolves its conflicts and commits it, as when a
## merge that this script makes has conflicts (see `commit_resolved_merge`):
## it first runs `git rerere`, which applies any resolution recorded since
## the merge stopped, and then asks the AI agent ${llm_agent}, if it is not
## empty, about the conflicts that remain.  The commit's message is the
## merge's own (see `in_progress_merge_message`).  Does nothing if no merge
## is in progress.
##
## Returns 1, after printing a diagnostic, and leaves the merge in progress,
## which it notes in AGENT-TODO.md (see `report_merge_in_progress`), if an AI
## agent is working in DIRECTORY (see `agent_processes_in`), as when the user
## is resolving the conflicts in a session that this script printed a command
## to resume; if no conflicted file remains; if a conflicted file changed
## after git, `git rerere`, and this script left it (see
## `changed_conflicted_files`), as when this script rejected an AI agent's
## work, whose edits remain; or if the conflicts are not resolved or the
## merge cannot be committed.  The same holds if the current directory of a
## running AI agent cannot be read, so that it might be working in DIRECTORY.
## If `agent_processes_in` cannot tell at all whether an AI agent is working
## in DIRECTORY, because the system has neither /proc nor `lsof`, this
## function proceeds as if none is.
finish_merge_in_progress() {
  if ! git rev-parse --verify --quiet MERGE_HEAD > /dev/null; then
    return 0
  fi
  finish_in_progress="${SCRIPT_NAME}: a merge is in progress in $1"
  # `agent_processes_in` has said why it cannot tell.
  finish_agents="$(agent_processes_in "$1")"
  finish_agents_status=$?
  case "${finish_agents_status}" in
    0 | 2) ;;
    *)
      echo "${SCRIPT_NAME}: finishing the merge in $1 anyway" >&2
      finish_agents=''
      ;;
  esac
  if [ -z "${finish_agents}" ] && [ "${finish_agents_status}" -eq 2 ]; then
    echo "${finish_in_progress}, and an AI agent whose current directory cannot be read might be working there; finish the merge, or abort it with \`git merge --abort\`" >&2
    report_merge_in_progress "The current directory of an AI agent's process could not be read, so the agent might have been working in the directory."
    return 1
  fi
  if [ -n "${finish_agents}" ]; then
    printf '%s\n' "${finish_agents}" | while read -r finish_pid finish_command; do
      echo "${SCRIPT_NAME}: ${finish_command} (process ${finish_pid}) is working in $1" >&2
    done
    echo "${finish_in_progress}, and an AI agent is working there; finish the merge, or abort it with \`git merge --abort\`" >&2
    report_merge_in_progress "An AI agent was working in the directory:  $(printf '%s\n' "${finish_agents}" \
      | sed -e 's/^\([0-9]*\) \(.*\)/\2 (process \1)/' | paste -s -d ' ' -)."
    return 1
  fi
  # `resolve_merge_conflicts` would say only that it cannot list the
  # conflicted files.  A merge in progress without conflicts is one whose
  # conflicts someone resolved and staged, one whose commit a hook rejected,
  # or one whose message `git pull` could not compose; in each case, a person
  # should look at it.
  if [ -z "$(git ls-files --unmerged)" ]; then
    echo "${finish_in_progress}, and has no conflicted file; finish it with \`git commit\`, or abort it with \`git merge --abort\`" >&2
    report_merge_in_progress "No conflicted file remains."
    return 1
  fi
  # `resolve_merge_conflicts` would take such a file, which has no conflict
  # markers, for one that `git rerere` resolved.
  finish_changed="$(changed_conflicted_files)"
  if [ -n "${finish_changed}" ]; then
    printf '%s\n' "${finish_changed}" | while IFS= read -r finish_file; do
      echo "${SCRIPT_NAME}: changed after the merge stopped: ${finish_file}" >&2
    done
    echo "${finish_in_progress}, and its conflicted files changed after the merge stopped, as when an AI agent's work was rejected; finish the merge, or abort it with \`git merge --abort\`" >&2
    report_merge_in_progress "Its conflicted files changed after the merge stopped:  $(printf '%s\n' "${finish_changed}" | paste -s -d ' ' -)."
    return 1
  fi
  # Every conflicted file is as git and `git rerere` left it, so `git rerere`
  # changes only a file that still has conflict markers.
  # `rerere.autoUpdate` false leaves each file that it resolves unmerged in
  # the index, where `resolve_merge_conflicts` finds it.
  if ! git -c rerere.autoUpdate=false rerere; then
    echo "${SCRIPT_NAME}: \`git rerere\` failed in $1" >&2
  fi
  if ! finish_message="$(in_progress_merge_message)"; then
    echo "${finish_in_progress}, and has no MERGE_MSG; finish it, or abort it with \`git merge --abort\`" >&2
    report_merge_in_progress "It has no MERGE_MSG."
    return 1
  fi
  # The source as `resolve_merge_conflicts` names it, such as "branch 'main'"
  # for the subject "Merge branch 'main' into feature".
  finish_subject="$(printf '%s\n' "${finish_message}" | head -n 1)"
  case "${finish_subject}" in
    "Merge "*)
      finish_source="${finish_subject#Merge }"
      case "${finish_source}" in
        *" into "*) finish_source="${finish_source% into *}" ;;
      esac
      ;;
    *) finish_source="commit $(git rev-parse --verify --quiet MERGE_HEAD)" ;;
  esac
  echo "${SCRIPT_NAME}: finishing the merge of ${finish_source} that is in progress in $1" >&2
  commit_resolved_merge "${llm_agent}" MERGE_HEAD "${finish_source}" "${finish_message}"
}

## Usage: git_push_to FROM_DIR TO_DIR PULL_FROM FIRST
## A helper function that works on exactly two repositories.  Pulls FROM_DIR
## first if PULL_FROM is 1, and not if it is 0.  FIRST is 1 if FROM_DIR is
## the first directory of the chain, and 0 otherwise.  Sets ${push_step} to the
## step that it reached, such as "pulling DIR" or "building"; `push_chain`
## reports it when this function fails.  Sets ${from_pulled} to 1 once it
## has pulled FROM_DIR, and to 0 before then.
git_push_to() {

  from="$1"
  to="$2"
  push_step='checking the directories'
  from_pulled=0
  # A rerun refuses to pull the first directory while a merge is in progress
  # there.  Any other FROM_DIR is the TO_DIR of the step before, where a
  # rerun finishes the merge.
  rerun_finishes_merge=$((1 - $4))

  # A failure here is not yet an error, and it leaves the variable empty:  a
  # nonexistent directory fails here, and the tests just below diagnose that
  # better.
  from_absolute="$(absolute_path "${from}")"
  to_absolute="$(absolute_path "${to}")"

  if [ ! -d "${from}" ]; then
    if [ -n "${from_absolute}" ] && [ "${from}" != "${from_absolute}" ]; then
      echo "${SCRIPT_NAME}: no such directory: ${from} = ${from_absolute}" >&2
    else
      echo "${SCRIPT_NAME}: no such directory: ${from}" >&2
    fi
    return 1
  fi
  if [ ! -d "${to}" ]; then
    if [ -n "${to_absolute}" ] && [ "${to}" != "${to_absolute}" ]; then
      echo "${SCRIPT_NAME}: no such directory: ${to} = ${to_absolute}" >&2
    else
      echo "${SCRIPT_NAME}: no such directory: ${to}" >&2
    fi
    return 1
  fi
  if [ -z "${from_absolute}" ]; then
    echo "${SCRIPT_NAME}: cannot canonicalize: ${from}" >&2
    return 1
  fi
  if [ -z "${to_absolute}" ]; then
    echo "${SCRIPT_NAME}: cannot canonicalize: ${to}" >&2
    return 1
  fi

  if [ "${from_absolute}" = "${to_absolute}" ]; then
    echo "${SCRIPT_NAME}: FROM_DIR and TO_DIR are the same directory: ${from_absolute}" >&2
    return 1
  fi

  # Check the upstream before asking whether the branch was deleted:
  # `is_deleted_branch` cannot tell, and answers status 3, when the branch
  # has no upstream, and its diagnostic is less specific than this one.
  if ! check_upstream "${from_absolute}"; then
    return 1
  fi
  # The branch that the `git fetch` below brings over.  Read it now:  the
  # call to `check_upstream` for ${to_absolute} overwrites it with TO_DIR's
  # branch.
  from_branch="${checked_out_branch}"

  if ! check_branch_exists "${from_absolute}"; then
    return 1
  fi

  if [ "$3" -eq 1 ]; then
    push_step="pulling ${from}"
    if ! pull_resolving "${llm_agent}" "${from_absolute}"; then
      return 1
    fi
    from_pulled=1
    from_fetched="${pull_fetched}"
  else
    # As `pull_resolving` does, refuse to merge from a directory with a
    # merge in progress, whose branch lacks that merge.
    push_step="checking ${from}"
    if ! refuse_merge_in_progress "${from_absolute}" "It was in progress when \`${SCRIPT_NAME}\` was about to merge from it."; then
      return 1
    fi
    # The head that an earlier chain's pull of FROM_DIR fetched, as the pull
    # would have set ${pull_fetched}.
    from_fetched="$(upstream_fetch_head "${from_absolute}")" || from_fetched=''
  fi
  push_step="checking ${to}"

  orig_dir=$(pwd)

  if ! cd "$to_absolute"; then
    echo "${SCRIPT_NAME}: cannot cd to ${to_absolute}" >&2
    return 1
  fi

  if ! check_upstream "${to_absolute}"; then
    return 1
  fi

  if ! check_branch_exists "${to_absolute}"; then
    return 1
  fi

  # TO_DIR is never the first directory of the chain.  A merge in progress in
  # the first directory makes `refuse_merge_in_progress` above, which
  # `pull_resolving` calls, fail.
  # Note: pwd=to_absolute
  # From here on, a merge that this function leaves in progress is in
  # TO_DIR, where a rerun finishes it.
  rerun_finishes_merge=1
  push_step="finishing the merge in progress in ${to}"
  if ! finish_merge_in_progress "${to_absolute}"; then
    return 1
  fi

  # `--no-rebase` because a rebase would drop a merge of FROM_DIR's branch
  # that an earlier run of this command made but did not push, as when its
  # build failed, and would copy that merge's commits onto TO_DIR's branch.
  push_step="pulling ${to}"
  if ! pull_resolving "${llm_agent}" "${to_absolute}" --no-rebase; then
    return 1
  fi
  to_fetched="${pull_fetched}"

  # Note: pwd=to_absolute
  push_step="fetching the branch of ${from}"
  if ! fetch_branch "${from_absolute}" "${from_branch}"; then
    return 1
  fi
  merge_head="${fetched_head}"

  # FROM_DIR and TO_DIR are clones of one project, so the merge should read
  # the way it does when two branches of one clone are merged:
  #
  #   Merge branch 'feature' into main
  #
  # `git pull PATH BRANCH` would instead write "Merge branch 'feature' of
  # ../myrepo-branch-feature into main", and would head the commit summaries
  # that `merge.log` turns on with "* 'feature' of ../myrepo-branch-feature:".
  # So the description passed to `merge_build_push` names FROM_DIR's branch
  # as if it were a branch of this repository, ".", for which git omits
  # " of LOCATION" from the merge message (see `merge_build_push`).
  #
  # The histories of the remote branches that FROM_DIR's branch pushes to and
  # pulls from, and of the heads that the pulls of FROM_DIR and TO_DIR
  # fetched (or, if FROM_DIR was not pulled, that the latest fetch of its
  # upstream branch fetched), were built where they were pushed, so a failed
  # build of TO_DIR does not ask the agent about their merges.  FROM_DIR's own
  # merges, such as the one that the pull just made, are not among them.
  # Note: pwd=to_absolute
  if ! merge_build_push "${merge_head}" "branch '${from_branch}' of ." \
    "${from_branch} of ${from_absolute}" "${nocompile}" "${llm_agent}" \
    "${to_fetched} ${from_fetched}" "${from_absolute}"; then
    push_step="${merge_build_push_step}"
    return 1
  fi

  push_step="changing back to ${orig_dir}"
  if ! cd "${orig_dir}"; then
    echo "${SCRIPT_NAME}: cannot cd back to ${orig_dir}" >&2
    return 1
  fi

  return 0
}

## Returns 0 if a rebase is in progress in the current directory.
rebase_in_progress() {
  [ -d "$(git rev-parse --git-path rebase-merge)" ] \
    || [ -d "$(git rev-parse --git-path rebase-apply)" ]
}

## Resolves every conflict of the stopped rebase in the current directory in
## favor of the commit being replayed, REBASE_HEAD:  each unmerged path gets
## that commit's version, or is removed if that commit does not have it.
resolve_conflicts_as_theirs() {
  # `xargs -0` passes pathnames that contain whitespace or newlines intact.
  # GIT_LITERAL_PATHSPECS keeps git from interpreting glob characters in them.
  # shellcheck disable=SC2016 # The inner shell expands ${path}.
  git diff --name-only --diff-filter=U -z \
    | GIT_LITERAL_PATHSPECS=1 xargs -0 sh -c '
        for path; do
          if git cat-file -e "REBASE_HEAD:${path}" 2> /dev/null; then
            git checkout -q REBASE_HEAD -- "${path}" || exit 1
          else
            git rm -q -f -- "${path}" || exit 1
          fi
        done' sh
}

## Rebases the branch in the current directory, which is the top level of a
## clone, replaying the commits that are not reachable from the first argument
## onto the second argument.  Merge commits are dropped, and every conflict is
## resolved in favor of the commit being replayed.  Returns 1, after printing a
## diagnostic and aborting the rebase, on failure.
rebase_as_theirs() {
  rebase_upstream="$1"
  rebase_onto="$2"
  # Override configuration variables that would change what the rebase does:
  # `rebase.autoSquash` would reorder commits, `rebase.autoStash` would hide a
  # dirty working tree, `rebase.rebaseMerges` would keep the merge commits
  # that this rebase eliminates, and `rebase.updateRefs` would move other
  # branches.  `--empty=drop` drops a commit whose changes are already in the
  # new base.
  # Git's output about conflicts is not of interest, because they are
  # resolved below; show its output only if the rebase could not start.
  if rebase_output="$(git rebase -q -X theirs --empty=drop --no-autosquash \
    --no-autostash --no-rebase-merges --no-update-refs \
    --onto "${rebase_onto}" "${rebase_upstream}" 2>&1)"; then
    return 0
  fi
  if ! rebase_in_progress; then
    printf '%s\n' "${rebase_output}" >&2
    echo "${SCRIPT_NAME}: problem rebasing in $(pwd)" >&2
    return 1
  fi
  while rebase_in_progress; do
    if ! stopped_at="$(git rev-parse --verify --quiet REBASE_HEAD)"; then
      echo "${SCRIPT_NAME}: rebase stopped without a commit to replay in $(pwd)" >&2
      git rebase --abort
      return 1
    fi
    if ! resolve_conflicts_as_theirs; then
      echo "${SCRIPT_NAME}: cannot resolve conflicts in replaying ${stopped_at} in $(pwd)" >&2
      git rebase --abort
      return 1
    fi
    if [ -n "$(git ls-files -u)" ]; then
      echo "${SCRIPT_NAME}: conflicts remain in replaying ${stopped_at} in $(pwd)" >&2
      git rebase --abort
      return 1
    fi
    # A commit whose changes are all in the new base leaves nothing to commit,
    # and `git rebase --continue` refuses to proceed.
    if git diff --cached --quiet; then
      git rebase --skip > /dev/null 2>&1
    else
      GIT_EDITOR=true git rebase --continue > /dev/null 2>&1
    fi
    if rebase_in_progress \
      && [ "$(git rev-parse --verify --quiet REBASE_HEAD)" = "${stopped_at}" ]; then
      echo "${SCRIPT_NAME}: rebase is stuck at ${stopped_at} in $(pwd)" >&2
      git rebase --abort
      return 1
    fi
  done
  return 0
}

## Sets ${replay_base} to a commit such that the commits of the current
## directory's branch that are not reachable from it are the branch's own
## commits.  The first argument is the directory of the previous branch, the
## second is that branch's ref, and the third is the commit of that branch
## that was merged into the current branch, which is an ancestor of HEAD.
##
## The current branch may also contain commits that the previous branch
## contained before it was rewritten -- for example, by an earlier run that
## force-pushed the previous branch and then failed on the current one.  The
## previous branch's reflog records its former heads.  If HEAD contains any of
## them, ${replay_base} is a new merge commit whose parents are the third
## argument and those former heads; otherwise, it is the third argument.
## Returns 1, after printing a diagnostic, on failure.
compute_replay_base() {
  # A missing reflog, for example because `core.logAllRefUpdates` is false,
  # leaves only the third argument.
  former_heads="$(git -C "$1" reflog show --format=%H "$2" -- 2> /dev/null | sort -u)"
  set -- "$3"
  for former_head in ${former_heads}; do
    # `git merge-base --is-ancestor` fails for a commit that is not in this
    # clone, which therefore is not in HEAD.
    if git merge-base --is-ancestor "${former_head}" HEAD 2> /dev/null \
      && ! git merge-base --is-ancestor "${former_head}" "$1"; then
      set -- "$@" "${former_head}"
    fi
  done
  if [ "$#" -eq 1 ]; then
    replay_base="$1"
    return 0
  fi
  first_parent="$1"
  for parent; do
    shift
    set -- "$@" -p "${parent}"
  done
  # The merge commit's tree is irrelevant, because it is used only to limit
  # which commits are replayed.
  if ! replay_base="$(git commit-tree "${first_parent}^{tree}" "$@" \
    -m "Former heads of the previous branch")"; then
    echo "${SCRIPT_NAME}: cannot create a commit that merges the former heads of the previous branch in $(pwd)" >&2
    return 1
  fi
  return 0
}

## Resets the current directory's branch to ${orig_head}, its head before
## `git_rebase_onto` rewrote it, after a failure.  If the branch stayed
## rewritten, the next `git pull` would merge the remote's history into it,
## and the next rebase would replay every commit twice.  `--keep` refuses to
## discard local changes; then this tells the user how to reset.
reset_to_orig_head() {
  if [ "$(git rev-parse --verify HEAD)" = "${orig_head}" ]; then
    return 0
  fi
  if git reset -q --keep "${orig_head}"; then
    echo "${SCRIPT_NAME}: reset ${to_branch} to ${orig_head}, its head before rebasing" >&2
  else
    echo "${SCRIPT_NAME}: cannot reset ${to_branch}; run \`git reset --keep ${orig_head}\` in $(pwd)" >&2
  fi
}

## Rebases the branch in the second directory onto the branch in the first,
## then pushes it if that changed it.  The third argument is the commit that
## the first directory's branch pointed to when it was last merged into the
## second's; the commits reachable from it are not replayed.  If ${squash} is
## 1, the result is a single commit.  Whether or not ${squash} is 1, the
## content of the second directory's branch does not change.  Both
## directories have already been checked by `git_push_to`.
git_rebase_onto() {
  from_absolute="$(absolute_path "$1")"
  to_absolute="$(absolute_path "$2")"
  old_from_head="$3"

  from_branch="$(current_branch "${from_absolute}")" || return 1
  to_branch="$(current_branch "${to_absolute}")" || return 1

  orig_dir=$(pwd)

  if ! cd "$to_absolute"; then
    echo "${SCRIPT_NAME}: cannot cd to ${to_absolute}" >&2
    return 1
  fi

  if ! fetch_branch "${from_absolute}" "${from_branch}"; then
    return 1
  fi
  new_from_head="${fetched_head}"

  orig_head="$(git rev-parse --verify HEAD)" || return 1
  orig_tree="$(git rev-parse --verify "HEAD^{tree}")" || return 1

  # `git_push_to` merged ${old_from_head} into this branch, so it is an
  # ancestor.  If it is not, then the branch changed in the meantime, and the
  # rebase would replay commits that do not belong to this branch.
  if ! git merge-base --is-ancestor "${old_from_head}" HEAD; then
    echo "${SCRIPT_NAME}: ${from_branch} at ${old_from_head} is not an ancestor of ${to_branch} in $(pwd)" >&2
    return 1
  fi
  if ! compute_replay_base "${from_absolute}" "refs/heads/${from_branch}" "${old_from_head}"; then
    return 1
  fi

  if [ "${squash}" -eq 1 ]; then
    # The message lists the messages of the branch's own commits, oldest
    # first, as `git merge --squash` does.
    if ! squash_message="$(git log --reverse --no-merges --format='%B' \
      "${replay_base}..HEAD")"; then
      echo "${SCRIPT_NAME}: cannot read the commit messages of ${to_branch} in $(pwd)" >&2
      return 1
    fi
    if [ -z "${squash_message}" ]; then
      squash_message="Changes in ${to_branch}"
    fi
    if [ "$(git rev-parse "${new_from_head}^{tree}")" = "${orig_tree}" ]; then
      new_head="${new_from_head}"
    elif [ "$(git rev-parse --verify --quiet HEAD^2)" = "" ] \
      && [ "$(git rev-parse --verify --quiet HEAD^1)" = "${new_from_head}" ]; then
      # The branch is already a single commit on top of ${from_branch}.
      new_head="${orig_head}"
    elif ! new_head="$(printf '%s\n' "${squash_message}" \
      | git commit-tree "${orig_tree}" -p "${new_from_head}")"; then
      echo "${SCRIPT_NAME}: cannot create the squashed commit in $(pwd)" >&2
      return 1
    fi
    if ! git merge -q --ff-only "${new_head}" 2> /dev/null \
      && ! git reset -q --keep "${new_head}"; then
      echo "${SCRIPT_NAME}: cannot move ${to_branch} to ${new_head} in $(pwd)" >&2
      reset_to_orig_head
      return 1
    fi
  else
    if ! rebase_as_theirs "${replay_base}" "${new_from_head}"; then
      return 1
    fi
    # The replayed commits may not reproduce the branch's content, for example
    # because a conflict resolution in a dropped merge commit is lost.  Restore
    # the content with one more commit.
    if [ "$(git rev-parse --verify "HEAD^{tree}")" != "${orig_tree}" ]; then
      if ! restore_commit="$(git commit-tree "${orig_tree}" -p HEAD \
        -m "Restore the content of ${to_branch} from before rebasing onto ${from_branch}")"; then
        echo "${SCRIPT_NAME}: cannot create a commit to restore ${to_branch} in $(pwd)" >&2
        reset_to_orig_head
        return 1
      fi
      if ! git merge -q --ff-only "${restore_commit}"; then
        echo "${SCRIPT_NAME}: cannot restore the content of ${to_branch} in $(pwd)" >&2
        reset_to_orig_head
        return 1
      fi
    fi
  fi

  if [ "$(git rev-parse --verify HEAD)" != "${orig_head}" ]; then
    # The rebase rewrote the branch, so a plain push would be refused.
    # `--force-with-lease` refuses to overwrite commits that someone else
    # pushed since `git_push_to` last pulled.
    if ! git push --quiet --force-with-lease; then
      echo "${SCRIPT_NAME}: problem pushing from $(pwd)" >&2
      reset_to_orig_head
      return 1
    fi
  fi

  if ! cd "${orig_dir}"; then
    echo "${SCRIPT_NAME}: cannot cd back to ${orig_dir}" >&2
    return 1
  fi

  return 0
}

## Usage: chain_failed MESSAGE
## Prints MESSAGE, which says which step of `push_chain` failed, as a
## diagnostic, and appends it to the summary (see `append_summary`).
chain_failed() {
  echo "${SCRIPT_NAME}: $1" >&2
  append_summary "$1"
}

## Pushes each given directory into the next one, without pulling the first
## directory if ${no_pull_first} is 1.  Then, if ${rebase} is 1,
## rebases each directory's branch, except the first, onto the previous one.
## Returns 1 at the first failure, after printing a diagnostic that names the
## step that failed, such as "git-push-to: failed to push myrepo-branch-main
## into myrepo-branch-feature, while building", and appending it to the
## summary.  Returns 2 instead if it fails before it has pulled the first
## directory, which it pulls if ${no_pull_first} is 0.
push_chain() {
  prev=''
  pull_from=$((1 - no_pull_first))
  # 1 until the first directory has been pulled, if it is to be pulled.
  first_unpulled="${pull_from}"
  # 1 for the step whose FROM_DIR is the first directory.
  first_step=1
  for arg; do
    if [ -n "$prev" ]; then
      if ! git_push_to "$prev" "$arg" "${pull_from}" "${first_step}"; then
        chain_failed "failed to push ${prev} into ${arg}, while ${push_step}"
        if [ "${first_unpulled}" -eq 1 ] && [ "${from_pulled}" -eq 0 ]; then
          return 2
        fi
        return 1
      fi
      pull_from=1
      first_unpulled=0
      first_step=0
    fi
    prev="$arg"
  done
  if [ "${rebase}" -eq 0 ]; then
    return 0
  fi
  prev=''
  # The previous directory's head before it was rebased, which is what the
  # current directory merged from it.
  old_prev_head=''
  for arg; do
    if ! arg_head="$(git -C "$arg" rev-parse --verify HEAD)"; then
      chain_failed "failed to rebase, because HEAD cannot be read in $arg"
      return 1
    fi
    if [ -n "$prev" ]; then
      if ! git_rebase_onto "$prev" "$arg" "${old_prev_head}"; then
        chain_failed "failed to rebase $arg onto $prev"
        return 1
      fi
    fi
    prev="$arg"
    old_prev_head="${arg_head}"
  done
  return 0
}

## Returns 0 if the argument is a slug, ORG:BRANCH or BRANCH, rather than a
## directory.  Git forbids a branch name that starts with "/" or ".", or whose
## component starts with ".".  An argument BRANCH that names no directory in
## the current directory is not a slug, so that a misspelled directory name
## is reported as a missing directory.
is_slug() {
  if [ -d "$1" ]; then
    return 1
  fi
  case "$1" in
    '' | */*:* | :* | *: | /* | .* | */.*) return 1 ;;
    *:*) return 0 ;;
  esac
  # slug_matches fails only if it finds a directory for the slug.
  is_slug_matches="$(slug_matches "$1" 2> /dev/null)" || return 0
  [ -n "${is_slug_matches}" ]
}

## Usage: names_project PROJECT
## Returns 0 if ${slug_org}, the ORG of a slug ORG:BRANCH, names the clone
## PROJECT in the current directory, as ORG "-" does, because there is no
## clone PROJECT-fork-ORG and ORG owns the upstream repository of the clone
## PROJECT, as typetools owns typetools/checker-framework.  `enter_slug_clone`
## in common-functions.sh applies the same rule.
names_project() {
  [ -n "${slug_org}" ] && [ "${slug_org}" != '-' ] \
    && [ ! -d "$1-fork-${slug_org}" ] && [ -e "$1/.git" ] \
    && owns_upstream "${slug_org}" "$1"
}

## Returns 0 if the given directory has the given branch checked out.
has_branch_checked_out() {
  has_branch_actual="$(current_branch "$1")" && [ "${has_branch_actual}" = "$2" ]
}

## Prints the directory that the slug ORG:BRANCH names for the given project,
## or prints nothing and returns 1 if there is none.  ORG "-" stands for a
## directory whose name has no ORG:  PROJECT-branch-BRANCH, or PROJECT if it
## has BRANCH checked out and the former does not exist.  So does an ORG that
## owns the upstream repository of the clone PROJECT, if there is no clone
## PROJECT-fork-ORG; see `names_project`.
slug_dir() {
  parse_slug "$2"
  if names_project "$1"; then
    slug_dir "$1" "-:${slug_branch}"
    return
  fi
  if [ "${slug_org}" = "-" ]; then
    if [ -d "$1-branch-${slug_branch_dir}" ] \
      && has_branch_checked_out "$1-branch-${slug_branch_dir}" "${slug_branch}"; then
      printf '%s\n' "$1-branch-${slug_branch_dir}"
      return 0
    fi
    if [ ! -d "$1-branch-${slug_branch_dir}" ] && [ -e "$1/.git" ] \
      && has_branch_checked_out "$1" "${slug_branch}"; then
      printf '%s\n' "$1"
      return 0
    fi
    return 1
  fi
  if [ -d "$1-fork-${slug_org}-branch-${slug_branch_dir}" ]; then
    if has_branch_checked_out "$1-fork-${slug_org}-branch-${slug_branch_dir}" "${slug_branch}"; then
      printf '%s\n' "$1-fork-${slug_org}-branch-${slug_branch_dir}"
      return 0
    fi
    return 1
  fi
  if [ -d "$1-fork-${slug_org}" ] \
    && has_branch_checked_out "$1-fork-${slug_org}" "${slug_branch}"; then
    printf '%s\n' "$1-fork-${slug_org}"
    return 0
  fi
  return 1
}

## Returns 0 if the given directory has ${slug_branch} checked out.  Otherwise,
## prints an error message and returns 1.
check_branch_dir() {
  if ! check_actual="$(current_branch "$1")"; then
    check_actual="a detached HEAD"
  elif [ "${check_actual}" = "${slug_branch}" ]; then
    return 0
  fi
  echo "${SCRIPT_NAME}: ${1#./} has ${check_actual} checked out, not ${slug_branch}" >&2
  return 1
}

## Prints, one per line, PROJECT:ORG for each directory in the current
## directory that the slug names.  If the slug has no ORG, every ORG matches,
## and so do PROJECT-branch-BRANCH and a clone PROJECT that has BRANCH
## checked out, for which ORG is "-".  ORG "-" matches only those two, and so
## does an ORG that names the clone PROJECT (see `names_project`).
## Returns 1, after printing an error message, if a directory
## PROJECT[-fork-ORG]-branch-BRANCH that the slug names has some other branch
## checked out, because merging into that directory would merge into the wrong
## branch.
slug_matches() {
  parse_slug "$1"
  match_status=0
  for dir in ./*-fork-*-branch-"${slug_branch_dir}"; do
    if [ ! -d "${dir}" ] || [ "${slug_org}" = '-' ]; then continue; fi
    name="${dir#./}"
    name="${name%-branch-"${slug_branch_dir}"}"
    parse_clone_name "${name}"
    # For example, "p-fork-o-branch-x-branch-main" is not a directory for
    # branch "main".
    case "${clone_org}" in *-branch-*) continue ;; esac
    if [ -n "${slug_org}" ] && [ "${clone_org}" != "${slug_org}" ]; then continue; fi
    if ! check_branch_dir "${dir}"; then
      match_status=1
      continue
    fi
    printf '%s:%s\n' "${clone_project}" "${clone_org}"
  done
  if [ -z "${slug_org}" ] || [ "${slug_org}" = '-' ]; then
    for dir in ./*-branch-"${slug_branch_dir}"; do
      if [ ! -d "${dir}" ]; then continue; fi
      name="${dir#./}"
      project="${name%-branch-"${slug_branch_dir}"}"
      case "${project}" in *-fork-* | *-branch-*) continue ;; esac
      if ! check_branch_dir "${dir}"; then
        match_status=1
        continue
      fi
      printf '%s:-\n' "${project}"
    done
    for dir in ./*; do
      if [ ! -e "${dir}/.git" ]; then continue; fi
      name="${dir#./}"
      case "${name}" in *-fork-* | *-branch-*) continue ;; esac
      # A PROJECT-branch-BRANCH directory takes precedence.
      if [ -d "${name}-branch-${slug_branch_dir}" ]; then continue; fi
      if has_branch_checked_out "${dir}" "${slug_branch}"; then
        printf '%s:-\n' "${name}"
      fi
    done
  fi
  if [ -n "${slug_org}" ] && [ "${slug_org}" != '-' ]; then
    for dir in ./*; do
      name="${dir#./}"
      case "${name}" in *-fork-* | *-branch-*) continue ;; esac
      if ! names_project "${name}"; then continue; fi
      # As for ORG "-", a PROJECT-branch-BRANCH directory takes precedence.
      if [ -d "${name}-branch-${slug_branch_dir}" ]; then
        if ! check_branch_dir "${name}-branch-${slug_branch_dir}"; then
          match_status=1
          continue
        fi
        printf '%s:%s\n' "${name}" "${slug_org}"
      elif has_branch_checked_out "${dir}" "${slug_branch}"; then
        printf '%s:%s\n' "${name}" "${slug_org}"
      fi
    done
  fi
  for dir in ./*-fork-*; do
    if [ ! -d "${dir}" ] || [ "${slug_org}" = '-' ]; then continue; fi
    name="${dir#./}"
    parse_clone_name "${name}"
    case "${clone_org}" in *-branch-*) continue ;; esac
    if [ -n "${slug_org}" ] && [ "${clone_org}" != "${slug_org}" ]; then continue; fi
    # A PROJECT-fork-ORG-branch-BRANCH directory takes precedence.
    if [ -d "${name}-branch-${slug_branch_dir}" ]; then continue; fi
    if has_branch_checked_out "${dir}" "${slug_branch}"; then
      printf '%s:%s\n' "${clone_project}" "${clone_org}"
    fi
  done
  return "${match_status}"
}

## Main program starts here.

while [ "$#" -ge 1 ]; do
  case "$1" in
    --nocompile) nocompile=1 ;;
    --no-pull-first) no_pull_first=1 ;;
    --rebase) rebase=1 ;;
    --squash)
      rebase=1
      squash=1
      ;;
    --summary)
      if [ "$#" -lt 2 ]; then
        echo "${SCRIPT_NAME}: --summary requires a file name" >&2
        exit 1
      fi
      # `git_push_to` changes the current directory.
      case "$2" in
        /*) summary_file="$2" ;;
        *) summary_file="$(pwd)/$2" ;;
      esac
      # `append_summary` does not diagnose a failure to write.  A failed
      # redirection of the special built-in `:` would exit the shell.
      if [ -z "$2" ] || ! true 2> /dev/null >> "${summary_file}"; then
        echo "${SCRIPT_NAME}: cannot write the summary file: $2" >&2
        exit 1
      fi
      shift
      ;;
    *)
      if ! parse_llm_option "$1"; then break; fi
      ;;
  esac
  shift
done

if [ "$#" -lt 2 ]; then
  echo "${SCRIPT_NAME}: not enough arguments" >&2
  echo "Usage: ${SCRIPT_NAME} [OPTIONS] FROM_DIR TO_DIR ..." >&2
  echo "   or: ${SCRIPT_NAME} [OPTIONS] [ORG:]BRANCH [ORG:]BRANCH ..." >&2
  echo "OPTIONS: [--nocompile] [--no-pull-first] [--rebase | --squash] ${llm_options_usage} [--summary FILE]" >&2
  exit 1
fi

num_slugs=0
for arg; do
  if is_slug "$arg"; then
    num_slugs=$((num_slugs + 1))
  fi
done

if [ "${num_slugs}" -eq 0 ]; then
  push_chain "$@"
  exit
fi

if [ "${num_slugs}" -ne "$#" ]; then
  for arg; do
    if [ ! -d "$arg" ] && ! is_slug "$arg"; then
      echo "${SCRIPT_NAME}: no such directory: $arg" >&2
      echo "${SCRIPT_NAME}: and, as a slug, $arg names no directory in $(pwd)" >&2
      exit 1
    fi
  done
  echo "${SCRIPT_NAME}: cannot mix slugs with directories: $*" >&2
  exit 1
fi

newline='
'

# Resolve every slug before pushing anything, so that a misspelled slug does
# not leave the work half done.
#
# Each chain is identified by a key PROJECT:ORG.  A slug BRANCH, which has no
# ORG, contributes to the chain for each PROJECT and ORG that has a directory
# for it, so each chain stays within one ORG.  A slug ORG:BRANCH contributes
# to every chain for its PROJECT.  A PROJECT with directories only for slugs
# ORG:BRANCH gets a single chain whose key has an empty ORG.  The key
# PROJECT:- is the chain of directories PROJECT-branch-BRANCH.
keys=''
explicit_projects=''
for arg; do
  if ! check_slug_org "$arg"; then
    exit 1
  fi
  if ! arg_matches="$(slug_matches "$arg")"; then
    exit 1
  fi
  parse_slug "$arg"
  if [ -z "${arg_matches}" ]; then
    if [ "${slug_org}" = '-' ]; then
      echo "${SCRIPT_NAME}: no directory *-branch-${slug_branch_dir} (or a clone on branch ${slug_branch}) whose name has no ORG in $(pwd) for $arg" >&2
    elif [ -n "${slug_org}" ]; then
      echo "${SCRIPT_NAME}: no directory *-fork-${slug_org}-branch-${slug_branch_dir} (or *-fork-${slug_org} on branch ${slug_branch}) in $(pwd) for $arg" >&2
    else
      echo "${SCRIPT_NAME}: no directory *-branch-${slug_branch_dir} (or *-fork-* or a clone on branch ${slug_branch}) in $(pwd) for $arg" >&2
    fi
    exit 1
  fi
  if [ -n "${slug_org}" ]; then
    explicit_projects="${explicit_projects}${newline}$(printf '%s\n' "${arg_matches}" | sed -e 's/:.*//')"
  else
    keys="${keys}${newline}${arg_matches}"
  fi
done
saved_ifs="${IFS}"
IFS="${newline}"
for project in ${explicit_projects}; do
  case "${keys}${newline}" in
    *"${newline}${project}:"*) ;;
    *) keys="${keys}${newline}${project}:" ;;
  esac
done
IFS="${saved_ifs}"
keys="$(printf '%s\n' "${keys}" | sed -e '/^$/d' | sort -u)"

# Git forbids whitespace and glob characters in branch names, so the slugs can
# be kept in a whitespace-separated string.
slugs="$*"

status=0
num_chains=0
# The first directories that the chains so far pulled; see
# `is_pulled_first_dir`.
pulled_first_dirs=''
IFS="${newline}"
for key in ${keys}; do
  IFS="${saved_ifs}"
  project="${key%%:*}"
  org="${key#*:}"
  chain=''
  chain_length=0
  last_dir=''
  for slug in ${slugs}; do
    parse_slug "${slug}"
    if [ -z "${slug_org}" ]; then
      if [ -z "${org}" ]; then continue; fi
      slug="${org}:${slug}"
    fi
    # For ORG, the slugs ORG:BRANCH and BRANCH name the same directory, which
    # must not be pushed into itself.
    if dir="$(slug_dir "${project}" "${slug}")" && [ "${dir}" != "${last_dir}" ]; then
      last_dir="${dir}"
      chain="${chain}${dir}${newline}"
      chain_length=$((chain_length + 1))
    fi
  done
  # A project with fewer than two of the directories is silently skipped,
  # because reporting every such project would be too verbose.
  if [ "${chain_length}" -lt 2 ]; then
    IFS="${newline}"
    continue
  fi
  num_chains=$((num_chains + 1))
  # Pull a directory that starts several chains only for the first of them
  # that pulls it; see "Several chains".
  chain_first="${chain%%"${newline}"*}"
  chain_no_pull_first="${no_pull_first}"
  if is_pulled_first_dir "${chain_first}"; then
    chain_no_pull_first=1
  fi
  # Run the chain in a subshell, because `git_push_to` changes the working
  # directory and does not change it back when it fails.  Continue with the
  # other chains after a failure, because they are independent of it.
  (
    no_pull_first="${chain_no_pull_first}"
    set -f
    IFS="${newline}"
    # shellcheck disable=SC2086 # Split ${chain} on newlines.
    set -- ${chain}
    IFS="${saved_ifs}"
    set +f
    push_chain "$@"
  )
  chain_status=$?
  if [ "${chain_status}" -ne 0 ]; then
    status=1
  fi
  # A chain that failed before it pulled its first directory leaves the
  # directory for a later chain to pull.
  if [ "${chain_status}" -ne 2 ] && [ "${chain_no_pull_first}" -eq 0 ]; then
    add_pulled_first_dir "${chain_first}"
  fi
  IFS="${newline}"
done
IFS="${saved_ifs}"

if [ "${num_chains}" -eq 0 ]; then
  echo "${SCRIPT_NAME}: no project has directories for two or more of: ${slugs}" >&2
  exit 1
fi

exit "${status}"
