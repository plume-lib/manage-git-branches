#!/bin/sh

# Pushes one git repository into another, from local clones.  Fails if the
# resulting merge does not compile.  If more than two repositories are given,
# each is pushed into the next in turn.
#
# Usage:
#   git-push-to [--nocompile] FROM_DIR TO_DIR ...
#   git-push-to [--nocompile] [ORG:]BRANCH [ORG:]BRANCH ...
#
# Each argument names the top level of a working copy (that is, of a clone).
# Each may be absolute directory names or relative to the current directory.
# The first argument may be "--nocompile" to skip the compilation step.
#
# Alternately, each argument may be a slug of the form ORG:BRANCH, which names
# a directory in the current directory:  PROJECT-fork-ORG-branch-BRANCH, or
# PROJECT-fork-ORG if that directory has BRANCH checked out and the former
# does not exist.  A "/" in BRANCH is written as "-" in the directory name, as
# `git-new-branch` does.  Every PROJECT that has a directory for any of the
# slugs gets its own chain, made of the slugs' directories that exist for that
# PROJECT.  For example,
# `git-push-to typetools:master mernst:feature` is equivalent to
#   git-push-to checker-framework-fork-typetools-branch-master \
#               checker-framework-fork-mernst-branch-feature
# and, if stubparser-fork-mernst-branch-feature exists but no stubparser
# directory for typetools:master does, a PROJECT with a single directory has
# nothing to push and is skipped.  Slugs and directories cannot be mixed.
#
# A slug may also be just BRANCH, which matches every ORG.  Then each PROJECT
# and ORG gets its own chain, so a chain never goes from one ORG's BRANCH to
# another ORG's BRANCH.  For example, `git-push-to main feature` pushes
# PROJECT-fork-ORG-branch-main into PROJECT-fork-ORG-branch-feature for each
# PROJECT and ORG.  A slug ORG:BRANCH in the same command belongs to every
# chain of its PROJECT:  `git-push-to typetools:master master feature` pushes
# typetools's master into each ORG's master, then that into ORG's feature.
#
# This script does the following:
#  * pull FROM_DIR and TO_DIR from their remotes,
#  * merge FROM_DIR's branch into TO_DIR,
#  * build TO_DIR using `compile-project` (see its documentation),
#    (Skips the compilation step if environment variable
#    MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT is set.)
#  * push TO_DIR to its remote if the build succeeds.
#
# If more than two directories are supplied, the procedure is performed on each
# pair of adjacent directories in turn.

# Here is an example of use.
#
# Suppose you have 3 branches named "part1", "part2", and "part3".  Each one
# contains the changes in the previous part, plus more.  Each branch is
# checked out in its own directory.  To keep all of these branches in sync,
# whenever you make a change to any branch (including to the main branch), run
# the following command:
#
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part1 \
#     MYDIR/myrepo-branch-part2 \
#     MYDIR/myrepo-branch-part3
#
# This helps to ensure that you will resolve each merge conflict just once.
#
# The history of the branches will contain many merges (most of which will be
# clean merges that do not require your attention).  If you are using the
# standard squash-and-merge handling of pull requests, the branch history will
# not be reflected in your final repository.

# Here is a more complex example of use.
#
# Suppose you have a branch named "allchanges".  It contains a main set of
# changes, but also two sets of independent changes that should be
# pull-requested separately.  The first part of the changes consists of 3
# subparts that build upon one another, and the second part of the changes
# consists of 2 subparts that build upon one another.
#
# So, you have the following branches.
#  * allchanges
#     * part1   -- a subset of "allchanges"
#        * part1-step1  -- a subset of "part1-step2"
#        * part1-step2  -- a subset of "part1"
#     * part2   -- a subset of "allchanges"
#        * part2-step1  -- a subset of "part2"
#
# You would make 6 pull requests, in order to make each one address just one
# concern.  This makes the pull requests easier to review, and it makes the
# version control history easier to understand.
#
# Assume that you have each of these branches checked out in its own directory.
# To keep all of these branches in sync, whenever you make a change to any
# branch (including to the main branch), you would run the following commands:
#
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part1-step1 \
#     MYDIR/myrepo-branch-part1-step2 \
#     MYDIR/myrepo-branch-part1 \
#     MYDIR/myrepo-branch-allchanges && \
#   git-push-to \
#     MYDIR/myrepo-branch-main \
#     MYDIR/myrepo-branch-part2-step1 \
#     MYDIR/myrepo-branch-part2 \
#     MYDIR/myrepo-branch-allchanges

nocompile=0

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/remote-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/remote-functions.sh" >&2
  exit 1
fi
# shellcheck source=remote-functions.sh
. "${SCRIPT_DIR}/remote-functions.sh"

## Tests whether the working copy in the given directory has an upstream
## branch, which `git pull` and `git push` require.  If it does not, prints an
## explanation and returns 1.
##
## Also sets ${checked_out_branch} to the name of the branch that the
## directory has checked out, or to the empty string if HEAD is detached or
## the directory is not a working copy.  It is the local branch, not the
## upstream branch that this function is named for; the two can differ.  The
## `git fetch` and `git merge` below act on that branch, and this is where its
## name is determined.
check_upstream() {
  checked_out_branch=''
  # If the directory is not a working copy, or HEAD is detached, let a
  # subsequent command diagnose that:  `check_branch_exists` does so
  # accurately, whereas `git rev-parse --abbrev-ref HEAD` prints "HEAD" for a
  # detached HEAD, which this function would then report as a branch name.
  # Strip the known prefix ourselves, because `symbolic-ref --short` can return
  # "heads/BRANCH" when a tag and the branch have the same name.
  branch_ref="$(git -C "$1" symbolic-ref --quiet HEAD 2> /dev/null)" || return 0
  branch="${branch_ref#refs/heads/}"
  checked_out_branch="${branch}"
  remote="$(git -C "$1" config --get "branch.${branch}.remote")"
  merge_refs="$(git -C "$1" config --get-all "branch.${branch}.merge")"
  if [ -n "${remote}" ] && [ -n "${merge_refs}" ]; then
    return 0
  fi
  echo "${SCRIPT_NAME}: branch ${branch} in $1 has no upstream branch, so it cannot be pulled or pushed" >&2
  return 1
}

## Returns 0 if the given directory is the top level of a clone whose branch
## still exists in its remote.  Otherwise, prints a diagnostic and returns 1.
## Only status 1 from `is_deleted_branch` means "the branch still exists"; any
## other status is a reason not to proceed, because treating it as success
## would silently disable this check.
##
## Call the function of remote-functions.sh rather than running the
## `is-deleted-branch` command, which is a wrapper around it.  One process for
## the whole run is what keeps this check from asking a remote the same
## question twice.  In a chain of directories, each middle directory is the
## TO_DIR of one call and the FROM_DIR of the next, so it is checked twice;
## and in this package's workflow every directory of the chain is a clone of
## one upstream, so one `git ls-remote` answers for the whole chain.
check_branch_exists() {
  is_deleted_branch "$1"
  is_deleted_status=$?
  case "${is_deleted_status}" in
    0)
      echo "${SCRIPT_NAME}: is a deleted branch: $1" >&2
      return 1
      ;;
    1) ;;
    2)
      # Status 2 also means a bare repository or a subdirectory of a working
      # copy, so do not say merely "not a git clone", which would send a user
      # who is in such a directory looking for the wrong problem.
      echo "${SCRIPT_NAME}: not the top level of a git clone: $1" >&2
      return 1
      ;;
    3)
      # HEAD is detached, no remote can be determined for the branch, the
      # branch has no upstream configuration and nothing shows that it was
      # ever pushed, or the remote could not be contacted.
      # Whether the branch still exists is unknown.
      echo "${SCRIPT_NAME}: cannot tell whether the branch still exists in its remote: $1" >&2
      return 1
      ;;
    *)
      # `is_deleted_branch` answers only 0, 1, 2, or 3.  Any other status
      # means it could not answer at all, which must not be treated as "the
      # branch still exists".
      echo "${SCRIPT_NAME}: is_deleted_branch returned status ${is_deleted_status} on: $1" >&2
      return 1
      ;;
  esac
  return 0
}

## Prints the absolute pathname of the given directory, with symbolic links
## resolved.  Prints nothing and returns nonzero if the directory cannot be
## canonicalized, which the callers below diagnose.
## `realpath` would be simpler, but POSIX added it only in 2024 and some systems
## still lack it, whereas `cd` and `pwd -P` are portable.  `cd` writes its own
## diagnostic when it fails; discard it, because the callers below write a
## better one.
absolute_path() {
  (CDPATH='' cd -- "$1" && pwd -P) 2> /dev/null
}

## A helper function that works on exactly two repositories.
git_push_to() {

  from="$1"
  to="$2"

  # A failure here is not yet an error, and it leaves the variable empty:  a
  # nonexistent directory fails here, and the tests just below diagnose that
  # better.
  from_absolute="$(absolute_path "${from}")"
  to_absolute="$(absolute_path "${to}")"

  if [ ! -d "${from}" ]; then
    if [ -n "${from_absolute}" ] && [ "${from}" != "${from_absolute}" ]; then
      echo "${SCRIPT_NAME}: no such directory: ${from} = ${from_absolute}" >&2
    else
      echo "${SCRIPT_NAME}: no such directory: ${from}" >&2
    fi
    return 1
  fi
  if [ ! -d "${to}" ]; then
    if [ -n "${to_absolute}" ] && [ "${to}" != "${to_absolute}" ]; then
      echo "${SCRIPT_NAME}: no such directory: ${to} = ${to_absolute}" >&2
    else
      echo "${SCRIPT_NAME}: no such directory: ${to}" >&2
    fi
    return 1
  fi
  if [ -z "${from_absolute}" ]; then
    echo "${SCRIPT_NAME}: cannot canonicalize: ${from}" >&2
    return 1
  fi
  if [ -z "${to_absolute}" ]; then
    echo "${SCRIPT_NAME}: cannot canonicalize: ${to}" >&2
    return 1
  fi

  if [ "${from_absolute}" = "${to_absolute}" ]; then
    echo "${SCRIPT_NAME}: FROM_DIR and TO_DIR are the same directory: ${from_absolute}" >&2
    return 1
  fi

  # Check the upstream before asking whether the branch was deleted:
  # `is_deleted_branch` cannot tell, and answers status 3, when the branch
  # has no upstream, and its diagnostic is less specific than this one.
  if ! check_upstream "${from_absolute}"; then
    return 1
  fi
  # The branch that the `git fetch` below brings over.  Read it now:  the
  # call to `check_upstream` for ${to_absolute} overwrites it with TO_DIR's
  # branch.
  from_branch="${checked_out_branch}"

  if ! check_branch_exists "${from_absolute}"; then
    return 1
  fi

  if ! git -C "$from_absolute" pull -q; then
    echo "${SCRIPT_NAME}: problem pulling ${from_absolute}" >&2
    return 1
  fi

  orig_dir=$(pwd)

  if ! cd "$to_absolute"; then
    echo "${SCRIPT_NAME}: cannot cd to ${to_absolute}" >&2
    return 1
  fi

  if ! check_upstream "${to_absolute}"; then
    return 1
  fi

  if ! check_branch_exists "${to_absolute}"; then
    return 1
  fi

  if ! git pull -q; then
    echo "${SCRIPT_NAME}: problem pulling in ${to_absolute}" >&2
    return 1
  fi

  # Fetch from a relative pathname, so that the pathname that `git fetch`
  # records in FETCH_HEAD does not embed this machine's directory layout.
  # `relative-path` is a portable version of `realpath --relative-to`, whose
  # `--relative-to` option the BSD and macOS versions of `realpath` lack.
  # Note: pwd=to_absolute
  if ! from_relative="$("${SCRIPT_DIR}"/relative-path "${to_absolute}" "${from_absolute}")"; then
    echo "${SCRIPT_NAME}: cannot express ${from_absolute} relative to ${to_absolute}" >&2
    return 1
  fi
  # `git fetch` parses a colon in a bare pathname as an scp-style URL.
  case "${from_relative}" in
    ./* | ../* | .) ;;
    *) from_relative="./${from_relative}" ;;
  esac

  # Name the branch as well as the repository, rather than fetching the
  # pathname alone.  `git fetch PATH` brings over whatever FROM_DIR's HEAD
  # points at, whereas `git fetch PATH BRANCH` brings over the branch that
  # `check_upstream` determined and `check_branch_exists` validated.  If
  # FROM_DIR's HEAD moved in between, the one-operand form merges something
  # that this script never checked.
  #
  # Spell the branch as `refs/heads/BRANCH` rather than as a bare name.
  # `git fetch` resolves a bare name by trying `refs/BRANCH` and
  # `refs/tags/BRANCH` before `refs/heads/BRANCH` -- the same collision that
  # `check_upstream` contends with above, where a tag and the branch share a
  # name.  Given a bare name, such a tag is merged in place of the branch:
  # silently, and with exit status 0, because merging the tag is a perfectly
  # good merge as far as git is concerned.  The full refname admits no such
  # ambiguity.
  #
  # ${from_branch} is not empty here:  `check_upstream` leaves it empty for a
  # detached HEAD and for a directory that is not a working copy, and
  # `check_branch_exists` above refuses both.
  if ! git fetch -q -- "${from_relative}" "refs/heads/${from_branch}"; then
    # Note: pwd=to_absolute
    echo "${SCRIPT_NAME}: problem fetching ${from_absolute} into $(pwd)" >&2
    return 1
  fi
  if ! merge_head="$(git rev-parse --verify --quiet FETCH_HEAD)"; then
    echo "${SCRIPT_NAME}: cannot read FETCH_HEAD after fetching ${from_absolute} into $(pwd)" >&2
    return 1
  fi

  # FROM_DIR and TO_DIR are clones of one project, so the merge should read
  # the way it does when two branches of one clone are merged:
  #
  #   Merge branch 'feature' into main
  #
  # `git pull PATH BRANCH` would instead write "Merge branch 'feature' of
  # ../myrepo-branch-feature into main", and would head the commit summaries
  # that `merge.log` turns on with "* 'feature' of ../myrepo-branch-feature:".
  # `fmt-merge-msg` appends " of SOURCE" for every source except ".", the local
  # repository, and `git fetch` records the pathname that this script fetched
  # from as the source.  So hand `fmt-merge-msg` the line that `git fetch`
  # would have written for a branch of this repository.  Git still composes
  # the message:  the "into BRANCH" suffix, which it omits on the default
  # branch, and the commit summaries, which `merge.log` governs.
  #
  # Composing the message by hand would fabricate it rather than letting git
  # describe what it merged, and would discard those commit summaries.
  if ! merge_message="$(printf "%s\t\tbranch '%s' of .\n" \
    "${merge_head}" "${from_branch}" | git fmt-merge-msg)"; then
    echo "${SCRIPT_NAME}: cannot compose a merge message for ${from_branch} of ${from_absolute}" >&2
    return 1
  fi

  # Merge rather than `git pull`, which rebases if `pull.rebase` is set.  A
  # rebase would rewrite the branch that this script is about to push.
  # `--no-edit` keeps a chain of directories from stopping at an editor.
  # `--no-log` prevents a second copy of the commit summaries:  `git merge`
  # appends them to a message given with `-m` when `merge.log` is set, and
  # ${merge_message} already contains the ones that `fmt-merge-msg` wrote.
  if ! git merge -q --no-edit --no-log -m "${merge_message}" "${merge_head}"; then
    # Note: pwd=to_absolute
    echo "${SCRIPT_NAME}: problem merging ${from_absolute} into $(pwd)" >&2
    return 1
  fi

  if [ "$nocompile" -eq 0 ] && [ -z "$MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT" ]; then
    if ! "${SCRIPT_DIR}"/compile-project; then
      echo "${SCRIPT_NAME}: unable to build in $(pwd)" >&2
      return 1
    fi
  fi

  if ! git push --quiet; then
    echo "${SCRIPT_NAME}: problem pushing from $(pwd)" >&2
    return 1
  fi

  if ! cd "${orig_dir}"; then
    echo "${SCRIPT_NAME}: cannot cd back to ${orig_dir}" >&2
    return 1
  fi

  return 0
}

## Pushes each given directory into the next one.  Returns 1 at the first
## failure.
push_chain() {
  prev=''
  for arg; do
    if [ -n "$prev" ]; then
      if ! git_push_to "$prev" "$arg"; then
        return 1
      fi
    fi
    prev="$arg"
  done
  return 0
}

## Returns 0 if the argument is a slug, ORG:BRANCH or BRANCH, rather than a
## directory.  Git forbids a branch name that starts with "/" or ".", or whose
## component starts with ".".
is_slug() {
  if [ -d "$1" ]; then
    return 1
  fi
  case "$1" in
    '' | */*:* | :* | *: | /* | .* | */.*) return 1 ;;
    *) return 0 ;;
  esac
}

## Sets ${slug_org}, ${slug_branch}, and ${slug_branch_dir} from the slug
## ORG:BRANCH or BRANCH.  ${slug_org} is empty if the slug has no ORG.
## ${slug_branch_dir} is BRANCH as it appears in a directory name.
parse_slug() {
  case "$1" in
    *:*)
      slug_org="${1%%:*}"
      slug_branch="${1#*:}"
      ;;
    *)
      slug_org=''
      slug_branch="$1"
      ;;
  esac
  slug_branch_dir="$(printf '%s\n' "${slug_branch}" | sed -e "s:/:-:g")"
}

## Returns 0 if the given directory has the given branch checked out.
has_branch_checked_out() {
  has_branch_ref="$(git -C "$1" symbolic-ref --quiet HEAD 2> /dev/null)" || return 1
  [ "${has_branch_ref}" = "refs/heads/$2" ]
}

## Prints the directory that the slug ORG:BRANCH names for the given project,
## or prints nothing and returns 1 if there is none.
slug_dir() {
  parse_slug "$2"
  if [ -d "$1-fork-${slug_org}-branch-${slug_branch_dir}" ]; then
    if has_branch_checked_out "$1-fork-${slug_org}-branch-${slug_branch_dir}" "${slug_branch}"; then
      printf '%s\n' "$1-fork-${slug_org}-branch-${slug_branch_dir}"
      return 0
    fi
    return 1
  fi
  if [ -d "$1-fork-${slug_org}" ] \
    && has_branch_checked_out "$1-fork-${slug_org}" "${slug_branch}"; then
    printf '%s\n' "$1-fork-${slug_org}"
    return 0
  fi
  return 1
}

## Prints, one per line, PROJECT:ORG for each directory in the current
## directory that the slug names.  If the slug has no ORG, every ORG matches.
## Returns 1, after printing an error message, if a directory
## PROJECT-fork-ORG-branch-BRANCH that the slug names has some other branch
## checked out, because merging into that directory would merge into the wrong
## branch.
slug_matches() {
  parse_slug "$1"
  match_status=0
  for dir in ./*-fork-*-branch-"${slug_branch_dir}"; do
    if [ ! -d "${dir}" ]; then continue; fi
    name="${dir#./}"
    name="${name%-branch-"${slug_branch_dir}"}"
    project="${name%-fork-*}"
    org="${name##*-fork-}"
    # For example, "p-fork-o-branch-x-branch-main" is not a directory for
    # branch "main".
    case "${org}" in *-branch-*) continue ;; esac
    if [ -n "${slug_org}" ] && [ "${org}" != "${slug_org}" ]; then continue; fi
    if has_branch_checked_out "${dir}" "${slug_branch}"; then
      printf '%s:%s\n' "${project}" "${org}"
    else
      match_actual="$(git -C "${dir}" symbolic-ref --quiet --short HEAD 2> /dev/null)" \
        || match_actual="a detached HEAD"
      echo "${SCRIPT_NAME}: ${dir#./} has ${match_actual} checked out, not ${slug_branch}" >&2
      match_status=1
    fi
  done
  for dir in ./*-fork-*; do
    if [ ! -d "${dir}" ]; then continue; fi
    name="${dir#./}"
    project="${name%-fork-*}"
    org="${name##*-fork-}"
    case "${org}" in *-branch-*) continue ;; esac
    if [ -n "${slug_org}" ] && [ "${org}" != "${slug_org}" ]; then continue; fi
    # A PROJECT-fork-ORG-branch-BRANCH directory takes precedence.
    if [ -d "${name}-branch-${slug_branch_dir}" ]; then continue; fi
    if has_branch_checked_out "${dir}" "${slug_branch}"; then
      printf '%s:%s\n' "${project}" "${org}"
    fi
  done
  return "${match_status}"
}

## Main program starts here.

if [ "$#" -ge 1 ] && [ "$1" = "--nocompile" ]; then
  nocompile=1
  shift
fi

if [ "$#" -lt 2 ]; then
  echo "${SCRIPT_NAME}: not enough arguments" >&2
  echo "Usage: ${SCRIPT_NAME} [--nocompile] FROM_DIR TO_DIR ..." >&2
  echo "   or: ${SCRIPT_NAME} [--nocompile] [ORG:]BRANCH [ORG:]BRANCH ..." >&2
  exit 1
fi

num_slugs=0
for arg; do
  if is_slug "$arg"; then
    num_slugs=$((num_slugs + 1))
  fi
done

if [ "${num_slugs}" -eq 0 ]; then
  push_chain "$@"
  exit
fi

if [ "${num_slugs}" -ne "$#" ]; then
  echo "${SCRIPT_NAME}: cannot mix slugs with directories: $*" >&2
  exit 1
fi

newline='
'

# Resolve every slug before pushing anything, so that a misspelled slug does
# not leave the work half done.
#
# Each chain is identified by a key PROJECT:ORG.  A slug BRANCH, which has no
# ORG, contributes to the chain for each PROJECT and ORG that has a directory
# for it, so each chain stays within one ORG.  A slug ORG:BRANCH contributes
# to every chain for its PROJECT.  A PROJECT with directories only for slugs
# ORG:BRANCH gets a single chain whose key has an empty ORG.
keys=''
explicit_projects=''
for arg; do
  if ! arg_matches="$(slug_matches "$arg")"; then
    exit 1
  fi
  parse_slug "$arg"
  if [ -z "${arg_matches}" ]; then
    echo "${SCRIPT_NAME}: no directory *-fork-${slug_org:-*}-branch-${slug_branch_dir} (or *-fork-${slug_org:-*} on branch ${slug_branch}) in $(pwd) for $arg" >&2
    exit 1
  fi
  if [ -n "${slug_org}" ]; then
    explicit_projects="${explicit_projects}${newline}$(printf '%s\n' "${arg_matches}" | sed -e 's/:.*//')"
  else
    keys="${keys}${newline}${arg_matches}"
  fi
done
saved_ifs="${IFS}"
IFS="${newline}"
for project in ${explicit_projects}; do
  case "${keys}${newline}" in
    *"${newline}${project}:"*) ;;
    *) keys="${keys}${newline}${project}:" ;;
  esac
done
IFS="${saved_ifs}"
keys="$(printf '%s\n' "${keys}" | sed -e '/^$/d' | sort -u)"

# Git forbids whitespace and glob characters in branch names, so the slugs can
# be kept in a whitespace-separated string.
slugs="$*"

status=0
num_chains=0
IFS="${newline}"
for key in ${keys}; do
  IFS="${saved_ifs}"
  project="${key%%:*}"
  org="${key#*:}"
  if [ -n "${org}" ]; then
    chain_name="${project} (${org})"
  else
    chain_name="${project}"
  fi
  chain=''
  chain_length=0
  last_dir=''
  for slug in ${slugs}; do
    parse_slug "${slug}"
    if [ -z "${slug_org}" ]; then
      if [ -z "${org}" ]; then continue; fi
      slug="${org}:${slug}"
    fi
    # For ORG, the slugs ORG:BRANCH and BRANCH name the same directory, which
    # must not be pushed into itself.
    if dir="$(slug_dir "${project}" "${slug}")" && [ "${dir}" != "${last_dir}" ]; then
      last_dir="${dir}"
      chain="${chain}${dir}${newline}"
      chain_length=$((chain_length + 1))
    fi
  done
  if [ "${chain_length}" -lt 2 ]; then
    echo "${SCRIPT_NAME}: skipping ${chain_name}, which has only ${chain%"${newline}"}" >&2
    IFS="${newline}"
    continue
  fi
  num_chains=$((num_chains + 1))
  # Run the chain in a subshell, because `git_push_to` changes the working
  # directory and does not change it back when it fails.  Continue with the
  # other chains after a failure, because they are independent of it.
  if ! (
    set -f
    IFS="${newline}"
    # shellcheck disable=SC2086 # Split ${chain} on newlines.
    set -- ${chain}
    IFS="${saved_ifs}"
    set +f
    push_chain "$@"
  ); then
    status=1
  fi
  IFS="${newline}"
done
IFS="${saved_ifs}"

if [ "${num_chains}" -eq 0 ]; then
  echo "${SCRIPT_NAME}: no project has directories for two or more of: ${slugs}" >&2
  exit 1
fi

exit "${status}"
