#!/bin/sh

# Shows the differences between the default branch of the upstream repository
# and the current working tree, ignoring changes in the amount of whitespace.
# Like a GitHub pull request, it diffs from the merge base of that branch and
# HEAD, so a change that was made upstream but has not been merged into HEAD
# does not appear.
#
# Usage:
#   git-diff-upstream [--no-fetch] [GIT-DIFF-ARGS]
#
# The upstream repository is the remote named `upstream` if there is one, as
# in a fork, then `origin`, then the clone's only remote if it has exactly
# one.  Its default branch is `REMOTE/HEAD`, such as `upstream/master`.
#
# A clone of a fork might have no `upstream` remote, so that the remote chosen
# that way is the fork, such as `origin` for `git@github.com:ME/PROJ.git`.  A
# fork's default branch can lag behind its parent's.  If the current branch
# has merged the parent's newer commits, a diff from the fork's default branch
# shows those commits as changes of the current branch, though a pull request
# against the parent would not.  So, if that remote is a GitHub repository
# that a user (not an organization) owns and that GitHub says is a fork, this
# command diffs from the default branch of the fork's parent instead, such as
# `ORG/PROJ`:  the clone's remote for the parent if it has one, and otherwise
# the parent's URL, whose form is the same as the fork's, such as
# `git@github.com:ORG/PROJ.git`.  It fetches that URL's default branch into
# `refs/fork-upstream/org/proj`, and it adds no remote.  A fork that an
# organization owns, such as `typetools/jdk` (a fork of `openjdk/jdk`), is a
# downstream fork whose pull requests target the fork itself, so this command
# diffs from the fork's default branch.  Asking GitHub needs `gh`; without
# it, this command uses the remote chosen as above.  The answer is recorded in
# the git configuration variable `github-fork.ME/PROJ.upstream` (in lower
# case), as `ORG/PROJ` or as `none`, so GitHub is asked only once per clone;
# set that variable to override the answer.  With `--no-fetch`, this command
# does not ask GitHub and fetches nothing, but it uses a recorded answer and
# what an earlier run fetched.  `git-pull-upstream` chooses the upstream
# repository the same way.
#
# This command first fetches the remote and updates `REMOTE/HEAD` to name the
# remote's default branch, in case the remote has renamed it.  With
# `--no-fetch`, it does neither, except that it creates `REMOTE/HEAD` with
# `git remote set-head REMOTE --auto` if `REMOTE/HEAD` does not exist or names
# a branch that does not exist.
#
# So, unless `--no-fetch` is given, this command replaces a `REMOTE/HEAD` that
# was set by hand with `git remote set-head REMOTE BRANCH`.  To compare with
# such a BRANCH, run `git diff -b --patience --merge-base REMOTE/BRANCH`
# instead.
#
# It runs `git diff -b --patience --merge-base REMOTE/HEAD GIT-DIFF-ARGS`.
# Without `--merge-base`, the diff would be from the tip of REMOTE/HEAD, and
# would show every upstream change that HEAD lacks as its reversal.
# GIT-DIFF-ARGS, such as `--stat` or `-- PATH`, are passed to `git diff`.
# Like any `git diff` against a commit, it compares only tracked files:  a new
# file appears only once it has been added with `git add`.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

require_git 30 'for git diff --merge-base'

fetch=1
if [ "$#" -ge 1 ] && [ "$1" = "--no-fetch" ]; then
  fetch=0
  shift
fi

if ! find_upstream_ref "${fetch}"; then
  exit 1
fi

exec git diff -b --patience --merge-base "${upstream_ref}" "$@"
