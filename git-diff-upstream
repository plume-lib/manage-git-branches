#!/bin/sh

# Shows the differences between the default branch of the upstream repository
# and the current working tree, ignoring changes in the amount of whitespace.
# Like a GitHub pull request, it diffs from the merge base of that branch and
# HEAD, so a change that was made upstream but has not been merged into HEAD
# does not appear.
#
# Usage:
#   git-diff-upstream [--no-fetch] [GIT-DIFF-ARGS]
#
# The upstream repository is the remote named `upstream` if there is one, as
# in a fork, then `origin`, then the clone's only remote if it has exactly
# one.  Its default branch is `REMOTE/HEAD`, such as `upstream/master`.
#
# A clone of a fork might have no `upstream` remote, so that the remote chosen
# that way is the fork, such as `origin` for `git@github.com:ME/PROJ.git`.  A
# fork's default branch can lag behind its parent's.  If the current branch
# has merged the parent's newer commits, a diff from the fork's default branch
# shows those commits as changes of the current branch, though a pull request
# against the parent would not.  So, if that remote is a GitHub repository
# that GitHub says is a fork, this command uses the clone's remote for the
# fork's parent instead, such as `ORG/PROJ`.  If the clone has no remote for
# the parent, this command adds one, named `upstream`, whose URL has the same
# form as the fork's, such as `git@github.com:ORG/PROJ.git`.  This needs `gh`;
# without it, this command uses the remote chosen as above.  With
# `--no-fetch`, this command does not consult GitHub, but a clone to which an
# earlier run added `upstream` uses it.
#
# This command first fetches the remote and updates `REMOTE/HEAD` to name the
# remote's default branch, in case the remote has renamed it.  With
# `--no-fetch`, it does neither, except that it creates `REMOTE/HEAD` with
# `git remote set-head REMOTE --auto` if `REMOTE/HEAD` does not exist or names
# a branch that does not exist.
#
# So, unless `--no-fetch` is given, this command replaces a `REMOTE/HEAD` that
# was set by hand with `git remote set-head REMOTE BRANCH`.  To compare with
# such a BRANCH, run `git diff -b --patience --merge-base REMOTE/BRANCH`
# instead.
#
# It runs `git diff -b --patience --merge-base REMOTE/HEAD GIT-DIFF-ARGS`.
# Without `--merge-base`, the diff would be from the tip of REMOTE/HEAD, and
# would show every upstream change that HEAD lacks as its reversal.
# GIT-DIFF-ARGS, such as `--stat` or `-- PATH`, are passed to `git diff`.
# Like any `git diff` against a commit, it compares only tracked files:  a new
# file appears only once it has been added with `git add`.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

require_git 30 'for git diff --merge-base'

fetch=1
if [ "$#" -ge 1 ] && [ "$1" = "--no-fetch" ]; then
  fetch=0
  shift
fi

## Usage: lowercase STRING
## Prints STRING in lower case.
lowercase() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
}

## Usage: parent_remote REMOTE
## Prints the name of the remote for the parent of the repository that REMOTE
## names, if GitHub says that that repository is a fork, after adding a remote
## named "upstream" for the parent if the clone has no remote for it.  Prints
## REMOTE if REMOTE is not a GitHub repository, if it is not a fork, or if `gh`
## is not installed.  If GitHub cannot be asked, prints a diagnostic and then
## prints REMOTE.  Returns 1, after printing a diagnostic, if adding the remote
## fails.
parent_remote() {
  # `git remote get-url` applies `url.BASE.insteadOf`, which can map a GitHub
  # URL to a mirror or a local copy; the configured URL still names GitHub.
  parent_remote_url="$(git config --get "remote.$1.url")"
  parent_remote_fork="$(github_slug "${parent_remote_url}")"
  if [ -z "${parent_remote_fork}" ] || ! command -v gh > /dev/null 2>&1; then
    printf '%s\n' "$1"
    return 0
  fi
  # The repository is named with its host, so that `gh` does not ask the host
  # that ${GH_HOST} names instead.
  if ! parent_remote_parent="$(gh_query "cannot determine whether ${parent_remote_fork} is a fork" \
    gh repo view "github.com/${parent_remote_fork}" --json parent \
    --jq '.parent // empty | "\(.owner.login)/\(.name)"')"; then
    echo "${SCRIPT_NAME}: comparing with $1" >&2
    printf '%s\n' "$1"
    return 0
  fi
  if [ -z "${parent_remote_parent}" ]; then
    printf '%s\n' "$1"
    return 0
  fi
  # GitHub ignores the case of a repository's name, so a remote's URL might
  # spell it differently than GitHub's answer does.
  for parent_remote_name in $(git remote); do
    if [ "$(lowercase "$(github_slug "$(git config --get "remote.${parent_remote_name}.url")")")" \
      = "$(lowercase "${parent_remote_parent}")" ]; then
      printf '%s\n' "${parent_remote_name}"
      return 0
    fi
  done
  case "${parent_remote_url}" in
    git@github.com:*) parent_remote_new_url="git@github.com:${parent_remote_parent}.git" ;;
    ssh://git@github.com/*) parent_remote_new_url="ssh://git@github.com/${parent_remote_parent}.git" ;;
    *) parent_remote_new_url="https://github.com/${parent_remote_parent}.git" ;;
  esac
  if ! git remote add upstream "${parent_remote_new_url}"; then
    echo "${SCRIPT_NAME}: cannot add remote upstream for ${parent_remote_parent}, the parent of ${parent_remote_fork}" >&2
    return 1
  fi
  echo "${SCRIPT_NAME}: added remote upstream for ${parent_remote_parent}, the parent of ${parent_remote_fork}" >&2
  printf '%s\n' upstream
}

if ! remote="$(upstream_remote)"; then
  exit 1
fi
# A remote named "upstream" is the upstream repository by the clone's own
# configuration, even if it is a fork.
if [ "${fetch}" -eq 1 ] && [ "${remote}" != upstream ]; then
  if ! remote="$(parent_remote "${remote}")"; then
    exit 1
  fi
fi
if ! upstream_ref="$(upstream_default_branch "${remote}" "${fetch}")"; then
  exit 1
fi

exec git diff -b --patience --merge-base "${upstream_ref}" "$@"
