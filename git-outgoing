#!/bin/sh

# Shows the commits on local branches that are not on any remote branch,
# that is, commits that have not been pushed.
#
# Usage:
#   git-outgoing [GIT-LOG-ARGS]
#
# GIT-LOG-ARGS, such as `--oneline` or `-- PATH`, are passed to `git log`.
# Any revisions among them are shown in addition to the local branches.
# They may not include `--stdin`, which this command uses itself.
#
# Unlike `git log --branches --not --remotes`, this command omits a branch
# whose changes are already in some remote's default branch (`REMOTE/HEAD`),
# even though its commits are not.  That happens when a pull request is
# squash-merged and its remote branch is then deleted.  A branch is omitted
# when either:
#  * merging it into `REMOTE/HEAD` would not change any file, or
#  * some commit C in `REMOTE/HEAD` but not in the branch changes only files
#    that the branch changes, and merging the branch into C's parent yields
#    C's files.  C is then a squash-merge of the branch, and later changes
#    to `REMOTE/HEAD` do not matter.  To save time, only commits C that were
#    committed at most a day before the branch's last commit was authored, or
#    later, are examined.
# The commits of an omitted branch are not shown even when another branch
# contains them, as when that branch was started from the omitted one.
# A remote with no `REMOTE/HEAD` is not considered; to create it, run
# `git remote set-head REMOTE --auto`.
#
# This command does not contact any remote, so run `git fetch` first if
# the remote-tracking branches might be out of date.  It does not change the
# repository.  In a partial clone, a branch whose check needs file contents
# that have not been fetched is shown, with a warning.
#
# This command requires git 2.44 or later, for `git merge-tree --write-tree`
# (git 2.38) and `GIT_NO_LAZY_FETCH` (git 2.44).

# Prints an error message and exits with a failure status.
die() {
  echo "git-outgoing: $*" >&2
  exit 1
}

# Output is like "git version 2.44.0" or "git version 2.44.0.windows.1".
git_version="$(git version)" || exit 1
git_version="${git_version#git version }"
git_major="${git_version%%.*}"
git_minor="${git_version#*.}"
git_minor="${git_minor%%.*}"
case "${git_major}.${git_minor}" in
  *[!0-9.]* | .* | *.) die "cannot parse git version: ${git_version}" ;;
esac
if [ "${git_major}" -lt 2 ] || { [ "${git_major}" -eq 2 ] && [ "${git_minor}" -lt 44 ]; }; then
  die "requires git 2.44 or later, but found git ${git_version}"
fi

# The repository's object directory.  `git merge-tree --write-tree` writes the
# merge result as objects; git_scratch puts them in ${tmpdir} instead.
objects="$(git rev-parse --path-format=absolute --git-path objects)" || exit 1
tmpdir="$(mktemp -d)" || exit 1
trap 'rm -rf "${tmpdir}"' EXIT
trap 'rm -rf "${tmpdir}"; trap - INT; kill -s INT "$$"' INT
trap 'rm -rf "${tmpdir}"; trap - TERM; kill -s TERM "$$"' TERM
mkdir "${tmpdir}/objects" "${tmpdir}/objects/info" || exit 1
# The scratch object directory borrows the repository's objects through its
# alternates file, which separates entries by newlines.  Setting
# GIT_ALTERNATE_OBJECT_DIRECTORIES instead would split a path that contains
# the path separator, `:` or `;`.  The entry is C-quoted, so that it may
# contain any character.
{
  printf '"'
  printf '%s\n' "${objects}" | sed 's/[\\"]/\\&/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
  printf '"\n'
} > "${tmpdir}/objects/info/alternates" || die "cannot write ${tmpdir}/objects/info/alternates"

# Whether this repository is a partial clone, whose file contents may be
# missing until git fetches them on demand.  Non-empty if so.
partial_clone="$(git config --get extensions.partialclone)"
case "$?" in
  0 | 1) ;;
  *) exit 1 ;;
esac
if [ -z "${partial_clone}" ]; then
  promisor_remotes="$(git config --type=bool --get-regexp '^remote\..*\.promisor$')"
  case "$?" in
    0 | 1) ;;
    *) exit 1 ;;
  esac
  partial_clone="$(printf '%s\n' "${promisor_remotes}" | awk '$2 == "true"')"
fi
warned_partial_clone=

# Usage: git_scratch GIT-ARGS
# Runs git, writing any new objects to ${tmpdir} rather than to the repository.
# In a partial clone, git does not fetch missing objects from the remote.
git_scratch() {
  GIT_OBJECT_DIRECTORY="${tmpdir}/objects" \
    GIT_NO_LAZY_FETCH=1 \
    git "$@"
}

# Usage: git_failed COMMAND
# Handles the failure of COMMAND, a git command run by git_scratch whose
# standard error is in ${tmpdir}/git-errors.  In a partial clone, the failure
# is probably because some file contents have not been fetched, so this warns
# (once, with the first such error) and returns.  Otherwise, it dies.
git_failed() {
  if [ -n "${partial_clone}" ]; then
    if [ -z "${warned_partial_clone}" ]; then
      echo "git-outgoing: this partial clone probably lacks file contents needed to check whether some branches are merged; showing them.  The first error, from $1, was:" >&2
      cat "${tmpdir}/git-errors" >&2
      warned_partial_clone=1
    fi
    return 0
  fi
  cat "${tmpdir}/git-errors" >&2
  die "$1 failed"
}

# Usage: merge_yields COMMIT BRANCH TREE
# Succeeds if merging BRANCH into COMMIT yields TREE without conflicts.
# COMMIT and BRANCH must have a common ancestor.
merge_yields() {
  merge_tree="$(git_scratch merge-tree --write-tree --no-messages "$1" "$2" 2> "${tmpdir}/git-errors")"
  case "$?" in
    0) [ "${merge_tree}" = "$3" ] ;;
    1) return 1 ;; # The merge has conflicts.
    129)
      cat "${tmpdir}/git-errors" >&2
      die "git merge-tree --write-tree failed"
      ;;
    *)
      git_failed "git merge-tree $1 $2"
      return 1
      ;;
  esac
}

# The arguments for which ${tmpdir}/branch-paths was last computed.
branch_paths_key=

# Usage: has_squash_commit BASE BRANCH MERGE-BASES BRANCH-TIME
# Succeeds if BASE contains a commit, not in BRANCH, that changes only files
# that BRANCH changes, and that equals merging BRANCH into its parent.
# MERGE-BASES are the merge bases of BASE and BRANCH, one per line, and
# BRANCH-TIME is the author date of BRANCH's last commit, in seconds since the
# epoch.  Amending or rebasing BRANCH, unlike squash-merging it, keeps that
# date.
#
# The git commands that produce file names for awk to parse override any user
# configuration that would change their output.
has_squash_commit() {
  # Several remotes' default branches may have the same merge bases with
  # BRANCH.
  if [ "${branch_paths_key}" != "$3 $2" ]; then
    branch_paths_key=
    printf '%s\n' "$3" > "${tmpdir}/merge-bases" || die "cannot write ${tmpdir}/merge-bases"
    # The files that BRANCH changes relative to any of its merge bases, since
    # a squash commit may descend from any of them.  The file names are
    # relative to the top of the working tree.  With `core.quotePath=false`,
    # git quotes only a file name that contains a control character, a double
    # quote, or a backslash.  Such a name is quoted the same way in the output
    # of `git log` below, so it is compared correctly.
    : > "${tmpdir}/all-branch-paths" || die "cannot write ${tmpdir}/all-branch-paths"
    while read -r merge_base; do
      if ! git_scratch -c core.quotePath=false diff --no-relative --no-renames --name-only "${merge_base}" "$2" \
        >> "${tmpdir}/all-branch-paths" 2> "${tmpdir}/git-errors"; then
        git_failed "git diff ${merge_base} $2"
        return 1
      fi
    done < "${tmpdir}/merge-bases"
    sort -u "${tmpdir}/all-branch-paths" > "${tmpdir}/branch-paths" || die "sort failed"
    branch_paths_key="$3 $2"
  fi
  if [ ! -s "${tmpdir}/branch-paths" ]; then return 1; fi
  # A squash-merge is committed after the branch's last commit was authored;
  # the margin allows for clock skew between the computers that made the
  # commits.  `--since-as-filter`, unlike `--since`, does not stop at an older
  # commit, which could hide a newer one behind it.
  since="$(($4 - 24 * 60 * 60))"
  # The merge bases are excluded through `--stdin`, as `^COMMIT`.
  # `--ancestry-path` examines only descendants of a merge base, so each
  # commit's parent has a common ancestor with BRANCH, as merge_yields
  # requires.  There is no pathspec, which would make git compare each
  # commit's files with its parent's during the walk; only the commits that
  # pass `--since-as-filter` are compared, for `--name-only`.
  sed 's/^/^/' "${tmpdir}/merge-bases" > "${tmpdir}/log-input" || die "cannot write ${tmpdir}/log-input"
  # Each commit is introduced by a line that starts with \001, which git quotes
  # in a file name.
  if ! git_scratch -c core.quotePath=false log --no-merges --ancestry-path --no-renames --no-follow \
    --no-relative --no-show-signature --no-notes --no-color \
    --since-as-filter="@${since}" --format='%x01%H %T %P' --name-only \
    "$1" --stdin < "${tmpdir}/log-input" > "${tmpdir}/base-log" 2> "${tmpdir}/git-errors"; then
    git_failed "git log $1"
    return 1
  fi
  # Each line is "PARENT TREE" for one possible squash commit.
  awk '
    function report() { if (parent != "" && files > 0 && only_branch_files) print parent, tree }
    FILENAME == ARGV[1] { branch_path[$0]; next }
    /^\001/ { report(); split(substr($0, 2), fields, " "); tree = fields[2]; parent = fields[3]; files = 0; only_branch_files = 1; next }
    $0 == "" { next }
    { files++; if (!($0 in branch_path)) only_branch_files = 0 }
    END { report() }
  ' "${tmpdir}/branch-paths" "${tmpdir}/base-log" > "${tmpdir}/squash-candidates" || die "awk failed"
  while read -r squash_parent squash_tree; do
    if merge_yields "${squash_parent}" "$2" "${squash_tree}"; then return 0; fi
  done < "${tmpdir}/squash-candidates"
  return 1
}

# Usage: is_merged BRANCH BRANCH-TIME
# Succeeds if BRANCH's changes are in some remote's default branch.
# BRANCH-TIME is the author date of BRANCH's last commit.
is_merged() {
  while read -r base_commit base_tree; do
    base_merge_bases="$(git merge-base --all "${base_commit}" "$1")"
    case "$?" in
      0) ;;
      1) continue ;; # BRANCH has no history in common with this base.
      *) die "git merge-base ${base_commit} $1 failed" ;;
    esac
    if merge_yields "${base_commit}" "$1" "${base_tree}"; then return 0; fi
    if has_squash_commit "${base_commit}" "$1" "${base_merge_bases}" "$2"; then return 0; fi
  done < "${tmpdir}/bases"
  return 1
}

# Each line of ${tmpdir}/bases is "COMMIT TREE" for one remote's default
# branch, without duplicates.  A remote name may contain a slash, so the refs
# are matched against the remote names.
git remote > "${tmpdir}/remotes" || exit 1
git for-each-ref --format='%(refname) %(objectname) %(tree)' refs/remotes > "${tmpdir}/remote-refs" || exit 1
awk '
  FILENAME == ARGV[1] { want["refs/remotes/" $0 "/HEAD"]; next }
  $1 in want { print $2, $3 }
' "${tmpdir}/remotes" "${tmpdir}/remote-refs" > "${tmpdir}/all-bases" || die "awk failed"
sort -u "${tmpdir}/all-bases" > "${tmpdir}/bases" || die "sort failed"

# The local branches whose tips are not on any remote branch, one per line,
# each as "TIME NAME", where TIME is the author date of the tip in seconds
# since the epoch.  A full name, such as `refs/heads/main`, cannot be
# mistaken for a file name.  Comparing the tips with the unpushed commits
# avoids passing one argument per remote-tracking branch, as
# `git for-each-ref --no-merged` would require; with many remote-tracking
# branches, such arguments would exceed the limit on a command line's size.
git for-each-ref --format='%(objectname) %(authordate:unix) %(refname)' refs/heads > "${tmpdir}/local-branches" || exit 1
git rev-list --branches --not --remotes > "${tmpdir}/unpushed-commits" || exit 1
awk '
  FILENAME == ARGV[1] { line = $2 " " $3; refs[$1] = ($1 in refs) ? refs[$1] "\n" line : line; next }
  $0 in refs { print refs[$0]; delete refs[$0] }
' "${tmpdir}/local-branches" "${tmpdir}/unpushed-commits" > "${tmpdir}/unpushed-branches" || die "awk failed"

# The branches to show, one per line, and those to omit, each preceded by `^`.
# They are passed through `--stdin` rather than as arguments, which might
# exceed the limit on a command line's size.
: > "${tmpdir}/log-refs" || die "cannot write ${tmpdir}/log-refs"
while read -r branch_time branch; do
  if is_merged "${branch}" "${branch_time}"; then
    printf '^%s\n' "${branch}"
  else
    printf '%s\n' "${branch}"
  fi >> "${tmpdir}/log-refs" || die "cannot write ${tmpdir}/log-refs"
done < "${tmpdir}/unpushed-branches"

# The `--not` makes the remote-tracking branches negative, and the second
# `--not` makes any revisions in GIT-LOG-ARGS positive again.  The GIT-LOG-ARGS
# come last, so that a `--` in them does not turn `--remotes` into a path.
# Even with no branches, no remote-tracking branches, and no revisions in
# GIT-LOG-ARGS, `--remotes` keeps `git log` from showing HEAD.
git log --stdin --not --remotes --not "$@" < "${tmpdir}/log-refs"
