#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is:
#  * 0 (true) if the directory is on a branch that was deleted in its remote,
#  * 1 (false) if the directory is on a branch that still exists in its remote,
#  * 2 if the directory is not a clone, so the question does not apply.
#
# This command does not modify the directory.

SCRIPT_NAME="$(basename -- "$0")"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 1
fi

dir="$1"

if ! git -C "${dir}" rev-parse --git-dir > /dev/null 2>&1; then
  # Not a clone, so it is not on any branch, deleted or otherwise.  Report
  # this distinctly, so that a caller can give an accurate diagnostic.
  exit 2
fi

# The branch, remote, and remote branch that `git pull` in the directory
# would use.  If any is absent (say, because HEAD is detached or the branch
# has no upstream), then `git pull` fails for a reason other than a deleted
# branch, so the branch is not a deleted one.
branch="$(git -C "${dir}" symbolic-ref --quiet --short HEAD)" || exit 1
remote="$(git -C "${dir}" config --get "branch.${branch}.remote")" || exit 1
remote_ref="$(git -C "${dir}" config --get "branch.${branch}.merge")" || exit 1

# `git ls-remote --exit-code` exits with status 2 if the remote has no
# matching ref, and with some other nonzero status if it cannot be contacted.
git -C "${dir}" ls-remote --quiet --exit-code "${remote}" "${remote_ref}" > /dev/null 2>&1
ls_remote_status=$?
if [ "${ls_remote_status}" -eq 2 ]; then
  exit 0
fi
exit 1
