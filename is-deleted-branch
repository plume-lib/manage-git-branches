#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is 0 (true) if the directory is on a deleted branch or is
# not a clone, and 1 (false) otherwise.

# Fail on the use of an unset variable, which is usually a typo.
set -u

SCRIPT_NAME="$(basename -- "$0")"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 1
fi

# Exit status is 0 if a line is selected.
# Force LC_ALL=C so that git's diagnostics are in English, which the grep matches.
LC_ALL=C git -C "$1" pull 2>&1 | grep -q '\(no such ref was fetched\|fatal: not a git repository\)'
