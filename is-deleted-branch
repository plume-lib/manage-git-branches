#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is:
#  * 0 (true) if the directory is on a branch that was deleted in its remote,
#  * 1 (false) if the directory is on a branch that still exists in its remote,
#  * 2 (false) if the directory is not the top level of a clone, so the
#    question does not apply,
#  * 3 (false) if the question cannot be answered: HEAD is detached, no
#    remote can be determined for the branch, the branch has no upstream
#    configuration and nothing shows that it was ever pushed, the remote
#    could not be contacted, or this script could not resolve the location of
#    its own helper scripts,
#  * 64 if this command was invoked incorrectly.
#
# A caller must not treat every nonzero status as "the branch still exists";
# only status 1 means that.
#
# Status 0 says that the branch was deleted in its remote, not that the
# working copy holds nothing of value:  the branch can hold commits that were
# never pushed, and deleting the directory would lose them.
#
# A branch that has no upstream configuration is reported as deleted only if
# this clone still holds a record that the branch was pushed:  a
# remote-tracking ref for it, or a reflog entry for such a ref.  Either record
# can disappear.  Pruning (`git fetch --prune`, `git remote prune`, or the
# `fetch.prune` and `remote.NAME.prune` configuration variables) deletes the
# ref, and its reflog, along with the remote branch.  Reflog expiry deletes
# reflog entries that are older than `gc.reflogExpire` (90 days by default)
# even when the ref survives, because Git runs `git gc --auto` from commands
# such as `git commit` and `git fetch`.  Git then keeps no record of the push,
# so such a branch is "cannot tell" (status 3) rather than "deleted".

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
# Exit with status 3 on failure, not 1:  status 1 means "the branch still
# exists in its remote", and a caller that saw it would proceed as if this
# script had answered the question.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 3
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 3
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 3
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/remote-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/remote-functions.sh" >&2
  exit 3
fi
# shellcheck source=remote-functions.sh
. "${SCRIPT_DIR}/remote-functions.sh"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 64
fi

# A path that does not exist -- or that exists but is not a directory -- is
# certainly not a clone.  Reject it here rather than leaving it to `git -C`,
# for which the empty string is a documented no-op:  `git -C '' rev-parse`
# would answer about the current directory rather than about the argument.
# The `absolute_path` call below also rejects the empty string, but only as a
# side effect of `cd -- ''` failing; this test states the requirement directly.
if [ ! -d "$1" ]; then
  exit 2
fi

dir="$1"

# Prints the absolute path of directory $1, with symbolic links resolved.
# `realpath` would be simpler, but POSIX added it only in 2024 and some systems
# still lack it; of those that have it, not every one accepts `--` to end the
# options, which a pathname that starts with `-` needs.  `cd` and `pwd -P` are
# portable.
absolute_path() {
  (CDPATH='' cd -- "$1" && pwd -P)
}

# `git -C DIR rev-parse` succeeds for every directory within a clone's working
# tree, so also require that DIRECTORY is that working tree's top level.  A
# subdirectory is not itself a clone, and answering for the enclosing clone
# would answer a question that the caller did not ask.
toplevel="$(git -C "${dir}" rev-parse --show-toplevel 2> /dev/null)" || exit 2
if [ -z "${toplevel}" ]; then
  # A bare repository has no working tree, so it is not on any branch.
  exit 2
fi
# A pathname that cannot be canonicalized means that whether DIRECTORY is the
# top level of a clone cannot be determined.
# (status 2 would assert that DIRECTORY is not the top level of a clone.)
if ! dir_real="$(absolute_path "${dir}")"; then
  echo "${SCRIPT_NAME}: cannot canonicalize: ${dir}" >&2
  exit 3
fi
if ! toplevel_real="$(absolute_path "${toplevel}")"; then
  echo "${SCRIPT_NAME}: cannot canonicalize: ${toplevel}" >&2
  exit 3
fi
if [ "${dir_real}" != "${toplevel_real}" ]; then
  # Not a clone, so it is not on any branch, deleted or otherwise.
  exit 2
fi

# A detached HEAD is not on a branch, so there is no remote branch to ask
# about, and whether a branch was deleted cannot be determined.
# Strip the known prefix ourselves, because `symbolic-ref --short` can return
# "heads/BRANCH" when a tag and the branch have the same name.
if ! branch_ref="$(git -C "${dir}" symbolic-ref --quiet HEAD 2> /dev/null)"; then
  exit 3
fi
branch="${branch_ref#refs/heads/}"

# A branch with no commit does not yet exist even locally, so it was never
# pushed and it was not deleted.  `git clone` of an empty repository leaves
# HEAD on such a branch, and gives it upstream configuration that no push
# ever justified.
branch_commit="$(git -C "${dir}" rev-parse --verify --quiet "${branch_ref}")"
if [ -z "${branch_commit}" ]; then
  exit 3
fi

# The branch's upstream configuration:  a remote name and one or more refs
# such as "refs/heads/BRANCH".
branch_remote="$(git -C "${dir}" config --get "branch.${branch}.remote")"
merge_refs="$(git -C "${dir}" config --get-all "branch.${branch}.merge")"

# A branch exists in a remote because someone pushed it there, so ask the
# remote that `git push` uses.  `push_remote`, in remote-functions.sh,
# determines it; answering "cannot tell" for a branch that was never pushed to
# the remote that `remote.pushDefault` names is one reason for the order that
# it documents.
remote="$(push_remote "${dir}" "${branch}")"
if [ -z "${remote}" ]; then
  # The clone has no remote, or it has several and none is named "origin", so
  # there is no remote branch to ask about.
  exit 3
fi

# A branch has no upstream configuration until some command sets it, and
# neither `git checkout -b BRANCH` (which `git-new-branch` runs) nor
# `git push REMOTE BRANCH` sets it.  Such a branch can still exist in a
# remote, under the name that `git push` gives it:  a branch of the same name.
# `branch.BRANCH.merge` names refs in `branch.BRANCH.remote`, so it describes
# no other remote, and Git ignores it when `branch.BRANCH.remote` is unset
# (`git pull` then reports "no tracking information").
configured_upstream=0
upstream_refs="refs/heads/${branch}"
if [ -n "${merge_refs}" ] && [ "${remote}" = "${branch_remote}" ]; then
  configured_upstream=1
  upstream_refs="${merge_refs}"
fi

# Usage: tracking_refs REF
# Prints the remote-tracking refs that ${remote}'s fetch refspecs map REF to,
# one per line.  Prints nothing if no refspec maps REF, which is also what
# happens when ${remote} is a URL rather than the name of a configured remote:
# fetching from a URL creates no remote-tracking ref.
tracking_refs() {
  git -C "${dir}" config --get-all "remote.${remote}.fetch" \
    | while IFS= read -r refspec; do
      # A fetch refspec is [+]SOURCE:DESTINATION.  A "*" in SOURCE matches any
      # substring, and DESTINATION's "*" stands for what SOURCE's matched.
      # A refspec without a DESTINATION, such as the negative refspec
      # "^refs/heads/BRANCH", creates no remote-tracking ref.
      case "${refspec}" in
        *:*) ;;
        *) continue ;;
      esac
      refspec="${refspec#+}"
      source_pattern="${refspec%%:*}"
      destination="${refspec#*:}"
      case "${source_pattern}" in
        *'*'*)
          # A ref name cannot contain "*", "?", or "[", so the only pattern
          # character in SOURCE is the "*" that this case matched.
          source_prefix="${source_pattern%%'*'*}"
          source_suffix="${source_pattern#*'*'}"
          case "$1" in
            "${source_prefix}"*"${source_suffix}") ;;
            *) continue ;;
          esac
          matched="${1#"${source_prefix}"}"
          matched="${matched%"${source_suffix}"}"
          case "${destination}" in
            *'*'*)
              printf '%s%s%s\n' "${destination%%'*'*}" "${matched}" \
                "${destination#*'*'}"
              ;;
            *) printf '%s\n' "${destination}" ;;
          esac
          ;;
        *)
          if [ "$1" = "${source_pattern}" ]; then
            printf '%s\n' "${destination}"
          fi
          ;;
      esac
    done
}

# Usage: branch_was_pushed
# Returns 0 (true) if this clone shows that the branch was pushed to
# ${remote}.  The existence of a remote-tracking ref for the branch is not
# itself such a sign:  the ref may be a leftover from a different branch of
# the same name, which someone else pushed and deleted and which this clone
# never pruned.  A sign is a reflog entry that records a push.  So is a
# remote-tracking ref that is at the same commit as the branch:  even if that
# ref is a leftover, the branch holds no work that the remote lacks.
branch_was_pushed() {
  candidate_refs="$(tracking_refs "refs/heads/${branch}")"
  pushed=1
  # A ref name cannot contain a newline.
  pushed_saved_ifs="${IFS}"
  IFS='
'
  set -f
  for candidate_ref in ${candidate_refs}; do
    if [ "${candidate_ref}" = "${branch_ref}" ]; then
      # A fetch refspec can map the branch to itself, as the "+refs/*:refs/*"
      # that `git remote add --mirror=fetch` sets does.  The branch is
      # trivially at its own commit and its reflog is not a record of a push,
      # so such a ref is no sign that the branch was pushed.
      continue
    fi
    candidate_commit="$(git -C "${dir}" rev-parse --verify --quiet \
      "${candidate_ref}")" || continue
    if [ "${candidate_commit}" = "${branch_commit}" ] \
      || git -C "${dir}" reflog show "${candidate_ref}" 2> /dev/null \
      | grep -q ': update by push$'; then
      pushed=0
      break
    fi
  done
  set +f
  IFS="${pushed_saved_ifs}"
  return "${pushed}"
}

if [ "${configured_upstream}" -eq 0 ] && ! branch_was_pushed; then
  # The branch has no upstream configuration and no sign of having been
  # pushed, so it was probably never pushed, and a branch that was never
  # pushed was not deleted.  Contacting the remote could not settle the
  # question:  a branch of this name in the remote might be someone else's,
  # and the absence of one is what a never-pushed branch and a deleted branch
  # both look like.  Answering without the network also keeps a scan of many
  # never-pushed branches, such as `git-orphaned-branches` performs, from
  # making one network request per branch.
  exit 3
fi

# A ref name cannot contain a newline.  Preserve each configured merge value as
# one argument so that ls-remote succeeds if any configured upstream ref exists.
saved_ifs="${IFS}"
IFS='
'
set -f
# shellcheck disable=SC2086
set -- ${upstream_refs}
set +f
IFS="${saved_ifs}"

# `git ls-remote --exit-code` exits with status 2 if no matching ref exists.
# `git_batch_ssh`, in remote-functions.sh, disables the interactive prompts
# that would otherwise block this query forever.
git_batch_ssh "${dir}" ls-remote --exit-code "${remote}" "$@" > /dev/null 2>&1
status="$?"
case "${status}" in
  0)
    # The branch still exists in the remote.
    exit 1
    ;;
  2)
    # The branch was deleted in the remote.
    exit 0
    ;;
  *)
    # The remote could not be contacted (say, the network is down), so it is
    # unknown whether the branch still exists there.
    echo "${SCRIPT_NAME}: cannot list branches of remote ${remote} for ${dir}" >&2
    exit 3
    ;;
esac
