#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is 0 (true) if the directory is on a deleted branch or is
# not a clone, and 1 (false) otherwise.
#
# The status code is 2 if the answer could not be determined -- for example,
# the remote repository is unreachable or requires credentials.  In that case,
# this command prints an explanation to standard error.  This command never
# prompts for credentials, so it does not block for input.

SCRIPT_NAME="$(basename -- "$0")"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 1
fi

dir="$1"

# A directory that is not a clone.
if ! git -C "${dir}" rev-parse --git-dir > /dev/null 2>&1; then
  exit 0
fi

# A detached HEAD is not on a branch, so it is not on a deleted branch.
if ! branch="$(git -C "${dir}" symbolic-ref --quiet --short HEAD)"; then
  exit 1
fi

# The branch's upstream, as a remote name and a ref such as "refs/heads/BRANCH".
remote="$(git -C "${dir}" config --get "branch.${branch}.remote")"
upstream_ref="$(git -C "${dir}" config --get "branch.${branch}.merge")"
if [ -z "${remote}" ] || [ -z "${upstream_ref}" ]; then
  # The branch has no upstream, so it was never pushed:  it is a new branch
  # rather than a deleted one.
  exit 1
fi

# Ask the remote repository which branches it has.  Asking the remote, rather
# than interpreting the output of `git pull`, distinguishes a deleted branch
# from a failure such as a network outage, an authentication failure, or an
# unfinished merge in the clone, all of which `git pull` also reports as an
# error.
# GIT_TERMINAL_PROMPT=0 makes a request for credentials fail rather than block
# on an interactive prompt.
GIT_TERMINAL_PROMPT=0 git -C "${dir}" ls-remote --exit-code --heads "${remote}" "${upstream_ref}" > /dev/null 2>&1
status="$?"
case "${status}" in
  0)
    # The branch exists in the remote repository.
    exit 1
    ;;
  2)
    # `git ls-remote --exit-code` exits with status 2 when no ref matches, so
    # the branch was deleted in the remote repository.
    exit 0
    ;;
  *)
    echo "${SCRIPT_NAME}: cannot list the branches of remote ${remote} for ${dir}" >&2
    exit 2
    ;;
esac
