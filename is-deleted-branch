#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is:
#  * 0 (true) if the directory is on a branch that was deleted in its remote,
#  * 1 (false) if the directory is on a branch that still exists in its remote,
#  * 2 (false) if the directory is not the top level of a clone, so the
#    question does not apply,
#  * 3 (false) if the question cannot be answered: HEAD is detached, no
#    remote can be determined for the branch, the branch has no upstream
#    configuration and does not exist in the remote (so it may never have
#    been pushed), the remote could not be contacted, or this script could
#    not resolve the location of its own helper scripts,
#  * 64 if this command was invoked incorrectly.
#
# A caller must not treat every nonzero status as "the branch still exists";
# only status 1 means that.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
# Exit with status 3 on failure, not 1:  status 1 means "the branch still
# exists in its remote", and a caller that saw it would proceed as if this
# script had answered the question.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 3
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 3
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 3
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 64
fi

dir="$1"

# `git -C DIR rev-parse` succeeds for every directory within a clone's working
# tree, so also require that DIRECTORY is that working tree's top level.  A
# subdirectory is not itself a clone, and answering for the enclosing clone
# would answer a question that the caller did not ask.
toplevel="$(git -C "${dir}" rev-parse --show-toplevel 2> /dev/null)" || exit 2
if [ -z "${toplevel}" ]; then
  # A bare repository has no working tree, so it is not on any branch.
  exit 2
fi
dir_real="$(realpath -- "${dir}" 2> /dev/null)" || exit 2
toplevel_real="$(realpath -- "${toplevel}" 2> /dev/null)" || exit 2
if [ "${dir_real}" != "${toplevel_real}" ]; then
  # Not a clone, so it is not on any branch, deleted or otherwise.
  exit 2
fi

# A detached HEAD is not on a branch, so there is no remote branch to ask
# about, and whether a branch was deleted cannot be determined.
# Strip the known prefix ourselves, because `symbolic-ref --short` can return
# "heads/BRANCH" when a tag and the branch have the same name.
if ! branch_ref="$(git -C "${dir}" symbolic-ref --quiet HEAD 2> /dev/null)"; then
  exit 3
fi
branch="${branch_ref#refs/heads/}"

# The branch's upstream, as a remote name and one or more refs such as
# "refs/heads/BRANCH".
remote="$(git -C "${dir}" config --get "branch.${branch}.remote")"
upstream_refs="$(git -C "${dir}" config --get-all "branch.${branch}.merge")"

# A branch has no upstream configuration until some command sets it, and
# neither `git checkout -b BRANCH` (which `git-new-branch` runs) nor
# `git push REMOTE BRANCH` sets it.  Such a branch can still exist in a
# remote, so when configuration does not name the upstream, fall back to the
# remote and the ref that Git itself would use.
configured_upstream=1
if [ -z "${remote}" ] || [ -z "${upstream_refs}" ]; then
  configured_upstream=0
fi

if [ -z "${remote}" ]; then
  remote="$(git -C "${dir}" config --get remote.pushDefault)"
fi
if [ -z "${remote}" ]; then
  # Git uses the remote named "origin" when no configuration names a remote.
  # If there is no remote named "origin", but there is exactly one other
  # remote, then that is the only remote the branch could exist in.
  remotes="$(git -C "${dir}" remote)"
  if printf '%s\n' "${remotes}" | grep -q -x 'origin'; then
    remote='origin'
  elif [ "$(printf '%s\n' "${remotes}" | grep -c '.')" -eq 1 ]; then
    remote="${remotes}"
  else
    # The clone has no remote, or it has several and none is named "origin",
    # so there is no remote branch to ask about.
    exit 3
  fi
fi
if [ -z "${upstream_refs}" ]; then
  # `git push` creates or updates a branch of the same name in the remote.
  upstream_refs="refs/heads/${branch}"
fi

# A ref name cannot contain a newline.  Preserve each configured merge value as
# one argument so that ls-remote succeeds if any configured upstream ref exists.
saved_ifs="${IFS}"
IFS='
'
set -f
# shellcheck disable=SC2086
set -- ${upstream_refs}
set +f
IFS="${saved_ifs}"

if [ -z "${GIT_SSH_COMMAND:-}" ]; then
  unset GIT_SSH_COMMAND
fi
ssh_command="${GIT_SSH_COMMAND:-$(git -C "${dir}" config --get core.sshCommand)}"
ssh_variant="${GIT_SSH_VARIANT:-$(git -C "${dir}" config --get ssh.variant)}"

# `ssh_batch_option` is the option that disables interactive prompts for the
# selected SSH implementation.  Git accepts several SSH implementations, but
# only OpenSSH accepts `-o`; Plink and Putty accept `-batch`.
# When no variant is specified, recognize the standard command names and
# otherwise leave Git's own variant detection in charge.
# `ssh_resolved_variant` is the variant that `ssh_batch_option` belongs to.

# Usage: ssh_variant_of PROGRAM
# Prints the SSH variant that the command name PROGRAM denotes, or nothing if
# PROGRAM is not a command name that this script recognizes.
ssh_variant_of() {
  case "$(basename -- "$1")" in
    ssh | ssh.exe) echo 'ssh' ;;
    plink | plink.exe) echo 'plink' ;;
    putty | putty.exe) echo 'putty' ;;
  esac
}

ssh_resolved_variant=''
case "${ssh_variant}" in
  ssh | plink | putty)
    ssh_resolved_variant="${ssh_variant}"
    ;;
  '' | auto)
    if [ -z "${ssh_command}" ]; then
      if [ -z "${GIT_SSH:-}" ]; then
        # Git runs "ssh" when neither variable nor configuration names a
        # command.
        ssh_resolved_variant='ssh'
      else
        # GIT_SSH is an executable path rather than a shell command.
        ssh_resolved_variant="$(ssh_variant_of "${GIT_SSH}")"
      fi
    else
      # An SSH command is a shell command line, whose first word names the
      # program to run.
      ssh_resolved_variant="$(ssh_variant_of "${ssh_command%% *}")"
    fi
    ;;
esac

ssh_batch_option=''
case "${ssh_resolved_variant}" in
  ssh)
    ssh_batch_option='-o BatchMode=yes'
    ;;
  plink | putty)
    ssh_batch_option='-batch'
    ;;
esac

# `git ls-remote --exit-code` exits with status 2 if no matching ref exists.
# GIT_TERMINAL_PROMPT=0 makes an authentication failure an error rather than
# an interactive prompt.  OpenSSH's `-o BatchMode=yes` does the same for SSH
# authentication and host-key prompts.  Plink's and Putty's `-batch` option
# rejects any prompt that would require user input.

if [ -n "${ssh_batch_option}" ]; then
  if [ -n "${ssh_command}" ]; then
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${ssh_command} ${ssh_batch_option}" \
      git -C "${dir}" ls-remote --exit-code "${remote}" "$@" > /dev/null 2>&1
    status="$?"
  elif [ -n "${GIT_SSH:-}" ]; then
    # GIT_SSH is an executable path rather than a shell command.  A wrapper
    # adds the option without changing the way the path is parsed.
    # Git guesses the variant from the basename of GIT_SSH, and the wrapper's
    # basename is not one that Git recognizes.  Without GIT_SSH_VARIANT, Git
    # would guess the "simple" variant, which cannot pass a port or an address
    # family to SSH.
    IS_DELETED_BRANCH_GIT_SSH="${GIT_SSH}"
    IS_DELETED_BRANCH_SSH_BATCH_OPTION="${ssh_batch_option}"
    export IS_DELETED_BRANCH_GIT_SSH IS_DELETED_BRANCH_SSH_BATCH_OPTION
    GIT_TERMINAL_PROMPT=0 GIT_SSH="${SCRIPT_DIR}/is-deleted-branch-ssh-wrapper" \
      GIT_SSH_VARIANT="${ssh_resolved_variant}" \
      git -C "${dir}" ls-remote --exit-code "${remote}" "$@" > /dev/null 2>&1
    status="$?"
  else
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh ${ssh_batch_option}" \
      git -C "${dir}" ls-remote --exit-code "${remote}" "$@" > /dev/null 2>&1
    status="$?"
  fi
else
  GIT_TERMINAL_PROMPT=0 \
    git -C "${dir}" ls-remote --exit-code "${remote}" "$@" > /dev/null 2>&1
  status="$?"
fi
case "${status}" in
  0)
    # The branch still exists in the remote.
    exit 1
    ;;
  2)
    if [ "${configured_upstream}" -eq 0 ] \
      && ! git -C "${dir}" rev-parse --verify --quiet \
        "refs/remotes/${remote}/${branch}" > /dev/null 2>&1; then
      # The branch has no upstream configuration and no remote-tracking ref,
      # so it was probably never pushed.  A branch that was never pushed was
      # not deleted.  A branch that was deleted and whose remote-tracking ref
      # was then pruned looks the same, so the question cannot be answered.
      exit 3
    fi
    # The branch was deleted in the remote.
    exit 0
    ;;
  *)
    # The remote could not be contacted (say, the network is down), so it is
    # unknown whether the branch still exists there.
    echo "${SCRIPT_NAME}: cannot list branches of remote ${remote} for ${dir}" >&2
    exit 3
    ;;
esac
