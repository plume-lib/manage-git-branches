#!/bin/sh

# Tests whether a directory is on a deleted branch.
#
# Usage:
#   is-deleted-branch DIRECTORY
#
# The status code is 0 (true) if the directory is on a deleted branch, and 1
# (false) otherwise, including any directory that is not a clone.
#
# This command does not modify the directory.
#
# A branch that has never been pushed is not a deleted branch, so this
# command returns 1 (false) for it.

SCRIPT_NAME="$(basename -- "$0")"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} DIRECTORY" >&2
  exit 1
fi

dir="$1"

if ! git -C "${dir}" rev-parse --git-dir > /dev/null 2>&1; then
  # Not a clone, so not a deleted branch.
  exit 1
fi

# A detached HEAD is not on a branch, so it is not on a deleted branch.
# Strip the known prefix ourselves: `symbolic-ref --short` can return
# "heads/BRANCH" when a tag and the branch have the same name.
if ! branch_ref="$(git -C "${dir}" symbolic-ref --quiet HEAD 2> /dev/null)"; then
  exit 1
fi
branch="${branch_ref#refs/heads/}"

# The branch's upstream, as a remote name and a ref such as "refs/heads/BRANCH".
remote="$(git -C "${dir}" config --get "branch.${branch}.remote")"
upstream_ref="$(git -C "${dir}" config --get "branch.${branch}.merge")"
if [ -z "${remote}" ] || [ -z "${upstream_ref}" ]; then
  # The branch has no upstream, so it was never pushed:  it is a new branch
  # rather than a deleted one.
  exit 1
fi

# `git ls-remote --exit-code` exits with status 2 if no matching ref exists.
# GIT_TERMINAL_PROMPT=0 makes an authentication failure an error rather than
# an interactive prompt.  OpenSSH's `-o BatchMode=yes` does the same for SSH
# authentication and host-key prompts.
ssh_command="${GIT_SSH_COMMAND:-$(git -C "${dir}" config --get core.sshCommand)}"
ssh_variant="${GIT_SSH_VARIANT:-$(git -C "${dir}" config --get ssh.variant)}"

# Git accepts several SSH implementations, but only OpenSSH accepts `-o`.
# When no variant is specified, recognize the standard OpenSSH command and
# otherwise leave Git's own variant detection in charge.
use_batch_mode=false
case "${ssh_variant}" in
  ssh)
    use_batch_mode=true
    ;;
  '' | auto)
    if [ -z "${ssh_command}" ]; then
      if [ -z "${GIT_SSH:-}" ]; then
        use_batch_mode=true
      else
        case "$(basename -- "${GIT_SSH}")" in
          ssh | ssh.exe)
            use_batch_mode=true
            ;;
        esac
      fi
    else
      case "${ssh_command}" in
        ssh | ssh\ * | */ssh | */ssh\ * | ssh.exe | ssh.exe\ * | */ssh.exe | */ssh.exe\ *)
          use_batch_mode=true
          ;;
      esac
    fi
    ;;
esac

if ${use_batch_mode}; then
  if [ -n "${ssh_command}" ]; then
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${ssh_command} -o BatchMode=yes" \
      git -C "${dir}" ls-remote --exit-code --heads "${remote}" "${upstream_ref}" > /dev/null 2>&1
    status="$?"
  elif [ -n "${GIT_SSH:-}" ]; then
    # GIT_SSH is an executable path rather than a shell command.  A wrapper
    # adds the option without changing the way the path is parsed.
    ssh_wrapper_dir="$(mktemp -d "${TMPDIR:-/tmp}/${SCRIPT_NAME}.XXXXXX")" || {
      echo "${SCRIPT_NAME}: cannot create temporary SSH wrapper" >&2
      exit 1
    }
    ssh_wrapper="${ssh_wrapper_dir}/ssh"
    cat > "${ssh_wrapper}" <<'EOF'
#!/bin/sh
exec "${IS_DELETED_BRANCH_GIT_SSH}" -o BatchMode=yes "$@"
EOF
    chmod +x "${ssh_wrapper}"
    IS_DELETED_BRANCH_GIT_SSH="${GIT_SSH}"
    export IS_DELETED_BRANCH_GIT_SSH
    GIT_TERMINAL_PROMPT=0 GIT_SSH="${ssh_wrapper}" \
      git -C "${dir}" ls-remote --exit-code --heads "${remote}" "${upstream_ref}" > /dev/null 2>&1
    status="$?"
    rm -rf -- "${ssh_wrapper_dir}"
  else
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' \
      git -C "${dir}" ls-remote --exit-code --heads "${remote}" "${upstream_ref}" > /dev/null 2>&1
    status="$?"
  fi
else
  GIT_TERMINAL_PROMPT=0 \
    git -C "${dir}" ls-remote --exit-code --heads "${remote}" "${upstream_ref}" > /dev/null 2>&1
  status="$?"
fi
case "${status}" in
  0)
    # The branch still exists in the remote.
    exit 1
    ;;
  2)
    # The branch was deleted in the remote.
    exit 0
    ;;
  *)
    echo "${SCRIPT_NAME}: cannot list branches of remote ${remote} for ${dir}" >&2
    exit 1
    ;;
esac
