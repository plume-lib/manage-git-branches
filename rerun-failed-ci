def circleci_job_log(slug: str, job: int) -> str:
    """Read the output of the failed steps of a CircleCI job.

    Args:
        slug: the job's project slug, such as "gh/ORG/REPO".
        job: the job number.

    Returns:
        The output.
    """
    vcs, _, project = slug.partition("/")
    v1_vcs = {"gh": "github", "bb": "bitbucket"}.get(vcs)
    if v1_vcs is None:
        msg = f"cannot read the log of a job of CircleCI project {slug}"
        raise ValueError(msg)
    details = request_util.request(
        "GET",
        f"{ci_build.CIRCLECI_API}/v1.1/project/{v1_vcs}/{project}/{job}",
        ci_build.circleci_headers(),
    )
    output = []
    for step in details["steps"]:
        for action in step["actions"]:
            if action.get("status") in {"failed", "timedout"} and action.get("output_url"):
                output.extend(
                    m["message"] for m in request_util.request("GET", action["output_url"])
                )
    return "\n".join(output)


def gha_jobs(repo: str, run: int, which: str) -> list[dict[str, Any]]:
    """Return the jobs of a GitHub Actions workflow run.

    Args:
        repo: the repository's GitHub slug, such as "ORG/REPO".
        run: the id of the workflow run.
        which: "latest" for the jobs of the latest attempt, or "all" for the jobs of
            every attempt.

    Returns:
        The jobs.
    """
    pages = request_util.gh_api(
        f"repos/{repo}/actions/runs/{run}/jobs?filter={which}&per_page=100", paginate=True
    )
    return [job for page in pages for job in page["jobs"]]


def gha_job_log(repo: str, job: int) -> tuple[str, bool]:
    """Read the log of the failed steps of a GitHub Actions job, and its failure annotations.

    The failure annotations describe failures, such as a lost runner, that leave no
    log.  Warning and notice annotations are omitted, because a step that succeeded can
    produce them.

    Args:
        repo: the repository's GitHub slug, such as "ORG/REPO".
        job: the id of the job.

    Returns:
        The log, followed by the failure annotations, and whether the log could be
        read.  If the log or the annotations could not be read, the result contains
        only the other.
    """
    parts = []
    read = True
    try:
        log = request_util.run(
            ["gh", "run", "view", "--repo", repo, "--job", str(job), "--log-failed"]
        )
        # Each line starts with the job name and the step name, each followed by a tab.
        parts.extend(line.split("\t", 2)[-1] for line in log.splitlines())
    except request_util.REQUEST_ERRORS:
        read = False
    try:
        pages = request_util.gh_api(
            f"repos/{repo}/check-runs/{job}/annotations?per_page=100", paginate=True
        )
        parts.extend(
            a["message"] for page in pages for a in page if a.get("annotation_level") == "failure"
        )
    except request_util.REQUEST_ERRORS:
        pass
    return "\n".join(parts), read


def azure_stage(record: dict[str, Any], by_id: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """Return the stage that contains a record of an Azure Pipelines timeline.

    A record's parent is a stage, a phase, or a job.

    Args:
        record: the record.
        by_id: a map from the id of each record of the timeline to the record.

    Returns:
        The stage's record, or an empty dict if there is none.
    """
    while record.get("type") != "Stage":
        record = by_id.get(record.get("parentId"), {})
        if not record:
            return {}
    return record


def azure_job_log(api: str, job: dict[str, Any], records: list[dict[str, Any]]) -> tuple[str, bool]:
    """Read the logs of the failed tasks of an Azure Pipelines job, and its errors.

    The errors that the job and its tasks report describe failures, such as a lost
    agent, that leave no log.  Warnings are omitted, because a task that succeeded can
    report them.

    Args:
        api: the URL of the job's build in the Azure DevOps API.
        job: the timeline record of the job.
        records: the timeline of the job's build.

    Returns:
        The logs, followed by the errors, and whether every log could be read.
    """
    failed_tasks = [
        r for r in records if r.get("parentId") == job["id"] and r["result"] == "failed"
    ]
    parts = []
    read = True
    for task in failed_tasks:
        if (task.get("log") or {}).get("id") is None:
            continue
        try:
            parts.append(
                ci_build.azure_get(f"{api}/logs/{task['log']['id']}?api-version=7.1", text=True)
            )
        except request_util.REQUEST_ERRORS:
            read = False
    parts.extend(
        issue["message"]
        for r in [job, *failed_tasks]
        for issue in r.get("issues") or []
        if issue.get("type") == "error" and issue.get("message")
    )
    return "\n".join(parts), read


