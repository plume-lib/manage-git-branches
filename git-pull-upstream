#!/bin/sh

# Merges the default branch of the upstream repository into the current
# branch.  Fails if the resulting merge does not compile.  (Skips the
# compilation step if the --nocompile argument is given or if environment
# variable MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT is set.)
#
# Usage:
#   git-pull-upstream [--nocompile] [--allow-dependent] [--llm | --no-llm]
#                     [--claude | --codex]
#
# By default, this script asks an AI agent to resolve merge conflicts and to
# fix a failed build, as `git-push-to` does; the "--llm", "--no-llm",
# "--claude", and "--codex" options are as for `git-push-to`.  The
# "--allow-dependent" option is described in "Branches that build on another
# pull request" below.
#
# The upstream repository is the remote named `upstream` if there is one, as
# in a fork, then `origin`, then the clone's only remote if it has exactly
# one.  Its default branch is `REMOTE/HEAD`, such as `upstream/master`.  In
# a clone of a GitHub fork that a user owns and that has no `upstream` remote,
# the upstream repository is the fork's parent, as for `git-diff-upstream`:
# the clone's remote for the parent if it has one, and otherwise the parent's
# URL, whose default branch is fetched into `refs/fork-upstream/ORG/PROJ`
# rather than into a remote-tracking branch.
#
# This script does the following:
#  * fetch the upstream repository's default branch:  for a remote, update
#    `REMOTE/HEAD` to name that branch, in case the remote has renamed it
#    (this replaces a `REMOTE/HEAD` that was set by hand with
#    `git remote set-head`), and fetch it; for the parent's URL, fetch the
#    parent's HEAD into `refs/fork-upstream/ORG/PROJ`,
#  * pull the current branch from its upstream branch,
#  * merge the upstream repository's default branch into the current branch,
#    first merging the final version of each pull request that landed in it
#    and of which the current branch merged an earlier version, if that
#    avoids conflicts (see `git-push-to`, under "Conflicts"),
#  * build using `compile-project` (see its documentation),
#  * push the current branch if the build succeeds.
# If the build fails, this script asks the AI agent to fix it only if a merge
# on the current branch might have broken it:  the branch has a merge commit
# that is in the history of none of the remote branches that it pushes to
# and pulls from, the upstream repository's default branch, and the head
# that the pull fetched, and that combined changes (its tree differs from
# each of its parents' trees), and the branch's tree differs from those
# commits' trees.  A remote branch counts only if its repository is not in
# the local file system, such as one on GitHub, or is a bare repository
# without a linked worktree, because the branches of another repository,
# such as another working clone, need not have been built.  That merge commit
# can be the merge of the upstream repository's default branch, a merge that
# the pull made, or a merge that an earlier run made but did not push.
# If the current branch already contains the upstream repository's default
# branch, it skips the merge, and it stops there if the current branch matches
# the branch that it pushes to (which differs from the branch that it pulls
# from when `branch.BRANCH.pushRemote` or `remote.pushDefault` is set).
# Otherwise, as after a run whose build failed, it builds and pushes.
#
# It fails, without pulling, merging, or pushing, if the current branch
# pushes to the upstream repository's default branch, as a fork's `master`
# that tracks `upstream/master` does, or if it is in a fork and pushes to any
# branch of the upstream repository (the remote `upstream` or the fork's
# parent), through any remote or URL, or if `git push` might push other
# branches too, because `push.default` is "matching" or
# `remote.REMOTE.mirror` or `remote.REMOTE.push` is set.
# It fails after pulling, but without merging, if `git push --dry-run` shows
# that the current branch cannot be pushed.
#
# It fails, without pulling, if a merge is in progress, as `git pull` would.
# But if the current branch's upstream branch, once fetched, already contains
# both sides of the merge, as when another clone made the same merge and
# pushed it, then the merge is redundant, and this script aborts it if
# nobody has worked on it since git, `git rerere`, and this package's scripts
# left it, and no AI agent is working in the directory; the pull then
# fast-forwards the branch.  For a redundant merge that somebody has worked
# on, the diagnostic says that the merge is probably redundant.
#
# Unlike `git-pull-from`, this command needs no working tree for the upstream
# repository's default branch, and it does not build that branch.

# Branches that build on another pull request
#
# A branch whose pull request builds on another pull request, B, receives the
# upstream repository's default branch through B's branch, which `git-push-to`
# merges into it.  Merging the default branch into it directly as well would
# give it the same changes by two paths, in two different merge commits, and
# a later merge of B's branch would then be a criss-cross merge:  one with
# several merge bases, whose conflicts are harder to resolve.  So, after
# pulling, this script fails without merging if the current branch does not
# already contain the default branch and an open pull request from the
# current branch builds on another one:
#  * its base branch, such as "feature-b", is not the default branch of the
#    base repository and is the head branch of an open pull request B of the
#    base repository, as for a pull request that is stacked on B's; or
#  * its description has a line "Land after #N." (with or without the
#    period), as `pr-status` writes, where N, such as 123, is the number of
#    an open pull request of the same repository that is not a fix to the
#    current branch's pull request, that is, whose base branch is not the
#    current branch.  `pr-status` updates the current branch from N's branch.
#    As for `pr-status`, the line can name N as "ORG/REPO#N" or by its URL,
#    and it can continue with text that names no other pull request, as in
#    "Land after #123 (it adds the helper)."
# Instead, update the branch with `git-push-to` from the branch that it builds
# on; `pr-status` prints the `git-push-to` chains that do so.  The option
# "--allow-dependent" merges anyway.
#
# The pull requests from the current branch are the ones that
# `pr_repositories` in common-functions.sh describes, except that their base
# repository is the upstream repository, whose default branch this script
# merges.  A "Land after" line is one that `pr-status --print-land-after`
# reports.  `pr-status` needs Python 3.10 or later; if `python3` is older,
# this script runs `pr-status` with a Python that `uv` provides, if `uv` is
# installed (see "Python version" in README.md), and otherwise it says so and
# ignores the "Land after" lines.  This script asks GitHub before pulling.  The check is
# skipped, silently, if `gh` is not installed or has no token for
# github.com, as when no user has logged in with `gh auth login`, or if the
# current branch does not push to a GitHub repository, or if the upstream
# repository is not on GitHub.  If GitHub cannot be asked, this script says
# so and merges.  A dependence that only another pull request's
# description states, as in "Land before #M" in B's description, or that only
# the commits of the current branch show, is not detected.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"
# Through `agent_processes_in`, this script runs git in the current
# directories of other processes, where an inherited $GIT_DIR would override
# `git -C`.
unset_git_location_variables

# Usage: run_pr_status ARGUMENT...
# Runs `pr-status` with the ARGUMENTs and with a Python that is new enough
# for it:  `python3`, if it is Python 3.10 or later, as `pr-status` requires,
# and otherwise a Python that `uv` provides, if `uv` is installed, as
# "Python version" in README.md describes.
run_pr_status() {
  if python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2> /dev/null \
    || ! command -v uv > /dev/null 2>&1; then
    "${SCRIPT_DIR}/pr-status" "$@"
  else
    uv run --quiet --no-project --python '>=3.10' "${SCRIPT_DIR}/pr-status" "$@"
  fi
}

# Usage: find_dependence BRANCH
# Sets ${dependence} to a diagnostic that says how an open pull request from
# BRANCH, a branch of the clone in the current directory, builds on another
# pull request, as "Branches that build on another pull request" above
# describes, or to the empty string if none does or if GitHub is not or
# cannot be asked.  The upstream repository is the one that
# ${upstream_slug} names, as `find_upstream_ref` sets it.
find_dependence() {
  dependence=''
  gh_usable || return 0
  [ -n "${upstream_slug}" ] || return 0
  pr_repositories "$(pwd)" "$1" "${upstream_slug}" || return 0
  # Each pull request yields a line "pr NUMBER BASE DEFAULT HEADDEFAULT HEAD",
  # where BASE is its base branch, DEFAULT is the base repository's default
  # branch, HEADDEFAULT is the head repository's default branch, and HEAD is
  # the head repository, followed by a line "body NUMBER TEXT HEAD" for each
  # line TEXT of its description.
  # shellcheck disable=SC2016 # The expansions are for jq.
  if ! fd_answer="$(branch_pulls "${pr_base_repo}" "${pr_head_repo}" "${pr_head_branch}" open \
    '.number as $n | "pr \($n) \(.base.ref) \(.base.repo.default_branch) \(.head.repo.default_branch)", ((.body // "") | split("\n")[] | "body \($n) \(.)")')"; then
    echo "${SCRIPT_NAME}: cannot tell whether the current branch builds on another pull request; assuming that it does not" >&2
    return 0
  fi
  # Each word of ${fd_findings} is "base:NUMBER:BASE" for a pull request whose
  # base branch, BASE, is not the default branch, or "after:NUMBER:N" for each
  # line of its description that says to land after pull request N of the
  # base repository, as `pr-status --print-land-after` reads the description.
  # A branch's name contains neither whitespace nor ":", so splitting
  # ${fd_findings} yields each word intact.  A pull request from the head
  # repository's default branch is ignored, as `pr_repositories` explains.
  # Each word of ${fd_prs} is "NUMBER:BASE:DEFAULT" for such a pull request.
  fd_findings=''
  fd_prs="$(printf '%s\n' "${fd_answer}" \
    | awk -v head_branch="${pr_head_branch}" \
      '$1 == "pr" && $5 != head_branch { print $2 ":" $3 ":" $4 }')"
  for fd_pr_fields in ${fd_prs}; do
    fd_pr="${fd_pr_fields%%:*}"
    fd_base="${fd_pr_fields#*:}"
    fd_default="${fd_base#*:}"
    fd_base="${fd_base%%:*}"
    if [ "${fd_base}" != "${fd_default}" ]; then
      fd_findings="${fd_findings} base:${fd_pr}:${fd_base}"
    fi
    if ! fd_numbers="$(printf '%s\n' "${fd_answer}" \
      | awk -v pr="${fd_pr}" '$1 == "body" && $2 == pr { sub(/^body [0-9]+ /, ""); sub(/ [^ ]*$/, ""); print }' \
      | run_pr_status --print-land-after "${pr_base_repo}")"; then
      echo "${SCRIPT_NAME}: cannot read the \"Land after\" lines of ${pr_base_repo}#${fd_pr}; ignoring them" >&2
      continue
    fi
    for fd_number in ${fd_numbers}; do
      if [ "${fd_number}" != "${fd_pr}" ]; then
        fd_findings="${fd_findings} after:${fd_pr}:${fd_number}"
      fi
    done
  done

  for fd_finding in ${fd_findings}; do
    fd_kind="${fd_finding%%:*}"
    fd_rest="${fd_finding#*:}"
    fd_pr="${fd_rest%%:*}"
    fd_rest="${fd_rest#*:}"
    case "${fd_kind}" in
      base)
        # The base branch counts only if it is the branch of an open pull
        # request, B, rather than a long-lived branch such as "release-1.x"
        # or the branch of a pull request that has landed.  B's head
        # repository is the base repository, where its branch is.
        if ! fd_other="$(branch_pulls "${pr_base_repo}" "${pr_base_repo}" "${fd_rest}" open '"\(.number)"')"; then
          echo "${SCRIPT_NAME}: cannot tell whether ${fd_rest}, the base branch of ${pr_base_repo}#${fd_pr}, is the branch of another pull request; assuming that it is not" >&2
          continue
        fi
        fd_other="$(printf '%s\n' "${fd_other}" | awk '{ print $1; exit }')"
        [ -n "${fd_other}" ] || continue
        fd_reason="its base branch is ${fd_rest}, the head branch of ${pr_base_repo}#${fd_other}"
        ;;
      after)
        # Each answer is "STATE BASE", where BASE is the pull request's base
        # branch.  GitHub fails for a number that names no pull request,
        # such as the number of an issue.
        # shellcheck disable=SC2016 # The expansions are for jq.
        if ! fd_other="$(gh_query "cannot ask GitHub about ${pr_base_repo}#${fd_rest}" \
          gh api -X GET "repos/${pr_base_repo}/pulls/${fd_rest}" \
          --hostname github.com --jq '"\(.state) \(.base.ref)"')"; then
          echo "${SCRIPT_NAME}: ignoring the line \"Land after #${fd_rest}\" of ${pr_base_repo}#${fd_pr}" >&2
          continue
        fi
        [ "${fd_other%% *}" = open ] || continue
        # A fix to the current branch's pull request is merged into the
        # current branch, not the other way around.  Only a pull request
        # whose head repository is the base repository can have one.
        if [ "${fd_other#* }" = "${pr_head_branch}" ] \
          && [ "$(lowercase "${pr_head_repo}")" = "$(lowercase "${pr_base_repo}")" ]; then
          continue
        fi
        fd_reason="its description says to land after ${pr_base_repo}#${fd_rest}"
        ;;
      *) continue ;;
    esac
    dependence="${SCRIPT_NAME}: the current branch's pull request ${pr_base_repo}#${fd_pr} builds on another pull request:  ${fd_reason}"
    return 0
  done
}

nocompile=0
allow_dependent=0
while [ "$#" -ge 1 ]; do
  case "$1" in
    --nocompile) nocompile=1 ;;
    --allow-dependent) allow_dependent=1 ;;
    *)
      if ! parse_llm_option "$1"; then break; fi
      ;;
  esac
  shift
done

if [ "$#" -ne 0 ]; then
  echo "Usage: ${SCRIPT_NAME} [--nocompile] [--allow-dependent] ${llm_options_usage}" >&2
  exit 1
fi

# Check that the current branch can be pulled, choose the upstream remote and
# fetch it, and refuse a push that would be a mistake, so that a run that
# fails for any of these reasons does so before the pull changes the current
# branch.
if ! check_upstream "$(pwd)"; then
  exit 1
fi
if [ -z "${checked_out_branch}" ]; then
  echo "${SCRIPT_NAME}: HEAD is detached; check out a branch first" >&2
  exit 1
fi
# The fetch can prompt, as the push below can, so that a user who must type a
# passphrase can do so for every one of them.
if ! find_upstream_ref 1; then
  exit 1
fi

# Refuse a push that would publish the current branch in the upstream
# repository by mistake:
#  * In a fork, whose upstream repository is the remote named "upstream" or
#    is the fork's parent, any push to that repository, as for a branch
#    created from `upstream/master` when `push.default` is "current".  The
#    fork is where its branches belong.  The push destination is compared by
#    repository (see `url_key`) rather than by the remote's name, so a push
#    through another remote for that repository, or through its URL, is
#    refused too.
#  * In any clone, a push to the branch that this command merges from, as when
#    a fork's `master` tracks `upstream/master`.  Merging that branch into
#    itself does nothing, so the only effect of the run would be to publish
#    the current branch's own commits there.
# `%(push)` and `%(push:remotename)`, unlike `@{push}`, do not require the
# remote-tracking branch for the destination to exist, as it does not before
# the first push.
# A ref name cannot contain a space, so the first space separates the fields,
# and `%(push)` is first because it may be empty.
push_fields="$(git for-each-ref --format='%(push) %(push:remotename)' \
  "refs/heads/${checked_out_branch}")"
push_ref="${push_fields%% *}"
push_remote_name="${push_fields#* }"
if [ "${upstream_source}" = upstream ] || [ "${upstream_is_parent}" -eq 1 ]; then
  # Each list is sorted without duplicates, so a key that occurs twice in
  # their concatenation is in both.
  upstream_keys="$(remote_urls . "${upstream_source}" | url_keys . | sort -u)"
  push_keys="$(remote_urls . "${push_remote_name}" --push | url_keys . | sort -u)"
  if [ -n "$(printf '%s\n%s\n' "${upstream_keys}" "${push_keys}" | sort | uniq -d)" ]; then
    echo "${SCRIPT_NAME}: the current branch pushes to \"${push_remote_name}\", which is the upstream repository rather than the fork, so this command does not push it; if you mean to, run \`git push\`" >&2
    exit 1
  fi
fi
if [ "${push_ref}" = "${upstream_ref}" ]; then
  echo "${SCRIPT_NAME}: the current branch pushes to ${upstream_ref#refs/remotes/}, the branch that this command merges from, so this command does not push it; if you mean to, run \`git push\`" >&2
  exit 1
fi
# The checks above are about the current branch, so refuse a `git push` that
# would push other branches too:  "matching" pushes every branch that the
# remote also has, `remote.REMOTE.mirror` pushes every ref, and refspecs in
# `remote.REMOTE.push` replace the current branch with whatever they name.
if [ "$(git config --get push.default)" = matching ]; then
  echo "${SCRIPT_NAME}: push.default is \"matching\", so \`git push\` would push other branches too; this command does not push" >&2
  exit 1
fi
if [ "$(git config --bool --get "remote.${push_remote_name}.mirror")" = true ]; then
  echo "${SCRIPT_NAME}: remote.${push_remote_name}.mirror is set, so \`git push\` would push every ref; this command does not push" >&2
  exit 1
fi
if [ -n "$(git config --get-all "remote.${push_remote_name}.push")" ]; then
  echo "${SCRIPT_NAME}: remote.${push_remote_name}.push is set, so \`git push\` might push other branches too; this command does not push" >&2
  exit 1
fi

# Ask GitHub before the pull, which does not change GitHub's answer, so that
# the query and its diagnostics precede any merge that the pull makes.  But
# refuse only after the pull, which can bring the default branch into the
# current branch, so that a branch that need not merge is not refused.
dependence=''
if [ "${allow_dependent}" -eq 0 ] && ! git merge-base --is-ancestor "${upstream_ref}" HEAD; then
  find_dependence "${checked_out_branch}"
fi

# `--no-rebase` because a rebase would drop a merge from `upstream` that an
# earlier run of this command made but did not push, as when its build
# failed, and would copy that merge's commits onto the current branch.
if ! pull_resolving "${llm_agent}" "$(pwd)" --no-rebase; then
  exit 1
fi

# Stop if there is nothing to merge and nothing to push.  If there is nothing
# to merge, still build and push if the branch has commits that are not
# pushed, as after a run of this command whose build failed.
# This compares with ${push_ref}, where the current branch pushes, rather than
# with `@{upstream}`, where it pulls from:  the two differ when
# `branch.BRANCH.pushRemote` or `remote.pushDefault` is set.  If ${push_ref}
# is empty or does not exist, as before the first push, do not stop.
if git merge-base --is-ancestor "${upstream_ref}" HEAD; then
  contains_upstream=1
else
  contains_upstream=0
fi
if [ "${contains_upstream}" -eq 1 ] \
  && push_head="$(git rev-parse --verify --quiet "${push_ref}")" \
  && [ "$(git rev-parse HEAD)" = "${push_head}" ]; then
  exit 0
fi

# Find out now, rather than after the merge and the build, whether the push
# can succeed.  `%(push)` is empty when git cannot name the destination
# locally.  The push may fail then, as when `push.default` is "simple" and the
# current branch's name differs from its upstream branch's, or it may succeed,
# as when that branch pushes to a remote other than the one it pulls from.
# Only the remote can tell.  Ask after the pull, because before it the remote
# would reject a push of a branch that lacks the remote's new commits.
if [ -z "${push_ref}" ] && ! git push --dry-run --quiet; then
  echo "${SCRIPT_NAME}: the current branch cannot be pushed, so this command does not merge it" >&2
  exit 1
fi

if [ "${contains_upstream}" -eq 0 ] && [ -n "${dependence}" ]; then
  printf '%s\n' "${dependence}" >&2
  echo "${SCRIPT_NAME}: so this command does not merge ${upstream_ref#refs/remotes/} directly, which would make a later merge of the branch that it builds on a criss-cross merge; update the current branch with \`git-push-to\` from the branch that it builds on, as \`pr-status\` prints, or pass --allow-dependent" >&2
  exit 1
fi

# Merge the commit, rather than a ref name such as `upstream/master`, so that
# a tag or a local branch of that name cannot be merged in its place.  The
# merge message is the one that `git merge upstream/master` would write:
#
#   Merge remote-tracking branch 'upstream/master' into feature
#
# or, for a fork's parent that was fetched from its URL, the one that
# `git pull URL` would write, but naming the URL that the clone's
# configuration gives rather than the one that `url.BASE.insteadOf` rewrites
# it to:
#
#   Merge github.com:ORG/PROJ into feature
#
# If the current branch already contains the commit, the merge does nothing.
if ! upstream_head="$(git rev-parse --verify --quiet "${upstream_ref}")"; then
  echo "${SCRIPT_NAME}: cannot read ${upstream_ref}" >&2
  exit 1
fi
# The history of the upstream repository's default branch was built where it
# was pushed, unless that repository's branches need not have been built (see
# `is_built_remote`).  So was the head that the pull fetched, even if no
# remote-tracking branch records it.
if is_built_remote . "${upstream_source}"; then
  upstream_built="${upstream_ref}"
else
  upstream_built=''
fi
case "${upstream_ref}" in
  refs/remotes/*) upstream_merge_source="remote-tracking branch '${upstream_ref#refs/remotes/}' of ." ;;
  *) upstream_merge_source="$(fetch_head_location "${upstream_source}")" ;;
esac
if ! merge_build_push "${upstream_head}" \
  "${upstream_merge_source}" "${upstream_ref}" \
  "${nocompile}" "${llm_agent}" "${upstream_built} ${pull_fetched}"; then
  exit 1
fi
