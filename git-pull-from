#!/bin/sh

# Pulls from another directory into the current repository.  Fails if
# the resulting merge does not compile.  (Skips the compilation step
# if the --nocompile argument is given or if environment variable
# MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT is set.)
#
# Usage:
#   git-pull-from [--nocompile] OTHER-REPO-DIR
#
# Run this command from the top level of a working copy (that is, a
# clone).  OTHER-REPO-DIR is the top level of another working copy; it
# may be an absolute or relative pathname.

# This script does the following:
#  * pull another directory from its remote,
#  * pull that other directory into this one,
#  * build this one using `compile-project` (see its documentation),
#  * push this one to its remote if the build succeeds.
#
# All the work is done by `git-push-to OTHER-REPO-DIR .`, so the two commands
# behave identically and diagnostics mention `git-push-to`.
#
# Calling `git-push-to` is often more readable, because it makes both directory names explicit.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

nocompile=0

if [ "$#" -ge 1 ] && [ "$1" = "--nocompile" ]; then
  nocompile=1
  shift
fi

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} [--nocompile] OTHER-REPO-DIR" >&2
  exit 1
fi

# Like each argument of `git-push-to`, the current directory must be the top
# level of a clone.  Diagnose that here rather than leaving it to `git-push-to`,
# which would report it about ".":  that does not tell the user which directory
# to run this command in, and `git-push-to` cannot know that "." came from this
# command rather than from the user.
# Capture the top level first: under a POSIX `sh` (e.g., dash), a command
# substitution that produces no output is an empty argument rather than an
# error, so testing the status of `git rev-parse` alone would not catch it.
if ! TOPLEVEL="$(git rev-parse --show-toplevel 2> /dev/null)" || [ -z "${TOPLEVEL}" ]; then
  # The current directory is not in a working copy at all:  it is outside any
  # repository, or it is in a bare repository, which has no working copy.
  echo "${SCRIPT_NAME}: not the top level of a git clone: $(pwd)" >&2
  exit 1
fi
# Compare physical pathnames, because the current directory may be reached
# through a symbolic link that `git rev-parse --show-toplevel` resolved.
if ! TOPLEVEL_PHYSICAL="$(CDPATH='' cd -- "${TOPLEVEL}" && pwd -P)" \
  || [ -z "${TOPLEVEL_PHYSICAL}" ]; then
  echo "${SCRIPT_NAME}: cannot canonicalize the top level of this clone: ${TOPLEVEL}" >&2
  exit 1
fi
if [ "$(pwd -P)" != "${TOPLEVEL_PHYSICAL}" ]; then
  echo "${SCRIPT_NAME}: not the top level of a git clone: $(pwd)" >&2
  echo "${SCRIPT_NAME}: its top level is: ${TOPLEVEL}" >&2
  exit 1
fi

# OTHER-REPO-DIR must be the top level of a clone too.  `git-push-to` also
# checks this, but check it here so that the diagnostic names this command's
# argument rather than appearing to come from a command the user did not run.
if [ ! -d "$1" ]; then
  echo "${SCRIPT_NAME}: no such directory: $1" >&2
  exit 1
fi
if ! OTHER_TOPLEVEL="$(git -C "$1" rev-parse --show-toplevel 2> /dev/null)" \
  || [ -z "${OTHER_TOPLEVEL}" ]; then
  echo "${SCRIPT_NAME}: not the top level of a git clone: $1" >&2
  exit 1
fi
if ! OTHER_TOPLEVEL_PHYSICAL="$(CDPATH='' cd -- "${OTHER_TOPLEVEL}" && pwd -P)" \
  || [ -z "${OTHER_TOPLEVEL_PHYSICAL}" ]; then
  echo "${SCRIPT_NAME}: cannot canonicalize the top level of that clone: ${OTHER_TOPLEVEL}" >&2
  exit 1
fi
if ! OTHER_PHYSICAL="$(CDPATH='' cd -- "$1" && pwd -P)" || [ -z "${OTHER_PHYSICAL}" ]; then
  echo "${SCRIPT_NAME}: cannot canonicalize: $1" >&2
  exit 1
fi
if [ "${OTHER_PHYSICAL}" != "${OTHER_TOPLEVEL_PHYSICAL}" ]; then
  echo "${SCRIPT_NAME}: not the top level of a git clone: $1" >&2
  echo "${SCRIPT_NAME}: its top level is: ${OTHER_TOPLEVEL}" >&2
  exit 1
fi

if [ "$nocompile" -eq 1 ]; then
  exec "${SCRIPT_DIR}"/git-push-to --nocompile "$1" .
else
  exec "${SCRIPT_DIR}"/git-push-to "$1" .
fi
