#!/bin/sh

# Pulls from another directory into the current repository.  Fails if
# the resulting merge does not compile.  (Skips the compilation step
# if the --nocompile argument is given or if environment variable
# MANAGE_GIT_BRANCHES_SKIP_COMPILE_PROJECT is set.)
#
# Usage:
#   git-pull-from [--nocompile] OTHER-REPO-DIR
#
# Run this command from within a repository.  OTHER-REPO-DIR may be an absolute
# or relative pathname.

# This script does the following:
#  * pull another directory from its remote,
#  * pull that other directory into this one,
#  * build this one using `compile-project` (see its documentation),
#  * push this one to its remote if the build succeeds.
#
# All the work is done by `git-push-to OTHER-REPO-DIR .`, so the two commands
# behave identically and diagnostics mention `git-push-to`.
#
# Calling `git-push-to` is often more readable, because it makes both directory names explicit.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  script_link="$(readlink -- "${script_path}")"
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

nocompile=0

if [ "$#" -ge 1 ] && [ "$1" = "--nocompile" ]; then
  nocompile=1
  shift
fi

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} [--nocompile] OTHER-REPO-DIR" >&2
  exit 1
fi

if [ "$nocompile" -eq 1 ]; then
  exec "${SCRIPT_DIR}"/git-push-to --nocompile "$1" .
else
  exec "${SCRIPT_DIR}"/git-push-to "$1" .
fi
