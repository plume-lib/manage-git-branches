#!/bin/sh

# Compiles the project that contains the current or given directory.
#
# Supports Gradle, Maven, and Make projects.  If no buildfile is found
# at the top level, searches at (only) the next level down.
#
# The exit status is failure if any build fails.  If no buildfile is
# found and ERR_IF_NO_BUILDFILE is set to a non-empty value, then the
# exit status is failure.
#
# Usage:
#   compile-project [--clean] [--no-discover] [<directory>]
#
# If --clean is passed, then the project is cleaned before being compiled.
# If --no-discover is passed, then the current directory (or <directory>) is
# used as the top level of the project, without discovering the top level of
# the git clone that contains it.
# If variable GRADLE_ASSEMBLE_FLAGS is defined, it is passed to `gradlew assemble` or `gradle assemble`.
# If variable MVN_COMPILE_FLAGS is defined, it is passed to `mvnw compile` or `mvn compile`.
# If variable MAKE_FLAGS is defined, it is passed to `make`.
# If variable ERR_IF_NO_BUILDFILE is non-empty, the script fails if no buildfile is found.
#
# This command does not need to be run in, or be given, the top-level directory
# of the project; it discovers the top-level directory on its own (from the
# current directory, or from <directory> if one is given) and runs the command
# there.  Pass --no-discover to compile in the given directory itself.

# TODO: Handle other build systems too, such as Ant.
# TODO: Have a list of per-directory or per-repository commands, to override the default.

# SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

usage() {
  echo "Usage: ${SCRIPT_NAME} [--clean] [--no-discover] [<directory>]" >&2
  exit 1
}

CLEAN=""
DISCOVER=1
while [ "$#" -ge 1 ]; do
  case "$1" in
    --clean)
      CLEAN="$1"
      shift
      ;;
    --no-discover)
      DISCOVER=0
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

# $startdir is a physical absolute path, without a trailing "/" character, so
# that it can be compared to the output of `git rev-parse --show-toplevel`,
# which is also a physical absolute path.
if [ "$#" -eq 0 ]; then
  if ! startdir="$(pwd -P)" || [ -z "$startdir" ]; then
    echo "${SCRIPT_NAME}: cannot determine the current directory" >&2
    exit 1
  fi
elif [ "$#" -eq 1 ]; then
  if [ -z "$1" ]; then
    echo "${SCRIPT_NAME}: the <directory> argument is empty" >&2
    exit 1
  fi
  if [ ! -d "$1" ]; then
    echo "${SCRIPT_NAME}: not a directory: $1" >&2
    exit 1
  fi
  if ! startdir="$(CDPATH='' cd -- "$1" && pwd -P)" || [ -z "$startdir" ]; then
    echo "${SCRIPT_NAME}: cannot change to directory: $1" >&2
    exit 1
  fi
else
  usage
fi

# $toplevel does not have a trailing "/" character
if [ "$DISCOVER" = 0 ]; then
  toplevel="$startdir"
  echo "Running ${SCRIPT_NAME} in $toplevel"
elif toplevel="$(git -C "$startdir" rev-parse --show-toplevel 2> /dev/null)" && [ -n "$toplevel" ]; then
  if [ "$toplevel" = "$startdir" ]; then
    echo "Running ${SCRIPT_NAME} in $toplevel"
  else
    echo "Running ${SCRIPT_NAME} in $toplevel, called from $startdir"
  fi
else
  toplevel="$startdir"
  echo "Running ${SCRIPT_NAME} in $toplevel"
fi

# Returns a status code indicating success or failure, or 222 if no buildfile was found.
compile_in_directory() {
  dir="$1"

  if [ -f "$dir/gradlew" ]; then
    if [ -n "$CLEAN" ]; then
      "$dir/gradlew" --project-dir "$dir" clean -q < /dev/null
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    "$dir/gradlew" --project-dir "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS} < /dev/null
    return $?
  elif [ -f "$dir/build.gradle" ]; then
    if [ -n "$CLEAN" ]; then
      gradle --project-dir "$dir" clean -q < /dev/null
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    gradle --project-dir "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS} < /dev/null
    return $?
  elif [ -f "$dir/mvnw" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && ./mvnw -q clean)
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && ./mvnw -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/pom.xml" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && mvn -q clean)
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && mvn -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/Makefile" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && make clean)
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && make ${MAKE_FLAGS})
    return $?
  else
    # No buildfile was found.
    return 222
  fi
}

compile_in_directory "$toplevel"
result=$?

if [ "$result" != 222 ]; then
  # A buildfile was found; exit with the exit code of the compilation step.
  exit $result
else
  # Call compile_in_directory in subdirectories.
  buildfile_found=0
  for subdir in "$toplevel"/*/; do
    compile_in_directory "$subdir"
    result=$?
    if [ "$result" = 222 ]; then
      continue
    fi
    buildfile_found=1
    if [ "$result" -ne 0 ]; then
      exit $result
    fi
  done
  if [ "$buildfile_found" = 0 ] && [ -n "$ERR_IF_NO_BUILDFILE" ]; then
    echo "${SCRIPT_NAME} did nothing in ${toplevel}" >&2
    exit 1
  fi
fi
