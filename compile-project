#!/bin/sh

# Compiles the project that contains the current or given directory, or, with
# --format, reformats its source code.
#
# Supports Gradle, Maven, and Make projects.  If no buildfile is found
# at the top level, searches at (only) the next level down.
#
# Prints nothing unless a build fails, or writes to standard error, or no
# buildfile is found and ERR_IF_NO_BUILDFILE is set.  Then it prints, to
# standard error, the directory where it ran and the builds' standard output
# and standard error together, in the order in which the builds wrote them.
# That order is approximate:  a line of standard error written just before a
# line of standard output can appear after it.  And a program that buffers its
# standard output, as many programs do when it is not a terminal, can write it
# long after standard error that it wrote later.  The output is printed after
# the builds finish, or when this command is interrupted, not while they run.
# The output omits the warnings about missing documentation that javadoc and
# javac's doclint print, such as "warning: no @param for x", unless the build
# failed because of warnings, as with "-Werror" (see
# `elide_missing_doc_warnings`, below).  So a build whose only output to
# standard error is such warnings prints nothing.
# The builds' standard input is /dev/null, so a build that prompts for input
# fails rather than waiting for input with its prompt hidden.  If a build
# starts a background process that keeps standard error open, this command
# waits for that process to exit.
#
# The exit status is failure if any build fails, if <directory> is given
# but is not a directory, or if the top-level directory cannot be
# determined.  If no buildfile is found and ERR_IF_NO_BUILDFILE is set to
# a non-empty value, then the exit status is failure.
#
# Usage:
#   compile-project [--clean | --format] [<directory>]
#
# If --clean is passed, then the project is cleaned before being compiled.
# If the clean fails, the project is not compiled and the exit status is failure.
# If --format is passed, then the project is reformatted rather than compiled,
# by the formatter that its buildfile configures:
#  * Gradle:  `gradlew spotlessApply` or `gradle spotlessApply`, if a Gradle
#    buildfile refers to Spotless as `gradle_uses_spotless`, below, describes.
#    The buildfiles are the files `*.gradle` and `*.gradle.kts` anywhere in
#    the directory, including under `buildSrc/` or `build-logic/`, which can
#    hold a convention plugin that applies Spotless.
#  * Maven:  `mvnw spotless:apply` or `mvn spotless:apply`, if `pom.xml`
#    mentions "spotless-maven-plugin".
#  * Make:  `make reformat`, or else `make format`, if the Makefile has a rule
#    for that target.
# A project whose buildfile configures none of these is left unchanged, and
# the exit status is success.  The flag variables below are not passed to the
# formatter.
# If variable GRADLE_ASSEMBLE_FLAGS is defined, it is passed to `gradlew assemble` or `gradle assemble`.
# If a Gradle command fails, writing "Failed to exec spawn helper" to standard
# error, and was not stopped by a signal, and some of the user's idle Gradle
# daemons of the command's Gradle version run a Java executable that was
# deleted after they started, as by an upgrade of the JDK, this command stops
# those daemons, which cannot start processes, and runs the Gradle command once
# more.  It recognizes such daemons only where /proc exists, as on Linux.
# If variable MVN_COMPILE_FLAGS is defined, it is passed to `mvnw compile` or `mvn compile`.
# If variable MAKE_FLAGS is defined, it is passed to `make`.
# If variable ERR_IF_NO_BUILDFILE is non-empty, the script fails if no buildfile is found.
#
# This command does not need to be run in the top-level directory of the project;
# it will discover the top-level directory on its own and run the command there.
# The top level is that of the git repository containing the current or given
# directory, or the directory itself if it is not within a git repository.

# TODO: Handle other build systems too, such as Ant.
# TODO: Have a list of per-directory or per-repository commands, to override the default.

# Git exports $GIT_DIR, $GIT_WORK_TREE, and $GIT_INDEX_FILE to hooks and to the
# commands run by `git rebase --exec`, `git bisect run`, and
# `git submodule foreach`.  The first two take precedence over the `-C`
# argument of `git`, so leaving them set would make this script compile
# whatever repository the caller happened to be working in, rather than the
# current or given directory.
#
# $GIT_INDEX_FILE names the index alone, which this script's own
# `rev-parse --show-toplevel` does not read, so unsetting it changes no answer
# here.  Unset it all the same:  the build command runs with this environment,
# and a build that consults git -- one that stamps a version from
# `git describe`, or a formatter that checks only what changed -- would read
# some other repository's index.  The three variables travel together, and a
# script that unsets two of them invites the reader to wonder about the third.
unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
# `cd` consults $CDPATH, so leaving it set would make `cd "$dir"` compile some
# other directory named "$dir" (and print the directory it chose to stdout).
CDPATH=''

CLEAN=""
FORMAT=""
if [ "$#" -ge 1 ]; then
  case "$1" in
    --clean)
      CLEAN="$1"
      shift
      ;;
    --format)
      FORMAT="$1"
      shift
      ;;
  esac
fi

# SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

# Prints the top level of the git repository that contains directory $1.
# The exit status is 0 on success, 222 if $1 is not within a git repository, and
# 1 if git could not answer the question -- for example, because the repository
# is owned by another user, or has an unsupported format, or git is not
# installed.  In that case, git's diagnostic has been copied to stderr; the
# caller must not conclude that $1 is outside a repository.
git_toplevel() {
  # Run git twice, rather than capturing its standard output and standard error
  # together, so that a warning on standard error cannot be mistaken for part of
  # the directory name.  LC_ALL is set because the message is matched below.
  if git_toplevel_stderr="$(LC_ALL=C git -C "$1" rev-parse --show-toplevel 2>&1 > /dev/null)"; then
    git -C "$1" rev-parse --show-toplevel
    return 0
  fi
  case "${git_toplevel_stderr}" in
    *'not a git repository'*) return 222 ;;
  esac
  if [ -n "${git_toplevel_stderr}" ]; then
    printf '%s\n' "${git_toplevel_stderr}" >&2
  fi
  return 1
}

# $toplevel has no trailing "/" character, unless it is the root directory "/".
if [ "$#" -eq 0 ]; then
  toplevel="$(git_toplevel .)"
  case "$?" in
    0) running_message="Running ${SCRIPT_NAME} in $toplevel, called from $(pwd)" ;;
    222)
      toplevel="$(pwd)"
      running_message="Running ${SCRIPT_NAME} in $toplevel"
      ;;
    *) exit 1 ;;
  esac
elif [ "$#" -eq 1 ]; then
  if [ ! -d "$1" ]; then
    printf '%s: not a directory: %s\n' "${SCRIPT_NAME}" "$1" >&2
    exit 1
  fi
  toplevel="$(git_toplevel "$1")"
  case "$?" in
    0) running_message="Running ${SCRIPT_NAME} in $toplevel, called for $1" ;;
    222)
      # The directory is its own top level.  Make it absolute, so that later
      # messages and `cd` commands do not depend on the current directory.
      # This also removes any trailing "/" characters.
      if ! toplevel="$(cd -- "$1" && pwd)"; then
        exit 1
      fi
      running_message="Running ${SCRIPT_NAME} in $toplevel"
      ;;
    *) exit 1 ;;
  esac
else
  printf '%s\n' "Usage: ${SCRIPT_NAME} [--clean | --format] [<directory>]" >&2
  exit 1
fi

# Prints, one per line, the process ids of the current user's idle Gradle
# daemons that run a Java executable that was deleted after the daemon
# started, as when a package upgrade replaced the JDK.  Such a daemon cannot
# start a process:  Java fails with "Failed to exec spawn helper", so a build
# that runs a program, such as `git`, fails.  Prints only the daemons of the
# Gradle version that the Gradle command $1, such as `gradle` or
# `DIR/gradlew`, runs for the project in directory $2.  Omits a daemon that is
# busy, as with another build, so that stopping it cannot break that build.
# Prints nothing on a system without /proc, where such a daemon cannot be
# recognized.
stale_gradle_daemons() {
  if [ ! -d /proc ]; then
    return 0
  fi
  # `--status` prints a header "PID STATUS INFO" and then one line per daemon
  # of the command's Gradle version, such as "  1234 IDLE     9.9.0".
  for stale_pid in $("$1" --project-dir "$2" --status < /dev/null 2> /dev/null \
    | awk '$1 ~ /^[0-9]+$/ && $2 == "IDLE" { print $1 }'); do
    # The kernel appends " (deleted)" to the name of a deleted executable.
    case "$(readlink "/proc/${stale_pid}/exe" 2> /dev/null)" in
      *' (deleted)') printf '%s\n' "${stale_pid}" ;;
    esac
  done
}

# Stops the stale Gradle daemons that `stale_gradle_daemons "$1" "$2"` prints.
# Sends each one SIGTERM and, if it is still running 10 seconds later, SIGKILL.
# Returns 0, after printing a notice to standard error, if there were any,
# and 1 otherwise.
stop_stale_gradle_daemons() {
  stale_pids="$(stale_gradle_daemons "$1" "$2")"
  if [ -z "${stale_pids}" ]; then
    return 1
  fi
  printf '%s: stopping Gradle daemons whose Java executable was deleted after they started, as by an upgrade of the JDK (process ids %s), and building again\n' \
    "${SCRIPT_NAME}" "$(printf '%s\n' "${stale_pids}" | paste -s -d ' ' -)" >&2
  # shellcheck disable=SC2086 # Each process id is one word.
  kill ${stale_pids} 2> /dev/null
  stale_waited=0
  while :; do
    stale_alive=""
    for stale_pid in ${stale_pids}; do
      if kill -0 "${stale_pid}" 2> /dev/null; then
        stale_alive="${stale_alive} ${stale_pid}"
      fi
    done
    if [ -z "${stale_alive}" ]; then
      return 0
    fi
    if [ "${stale_waited}" -ge 10 ]; then
      # shellcheck disable=SC2086 # Each process id is one word.
      kill -s KILL ${stale_alive} 2> /dev/null
      return 0
    fi
    sleep 1
    stale_waited=$((stale_waited + 1))
  done
}

# Runs the command given by the arguments, with standard input from /dev/null,
# and copies its standard error to file $gradle_errors as well as to standard
# error.  Returns the exit status of the command.
run_copying_errors() {
  # The command's standard output goes to file descriptor 3, which is this
  # function's standard output, and its standard error goes to `tee`.  `tee`
  # ignores signals for the reason given where the builds' output is copied,
  # below.  A pipeline does not pass on the status of its first command in
  # POSIX sh, so the status goes through a file.
  {
    {
      "$@" < /dev/null 2>&1 1>&3 3>&-
      echo "$?" > "${gradle_status_file}"
    } | (
      trap '' HUP INT TERM
      exec tee "${gradle_errors}"
    ) >&2
  } 3>&1
  run_copying_errors_status="$(cat "${gradle_status_file}" 2> /dev/null)"
  return "${run_copying_errors_status:-1}"
}

# Runs the Gradle command $1, such as `gradle` or `DIR/gradlew`, for the
# project in directory $2, with the arguments after the second, such as
# `assemble -q`, and with standard input from /dev/null.  If the command fails,
# writing "Failed to exec spawn helper" to standard error, and was not stopped
# by a signal, and stale Gradle daemons can be stopped (see
# `stop_stale_gradle_daemons`), runs it once more.  Returns the exit status of
# the last run.
run_gradle() {
  run_gradle_command="$1"
  run_gradle_dir="$2"
  shift 2
  if run_copying_errors "${run_gradle_command}" --project-dir "${run_gradle_dir}" "$@"; then
    return 0
  else
    run_gradle_status=$?
  fi
  # A status above 128 means that the command was stopped by a signal, as by a
  # Ctrl-C, which a second run would ignore.
  if [ "${run_gradle_status}" -gt 128 ] \
    || ! grep -q 'Failed to exec spawn helper' "${gradle_errors}" \
    || ! stop_stale_gradle_daemons "${run_gradle_command}" "${run_gradle_dir}"; then
    return "${run_gradle_status}"
  fi
  "${run_gradle_command}" --project-dir "${run_gradle_dir}" "$@" < /dev/null
}

# Returns 0 if a Gradle buildfile of the project in directory $1 refers to
# Spotless, and 1 otherwise.  The buildfiles are the files `*.gradle` and
# `*.gradle.kts` anywhere in $1, such as `$1/build.gradle`,
# `$1/services/api/build.gradle.kts`, and a convention plugin under
# `$1/buildSrc/` or `$1/build-logic/`, except under a directory that holds
# version-control data, build output, or downloaded dependencies, such as
# `.git`, `build`, `.gradle`, or `node_modules`.  A buildfile refers to
# Spotless if a line names the plugin's id, as in
# `id("com.diffplug.spotless")`, names a plugin of a version catalog whose
# alias ends with "spotless", as in `alias(libs.plugins.spotless)`, or starts
# a `spotless` block, as in `spotless {`.  A line that starts with a comment,
# as in `// id("com.diffplug.spotless")` or a line ` * ...` within a block
# comment, or that names Spotless only after a "/", as in a comment
# `// TODO: adopt spotless`, does not count.  A version catalog, such as
# `gradle/libs.versions.toml`, is not searched, because it can declare a
# plugin that no project applies.
gradle_uses_spotless() {
  # Each pattern but the last requires that no "/" or leading "*" precede the
  # mention, so that a comment does not count.
  grep -r -q -E --include='*.gradle' --include='*.gradle.kts' \
    --exclude-dir=.git --exclude-dir=.gradle --exclude-dir=build \
    --exclude-dir=node_modules \
    -e '^[[:space:]]*([^*/[:space:]][^/]*)?com\.diffplug\.spotless' \
    -e '^[[:space:]]*([^*/[:space:]][^/]*)?plugins\.([A-Za-z0-9_]+\.)*spotless([^A-Za-z0-9_.]|$)' \
    -e '^[[:space:]]*spotless[[:space:]]*\{' \
    -- "$1"
}

# Prints the first of the targets "reformat" and "format" for which the
# Makefile $1 has a rule, or nothing if it has a rule for neither.  A rule can
# have several targets, as in "format reformat: ...".  A rule made by an
# `include`d file is not found.
make_format_target() {
  for make_target in reformat format; do
    # A rule's target is followed by ":", or by "::" for a double-colon rule.
    # Colons that are followed by "=" are those of a variable assignment, such
    # as "format := ...", "format ::= ...", or "format :::= ...", rather than
    # those of a rule.
    # The other targets of the rule precede or follow the target, separated
    # by spaces.
    if grep -q -E "^([^#:=[:space:]]+[[:space:]]+)*${make_target}([[:space:]]+[^#:=[:space:]]+)*[[:space:]]*::?([^:=]|\$)" "$1"; then
      printf '%s\n' "${make_target}"
      return
    fi
  done
}

# Sets $buildfile_found_here to 1 if a buildfile was found in directory $1, or to 0
# if none was.  Returns the status of the formatter that the buildfile
# configures (see the --format option, above), or 0 if no buildfile was found or
# it configures no formatter.
format_in_directory() {
  dir="$1"
  buildfile_found_here=1

  if [ -f "$dir/gradlew" ] || [ -f "$dir/build.gradle" ] || [ -f "$dir/build.gradle.kts" ]; then
    if ! gradle_uses_spotless "$dir"; then
      return 0
    fi
    if [ -f "$dir/gradlew" ]; then
      run_gradle "$dir/gradlew" "$dir" spotlessApply -q
    else
      run_gradle gradle "$dir" spotlessApply -q
    fi
    return $?
  elif [ -f "$dir/mvnw" ] || [ -f "$dir/pom.xml" ]; then
    if ! grep -q -e spotless-maven-plugin -- "$dir/pom.xml" 2> /dev/null; then
      return 0
    fi
    if [ -f "$dir/mvnw" ]; then
      (cd "$dir" && ./mvnw -q spotless:apply)
    else
      (cd "$dir" && mvn -q spotless:apply)
    fi
    return $?
  elif [ -f "$dir/Makefile" ]; then
    format_target="$(make_format_target "$dir/Makefile")"
    if [ -z "${format_target}" ]; then
      return 0
    fi
    (cd "$dir" && make "${format_target}")
    return $?
  else
    # No buildfile was found.
    buildfile_found_here=0
    return 0
  fi
}

# Sets $buildfile_found_here to 1 if a buildfile was found in directory $1, or to 0
# if none was.  Returns the status of the build; or, if --clean was given and the
# clean failed, the status of the clean, without building; or 0 if no buildfile
# was found.  With --format, reformats rather than builds, as
# `format_in_directory` does.
# The "was a buildfile found?" answer is a variable rather than a reserved exit
# status, because every exit status is one that a build command itself might return.
compile_in_directory() {
  if [ -n "$FORMAT" ]; then
    format_in_directory "$1"
    return $?
  fi
  dir="$1"
  buildfile_found_here=1

  if [ -f "$dir/gradlew" ]; then
    if [ -n "$CLEAN" ]; then
      run_gradle "$dir/gradlew" "$dir" clean -q || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    run_gradle "$dir/gradlew" "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS}
    return $?
  elif [ -f "$dir/build.gradle" ] || [ -f "$dir/build.gradle.kts" ]; then
    if [ -n "$CLEAN" ]; then
      run_gradle gradle "$dir" clean -q || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    run_gradle gradle "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS}
    return $?
  elif [ -f "$dir/mvnw" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && ./mvnw -q clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && ./mvnw -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/pom.xml" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && mvn -q clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && mvn -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/Makefile" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && make clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && make ${MAKE_FLAGS})
    return $?
  else
    # No buildfile was found.
    buildfile_found_here=0
    return 0
  fi
}

# Compiles the project in $toplevel or, if $toplevel has no buildfile, in
# each subdirectory of $toplevel that has one, stopping at the first build that
# fails.  Returns the status of that build, or 0 if no build fails.  If no
# buildfile is found and ERR_IF_NO_BUILDFILE is non-empty, prints a diagnostic
# and returns 1.  With --format, reformats rather than builds, as
# `compile_in_directory` does.
compile_project() {
  compile_in_directory "$toplevel"
  result=$?
  if [ "$buildfile_found_here" = 1 ]; then
    return $result
  fi
  buildfile_found=0
  for subdir in "$toplevel"/*/; do
    compile_in_directory "$subdir"
    result=$?
    if [ "$buildfile_found_here" = 0 ]; then
      continue
    fi
    buildfile_found=1
    if [ "$result" -ne 0 ]; then
      return $result
    fi
  done
  if [ "$buildfile_found" = 0 ] && [ -n "$ERR_IF_NO_BUILDFILE" ]; then
    printf '%s\n' "${SCRIPT_NAME} did nothing in $toplevel or its subdirectories" >&2
    return 1
  fi
  return 0
}

if ! tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/compile-project.XXXXXX")" || [ -z "$tmpdir" ]; then
  printf '%s\n' "${SCRIPT_NAME}: cannot create a temporary directory" >&2
  exit 1
fi
# The builds' standard output and standard error, together.
output="$tmpdir/output"
# The builds' standard error alone.
errors="$tmpdir/errors"
# The exit status of compile_project.
status_file="$tmpdir/status"
# The standard error of the last Gradle command that `run_gradle` ran.
gradle_errors="$tmpdir/gradle-errors"
# The exit status of the last command that `run_copying_errors` ran.
gradle_status_file="$tmpdir/gradle-status"

# Matches a line with which a build fails because of warnings:  javac's and
# javadoc's "error: warnings found and -Werror specified", which Maven can
# print as "[ERROR] error: warnings found and -Werror specified",
# "[ERROR] warnings found and -Werror specified", or
# "[ERROR] Exit code: 1 - error: warnings found and -Werror specified"; or
# maven-javadoc-plugin's
# "[ERROR] Failed to execute goal ...: Project contains Javadoc Warnings -> [Help 1]",
# which `<failOnWarnings>` causes.  Then the warnings are the cause of the
# failure, so none is elided.  The whole line must have one of these forms, so
# that a source line that a warning quotes, such as
#   String MSG = "warnings found and -Werror specified";
# does not match.  JDK 8's javadoc prints no such message when `-Xwerror`
# makes it fail, so its warnings about missing documentation are elided.
warnings_failure_regex='^((\[ERROR\] )?(Exit code: [0-9]+ - )?error: |\[ERROR\] )warnings found and -Werror specified[[:space:]]*$|^\[ERROR\] Failed to execute goal.*: Project contains Javadoc Warnings( -> \[Help [0-9]+\])?[[:space:]]*$'

# Removes from file $1 the warnings about missing documentation that javadoc
# and javac's doclint print, such as
#   /home/me/proj/src/main/java/Foo.java:42: warning: no @param for x
#     void bar(int x) {
#          ^
# that is, a warning "no comment", "no main description", "no @param",
# "no @param for ...", "no @return", "no @throws for ...", or "use of default
# constructor, which does not provide a comment", each with the source line
# and the line with a caret ("^") that follow it.  Each line can start with a
# log level, as in Maven's "[WARNING] void bar(int x) {".
#
# The output of builds that run in parallel, as Gradle's tasks do, can be
# interleaved line by line, so that lines of another build come between a
# warning and its source line, or between the source line and its caret line.
# A line is the source line of a warning if, ignoring leading and trailing
# whitespace, it is the line of the file that the warning names (a relative
# file name is relative to $toplevel), or if it directly follows the warning
# and a caret line directly follows it.  A caret line belongs to the earliest
# source line, found by its text, whose caret line has not yet appeared.  So
# when interleaved output holds both elided and other warnings, a caret line
# that is printed can be another warning's, in a different column.
#
# A count of the warnings, such as "22 warnings", is replaced by a count of
# the warnings that remain and of those that were elided, such as
# "2 warnings (and 20 about missing documentation, which are not shown)", or
# is removed if every warning that it counts was elided.  The warnings that a
# count counts are taken to be those that precede it and that no earlier count
# counted.  If those are more than the count, as when builds' output is
# interleaved, then the count is removed if all of them were elided, and is
# left unchanged otherwise.  But a count of 100, the number of warnings at
# which javadoc and javac stop by default, is never removed, and its
# replacement says that other warnings might not have been printed.
# Leaves the file unchanged if it cannot be rewritten.
elide_missing_doc_warnings() {
  # Each awk variable whose name ends in "_pool" is a number of warnings that
  # no count has counted yet.
  # A diagnostic whose file can be read expects a source line with known text:
  # tail_of[TEXT] diagnostics have expected TEXT, and head_of[TEXT] of them
  # have found it; elides[TEXT, I] is 1 if the Ith of them is elided.
  # The caret queue, caret_elide[caret_head..caret_tail], holds, for each
  # source line that was found by its text and whose caret line has not yet
  # appeared, 1 if that caret line is to be elided and 0 if it is to be
  # printed.
  if ELIDE_TOPLEVEL="${toplevel:-}" awk '
    function is_missing_doc_warning(line) {
      return line ~ /(^|: |^\[[A-Z]+\] )warning: (no (comment|main description|@return|@param|@param for .*|@throws for .*)|use of default constructor, which does not provide a comment)$/
    }
    function is_diagnostic(line) {
      return line ~ /: (warning|error): / || line ~ /^(\[[A-Z]+\] )?(warning|error): /
    }
    function is_warning(line) {
      return line ~ /: warning: / || line ~ /^(\[[A-Z]+\] )?warning: /
    }
    function is_caret(line) {
      return line ~ /^(\[[A-Z]+\] )?[ \t]*\^[ \t]*$/
    }
    function is_count(line) {
      return line ~ /^(\[[A-Z]+\] )?[0-9]+ warnings?$/
    }
    # Returns line, without its log level, leading whitespace, or trailing
    # whitespace.
    function trimmed(line) {
      sub(/^\[[A-Z]+\] /, "", line)
      sub(/^[ \t]+/, "", line)
      sub(/[ \t\r]+$/, "", line)
      return line
    }
    # Returns the nth line of the file named path, trimmed, or the empty
    # string if the file cannot be read or has fewer than n lines.
    function source_text(path, n,   line, i, result) {
      if (path !~ /^\// && toplevel != "") {
        path = toplevel "/" path
      }
      result = ""
      i = 0
      while ((getline line < path) > 0) {
        if (++i == n) {
          result = trimmed(line)
          break
        }
      }
      close(path)
      return result
    }
    # Records that the source line of the diagnostic on line is expected;
    # elide is 1 if the diagnostic is elided.  A diagnostic that is not elided
    # and that names no file expects no source line.
    function expect_source(line, elide,   text) {
      last_nr = 0
      last_text = ""
      sub(/^\[[A-Z]+\] /, "", line)
      if (match(line, /:[0-9]+: (warning|error): /)) {
        text = source_text(substr(line, 1, RSTART - 1), substr(line, RSTART + 1) + 0)
      } else if (!elide) {
        return
      }
      last_nr = NR
      last_elide = elide
      if (text != "") {
        last_text = text
        elides[text, ++tail_of[text]] = elide
      }
    }
    # Prints the count on the current line, rewritten as the comment of
    # elide_missing_doc_warnings describes, or prints nothing.
    function handle_count(   prefix, count, elided, kept) {
      match($0, /[0-9]+ warnings?$/)
      prefix = substr($0, 1, RSTART - 1)
      count = substr($0, RSTART) + 0
      if (elided_pool + kept_pool <= count) {
        elided = elided_pool
        kept = count - elided_pool
        elided_pool = 0
        kept_pool = 0
      } else if (kept_pool == 0) {
        elided = count
        kept = 0
        elided_pool -= count
      } else if (elided_pool == 0) {
        elided = 0
        kept_pool -= count
      } else {
        # Which of the warnings the count counts is unknown.
        elided = 0
        elided_pool = 0
        kept_pool = 0
      }
      if (elided == 0) {
        print
      } else if (kept > 0 || count == maxwarns) {
        printf "%s%d warning%s (and %d about missing documentation, which are not shown)", prefix, kept, (kept == 1 ? "" : "s"), elided
        if (count == maxwarns) {
          printf "; other warnings might not be printed, because javadoc and javac stop at %d unless given -Xmaxwarns", maxwarns
        }
        printf "\n"
      }
    }
    BEGIN {
      # The number of warnings at which javadoc and javac stop by default.
      maxwarns = 100
      toplevel = ENVIRON["ELIDE_TOPLEVEL"]
      caret_head = 1
      caret_tail = 0
    }
    # The previous line, held, directly followed an elided warning, and its
    # text is not that of any expected source line.  It is the source line of
    # the warning if this line is a caret line.
    holding {
      holding = 0
      if (is_caret($0)) {
        if (held_text != "" && tail_of[held_text] > head_of[held_text]) {
          tail_of[held_text]--
        }
        next
      }
      print held
    }
    # The previous line directly followed a diagnostic that is not elided, and
    # its text is not that of any expected source line.  If this line is a
    # caret line, it belongs to that diagnostic.
    printed_nr && printed_nr == NR - 1 && is_caret($0) {
      print
      next
    }
    is_missing_doc_warning($0) {
      elided_pool++
      expect_source($0, 1)
      next
    }
    is_caret($0) {
      if (caret_head <= caret_tail && caret_elide[caret_head++]) {
        next
      }
      print
      next
    }
    is_count($0) {
      handle_count()
      next
    }
    is_diagnostic($0) {
      if (is_warning($0)) {
        kept_pool++
      }
      expect_source($0, 0)
      print
      next
    }
    {
      text = trimmed($0)
      if (text != "" && tail_of[text] > head_of[text]) {
        elide = elides[text, ++head_of[text]]
        caret_elide[++caret_tail] = elide
        if (!elide) {
          print
        }
        next
      }
      if (last_nr && last_nr == NR - 1) {
        if (last_elide) {
          held = $0
          held_text = last_text
          holding = 1
          next
        }
        printed_nr = NR
      }
      print
    }
    END {
      if (holding) {
        print held
      }
    }
  ' "$1" > "$1.elided"; then
    mv -f -- "$1.elided" "$1"
  else
    rm -f -- "$1.elided"
  fi
}

# Elides, from each of the given files, the warnings about missing
# documentation, unless $output shows that warnings caused the build to fail.
# $output holds everything that the build printed, including the standard
# output to which Maven writes its warnings and errors.
elide_unless_warnings_failed() {
  if ! grep -q -E -e "$warnings_failure_regex" -- "$output" 2> /dev/null; then
    for elide_file; do
      elide_missing_doc_warnings "$elide_file"
    done
  fi
}

# When interrupted, print the output so far, which might show why the build
# was slow or stuck.  That includes a hang-up:  standard error might be a file
# rather than the terminal that hung up, and if it is that terminal, the write
# merely fails.  Each signal handler removes itself and the EXIT trap, and then
# re-raises the signal, so that this command dies of the signal.
# The shell runs a handler only after the build pipeline below finishes.  A
# Ctrl-C reaches the build too, so the build ends promptly.  But a SIGTERM sent
# to this command alone takes effect only once the build finishes.  Running the
# pipeline in the background and waiting for it would let the handler run at
# once, but the shell starts a background command with SIGINT ignored, so a
# Ctrl-C would no longer stop the build.

# Prints the output so far, removes the temporary directory, and dies of signal $1.
# shellcheck disable=SC2329 # Invoked by `trap`.
on_signal() {
  elide_unless_warnings_failed "$output"
  cat "$output" >&2
  rm -rf "$tmpdir"
  trap - "$1" EXIT
  kill -s "$1" "$$"
}
trap 'rm -rf "$tmpdir"' EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

printf '%s\n' "$running_message" > "$output"
# The builds' standard output is appended to $output, and their standard error
# goes through `tee`, which writes it to $errors and appends it to $output.
# Both are opened for appending, so that neither write overwrites the other.
# The order of lines in $output is exact only for writes that are separated in
# time, because a line of standard error passes through `tee`.  A single file
# descriptor for both would preserve the order exactly, but then this command
# could not tell whether the builds wrote to standard error.  A pipeline does
# not pass on the status of its first command in POSIX sh, so the status goes
# through $status_file.  `tee` ignores SIGHUP, SIGINT, and SIGTERM, so that
# after a hang-up, a Ctrl-C, or a SIGTERM sent to the whole process group, it
# still copies what the builds write to standard error as they end, rather than
# dying with that output unread in its pipe.  `tee` exits once the builds close
# their standard error, so ignoring these signals cannot leave it running.
{
  compile_project < /dev/null
  echo "$?" > "$status_file"
} 2>&1 >> "$output" | (
  trap '' HUP INT TERM
  exec tee "$errors"
) >> "$output"
build_status="$(cat "$status_file" 2> /dev/null)"
build_status="${build_status:-1}"

elide_unless_warnings_failed "$errors" "$output"
if [ "$build_status" != 0 ] || [ -s "$errors" ]; then
  cat "$output" >&2
fi
exit "$build_status"
