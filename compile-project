#!/bin/sh

# Compiles the project that contains the current or given directory.
#
# Supports Gradle, Maven, and Make projects.  If no buildfile is found
# at the top level, searches at (only) the next level down.
#
# Prints nothing unless a build fails, or writes to standard error, or no
# buildfile is found and ERR_IF_NO_BUILDFILE is set.  Then it prints, to
# standard error, the directory where it ran and the builds' standard output
# and standard error together, in the order in which the builds wrote them.
# That order is approximate:  a line of standard error written just before a
# line of standard output can appear after it.  And a program that buffers its
# standard output, as many programs do when it is not a terminal, can write it
# long after standard error that it wrote later.  The output is printed after
# the builds finish, or when this command is interrupted, not while they run.
# The builds' standard input is /dev/null, so a build that prompts for input
# fails rather than waiting for input with its prompt hidden.  If a build
# starts a background process that keeps standard error open, this command
# waits for that process to exit.
#
# The exit status is failure if any build fails, if <directory> is given
# but is not a directory, or if the top-level directory cannot be
# determined.  If no buildfile is found and ERR_IF_NO_BUILDFILE is set to
# a non-empty value, then the exit status is failure.
#
# Usage:
#   compile-project [--clean] [<directory>]
#
# If --clean is passed, then the project is cleaned before being compiled.
# If the clean fails, the project is not compiled and the exit status is failure.
# If variable GRADLE_ASSEMBLE_FLAGS is defined, it is passed to `gradlew assemble` or `gradle assemble`.
# If variable MVN_COMPILE_FLAGS is defined, it is passed to `mvnw compile` or `mvn compile`.
# If variable MAKE_FLAGS is defined, it is passed to `make`.
# If variable ERR_IF_NO_BUILDFILE is non-empty, the script fails if no buildfile is found.
#
# This command does not need to be run in the top-level directory of the project;
# it will discover the top-level directory on its own and run the command there.
# The top level is that of the git repository containing the current or given
# directory, or the directory itself if it is not within a git repository.

# TODO: Handle other build systems too, such as Ant.
# TODO: Have a list of per-directory or per-repository commands, to override the default.

# Git exports $GIT_DIR, $GIT_WORK_TREE, and $GIT_INDEX_FILE to hooks and to the
# commands run by `git rebase --exec`, `git bisect run`, and
# `git submodule foreach`.  The first two take precedence over the `-C`
# argument of `git`, so leaving them set would make this script compile
# whatever repository the caller happened to be working in, rather than the
# current or given directory.
#
# $GIT_INDEX_FILE names the index alone, which this script's own
# `rev-parse --show-toplevel` does not read, so unsetting it changes no answer
# here.  Unset it all the same:  the build command runs with this environment,
# and a build that consults git -- one that stamps a version from
# `git describe`, or a formatter that checks only what changed -- would read
# some other repository's index.  The three variables travel together, and a
# script that unsets two of them invites the reader to wonder about the third.
unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
# `cd` consults $CDPATH, so leaving it set would make `cd "$dir"` compile some
# other directory named "$dir" (and print the directory it chose to stdout).
CDPATH=''

CLEAN=""
if [ "$#" -ge 1 ]; then
  if [ "$1" = "--clean" ]; then
    CLEAN="$1"
    shift
  fi
fi

# SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

# Prints the top level of the git repository that contains directory $1.
# The exit status is 0 on success, 222 if $1 is not within a git repository, and
# 1 if git could not answer the question -- for example, because the repository
# is owned by another user, or has an unsupported format, or git is not
# installed.  In that case, git's diagnostic has been copied to stderr; the
# caller must not conclude that $1 is outside a repository.
git_toplevel() {
  # Run git twice, rather than capturing its standard output and standard error
  # together, so that a warning on standard error cannot be mistaken for part of
  # the directory name.  LC_ALL is set because the message is matched below.
  if git_toplevel_stderr="$(LC_ALL=C git -C "$1" rev-parse --show-toplevel 2>&1 > /dev/null)"; then
    git -C "$1" rev-parse --show-toplevel
    return 0
  fi
  case "${git_toplevel_stderr}" in
    *'not a git repository'*) return 222 ;;
  esac
  if [ -n "${git_toplevel_stderr}" ]; then
    printf '%s\n' "${git_toplevel_stderr}" >&2
  fi
  return 1
}

# $toplevel has no trailing "/" character, unless it is the root directory "/".
if [ "$#" -eq 0 ]; then
  toplevel="$(git_toplevel .)"
  case "$?" in
    0) running_message="Running ${SCRIPT_NAME} in $toplevel, called from $(pwd)" ;;
    222)
      toplevel="$(pwd)"
      running_message="Running ${SCRIPT_NAME} in $toplevel"
      ;;
    *) exit 1 ;;
  esac
elif [ "$#" -eq 1 ]; then
  if [ ! -d "$1" ]; then
    printf '%s: not a directory: %s\n' "${SCRIPT_NAME}" "$1" >&2
    exit 1
  fi
  toplevel="$(git_toplevel "$1")"
  case "$?" in
    0) running_message="Running ${SCRIPT_NAME} in $toplevel, called for $1" ;;
    222)
      # The directory is its own top level.  Make it absolute, so that later
      # messages and `cd` commands do not depend on the current directory.
      # This also removes any trailing "/" characters.
      if ! toplevel="$(cd -- "$1" && pwd)"; then
        exit 1
      fi
      running_message="Running ${SCRIPT_NAME} in $toplevel"
      ;;
    *) exit 1 ;;
  esac
else
  printf '%s\n' "Usage: ${SCRIPT_NAME} [--clean] [<directory>]" >&2
  exit 1
fi

# Sets $buildfile_found_here to 1 if a buildfile was found in directory $1, or to 0
# if none was.  Returns the status of the build; or, if --clean was given and the
# clean failed, the status of the clean, without building; or 0 if no buildfile
# was found.
# The "was a buildfile found?" answer is a variable rather than a reserved exit
# status, because every exit status is one that a build command itself might return.
compile_in_directory() {
  dir="$1"
  buildfile_found_here=1

  if [ -f "$dir/gradlew" ]; then
    if [ -n "$CLEAN" ]; then
      "$dir/gradlew" --project-dir "$dir" clean -q < /dev/null || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    "$dir/gradlew" --project-dir "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS} < /dev/null
    return $?
  elif [ -f "$dir/build.gradle" ]; then
    if [ -n "$CLEAN" ]; then
      gradle --project-dir "$dir" clean -q < /dev/null || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    gradle --project-dir "$dir" assemble -q ${GRADLE_ASSEMBLE_FLAGS} < /dev/null
    return $?
  elif [ -f "$dir/mvnw" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && ./mvnw -q clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && ./mvnw -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/pom.xml" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && mvn -q clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && mvn -q compile ${MVN_COMPILE_FLAGS})
    return $?
  elif [ -f "$dir/Makefile" ]; then
    if [ -n "$CLEAN" ]; then
      (cd "$dir" && make clean) || return $?
    fi
    # shellcheck disable=SC2086 # Word splitting is desirable here.
    (cd "$dir" && make ${MAKE_FLAGS})
    return $?
  else
    # No buildfile was found.
    buildfile_found_here=0
    return 0
  fi
}

# Compiles the project in $toplevel or, if $toplevel has no buildfile, in
# each subdirectory of $toplevel that has one, stopping at the first build that
# fails.  Returns the status of that build, or 0 if no build fails.  If no
# buildfile is found and ERR_IF_NO_BUILDFILE is non-empty, prints a diagnostic
# and returns 1.
compile_project() {
  compile_in_directory "$toplevel"
  result=$?
  if [ "$buildfile_found_here" = 1 ]; then
    return $result
  fi
  buildfile_found=0
  for subdir in "$toplevel"/*/; do
    compile_in_directory "$subdir"
    result=$?
    if [ "$buildfile_found_here" = 0 ]; then
      continue
    fi
    buildfile_found=1
    if [ "$result" -ne 0 ]; then
      return $result
    fi
  done
  if [ "$buildfile_found" = 0 ] && [ -n "$ERR_IF_NO_BUILDFILE" ]; then
    printf '%s\n' "${SCRIPT_NAME} did nothing in $toplevel or its subdirectories" >&2
    return 1
  fi
  return 0
}

if ! tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/compile-project.XXXXXX")" || [ -z "$tmpdir" ]; then
  printf '%s\n' "${SCRIPT_NAME}: cannot create a temporary directory" >&2
  exit 1
fi
# The builds' standard output and standard error, together.
output="$tmpdir/output"
# The builds' standard error alone.
errors="$tmpdir/errors"
# The exit status of compile_project.
status_file="$tmpdir/status"

# When interrupted, print the output so far, which might show why the build
# was slow or stuck.  Each signal handler removes itself and the EXIT trap,
# and then re-raises the signal, so that this command dies of the signal.
# The shell runs a handler only after the build pipeline below finishes.  A
# Ctrl-C reaches the build too, so the build ends promptly.  But a SIGTERM sent
# to this command alone takes effect only once the build finishes.  Running the
# pipeline in the background and waiting for it would let the handler run at
# once, but the shell starts a background command with SIGINT ignored, so a
# Ctrl-C would no longer stop the build.
trap 'rm -rf "$tmpdir"' EXIT
trap 'rm -rf "$tmpdir"; trap - HUP EXIT; kill -s HUP "$$"' HUP
trap 'cat "$output" >&2; rm -rf "$tmpdir"; trap - INT EXIT; kill -s INT "$$"' INT
trap 'cat "$output" >&2; rm -rf "$tmpdir"; trap - TERM EXIT; kill -s TERM "$$"' TERM

printf '%s\n' "$running_message" > "$output"
# The builds' standard output is appended to $output, and their standard error
# goes through `tee`, which writes it to $errors and appends it to $output.
# Both are opened for appending, so that neither write overwrites the other.
# The order of lines in $output is exact only for writes that are separated in
# time, because a line of standard error passes through `tee`.  A single file
# descriptor for both would preserve the order exactly, but then this command
# could not tell whether the builds wrote to standard error.  A pipeline does
# not pass on the status of its first command in POSIX sh, so the status goes
# through $status_file.  `tee` ignores SIGINT, so that after a Ctrl-C, it still
# copies what the builds write to standard error as they end.
{
  compile_project < /dev/null
  echo "$?" > "$status_file"
} 2>&1 >> "$output" | (
  trap '' INT
  exec tee "$errors"
) >> "$output"
build_status="$(cat "$status_file" 2> /dev/null)"
build_status="${build_status:-1}"

if [ "$build_status" != 0 ] || [ -s "$errors" ]; then
  cat "$output" >&2
fi
exit "$build_status"
