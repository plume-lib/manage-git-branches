#!/bin/sh

# This command lists directories named *-branch-* that are working trees of
# branches that have been deleted in the remote repository.  Only directories
# below the current directory are considered.  Newly created branches are not
# listed, only branches that have been deleted in the remote (for example,
# because a pull request has been merged).
# Also lists directories containing nothing but a `.project` file.
#
# A directory that another live worktree depends on is never listed, even when
# its own branch was deleted:  deleting it would take out a working tree that
# the user never named.  Such a directory is reported on standard error
# instead.
#
# Usage:
#   git-orphaned-branches [--print0]
#   git-orphaned-branches --print0 | xargs -0 rm -rf
#
# With --print0 (or -0), the directories are separated by a NUL character
# rather than by a newline, which is safe for directory names that contain
# whitespace, a newline, or a glob metacharacter.  Without it, a directory
# name that contains a newline is indistinguishable from two directory names.
#
# Usually, a remote branch disappears because its PR was merged.  It
# is conceivable that the branch has local commits that were never
# pushed, in which case deleting the branch could lose work.

# DEBUG=1

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other scripts even when this script
# is invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

# If non-empty, separate the output directories by NUL rather than by newline.
print0=""
if [ "$#" -ge 1 ] && { [ "$1" = "--print0" ] || [ "$1" = "-0" ]; }; then
  print0="$1"
  shift
fi

status=0

if [ "$#" -ne 0 ]; then
  echo "Usage: ${SCRIPT_NAME} [--print0]" >&2
  exit 1
fi

# Prints its argument, followed by a NUL character if --print0 was given and by
# a newline otherwise.
print_dir() {
  if [ -n "$print0" ]; then
    printf '%s\0' "$1"
  else
    printf '%s\n' "$1"
  fi
}

# Prints the absolute path of directory $1, with symbolic links resolved.
# `realpath` would be simpler, but POSIX added it only in 2024 and some systems
# still lack it, whereas `cd` and `pwd -P` are portable.
absolute_path() {
  (CDPATH='' cd -- "$1" && pwd -P)
}

# Returns 0 (true) if directory $1 contains no entry other than `.project`.
# `find "$1" -mindepth 1 -maxdepth 1` would be simpler, but the `-mindepth` and
# `-maxdepth` options are GNU extensions that POSIX `find` does not support.
only_dot_project() {
  # In a directory that cannot be listed (but can be searched, such as one with
  # mode 711), every glob below expands to nothing, which is indistinguishable
  # from an empty directory.  Do not claim that such a directory is empty.
  if [ ! -r "$1" ]; then
    return 1
  fi
  for entry in "$1"/* "$1"/.*; do
    case "${entry##*/}" in
      '.' | '..' | '.project') continue ;;
    esac
    # When a pattern matches nothing, the shell leaves it unexpanded.
    if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
      continue
    fi
    return 1
  done
  return 0
}

# Returns 0 (true) if directory $1 is the top level of a working tree.
#
# Ask git rather than testing whether `$1/.git` is a directory.  A submodule's
# working tree and a linked worktree each have a `.git` *file* that names a
# git directory elsewhere, so the directory test classified them as
# non-repositories:  a worktree whose branch was deleted in the remote was
# checked only for a lone `.project` file and was silently ignored.
# `is-deleted-branch` answers correctly for both kinds of working tree.
#
# Require the *top level*, which is what `is-deleted-branch` answers about and
# what `git -C "$1" rev-parse` alone does not establish:  every directory
# within a working tree satisfies that.  A subdirectory is not a branch
# directory, and it can still be a `.project`-only leftover that the other
# branch of `check_directory` reports.
is_working_tree() {
  is_working_tree_toplevel="$(git -C "$1" rev-parse --show-toplevel 2> /dev/null)" \
    || return 1
  # A bare repository has no working tree.
  if [ -z "${is_working_tree_toplevel}" ]; then
    return 1
  fi
  is_working_tree_dir="$(absolute_path "$1")" || return 1
  is_working_tree_top="$(absolute_path "${is_working_tree_toplevel}")" || return 1
  [ "${is_working_tree_dir}" = "${is_working_tree_top}" ]
}

# Prints the pathname of one linked worktree that depends on the repository in
# directory $1, or nothing if none does.
#
# A linked worktree's `.git` is a file that points into the repository of the
# main working tree, so removing that main working tree breaks every linked
# worktree of it -- a working tree that the user never named, and that may
# hold unpushed work.  This command's output is fed to `rm -rf`, so such a
# directory must not appear in it however orphaned its own branch is.
#
# `git worktree list --porcelain` prints the main working tree first and each
# linked worktree after it, one `worktree PATH` line per entry.  A pathname
# that contains a newline cannot be represented in that format; git offers
# `-z` for that, which needs git 2.36, and a newline in the pathname of a
# repository is pathological.
#
# A registration whose directory is gone protects nothing, because removing $1
# cannot break a working tree that does not exist.
live_dependent_worktree() {
  live_dependent_worktree_dir="$(absolute_path "$1")" || return 0
  git -C "$1" worktree list --porcelain 2> /dev/null \
    | sed -n 's/^worktree //p' \
    | (
      # Only the main working tree holds the repository that the others
      # depend on, so a linked worktree is at no risk of taking one down.
      IFS= read -r live_dependent_worktree_main || exit 0
      live_dependent_worktree_main_absolute="$(absolute_path "${live_dependent_worktree_main}")" \
        || exit 0
      if [ "${live_dependent_worktree_main_absolute}" != "${live_dependent_worktree_dir}" ]; then
        exit 0
      fi
      while IFS= read -r live_dependent_worktree_linked; do
        if [ -d "${live_dependent_worktree_linked}" ]; then
          printf '%s\n' "${live_dependent_worktree_linked}"
          exit 0
        fi
      done
      exit 0
    )
}

# Reports directory $1, whose name matches `*-branch-*`, if its branch was
# deleted in the remote or if it holds nothing but a `.project` file.
check_directory() {
  dir="$1"
  if [ -n "$DEBUG" ]; then echo "checking: $dir"; fi
  if is_working_tree "$dir"; then
    # It is the top level of a working tree.

    # If the branch was deleted in the remote, print the directory name.
    # Only status 0 from `is-deleted-branch` means "the branch was deleted".
    # Statuses 1, 2, and 3 are answers of "no" or "cannot tell", each of which
    # `is-deleted-branch` has already explained if it is worth explaining.  Any
    # other status means that `is-deleted-branch` could not run, which must not
    # be silently reported as "there is nothing to delete".
    # Redirect stdin from /dev/null, because `is-deleted-branch` runs `git`,
    # which runs `ssh`, and this script must not stop to await input.
    "${SCRIPT_DIR}"/is-deleted-branch "$dir" < /dev/null
    is_deleted_status=$?
    case "${is_deleted_status}" in
      # `cd` prints its own diagnostic on failure.
      0)
        if ! dir_absolute="$(absolute_path "$dir")"; then
          status=1
        else
          dependent_worktree="$(live_dependent_worktree "$dir")"
          if [ -n "${dependent_worktree}" ]; then
            # Removing this directory would remove the repository that the
            # other worktree's `.git` file points into.  Say so rather than
            # saying nothing:  the branch really was deleted, and the user is
            # entitled to know why this command is not offering the
            # directory for deletion.
            echo "${SCRIPT_NAME}: not listing ${dir_absolute}, which hosts the worktree ${dependent_worktree}" >&2
          else
            print_dir "${dir_absolute}"
          fi
        fi
        ;;
      1 | 2 | 3) ;;
      *)
        echo "${SCRIPT_NAME}: ${SCRIPT_DIR}/is-deleted-branch failed with status ${is_deleted_status} on: $dir" >&2
        status=1
        ;;
    esac
    # Do not prune.  Doing so makes it impossible to distinguish new from deleted branches.
    # git -C "$dir" remote prune origin 2>&1 > /dev/null
  else
    # It is not the top level of a working tree.
    if [ -f "$dir/.project" ] && only_dot_project "$dir"; then
      # It has only the `.project` file and no other content.
      # `cd` prints its own diagnostic on failure.
      if dir_absolute="$(absolute_path "$dir")"; then
        print_dir "${dir_absolute}"
      else
        status=1
      fi
    fi
  fi
}

# Examines directory $1 and every directory below it.
#
# The entries that remain to be examined are held in the positional
# parameters, which a shell makes local to a function call:  the recursive call
# below gets positional parameters of its own, and this call's are intact when
# it returns, so the recursion needs no variable that it could clobber.  `find`
# would be simpler, but `find` communicates through newline-separated text,
# which cannot represent a file name that contains a newline, whereas the
# positional parameters can hold any file name.
#
# A single worklist in the positional parameters of the main shell, in place of
# this recursion, would cost more:  pushing a directory's entries onto the
# worklist rewrites the whole worklist, which costs O(n) for each of the n
# entries of one directory and so is quadratic in a large one -- seconds rather
# than milliseconds for a directory of a few thousand entries, such as a
# `node_modules` or a package cache anywhere below the current directory.
examine_directory() {
  set -- "$1"/* "$1"/.*
  while [ "$#" -gt 0 ]; do
    case "${1##*/}" in
      '.' | '..')
        shift
        continue
        ;;
    esac
    # A pattern that matched nothing, which the shell leaves unexpanded, names
    # no directory, so this test skips it as well.  A symbolic link is not
    # followed, which is what `find` does by default and which prevents an
    # endless descent through a link to an ancestor.
    if [ -d "$1" ] && [ ! -L "$1" ]; then
      case "${1##*/}" in
        *-branch-*) check_directory "$1" ;;
      esac
      # Examine every directory's entries, even those of a directory that is
      # itself named `*-branch-*`, because such a directory may contain
      # another.
      examine_directory "$1"
    fi
    shift
  done
}

examine_directory .

exit "${status}"
