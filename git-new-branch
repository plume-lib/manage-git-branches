#!/bin/sh

# Creates a new branch of the current repository, and checks it out in a new
# sibling directory named REPONAME-branch-NEWBRANCHNAME/.
#
# Usage:
#   git-new-branch [--clean | --copy] [--verbose] [--allow-upstream] NEWBRANCHNAME
#   git-new-branch [--allow-upstream] ORG:NEWBRANCHNAME
#   git-new-branch -h | --help
#
# The new branch starts at the current commit, after a `git pull` of the
# current branch.  If the current branch has the name of the upstream
# repository's default branch, and that default branch is a fast-forward of
# the current commit (as for a fork's `master` that lags behind
# `upstream/master`) then the current branch is fast-forwarded to the default
# branch's latest commit, and the new branch starts there instead.  With
# `--clean`, the new branch starts there even if the current branch's
# uncommitted changes prevent the fast-forward.  This command creates no merge
# commit, though the `git pull` can.
#
# The new directory is:
#   (default)  a linked worktree of the current repository, made by
#              `git worktree add`, so that it shares the repository's object
#              store rather than holding a copy of it.  Its contents are the
#              same as the current directory's, including uncommitted
#              changes, staged changes, untracked files, and ignored files
#              such as build output, except for nested worktrees and some
#              build output that refers to the current directory.
#   --clean    a linked worktree that holds a clean checkout of the new
#              branch and nothing else.  It is the cheapest mode, in both
#              time and disk space, for starting fresh work.
#   --copy     a copy of the whole current directory, `.git` included, with
#              the same exceptions as the default mode, so it is an
#              independent clone that shares nothing with the current
#              repository.
#
# With `--verbose`, the default mode and `--copy` also say how many generated
# files they deleted from the new directory.
#
# A working tree that has submodules gets `--copy` automatically, and
# `--clean` is refused when the current commit has submodules.
#
# With a slug ORG:NEWBRANCHNAME, such as `mernst:feature`, the new branch is
# made in the clone of ORG's fork, PROJECT-fork-ORG, rather than in the
# current repository.  Its directory is PROJECT-fork-ORG-branch-NEWBRANCHNAME,
# a `--clean` worktree, and the new branch starts instead at the commit of
# PROJECT-fork-ORG, after a `git pull` there.  As for `git-push-to`, ORG "-"
# stands for the clone PROJECT itself, so `-:NEWBRANCHNAME` makes
# PROJECT-branch-NEWBRANCHNAME.
#
# In a clone of an upstream repository whose fork is in a sibling directory,
# this command refuses, unless `--allow-upstream` is given, because a branch
# for a pull request belongs in the fork.
#
# Every effect is local:  this command never contacts a remote except to
# read from it, and in particular it does not push the new branch.  It also
# gives the new branch no upstream branch, even under
# `branch.autoSetupMerge=always`; `git-push-to` and `git-pull-from` require
# one.  The first `git push` of the new branch sets its upstream branch if
# `push.autoSetupRemote` is true (git 2.37 or later) and `push.default` is
# "simple" (the default), "upstream", or "current"; otherwise,
# `git push -u REMOTE NEWBRANCHNAME` does.  Nor does this command build.
#
# Details:
#
# `find_upstream_commit` says what the upstream repository is, when it is
# fetched, and when the new branch starts at its default branch.
# `fast_forward_upstream` says how the current branch is fast-forwarded, and
# when it is not.
#
# A slug ORG:NEWBRANCHNAME acts as `git-new-branch --clean NEWBRANCHNAME` does
# when run in PROJECT-fork-ORG, a sibling of the current repository's main
# working tree, so the result is the same whichever of the project's
# directories it is run in:  PROJECT, PROJECT-fork-OTHERORG, a branch directory
# of either, or a worktree of any of those.  The new branch starts on whatever
# branch PROJECT-fork-ORG has checked out, not at the current directory's
# commit.  If the pull there cannot fast-forward, it changes nothing, and the
# new branch starts at PROJECT-fork-ORG's current commit, or at the upstream
# repository's default branch as described above.  The new directory
# holds none of the current directory's changes.  `--clean` is accepted with a
# slug but has no effect.  `--copy` cannot be used with a slug, and neither can
# an ORG that would make directory names ambiguous:  one that is "branch",
# starts with "branch-" or "fork-", ends with "-branch", or contains "-branch-"
# or "-fork-".
#
# The default mode and `--copy` copy build output, which can still refer to
# the current directory's files.  These modes delete such files that a tool
# presumably regenerates, and warn about the others.  They say which of the
# directories that they deleted files from CMake or autotools configured,
# because such a directory needs to be reconfigured.  With `--verbose`, they
# also say how many files they deleted and from which directories.
# `delete_or_warn_about_old_pathname` says which files those are, and
# `delete_stale_build_output` says which of them are deleted.
#
# The default mode and `--copy` leave out a worktree of this repository that
# is nested in the current directory, such as an ignored one in
# `.claude/worktrees/`, because its copy would share that worktree's HEAD and
# index; they say which ones they left out.
#
# The documentation of `choose_mode_for_submodules` says why submodules change
# the mode or prevent `--clean`.  A repository that has no
# commit is refused, because there is nothing to branch from.  Every mode but
# `--clean` is refused while a merge, cherry-pick, revert, or rebase is in
# progress, because the new directory would get the operation's staged
# changes without the operation itself.
#
# A clone of an upstream repository, for which the user has a fork, is
# refused unless `--allow-upstream` is given, because a branch for a pull
# request belongs in the fork.  The clone is such a clone if a sibling
# directory PROJECT-fork-ORG... (where the current directory is PROJECT or
# PROJECT-fork-OTHER, either of which can be followed by -branch-BRANCH) has a
# remote named "upstream" that is the repository that the new branch would be
# pushed to.  If git's configuration sets `github.user`, only a fork whose ORG
# is that user counts, so that another organization's fork of the same
# upstream repository does not.  The refusal names the fork's directory, in
# which to run this command instead.
#
# In the worktree modes, this script writes into the current repository:  it
# creates the new branch there and registers the new worktree in its `.git`.
# If the current repository is a branch directory's, REPONAME-branch-OTHER/,
# they are created instead in the sibling REPONAME/ that `main_clone_for`
# chooses, if there is one, so that the new worktree does not prevent the
# removal of REPONAME-branch-OTHER/.  That happens only if REPONAME/ has no
# branch of the new branch's name, and if the commit and staged files that the
# new worktree needs can be copied there.  Then the test for a branch of the
# same name on a remote consults REPONAME/'s remotes, because REPONAME/'s
# configuration says where the new branch would be pushed.
#
# Remove a worktree that this script created with
# `git-remove-branch-directory`, and move it with `git worktree move`, never
# with file-system commands; the "Worktrees" section of README.md says why.
# This applies to the default mode and `--clean`, not to `--copy`, whose
# directory is an independent clone.
#
# This command requires git 2.31 or later, and its default mode requires git
# 2.36 or later in a sparse checkout or with per-worktree configuration.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.  Do this
# before the `cd` below, because a relative pathname in $0 is relative to the
# directory that the caller ran this script from.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

# Without this, git commands that this script runs in the new directory would
# act on the current repository instead.  For example, `git worktree add` would
# write the new worktree's index over the file that $GIT_INDEX_FILE names,
# discarding the changes that are staged there.
unset_git_location_variables

usage() {
  echo "Usage: ${SCRIPT_NAME} [--clean | --copy] [--verbose] [--allow-upstream] NEWBRANCHNAME" >&2
  echo "   or: ${SCRIPT_NAME} [--allow-upstream] ORG:NEWBRANCHNAME" >&2
  echo "Run \`${SCRIPT_NAME} --help\` for more information." >&2
}

# Usage: print_synopsis
# Prints the synopsis at the top of this file, without the comment characters.
# The synopsis is the part of the first comment block, after the shebang line,
# that precedes the line "# Details:".  Reading it from this file keeps
# `--help` and the file's documentation from disagreeing.  A blank line is
# printed only between lines that are not blank, so that the output neither
# begins nor ends with one.  Prints nothing, and fails, if this file has no
# line "# Details:" in a comment block.
print_synopsis() {
  awk '
    NR == 1 { next }
    !/^#/ {
      text = ""
      blanks = 0
      next
    }
    $0 == "# Details:" {
      found = 1
      exit
    }
    {
      sub(/^# ?/, "")
      if ($0 == "") {
        blanks++
        next
      }
      if (text != "") {
        for (; blanks > 0; blanks--) text = text "\n"
      }
      blanks = 0
      text = text $0 "\n"
    }
    END {
      if (!found) exit 1
      printf "%s", text
    }' "${script_path}"
}

# `--help` and `-h` print the synopsis wherever they appear before `--`, even
# after the branch name, where the loop below stops looking for options.
for arg in "$@"; do
  case "${arg}" in
    --) break ;;
    -h | --help)
      if ! print_synopsis; then
        echo "${SCRIPT_NAME}: ERROR: cannot find the synopsis in ${script_path}" >&2
        exit 1
      fi
      exit
      ;;
  esac
done

# The mode:  "worktree" (the default), "clean", or "copy".  Selected on once,
# where the three implementations diverge, so that every check before that
# point is common to all three.
MODE='worktree'
# "yes" if --verbose was given, and "no" otherwise.
VERBOSE='no'
ALLOW_UPSTREAM=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --allow-upstream) ALLOW_UPSTREAM=1 ;;
    --clean | --copy)
      # The two ask for opposite things, so there is no sensible resolution.
      if [ "${MODE}" != 'worktree' ] && [ "${MODE}" != "${1#--}" ]; then
        echo "${SCRIPT_NAME}: --clean and --copy cannot be used together" >&2
        usage
        exit 1
      fi
      MODE="${1#--}"
      ;;
    --verbose) VERBOSE='yes' ;;
    --)
      shift
      break
      ;;
    # A slug, whose ORG can start with "-".
    *:*) break ;;
    -?*)
      # A typo such as `--cleann` must not silently create a branch of that
      # name.
      echo "${SCRIPT_NAME}: unrecognized option: $1" >&2
      usage
      exit 1
      ;;
    *) break ;;
  esac
  shift
done
if [ "$#" -ne 1 ]; then
  usage
  exit 1
fi

# This command needs nothing that git 2.31 added, but the worktrees that it
# makes are safely removed only by `git-remove-branch-directory`, which needs
# git 2.31.  Making a worktree that cannot be removed safely would be worse
# than refusing to make it.
require_git 31

# A slug ORG:NEWBRANCHNAME makes the branch in the clone of ORG's fork, as if
# this script had been run with `--clean NEWBRANCHNAME` in that clone, so the
# result does not depend on which of the project's directories it is run in.
# Git forbids ":" in a branch name, so an argument that contains one is a
# slug.
#
# ${SLUG_CLONE} is the clone that the slug names, or is empty if the argument
# is not a slug.
SLUG_CLONE=''
case "$1" in
  *:*)
    # This sets ${slug_org} and ${slug_branch}.
    if ! check_slug_org "$1"; then
      usage
      exit 1
    fi
    # Reject a bad branch name, such as one that contains another ":" or
    # starts with "-", before the `git pull` in the fork's clone and the
    # query to its remote, rather than when the branch is created.  A name
    # that `--branch` rewrites, such as "@{-1}", is a reference to a branch
    # rather than a new name.
    if [ -z "${slug_branch}" ] \
      || [ "$(git check-ref-format --branch "${slug_branch}" 2> /dev/null)" != "${slug_branch}" ]; then
      echo "${SCRIPT_NAME}: ERROR: not a valid branch name: ${slug_branch}" >&2
      usage
      exit 1
    fi
    if [ "${MODE}" = 'copy' ]; then
      echo "${SCRIPT_NAME}: ERROR: --copy cannot be used with a slug, which always makes a clean worktree" >&2
      usage
      exit 1
    fi
    MODE='clean'
    if ! SLUG_TOPLEVEL="$(git rev-parse --show-toplevel 2> /dev/null)" \
      || [ -z "${SLUG_TOPLEVEL}" ]; then
      echo "${SCRIPT_NAME}: ERROR: a slug must be given in a working tree of the project, such as PROJECT, PROJECT-fork-ORG, or one of their branch directories" >&2
      exit 1
    fi
    # The project's directories are named PROJECT, PROJECT-fork-ORG, and each
    # of those followed by -branch-BRANCH, side by side.  A linked worktree
    # might lie elsewhere, as in PROJECT/.claude/worktrees/NAME, so the names
    # are those of its main working tree, which holds the `.git` directory.
    # A bare repository, or a git directory outside its working tree, has no
    # main working tree that this naming convention could describe, so then
    # they are those of the current working tree.
    SLUG_MAIN="$(main_working_tree)" || SLUG_MAIN="${SLUG_TOPLEVEL}"
    SLUG_MAIN_NAME="$(basename -- "${SLUG_MAIN}")"
    parse_clone_name "${SLUG_MAIN_NAME%%-branch-*}"
    SLUG_PROJECT="${clone_project}"
    if [ "${slug_org}" = '-' ]; then
      SLUG_CLONE="$(dirname -- "${SLUG_MAIN}")/${SLUG_PROJECT}"
      SLUG_CLONE_DESCRIPTION="clone of ${SLUG_PROJECT}"
    else
      SLUG_CLONE="$(dirname -- "${SLUG_MAIN}")/${SLUG_PROJECT}-fork-${slug_org}"
      SLUG_CLONE_DESCRIPTION="clone of ${slug_org}'s fork of ${SLUG_PROJECT}"
    fi
    if [ ! -d "${SLUG_CLONE}" ]; then
      echo "${SCRIPT_NAME}: ERROR: there is no ${SLUG_CLONE_DESCRIPTION}:  directory does not exist: ${SLUG_CLONE}" >&2
      exit 1
    fi
    # A directory that is not the top level of a working tree would make the
    # branch in whatever repository contains it.  Both pathnames are
    # canonicalized, because git can spell a pathname differently than
    # `pwd -P` does, as Git for Windows does.
    if ! SLUG_CLONE_REAL="$(physical_path "${SLUG_CLONE}")" \
      || [ -z "${SLUG_CLONE_REAL}" ]; then
      echo "${SCRIPT_NAME}: ERROR: cannot canonicalize: ${SLUG_CLONE}" >&2
      exit 1
    fi
    if ! SLUG_CLONE_TOPLEVEL="$(git -C "${SLUG_CLONE}" rev-parse --show-toplevel 2> /dev/null)" \
      || [ -z "${SLUG_CLONE_TOPLEVEL}" ] \
      || [ "$(physical_path "${SLUG_CLONE_TOPLEVEL}" 2> /dev/null)" != "${SLUG_CLONE_REAL}" ]; then
      echo "${SCRIPT_NAME}: ERROR: not the top level of a working tree: ${SLUG_CLONE}" >&2
      exit 1
    fi
    if ! cd -- "${SLUG_CLONE}"; then
      echo "${SCRIPT_NAME}: ERROR: cannot cd to ${SLUG_CLONE}" >&2
      exit 1
    fi
    set -- "${slug_branch}"
    ;;
esac
BRANCHNAME="$1"

trap_branch_cleanup

# Capture the top level first: under a POSIX `sh` (e.g., dash), `cd ""` succeeds
# as a no-op, so testing `cd "$(...)"` directly would not catch an empty result.
if ! TOPLEVEL="$(git rev-parse --show-toplevel 2> /dev/null)" || [ -z "${TOPLEVEL}" ]; then
  echo "${SCRIPT_NAME}: Cannot determine top-level directory of git repository" >&2
  git rev-parse --show-toplevel >&2
  exit 1
fi
# ${TOPLEVEL} has every symbolic link resolved.  ${LOGICAL_TOPLEVEL} is the
# top level's pathname through the symbolic links in the current directory's
# logical pathname, which is the pathname that a build usually records.  It is
# ${TOPLEVEL} when the two do not name the same directory, as when the
# current directory was reached through a symbolic link inside the working
# tree.
LOGICAL_TOPLEVEL="$(cd -- "./$(git rev-parse --show-cdup)" && pwd)" || LOGICAL_TOPLEVEL=''
if [ -z "${LOGICAL_TOPLEVEL}" ] \
  || [ "$(cd -- "${LOGICAL_TOPLEVEL}" && pwd -P)" != "${TOPLEVEL}" ]; then
  LOGICAL_TOPLEVEL="${TOPLEVEL}"
fi
if ! cd "${TOPLEVEL}"; then
  echo "${SCRIPT_NAME}: Cannot cd to top-level directory: ${TOPLEVEL}" >&2
  exit 1
fi

# Git does not support a submodule in more than one worktree:  a copied
# submodule's `.git` file does not resolve from a linked worktree, which makes
# every git command there fail, and the repair would give both worktrees one
# submodule checkout, with one HEAD and one index.  So a working tree with
# submodules gets the full copy that `--copy` makes, which is an independent
# clone.  `--clean` is refused rather than given a worktree whose submodules
# are empty, because the only way to populate them leads to that shared
# checkout.
#
# The question is whether the new worktree would hold a submodule:  the
# default mode reproduces this working tree's index, and `--clean` checks out
# the current commit.  The `git pull` below can change both, so the question
# is asked again after it; asking it now as well reports a refusal before the
# pull, and lets the tests that depend on the mode precede the pull too.
choose_mode_for_submodules() {
  case "${MODE}" in
    clean)
      if has_gitlinks HEAD; then
        echo "${SCRIPT_NAME}: ERROR: the new branch would be a worktree, and the current commit of ${TOPLEVEL} has submodules, which a worktree cannot hold." >&2
        echo "${SCRIPT_NAME}: \`${SCRIPT_NAME} --copy ${BRANCHNAME}\` works in ${TOPLEVEL}, but it copies that whole directory, including .git and its uncommitted changes." >&2
        exit 1
      fi
      ;;
    worktree)
      if has_gitlinks; then
        note_copy_for_submodules 'this working tree'
        MODE='copy'
      fi
      ;;
  esac
}
choose_mode_for_submodules

# The default mode copies this working tree's index, whose skip-worktree bits
# a sparse checkout sets according to its patterns, which lie in this working
# tree's own git directory, as does its per-worktree configuration.  Git 2.36
# and later give the new worktree both, in `git worktree add`; with an older
# git, the new worktree would have the index without the patterns that it
# depends on.
if [ "${MODE}" = 'worktree' ] \
  && { [ "$(git config --bool core.sparseCheckout)" = 'true' ] \
    || [ "$(git config --bool extensions.worktreeConfig)" = 'true' ]; }; then
  require_git 36 'for a sparse checkout or per-worktree configuration, unless given --clean or --copy'
fi

# Refuse a working tree that does not hold its own `.git` directory, before
# anything expensive happens:  before the `git pull`, before any query to a
# remote, and before the copy.  `check_git_dir_is_directory` explains why.  The
# worktree modes do not copy `.git`, so they accept a linked worktree.  The
# test is of the mode that will actually run, which in a working tree with
# submodules is the copy.
check_git_dir_for_mode() {
  if [ "${MODE}" = 'copy' ]; then
    check_git_dir_accept=''
  else
    check_git_dir_accept='linked-worktree'
  fi
  if ! check_git_dir_is_directory "${TOPLEVEL}" "${check_git_dir_accept}"; then
    exit 1
  fi
}
check_git_dir_for_mode

# The default mode and `--copy` carry this working tree's index into the new
# directory, but not the state of an operation in progress:  the default mode
# does not copy this working tree's git directory, where that state lies, and
# the `git checkout -b` of `--copy` deletes it.  An index that holds a merge's
# resolved result would arrive without the merge, so a commit in the new
# directory would be an ordinary commit that silently includes the other
# side's changes.  `--clean` carries neither.
if [ "${MODE}" != 'clean' ]; then
  for state_file in MERGE_HEAD:merge CHERRY_PICK_HEAD:cherry-pick \
    REVERT_HEAD:revert rebase-merge:rebase rebase-apply:rebase; do
    if ! state_path="$(git rev-parse --git-path "${state_file%%:*}")" \
      || [ -z "${state_path}" ]; then
      echo "${SCRIPT_NAME}: ERROR: cannot determine the git directory of ${TOPLEVEL}" >&2
      exit 1
    fi
    if [ -e "${state_path}" ]; then
      echo "${SCRIPT_NAME}: ERROR: a ${state_file#*:} is in progress in ${TOPLEVEL}, and the new worktree would get its staged changes without the ${state_file#*:} itself." >&2
      echo "${SCRIPT_NAME}: Conclude or abort the ${state_file#*:} first, or use --clean, which carries no changes." >&2
      exit 1
    fi
  done
fi

REPO=$(basename "$(pwd)")
BRANCHNOSLASH="$(branch_dir_name "${BRANCHNAME}")"
# Canonicalize the parent directory, because ${BRANCHDIR} does not exist yet.
if ! PARENTDIR="$(realpath ..)" || [ -z "${PARENTDIR}" ]; then
  echo "${SCRIPT_NAME}: Cannot canonicalize the parent directory of $(pwd)" >&2
  exit 1
fi
BRANCHDIR="${PARENTDIR%/}/${REPO%%-branch-*}-branch-${BRANCHNOSLASH}"
BRANCH_TMPDIR="${BRANCHDIR}-TMP"

# The tests below precede the copy of the working tree, so that a name
# collision does not cost the user a full copy of the repository.  Among them,
# every test that needs no network access comes first -- including the test for
# ${BRANCHDIR} and the `git pull` that follows them -- so that a purely local
# failure is reported without waiting for a remote, which can take as long as a
# connection attempt takes to time out.

# "HEAD" is not the name of a branch, though it looks like one to a user and a
# clone even has a symbolic ref `refs/remotes/REMOTE/HEAD` that resolves.
# Creating the branch below rejects it, but only after the remote has been
# asked and the working tree has been copied, and its message names this
# script's own command line rather than the problem.  `git-checkout-branch`
# rejects the name too.
if [ "${BRANCHNAME}" = 'HEAD' ]; then
  echo "${SCRIPT_NAME}: ERROR: HEAD is not the name of a branch." >&2
  exit 1
fi

# A repository with no commit has nothing to branch from.  Refusing it in every
# mode gives one behavior on every supported git:  `git worktree add -b` on an
# unborn HEAD fails in versions of git before 2.42.
if ! git rev-parse --verify --quiet HEAD > /dev/null; then
  echo "${SCRIPT_NAME}: ERROR: ${TOPLEVEL} has no commit, so there is nothing to branch from.  Commit something first." >&2
  exit 1
fi

# A local branch has to be detected here rather than left to the creation of
# the branch below, which fails on one even when no remote has a branch of
# that name.
if git rev-parse --verify --quiet "refs/heads/${BRANCHNAME}" > /dev/null; then
  echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists in ${TOPLEVEL}." >&2
  exit 1
fi

if [ -e "${BRANCHDIR}" ]; then
  echo "${SCRIPT_NAME}: ERROR: directory exists: ${BRANCHDIR}" >&2
  exit 1
fi

# Usage: is_fork_sibling DIRECTORY KEYS USER
# Succeeds if DIRECTORY is a clone, other than this one, of the user's fork
# whose remote "upstream" has one of the repository keys (see `url_key`) in
# KEYS, which holds one per line.  DIRECTORY is named PROJECT-fork-ORG or
# PROJECT-fork-ORG-branch-OTHER.  If USER, which is in lower case, is not
# empty, only a fork whose ORG is USER, in any case, is the user's fork;
# otherwise, every fork is.
is_fork_sibling() {
  if [ -n "$3" ]; then
    ifs_org="${1##*/}"
    ifs_org="${ifs_org#*-fork-}"
    ifs_org="$(printf '%s\n' "${ifs_org%%-branch-*}" | tr '[:upper:]' '[:lower:]')"
    if [ "${ifs_org}" != "$3" ]; then
      return 1
    fi
  fi
  # Testing for `.git` also rejects a glob pattern that matched nothing, and it
  # keeps `git -C` from finding a repository that contains DIRECTORY.
  [ -e "$1/.git" ] \
    && [ "$(physical_path "$1")" != "${TOPLEVEL}" ] \
    && git -C "$1" config --get remote.upstream.url > /dev/null 2>&1 \
    && repository_key "$1" upstream | grep -q -x -F -- "$2"
}

# Usage: check_not_upstream_clone
# Exits with an explanation if this clone is the clone of an upstream
# repository whose fork the user has in a sibling directory; see the comment at
# the top of this file.
#
# The repository that the new branch would be pushed to is judged as `git push`
# would judge it for the new branch, which has no configuration of its own:
# by this repository's configuration and by the URLs that `git push` uses (see
# `remote_urls`).  The new branch is pushed to the same repositories wherever it
# is created:  ${WORKTREE_HOST}, if it is created there, pushes where this
# repository does (see `main_clone_for`), and a copy has this repository's
# configuration.
#
# Unlike the tests for a collision below, this test ignores the current
# branch's configuration.  In a fork, the main branch might track the upstream
# repository, which says nothing about where a branch for a pull request is
# pushed, and judging by it would refuse in the fork itself.
#
# Only the fork's main working tree is named, not each of its branch
# directories, which share its configuration and so would each match too.  A
# branch directory is examined only if its fork has no main working tree here.
check_not_upstream_clone() {
  cnuc_project="${REPO%%-branch-*}"
  cnuc_project="${cnuc_project%%-fork-*}"
  # Most clones have no fork beside them, and finding none is cheaper than
  # judging where the new branch would be pushed.  A pattern that matches
  # nothing is left as is, and a lone dangling symbolic link is no fork either.
  set -- "${PARENTDIR}/${cnuc_project}"-fork-*
  if [ $# -eq 1 ] && [ ! -e "$1" ]; then
    return 0
  fi
  cnuc_remote="$(push_remote . '')"
  if [ -z "${cnuc_remote}" ]; then
    return 0
  fi
  cnuc_urls="$(remote_urls . "${cnuc_remote}" --push)"
  cnuc_keys="$(printf '%s\n' "${cnuc_urls}" | url_keys .)"
  if [ -z "${cnuc_keys}" ]; then
    return 0
  fi
  cnuc_user="$(git config --get github.user | tr '[:upper:]' '[:lower:]')"
  cnuc_forks=''
  for cnuc_sibling in "${PARENTDIR}/${cnuc_project}"-fork-*; do
    case "${cnuc_sibling##*/}" in
      *-branch-*) continue ;;
    esac
    if is_fork_sibling "${cnuc_sibling}" "${cnuc_keys}" "${cnuc_user}"; then
      cnuc_forks="${cnuc_forks}  ${cnuc_sibling}
"
    fi
  done
  cnuc_branch_dir=''
  if [ -z "${cnuc_forks}" ]; then
    for cnuc_sibling in "${PARENTDIR}/${cnuc_project}"-fork-*-branch-*; do
      cnuc_name="${cnuc_sibling##*/}"
      if [ ! -e "${PARENTDIR}/${cnuc_name%%-branch-*}/.git" ] \
        && is_fork_sibling "${cnuc_sibling}" "${cnuc_keys}" "${cnuc_user}"; then
        cnuc_branch_dir="${cnuc_sibling}"
        break
      fi
    done
  fi
  if [ -z "${cnuc_forks}" ] && [ -z "${cnuc_branch_dir}" ]; then
    return 0
  fi
  cnuc_url_list="$(printf '%s\n' "${cnuc_urls}" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')"
  if [ -n "${cnuc_forks}" ]; then
    echo "${SCRIPT_NAME}: ERROR: the new branch would be pushed to ${cnuc_remote} (${cnuc_url_list}), which is the upstream repository of the fork in each of these directories:" >&2
    printf '%s' "${cnuc_forks}" >&2
    echo "${SCRIPT_NAME}: A branch for a pull request belongs in your fork, so run ${SCRIPT_NAME} there.  To create the branch here anyway, pass --allow-upstream." >&2
  else
    # The new branch starts at the current commit, so running this command in a
    # branch directory would start it on that directory's branch.
    echo "${SCRIPT_NAME}: ERROR: the new branch would be pushed to ${cnuc_remote} (${cnuc_url_list}), which is the upstream repository of the fork in this branch directory:" >&2
    echo "  ${cnuc_branch_dir}" >&2
    echo "${SCRIPT_NAME}: A branch for a pull request belongs in your fork.  Run ${SCRIPT_NAME} in a clone of the fork, such as a new one in ${PARENTDIR}/${cnuc_name%%-branch-*}, or in ${cnuc_branch_dir} if the new branch should start at its current commit.  To create the branch here anyway, pass --allow-upstream." >&2
  fi
  exit 1
}

# In the worktree modes, register the new worktree in the project's main clone
# rather than in a branch directory, when this repository is a branch
# directory's; see `main_clone_for`.  A main clone that has its own branch of
# the new branch's name cannot host it.
if [ "${MODE}" != 'copy' ]; then
  WORKTREE_HOST="$(main_clone_for "${TOPLEVEL}")"
fi
if [ -n "${WORKTREE_HOST}" ] \
  && git -C "${WORKTREE_HOST}" rev-parse --verify --quiet "refs/heads/${BRANCHNAME}" > /dev/null; then
  echo "${SCRIPT_NAME}: ${WORKTREE_HOST} has its own branch ${BRANCHNAME}, so the new worktree is registered in the repository of ${TOPLEVEL}" >&2
  WORKTREE_HOST=''
fi

# The refusal precedes the pull, so that a refused command changes nothing.
if [ "${ALLOW_UPSTREAM}" = 0 ]; then
  check_not_upstream_clone
fi

# Bring this working tree up to date, so that the branch is based on the most
# recent commit and the remote-tracking branches that the next test consults
# are as current as this clone can make them.  A failed pull is not fatal,
# because the repository might have no remote or the current branch might have
# no upstream, but it is reported: the branch will be based on a possibly stale
# commit.
#
# The pull runs under `git_batch_ssh`, because its output is captured rather
# than shown, so a prompt would be invisible and would block this script
# forever; a failure that says why is better than a silent hang.
#
# A slug pulls in a clone other than the current directory, where a merge or
# rebase that stopped on conflicts would be left for the user to find, so
# there the pull only fast-forwards.  `--no-rebase` is needed too:  in some
# versions of git, a configured `pull.rebase` or `branch.BRANCH.rebase`
# overrides `--ff-only`.
PULL_SUCCEEDED=1
if ! PULL_OUTPUT="$(git_batch_ssh . pull -q ${SLUG_CLONE:+--no-rebase --ff-only} 2>&1)"; then
  PULL_SUCCEEDED=0
  echo "${SCRIPT_NAME}: warning: \`git pull\` failed in ${TOPLEVEL}:" >&2
  if [ -n "${PULL_OUTPUT}" ]; then
    echo "${PULL_OUTPUT}" >&2
  fi
  if [ -n "$(git ls-files --unmerged)" ]; then
    echo "${SCRIPT_NAME}: ERROR: the failed pull left conflicts in ${TOPLEVEL}." >&2
    exit 1
  fi
  echo "${SCRIPT_NAME}: continuing without the pull." >&2
fi

# Usage: find_upstream_commit
# Sets ${UPSTREAM_COMMIT} to the commit at which the new branch starts instead
# of the current commit, or to the empty string if there is none.  That
# commit is the latest commit of the upstream repository's default branch,
# if the current branch has the same name as that default branch and that
# commit is a fast-forward of the current commit (as for a fork's `master`
# that lags behind `upstream/master`) and that commit changes no submodule.
# A current branch of another name, such as a release branch or a pull
# request's branch, or one with commits that the default branch lacks, as in
# a downstream fork, gets none, with no message.  A commit that adds, removes,
# or updates a submodule gets none, with a warning.  A fast-forward that adds
# a submodule would leave it uninitialized, and in a worktree it could not be
# initialized.  A fast-forward that updates or removes a submodule would leave
# the submodule's checkout as it was.  Also sets ${UPSTREAM_REF} and
# ${UPSTREAM_NAME} to the remote-tracking branch, such as
# `refs/remotes/upstream/master` and "upstream/master".
#
# The upstream repository is the remote that `upstream_remote` chooses, which
# `git-pull-upstream` merges from.  This fetches it and updates `REMOTE/HEAD`,
# which names its default branch, as `git-pull-upstream` does.  The fetch is
# unnecessary if the pull above succeeded and fetched the same remote, which
# brought the current branch up to date with it.  If the pull failed but
# contacted the same remote, the remote is not fetched again, because a second
# attempt would most likely fail the same way, after the same wait; the
# remote-tracking branches that this clone already has are used instead.  The
# fetch is also unnecessary if
# `REMOTE/HEAD` names an existing branch of another name than the current
# branch and the remote has no branch of the current branch's name, as for a
# pull request's branch in a fork.  Otherwise, a stale `REMOTE/HEAD`, such as
# one that still names `master` after the remote renamed it to `main`, could
# hide the remote's default branch.  Nothing here changes this working tree or
# its branch; `fast_forward_upstream` does that.
#
# A clone with no remote that `upstream_remote` chooses, such as one with no
# remote at all, has no upstream repository, and nothing is said about it.
# Any other failure, such as a fetch without network access, is not fatal
# either, for the same reasons that a failed pull is not, but it is reported:
# the new branch starts at the current commit, and lacks upstream commits
# that it might have had.
#
# The fetch runs under `git_batch_ssh`, as the pull above does.  The upstream
# repository might be another remote than the one that the pull contacted, so
# a prompt here is possible even if the pull issued none.
find_upstream_commit() {
  UPSTREAM_COMMIT=''
  # `git symbolic-ref --short` would print "heads/main" if a tag "main" exists.
  if ! fuc_ref="$(git symbolic-ref --quiet HEAD)" \
    || ! UPSTREAM_REMOTE="$(upstream_remote 2> /dev/null)"; then
    return
  fi
  fuc_branch="${fuc_ref#refs/heads/}"
  fuc_fetch=1
  if [ "${UPSTREAM_REMOTE}" = "$(git config "branch.${fuc_branch}.remote")" ]; then
    if [ "${PULL_SUCCEEDED}" -eq 1 ]; then
      return
    fi
    fuc_fetch=0
  fi
  fuc_same_name="refs/remotes/${UPSTREAM_REMOTE}/${fuc_branch}"
  if fuc_known="$(git symbolic-ref --quiet "refs/remotes/${UPSTREAM_REMOTE}/HEAD")" \
    && [ "${fuc_known}" != "${fuc_same_name}" ] \
    && git rev-parse --verify --quiet "${fuc_known}" > /dev/null \
    && ! git rev-parse --verify --quiet "${fuc_same_name}" > /dev/null; then
    return
  fi
  if ! UPSTREAM_REF="$(upstream_default_branch "${UPSTREAM_REMOTE}" "${fuc_fetch}" 1)" \
    || ! fuc_commit="$(git rev-parse --verify --quiet "${UPSTREAM_REF}^{commit}")"; then
    echo "${SCRIPT_NAME}: warning: cannot fetch the upstream repository's default branch, so the new branch cannot start at its latest commit; continuing." >&2
    return
  fi
  if [ "${UPSTREAM_REF}" = "${fuc_same_name}" ] \
    && [ "${fuc_commit}" != "$(git rev-parse HEAD)" ] \
    && git merge-base --is-ancestor HEAD "${fuc_commit}"; then
    UPSTREAM_NAME="${UPSTREAM_REF#refs/remotes/}"
    # A submodule's mode is 160000.  `--ignore-submodules=none` overrides a
    # `submodule.<name>.ignore` setting, which would otherwise hide the
    # submodule from the comparison.  A commit with no `.gitmodules` has no
    # submodule, as `has_gitlinks` also assumes, so in the usual repository
    # the comparison, which lists every changed path, is unnecessary.
    if { git cat-file -e "HEAD:.gitmodules" 2> /dev/null \
      || git cat-file -e "${fuc_commit}:.gitmodules" 2> /dev/null; } \
      && git diff-tree -r --no-renames --ignore-submodules=none HEAD "${fuc_commit}" \
      | awk '$1 == ":160000" || $2 == "160000" { found = 1 } END { exit !found }'; then
      echo "${SCRIPT_NAME}: warning: the new branch starts at the current commit of ${TOPLEVEL}, not at ${UPSTREAM_NAME}, the upstream repository's default branch, because the fast-forward would add, remove, or update a submodule." >&2
      return
    fi
    UPSTREAM_COMMIT="${fuc_commit}"
  fi
}

# The pull might have brought in a submodule.  If it switched the mode to the
# copy, the copy's own test of `.git` applies.  The sparse-checkout test above
# matters only to the default mode, which this cannot switch to.
PRE_PULL_MODE="${MODE}"
choose_mode_for_submodules
if [ "${MODE}" != "${PRE_PULL_MODE}" ]; then
  check_git_dir_for_mode
fi
if [ "${MODE}" = 'copy' ]; then
  WORKTREE_HOST=''
fi

# Copy into ${WORKTREE_HOST} the objects that the new worktree needs, now that
# the pull has settled the current commit.  This precedes the tests for a
# collision, because they depend on where the branch is created, which a
# failure to copy changes.
if [ -n "${WORKTREE_HOST}" ]; then
  if [ "${MODE}" = 'worktree' ]; then
    COPY_INDEX='index'
  else
    COPY_INDEX=''
  fi
  if ! copy_objects_to "${WORKTREE_HOST}" HEAD ${COPY_INDEX:+"${COPY_INDEX}"}; then
    echo "${SCRIPT_NAME}: so the new worktree is registered in the repository of ${TOPLEVEL}" >&2
    WORKTREE_HOST=''
  fi
fi

# Determine which remote the new branch would collide with:  the remote that
# `git push` would use for the current branch, as `push_remote` in
# common-functions.sh determines it, which is also the remote that
# `is-deleted-branch` and `git-push-to` use.  The new branch has no
# configuration of its own yet -- neither `git worktree add -b` nor
# `git checkout -b` creates any -- so this branch's configuration is what says
# which remote the new branch would eventually be pushed to.
#
# When the new branch is created in ${WORKTREE_HOST}, though, its pushes are
# governed by that repository's configuration, which might name other remotes,
# and this branch's configuration does not apply to it.  Then the tests below
# consult ${WORKTREE_HOST}'s remotes, and the remote is the one that
# ${WORKTREE_HOST} would push a branch with no configuration to.
#
# ${REMOTE} is empty if no remote can be determined; then no remote can be
# asked, and only the local tests apply.
if [ -n "${WORKTREE_HOST}" ]; then
  COLLISION_REPO="${WORKTREE_HOST}"
  COLLISION_CLONE="${WORKTREE_HOST}"
  REMOTE="$(push_remote "${WORKTREE_HOST}" '')"
else
  COLLISION_REPO='.'
  COLLISION_CLONE="${TOPLEVEL}"
  BRANCH_REF="$(git symbolic-ref --quiet HEAD 2> /dev/null)" || BRANCH_REF=''
  REMOTE="$(push_remote . "${BRANCH_REF#refs/heads/}")"
fi

# A remote-tracking branch is evidence that a remote has the branch, and it
# costs no network access.  When a remote can be determined, only ${REMOTE}'s
# refs are consulted:  a branch of the same name in another remote --
# "upstream" in a fork workflow, say -- is a branch that neither
# `git checkout -b` nor a later push to ${REMOTE} would collide with, so
# refusing on account of one would refuse a name that the user can in fact use.
#
# When no remote can be determined, every remote is consulted.  Any remote of
# this clone could be the one that the new branch is eventually pushed to --
# that is just what having determined none means -- so a remote-tracking branch
# is the only evidence available.  Skipping it would abandon the collision
# check in exactly the working tree that this script itself creates, since it
# writes no `branch.BRANCH.remote` for the new branch.
#
# The evidence is not conclusive:  a remote-tracking branch outlives the branch
# it tracks, because `git fetch` does not delete one unless it is asked to
# prune.  So the message says what the evidence is, rather than asserting that
# the remote has the branch, and it differs from the message for the query
# below, which asks the remote itself.
#
# "HEAD" needs no exclusion here, even though a clone has a symbolic ref
# `refs/remotes/REMOTE/HEAD` that resolves:  the name was rejected above.
if [ -n "${REMOTE}" ]; then
  TRACKING_REMOTES="${REMOTE}"
else
  TRACKING_REMOTES="$(git -C "${COLLISION_REPO}" remote)"
fi
for tracking_remote in ${TRACKING_REMOTES}; do
  if git -C "${COLLISION_REPO}" rev-parse --verify --quiet \
    "refs/remotes/${tracking_remote}/${BRANCHNAME}" > /dev/null; then
    echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists on remote ${tracking_remote}, according to the remote-tracking branch ${tracking_remote}/${BRANCHNAME} in ${COLLISION_CLONE}." >&2
    exit 1
  fi
done

# This clone shows no such branch, so ask the remote itself:  the clone might
# never have fetched the branch, or might not fetch it at all.
#
# Asking the remote does not change it.  In particular, this script does not
# push the new branch.
#
# The query runs under `git_batch_ssh`, as `is-deleted-branch` runs its own
# queries, because a prompt would otherwise block this query forever when this
# script is run from another script or a CI job.
# A remote that this script cannot ask is not an error; the branch is created.
if [ -n "${REMOTE}" ] \
  && git_batch_ssh "${COLLISION_REPO}" ls-remote --exit-code "${REMOTE}" \
    "refs/heads/${BRANCHNAME}" > /dev/null 2>&1; then
  echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists on remote ${REMOTE}, which was asked directly." >&2
  exit 1
fi

# Fetch the upstream repository only now that no test can refuse the branch,
# so that a refused name does not wait on it.
find_upstream_commit
# The new branch starts at ${UPSTREAM_COMMIT}, so a new worktree registered in
# ${WORKTREE_HOST} needs that commit there.  The fetch above updated only this
# repository's remote-tracking branches, so ${WORKTREE_HOST} might lack the
# commit even if it has a remote of the same name.  A failure to copy it costs
# only the fast-forward, not the choice of ${WORKTREE_HOST}.
if [ -n "${WORKTREE_HOST}" ] && [ -n "${UPSTREAM_COMMIT}" ] \
  && ! copy_objects_to "${WORKTREE_HOST}" "${UPSTREAM_REF}"; then
  echo "${SCRIPT_NAME}: so neither ${TOPLEVEL} nor the new branch is fast-forwarded to ${UPSTREAM_NAME}" >&2
  UPSTREAM_COMMIT=''
fi

# Say where the new worktree is registered, and where a slug makes the branch,
# only now that no test can refuse the branch and the pull and
# `find_upstream_commit` have settled the commit that it starts at.
if [ -n "${WORKTREE_HOST}" ]; then
  note_worktree_host
fi
# The base is whatever the fork's clone has checked out, which is not
# necessarily its main branch, so the message names it.  A slug makes a clean
# checkout, so the new branch starts at ${UPSTREAM_COMMIT}, if there is one,
# even if the fork's branch cannot be fast-forwarded to it.
if [ -n "${SLUG_CLONE}" ]; then
  if [ -n "${UPSTREAM_COMMIT}" ]; then
    SLUG_BASE="${UPSTREAM_NAME}"
    SLUG_START="${UPSTREAM_COMMIT}"
  elif SLUG_BASE="$(git symbolic-ref --quiet --short HEAD 2> /dev/null)"; then
    SLUG_BASE="its branch ${SLUG_BASE}"
    SLUG_START=HEAD
  else
    SLUG_BASE='its detached HEAD'
    SLUG_START=HEAD
  fi
  echo "${SCRIPT_NAME}: making branch ${BRANCHNAME} in ${SLUG_CLONE}, at commit $(git rev-parse --short "${SLUG_START}") of ${SLUG_BASE}" >&2
fi

# Usage: make_tmpdir
# Tests for ${BRANCH_TMPDIR}, and arranges for the traps to remove whatever is
# then created there.
#
# The test comes after every remote query rather than with the first test for
# ${BRANCHDIR}, so that no remote query, which can take as long as a
# connection attempt takes to time out, runs between the test and the
# assignment below.  Whatever the copy then leaves at that location was
# created by this script and the traps can safely remove it, even if the copy
# is interrupted before it finishes.
make_tmpdir() {
  if [ -e "${BRANCH_TMPDIR}" ]; then
    echo "${SCRIPT_NAME}: ERROR: directory exists: ${BRANCH_TMPDIR}" >&2
    exit 1
  fi
  TMPDIR_TO_CLEAN="${BRANCH_TMPDIR}"
}

# Test that the new directory's locations are free before the fast-forward,
# which changes ${TOPLEVEL}, so that a refused command leaves ${TOPLEVEL} as
# it was.  ${BRANCHDIR} is tested again, because the queries and the fetch
# above can take long.
if [ -e "${BRANCHDIR}" ]; then
  echo "${SCRIPT_NAME}: ERROR: directory exists: ${BRANCHDIR}" >&2
  exit 1
fi
if [ "${MODE}" != 'clean' ]; then
  make_tmpdir
fi

# Usage: fast_forward_upstream
# Fast-forwards the current branch, its index, and its working tree in
# ${TOPLEVEL} from the current commit to ${UPSTREAM_COMMIT}, the upstream
# repository's default branch, carrying every uncommitted change forward.
# The fast-forward is not made if it would change a file that has a staged
# change, an unstaged modification, or an unstaged deletion, or if it would
# overwrite an untracked file; then this prints a warning, changes nothing,
# and returns 1.  So does any other failure to update the index and the
# working tree, such as a locked index.  Such a failure is not fatal, because
# the current commit is usable.  As `git merge` does, the fast-forward overwrites an ignored file
# that the upstream repository has started to track.  If the index and the
# working tree were fast-forwarded but the branch could not be, this exits,
# after saying how to finish the fast-forward.
#
# `git read-tree -m -u` does to the index and the working tree what a
# fast-forward or `git checkout` does:  it carries every local change
# forward, and it refuses, before changing anything, if the fast-forward
# changes a file that has a staged change or an unstaged modification, or if
# it would overwrite an untracked file.  It does not refuse for an unstaged
# deletion:  it writes the upstream version of the file, which undoes the
# deletion, so that case is tested first.  `git merge --ff-only` is not used,
# because configuration can change what it does:  `merge.autoStash` would
# stash the changes on the stash stack that every worktree shares and reapply
# them with possible conflicts.  Plumbing commands heed no such
# configuration.  Nor is `git reset --keep` used, which would unstage the
# staged changes.
fast_forward_upstream() {
  if ! ffu_head="$(git -C "${TOPLEVEL}" rev-parse --verify HEAD)"; then
    echo "${SCRIPT_NAME}: warning: cannot determine the commit of ${TOPLEVEL}, so it was not fast-forwarded to ${UPSTREAM_NAME}." >&2
    return 1
  fi
  ffu_skipped="${SCRIPT_NAME}: warning: ${TOPLEVEL} was not fast-forwarded to ${UPSTREAM_NAME}, the upstream repository's default branch"
  # `git read-tree` takes a file whose metadata the index records wrongly, if
  # only in its modification time, for one with an unstaged change, so refresh
  # the index first, as `git status` would.  With `-q`, a file with an
  # unstaged change is no failure, but a locked index is.
  # The files that the fast-forward changes are listed only if there is an
  # unstaged deletion, because the list can be long.
  if ! git -C "${TOPLEVEL}" update-index -q --refresh > /dev/null \
    || ! ffu_deleted="$(git -C "${TOPLEVEL}" diff-files --name-only --diff-filter=D)" \
    || { [ -n "${ffu_deleted}" ] \
      && ! ffu_changed="$(git -C "${TOPLEVEL}" diff-tree -r --name-only --no-renames \
        "${ffu_head}" "${UPSTREAM_COMMIT}")"; }; then
    echo "${ffu_skipped}, because its state could not be determined." >&2
    return 1
  fi
  if [ -n "${ffu_deleted}" ] \
    && printf '%s\n' "${ffu_changed}" | grep -q -x -F -e "${ffu_deleted}"; then
    echo "${ffu_skipped}, because the fast-forward would change files that are deleted there." >&2
    return 1
  fi
  # Ignore HUP, INT, and TERM between the update of the index and working tree
  # and the update of the branch, so that no interruption leaves the files at
  # ${UPSTREAM_COMMIT} and the branch at ${ffu_head}.  The git commands inherit
  # the disposition.  The subshell keeps it from replacing the traps that
  # `trap_branch_cleanup` installed; the shell runs the trap for a signal that
  # arrives meanwhile once the subshell exits.
  ffu_status=0
  (
    trap '' HUP INT TERM
    git -C "${TOPLEVEL}" read-tree -m -u "${ffu_head}" "${UPSTREAM_COMMIT}" || exit 1
    git -C "${TOPLEVEL}" update-ref -m "${SCRIPT_NAME}: fast-forward to ${UPSTREAM_NAME}" \
      HEAD "${UPSTREAM_COMMIT}" "${ffu_head}" || exit 2
  ) || ffu_status=$?
  case "${ffu_status}" in
    0) ;;
    1)
      echo "${ffu_skipped}, because \`git read-tree\` failed, for the reason that it gives above, such as a file that has uncommitted changes there or an untracked file that the fast-forward would overwrite." >&2
      return 1
      ;;
    *)
      echo "${SCRIPT_NAME}: ERROR: the index and working tree of ${TOPLEVEL} were fast-forwarded to ${UPSTREAM_NAME}, but its branch could not be, so they differ from its commit.  To finish the fast-forward, run:" >&2
      echo "  git -C '${TOPLEVEL}' update-ref HEAD ${UPSTREAM_COMMIT} ${ffu_head}" >&2
      exit 1
      ;;
  esac
}
if [ -n "${UPSTREAM_COMMIT}" ]; then
  if fast_forward_upstream; then
    echo "${SCRIPT_NAME}: fast-forwarded ${TOPLEVEL} to ${UPSTREAM_NAME}, the upstream repository's default branch, where the new branch starts." >&2
  elif [ "${MODE}" = 'clean' ]; then
    echo "${SCRIPT_NAME}: the new branch starts at ${UPSTREAM_NAME} all the same, because it is a clean checkout." >&2
  else
    echo "${SCRIPT_NAME}: so the new branch starts at the current commit of ${TOPLEVEL}." >&2
    UPSTREAM_COMMIT=''
  fi
fi

# Usage: add_worktree_here GIT-WORKTREE-ADD-OPTION...
# Creates the branch ${BRANCHNAME} at the current commit in a new worktree at
# ${BRANCHDIR}.  The current commit is passed to git as a commit, not as HEAD,
# so that git sets up no upstream for the new branch even under
# `branch.autoSetupMerge=always`.
add_worktree_here() {
  if ! add_worktree_here_commit="$(git rev-parse --verify HEAD)"; then
    echo "${SCRIPT_NAME}: ERROR: cannot determine the current commit" >&2
    exit 1
  fi
  add_worktree "${BRANCHDIR}" "${BRANCHNAME}" "${add_worktree_here_commit}" "$@"
}

case "${MODE}" in
  copy)
    # Copy the whole directory, `.git` included, so that the new directory is
    # an independent clone.  It is not a registered worktree, so moving it
    # with `mv` is safe.
    copy_repository "${BRANCH_TMPDIR}"
    # `--no-track` sets up no upstream for the new branch even under
    # `branch.autoSetupMerge=always`, which would otherwise make the current
    # branch its upstream.
    if ! (cd -- "${BRANCH_TMPDIR}" && git checkout --no-track -b "${BRANCHNAME}" -q); then
      echo "${SCRIPT_NAME}: ERROR in: (cd -- \"${BRANCH_TMPDIR}\" && git checkout --no-track -b \"${BRANCHNAME}\" -q)" >&2
      exit 1
    fi
    if ! mv -- "${BRANCH_TMPDIR}" "${BRANCHDIR}"; then
      echo "${SCRIPT_NAME}: ERROR in: mv -- \"${BRANCH_TMPDIR}\" \"${BRANCHDIR}\"" >&2
      exit 1
    fi
    TMPDIR_TO_CLEAN=""
    ;;

  clean)
    # Git writes the tracked files, and the index that matches them, from the
    # shared object store.  This is the one mode that creates the worktree
    # directly at its final name with nothing to follow, which is acceptable
    # because `git worktree add` is one fast command; the default mode, whose
    # copy is slow, does its work under a temporary name instead.  The
    # checkout is made at ${UPSTREAM_COMMIT}, if there is one, even if
    # `fast_forward_upstream` left the current branch behind it, because a
    # clean checkout has no uncommitted changes for the fast-forward to
    # conflict with.
    if [ -n "${UPSTREAM_COMMIT}" ]; then
      add_worktree "${BRANCHDIR}" "${BRANCHNAME}" "${UPSTREAM_COMMIT}"
    else
      add_worktree_here
    fi
    ;;

  worktree)
    # 1. Copy every top-level entry except `.git` into a temporary directory.
    # This is the slow step, so it happens under the temporary name.
    #
    # `.git` must be skipped, not copied.  Copying a `.git` directory would
    # duplicate the object store, which is what this mode exists to avoid, and
    # copying the `.git` file of a linked worktree would give the copy the
    # *same* git directory as this worktree, with one HEAD and one index.
    if ! mkdir -- "${BRANCH_TMPDIR}"; then
      echo "${SCRIPT_NAME}: ERROR: cannot create ${BRANCH_TMPDIR}" >&2
      exit 1
    fi
    copy_working_tree "${BRANCH_TMPDIR}" .git

    # 2. Create the worktree.  With `--no-checkout`, git creates ${BRANCHDIR}
    # holding nothing but the `.git` file, rather than writing tracked files
    # that the copy would replace.
    add_worktree_here --no-checkout
    if ! WORKTREE_GITDIR_TO_CLEAN="$(git -C "${BRANCHDIR}" rev-parse \
      --absolute-git-dir)" || [ -z "${WORKTREE_GITDIR_TO_CLEAN}" ]; then
      echo "${SCRIPT_NAME}: ERROR: cannot determine the git directory of ${BRANCHDIR}" >&2
      exit 1
    fi

    # 3. Move the `.git` file into the copy, and the copy into place.  The
    # worktree ends up at exactly the path that it is registered under, and
    # ${BRANCHDIR} is incomplete only between the two renames.
    if ! mv -- "${BRANCHDIR}/.git" "${BRANCH_TMPDIR}/.git" \
      || ! rmdir -- "${BRANCHDIR}" \
      || ! mv -- "${BRANCH_TMPDIR}" "${BRANCHDIR}"; then
      echo "${SCRIPT_NAME}: ERROR: cannot move ${BRANCH_TMPDIR} to ${BRANCHDIR}" >&2
      exit 1
    fi
    TMPDIR_TO_CLEAN=""

    # 4. Install the index.  `--no-checkout` leaves the new worktree's index
    # empty, so that git would report every tracked file as deleted.  A copy
    # of this working tree's index reproduces its staged state exactly:  the
    # index records paths relative to the top level, `cp -p` preserves the
    # modification times that its stat data refers to, and every blob that it
    # names is in the shared object store, including one that only `git add`
    # created.  Git re-hashes the copied files on the first `git status` in
    # the new directory, because they have new inode numbers, and then
    # rewrites the index.
    #
    # The index lies in this working tree's own git directory, which is
    # `.git/worktrees/NAME` in a linked worktree.  Under `core.splitIndex`, the
    # index holds only recent changes and names a `sharedindex.SHA` file, in
    # the same git directory, that holds the rest; without that file, every
    # git command in the new worktree fails.  Every shared index file is
    # copied, rather than only the one that the index names, which is
    # recorded in binary; git deletes the others once they expire.
    if ! SRC_GITDIR="$(git rev-parse --absolute-git-dir)" \
      || [ -z "${SRC_GITDIR}" ]; then
      echo "${SCRIPT_NAME}: ERROR: cannot determine the git directory of ${TOPLEVEL}" >&2
      exit 1
    fi
    # A working tree that has no index at all has staged nothing, and the new
    # worktree's empty index says the same.  A pattern that matches nothing
    # is left unexpanded, and names no file.
    for index_file in "${SRC_GITDIR}/index" "${SRC_GITDIR}"/sharedindex.*; do
      if [ -e "${index_file}" ] \
        && ! \cp -p -- "${index_file}" "${WORKTREE_GITDIR_TO_CLEAN}/"; then
        echo "${SCRIPT_NAME}: ERROR: cannot copy ${index_file} to ${WORKTREE_GITDIR_TO_CLEAN}" >&2
        exit 1
      fi
    done
    ;;
esac
WORKTREE_TO_CLEAN=""
WORKTREE_GITDIR_TO_CLEAN=""
BRANCH_TO_CLEAN=""

# Usage: check_ignore PATHNAME
# Runs `git check-ignore` on PATHNAME, which is relative to ${BRANCHDIR}, in
# the repository that contains it, which for a file in a submodule is the
# submodule's.  Returns 0 if git ignores PATHNAME, 1 if it does not, and 128
# on an error.
check_ignore() {
  case "$1" in
    */*) git -C "${BRANCHDIR}/${1%/*}" check-ignore -q -- "${1##*/}" 2> /dev/null ;;
    *) git -C "${BRANCHDIR}" check-ignore -q -- "$1" 2> /dev/null ;;
  esac
}

# Usage: is_cache_dir DIRECTORY
# Returns 0 if DIRECTORY is a cache directory, and 1 otherwise.  A cache
# directory contains a `CACHEDIR.TAG` file that begins with the signature that
# the Cache Directory Tagging Specification (https://bford.info/cachedir/)
# defines.  The tool that wrote it regenerates its contents.
is_cache_dir() {
  [ -f "$1/CACHEDIR.TAG" ] || return 1
  cache_tag_line=''
  IFS= read -r cache_tag_line < "$1/CACHEDIR.TAG" 2> /dev/null
  case "${cache_tag_line}" in
    'Signature: 8a477f597d28d172789f06886806bc55'*) return 0 ;;
    *) return 1 ;;
  esac
}

# Usage: dir_list
# Reads directory names from standard input, one per line, and prints a
# comma-separated list of the distinct ones, in sorted order, each in
# backquotes and followed by "/".
dir_list() {
  LC_ALL=C sort -u | awk '{ printf "%s`%s/`", sep, $0; sep = ", " } END { print "" }'
}

# Usage: delete_stale_build_output OLD_NAMES
# Reads the pathnames of stale files, relative to ${BRANCHDIR}, one per line,
# from standard input.  Deletes each stale file that a tool presumably
# regenerates, and prints the pathname of each other stale file, including
# each one that cannot be deleted.  Says on standard error which of the
# directories that it deleted files from CMake or autotools configured, as
# shown by a `CMakeCache.txt` or `config.status` file in them, because such a
# directory needs to be reconfigured.  If ${VERBOSE} is "yes", also says how
# many files it deleted.  OLD_NAMES is the pathname that the deleted files
# contained or were symbolic links into.
#
# Whether a tool regenerates a file is not knowable, so it is judged by the
# directory that contains the file.  A tool presumably regenerates the files
# in a `build/` directory, in Gradle's `.gradle/` directory, and in a cache
# directory, as `is_cache_dir` defines it, such as Ruff's `.ruff_cache/` or
# Cargo's `target/`, whether at the top level, in a subproject, or in a
# submodule, if git ignores that directory.  Some tools write into a cache
# directory a `.gitignore` file that ignores the directory's contents but not
# the directory itself, so a cache directory also qualifies if git ignores
# its `CACHEDIR.TAG` file.  No file is deleted from a directory that:
#  * git does not ignore, because the directory might hold hand-written files,
#    such as local configuration;
#  * is within another directory that git ignores, such as a dependency's
#    directory in `node_modules/`, because no build of the project
#    regenerates the dependency's files; or
#  * is a submodule, because the submodule's files are not in a `build/`,
#    `.gradle/`, or cache directory of the submodule's own repository.
# This is a function, rather than code in the command substitution of
# `delete_or_warn_about_old_pathname`, because bash 3.2, which is /bin/sh on
# macOS, ends a command substitution at the ")" of a `case` pattern within it.
delete_stale_build_output() {
  stale_count=0
  # ${stale_names} lists the names of the directories that files were
  # deleted from, each followed by a newline.
  stale_names=''
  # ${stale_configured} lists the directories, relative to ${BRANCHDIR},
  # that CMake or autotools configured and that files were deleted from,
  # each preceded by a newline.
  stale_configured=''
  stale_last_dir=''
  while IFS= read -r stale_file; do
    if [ -z "${stale_file}" ]; then
      continue
    fi
    # ${stale_dir} is the outermost `build/`, `.gradle/`, or cache directory
    # that contains the file, or is empty if there is none, and
    # ${stale_owner} is the directory that contains ${stale_dir}, or is empty
    # for ${BRANCHDIR}, which git never ignores.
    stale_dir=''
    stale_owner=''
    stale_rest="${stale_file}"
    while [ -z "${stale_dir}" ]; do
      case "${stale_rest}" in
        */*) ;;
        *) break ;;
      esac
      stale_component="${stale_rest%%/*}"
      stale_rest="${stale_rest#*/}"
      stale_candidate="${stale_owner:+${stale_owner}/}${stale_component}"
      case "${stale_component}" in
        build | .gradle) stale_dir="${stale_candidate}" ;;
        *)
          if is_cache_dir "${BRANCHDIR}/${stale_candidate}"; then
            stale_dir="${stale_candidate}"
          else
            stale_owner="${stale_candidate}"
          fi
          ;;
      esac
    done
    if [ -z "${stale_dir}" ]; then
      printf '%s\n' "${stale_file}"
      continue
    fi
    # ${stale_delete} is "yes" if the files in ${stale_dir} are deleted and
    # "no" if they are not.  It is computed again only when ${stale_dir}
    # differs from the previous file's, which saves the `git check-ignore`
    # processes.  The order of the input affects only how often it is
    # computed, not its value.
    if [ "${stale_dir}" != "${stale_last_dir}" ]; then
      stale_last_dir="${stale_dir}"
      if [ -e "${BRANCHDIR}/${stale_dir}/.git" ]; then
        stale_delete=no
      elif [ -n "${stale_owner}" ] && {
        check_ignore "${stale_owner}"
        [ $? -ne 1 ]
      }; then
        stale_delete=no
      elif check_ignore "${stale_dir}"; then
        stale_delete=yes
      elif is_cache_dir "${BRANCHDIR}/${stale_dir}" \
        && check_ignore "${stale_dir}/CACHEDIR.TAG"; then
        stale_delete=yes
      else
        stale_delete=no
      fi
      # ${stale_markers} lists the directories, relative to ${BRANCHDIR}, in
      # ${stale_dir} or below it that hold a `CMakeCache.txt` or
      # `config.status` file, each followed by a newline.  The search precedes
      # the deletion of any file in ${stale_dir}, because those files contain
      # the pathname of the source directory and so are deleted too.
      stale_markers=''
      if [ "${stale_delete}" = yes ]; then
        stale_markers="$(cd "${BRANCHDIR}" \
          && find "./${stale_dir}" \( -name CMakeCache.txt -o -name config.status \) -type f -print 2> /dev/null \
          | sed -e 's|^\./||' -e 's|/[^/]*$||' | sort -u)"
        if [ -n "${stale_markers}" ]; then
          stale_markers="${stale_markers}
"
        fi
      fi
    fi
    if [ "${stale_delete}" = yes ] \
      && rm -f -- "${BRANCHDIR}/${stale_file}" 2> /dev/null; then
      stale_count=$((stale_count + 1))
      stale_names="${stale_names}${stale_dir##*/}
"
      # Each configured directory that contains the file needs to be
      # reconfigured.
      stale_unread_markers="${stale_markers}"
      while [ -n "${stale_unread_markers}" ]; do
        stale_marker="${stale_unread_markers%%
*}"
        stale_unread_markers="${stale_unread_markers#*
}"
        case "${stale_file}" in
          "${stale_marker}"/*)
            case "${stale_configured}
" in
              *"
${stale_marker}
"*) ;;
              *) stale_configured="${stale_configured}
${stale_marker}" ;;
            esac
            ;;
        esac
      done
      continue
    fi
    printf '%s\n' "${stale_file}"
  done
  if [ "${VERBOSE}" = yes ] && [ "${stale_count}" -gt 0 ]; then
    if [ "${stale_count}" -eq 1 ]; then
      stale_files='1 file'
    else
      stale_files="${stale_count} files"
    fi
    stale_dirs="$(printf '%s' "${stale_names}" | dir_list)"
    echo "${SCRIPT_NAME}: deleted generated files in ${BRANCHDIR} that contained the pathname of $1 or were symbolic links into it: ${stale_files} in ${stale_dirs}.  The tools that generated them regenerate them." >&2
  fi
  if [ -n "${stale_configured}" ]; then
    case "${stale_configured#?}" in
      *"
"*) stale_pronoun=them ;;
      *) stale_pronoun=it ;;
    esac
    echo "${SCRIPT_NAME}: deleted generated files that contained the pathname of $1 from $(printf '%s\n' "${stale_configured#?}" | dir_list) in ${BRANCHDIR}, which CMake or autotools configured.  Reconfigure ${stale_pronoun} before building there." >&2
  fi
}

# Usage: delete_or_warn_about_old_pathname
# Finds the stale files in ${BRANCHDIR}:  the files in ${BRANCHDIR} and in its
# submodules that git does not track and that contain the pathname of
# ${TOPLEVEL} or are symbolic links to it or into it.  The pathname is sought
# both as ${LOGICAL_TOPLEVEL} and as ${TOPLEVEL}.  Tracked files are not
# examined, because they are not build output.
#
# A stale file is usually build output that still refers to the files in
# ${TOPLEVEL} rather than to their copies.  For example, a program into which
# the build compiled the pathname of its installation directory runs the files
# installed in ${TOPLEVEL}.  A build in ${BRANCHDIR} might not recompile it,
# even after a reconfiguration, because build tools rarely notice a changed
# pathname.
#
# Deletes each stale file that a tool presumably regenerates, as
# `delete_stale_build_output` describes, and warns about each other stale
# file.
delete_or_warn_about_old_pathname() {
  # The pattern matches the pathname where it ends, or where it continues
  # with a character other than a letter, digit, "-", "_", or ".", such as
  # "/", a quotation mark, or a NUL.  So a sibling directory whose name
  # begins with the same characters, such as ${BRANCHDIR} itself, does not
  # match.  When ${LOGICAL_TOPLEVEL} is ${TOPLEVEL}, the pattern names the
  # same pathname twice, which is harmless.
  warn_old_pattern=''
  for warn_old_top in "${TOPLEVEL}" "${LOGICAL_TOPLEVEL}"; do
    warn_old_pattern="${warn_old_pattern:+${warn_old_pattern}|}$(printf '%s\n' "${warn_old_top}" | sed 's/[][\\.*^$+?(){}|]/\\&/g')"
  done
  warn_old_pattern="(${warn_old_pattern})([^-_.A-Za-z0-9]|\$)"
  # The first pass examines each symbolic link by its target's pathname.
  # grep would follow it instead, and read the target, which might be a file in
  # ${TOPLEVEL}, a directory, or a FIFO that blocks grep.  The second pass
  # examines the contents of every other file, except one whose name says
  # that its contents are compressed, such as an archive or an image:
  # compressed contents do not hold the pathname as plain text, and such files
  # are often the largest that the copy made.  xargs runs grep with its
  # standard input from /dev/null or not at all, so if there is no file to
  # examine, grep does not wait for input.
  # shellcheck disable=SC2016 # The shells that xargs runs expand the scripts.
  warn_old_files="$(
    exec 2> /dev/null
    cd -- "${BRANCHDIR}" || exit
    # Lists each file that git does not track, in ${BRANCHDIR} and in its
    # submodules, by its pathname relative to ${BRANCHDIR}, each followed by
    # a NUL.  `git ls-files --others` does not descend into a submodule.
    list_untracked() {
      git ls-files -z --others
      # shellcheck disable=SC2016 # The shells that git and xargs run expand the scripts.
      git submodule --quiet foreach --recursive \
        'git ls-files -z --others | xargs -0 sh -c '\''for file; do printf "%s/%s\000" "$0" "${file}"; done'\'' "${displaypath}"'
    }
    list_untracked \
      | LC_ALL=C xargs -0 sh -c '
        pattern="$1"
        shift
        for file; do
          if [ -L "${file}" ] && readlink -- "${file}" | grep -q -E -e "${pattern}"; then
            printf "%s\n" "${file}"
          fi
        done' sh "${warn_old_pattern}"
    list_untracked \
      | xargs -0 sh -c '
        for file; do
          if [ ! -L "${file}" ]; then
            case "${file}" in
              *.7z | *.aar | *.br | *.bz2 | *.ear | *.gif | *.gz | *.jar | *.jpeg \
                | *.jpg | *.lz | *.lzma | *.mkv | *.mov | *.mp3 | *.mp4 | *.png \
                | *.rar | *.tbz2 | *.tgz | *.txz | *.war | *.webm | *.webp \
                | *.whl | *.xz | *.zip | *.zst) ;;
              *) printf "%s\000" "${file}" ;;
            esac
          fi
        done' sh \
      | LC_ALL=C xargs -0 grep -l -E -e "${warn_old_pattern}" --
  )"
  if [ "${LOGICAL_TOPLEVEL}" = "${TOPLEVEL}" ]; then
    warn_old_names="${TOPLEVEL}"
  else
    warn_old_names="${LOGICAL_TOPLEVEL} (also ${TOPLEVEL})"
  fi
  warn_old_files="$(printf '%s\n' "${warn_old_files}" | delete_stale_build_output "${warn_old_names}")"
  if [ -z "${warn_old_files}" ]; then
    return
  fi
  echo "${SCRIPT_NAME}: warning: these files in ${BRANCHDIR}, which git does not track, contain the pathname of ${warn_old_names} or are symbolic links into it:" >&2
  printf '%s\n' "${warn_old_files}" | head -n 5 | sed 's/^/  /' >&2
  warn_old_count="$(printf '%s\n' "${warn_old_files}" | wc -l | tr -d ' ')"
  if [ "${warn_old_count}" -gt 5 ]; then
    echo "  and $((warn_old_count - 5)) more" >&2
  fi
  echo "${SCRIPT_NAME}: They are probably build output that still refers to the files in ${TOPLEVEL}, and a build might not recompile them, even after a reconfiguration.  Delete the build output and rebuild." >&2
  # `--clean` is refused when the current commit has submodules.
  if ! has_gitlinks HEAD; then
    echo "${SCRIPT_NAME}: Or remove ${BRANCHDIR} with git-remove-branch-directory, and run \`${SCRIPT_NAME} --clean ${BRANCHNAME}\`, which copies no untracked file and no uncommitted change." >&2
  fi
}
if [ "${MODE}" != 'clean' ]; then
  delete_or_warn_about_old_pathname
fi

echo "Success: created ${BRANCHDIR}"
