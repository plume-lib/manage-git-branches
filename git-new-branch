#!/bin/sh

# Creates a new branch of the current repository,
# in a sibling directory named REPONAME-branch-NEWBRANCHNAME/.
#
# Usage:
#   git-new-branch NEWBRANCHNAME
#
# The new branch is in a new directory that has the same directory
# contents as the current repository.
#
# Every effect of this script is local:  it never contacts a remote except to
# read from it, and in particular it does not push the new branch.  Therefore,
# the new branch has no upstream branch, which `git-push-to` and
# `git-pull-from` require.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.  Do this
# before the `cd` below, because a relative pathname in $0 is relative to the
# directory that the caller ran this script from.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/remote-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/remote-functions.sh" >&2
  exit 1
fi
# shellcheck source=remote-functions.sh
. "${SCRIPT_DIR}/remote-functions.sh"

if [ "$#" -ne 1 ]; then
  echo "Usage: ${SCRIPT_NAME} NEWBRANCHNAME" >&2
  exit 1
fi

STARTDIR="${PWD}"
# Set to the temporary directory just before we create it, so that the traps
# remove it if the script fails or is interrupted partway through.  Left empty
# otherwise, so the traps never remove a pre-existing directory that we did not
# create.
TMPDIR_TO_CLEAN=""
cleanup() {
  cd -- "${STARTDIR}" 2> /dev/null || true
  if [ -n "${TMPDIR_TO_CLEAN}" ]; then rm -rf -- "${TMPDIR_TO_CLEAN}"; fi
}
# A POSIX shell such as dash does not run an EXIT trap when the shell is killed
# by a signal, so trap the signals too.  Each signal handler restores the
# default disposition and re-sends the signal to this shell, so that the caller
# still sees the exit status that the signal produces.
trap cleanup EXIT
trap 'cleanup; trap - HUP EXIT; kill -s HUP "$$"' HUP
trap 'cleanup; trap - INT EXIT; kill -s INT "$$"' INT
trap 'cleanup; trap - TERM EXIT; kill -s TERM "$$"' TERM

# Capture the top level first: under a POSIX `sh` (e.g., dash), `cd ""` succeeds
# as a no-op, so testing `cd "$(...)"` directly would not catch an empty result.
if ! TOPLEVEL="$(git rev-parse --show-toplevel 2> /dev/null)" || [ -z "${TOPLEVEL}" ]; then
  echo "${SCRIPT_NAME}: Cannot determine top-level directory of git repository" >&2
  git rev-parse --show-toplevel >&2
  exit 1
fi
if ! cd "${TOPLEVEL}"; then
  echo "${SCRIPT_NAME}: Cannot cd to top-level directory: ${TOPLEVEL}" >&2
  exit 1
fi

REPO=$(basename "$(pwd)")
BRANCHNAME="$1"
BRANCHNOSLASH=$(printf '%s\n' "${BRANCHNAME}" | sed -e "s:/:-:g")
# Canonicalize the parent directory, because ${BRANCHDIR} does not exist yet.
if ! PARENTDIR="$(realpath ..)" || [ -z "${PARENTDIR}" ]; then
  echo "${SCRIPT_NAME}: Cannot canonicalize the parent directory of $(pwd)" >&2
  exit 1
fi
BRANCHDIR="${PARENTDIR%/}/${REPO%%-branch-*}-branch-${BRANCHNOSLASH}"
BRANCH_TMPDIR="${BRANCHDIR}-TMP"

# Bring this working copy up to date, so that the branch is based on the most
# recent commit.  A failed pull is not fatal, because the repository might have
# no remote or the current branch might have no upstream, but it is reported:
# the branch will be based on a possibly stale commit.
if ! PULL_OUTPUT="$(git pull -q 2>&1)"; then
  echo "${SCRIPT_NAME}: warning: \`git pull\` failed in ${TOPLEVEL}:" >&2
  if [ -n "${PULL_OUTPUT}" ]; then
    echo "${PULL_OUTPUT}" >&2
  fi
  if [ -n "$(git ls-files --unmerged)" ]; then
    echo "${SCRIPT_NAME}: ERROR: the failed pull left conflicts in ${TOPLEVEL}." >&2
    echo "${SCRIPT_NAME}: Resolve them, or run \`git merge --abort\`, then re-run ${SCRIPT_NAME}." >&2
    exit 1
  fi
  echo "${SCRIPT_NAME}: continuing, using the current commit of ${TOPLEVEL}." >&2
fi

# Determine which remote the new branch would collide with:  the remote that
# `git push` would use for the current branch, as `push_remote` in
# remote-functions.sh determines it, which is also the remote that
# `is-deleted-branch` and `git-push-to` use.  The new branch has no
# configuration of its own yet -- `git checkout -b` creates none -- and the new
# working copy is a copy of this one, so this branch's configuration is what
# says which remote the new branch would eventually be pushed to.
#
# ${REMOTE} is empty if no remote can be determined; then no remote can be
# asked, and only the local tests below apply.
BRANCH_REF="$(git symbolic-ref --quiet HEAD 2> /dev/null)" || BRANCH_REF=''
REMOTE="$(push_remote . "${BRANCH_REF#refs/heads/}")"

# These tests precede the copy of the working copy, so that a name collision
# does not cost the user a full copy of the repository.  Every test that needs
# no network access comes first, including the tests for the directories, so
# that a purely local failure is reported without waiting for a remote -- which
# may take as long as a connection attempt takes to time out.

# A local branch has to be detected here rather than left to the
# `git checkout -b` below, which fails on one even when no remote has a branch
# of that name.
if git rev-parse --verify --quiet "refs/heads/${BRANCHNAME}" > /dev/null; then
  echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists in this clone." >&2
  exit 1
fi

# A remote-tracking branch for ${REMOTE} shows that the remote has the branch,
# without asking the remote.  Only ${REMOTE}'s refs are consulted:  a branch of
# the same name in another remote -- "upstream" in a fork workflow, say -- is a
# branch that neither `git checkout -b` nor a later push to ${REMOTE} would
# collide with, so refusing on account of one would refuse a name that the user
# can in fact use.
#
# "HEAD" is excluded:  a clone has a symbolic ref `refs/remotes/REMOTE/HEAD`
# that names the remote's default branch, so that ref resolves, but "HEAD" is
# not the name of a branch.
if [ -n "${REMOTE}" ] && [ "${BRANCHNAME}" != 'HEAD' ] \
  && git rev-parse --verify --quiet "refs/remotes/${REMOTE}/${BRANCHNAME}" \
    > /dev/null; then
  echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists on remote ${REMOTE}." >&2
  exit 1
fi

if [ -e "${BRANCHDIR}" ]; then
  echo "${SCRIPT_NAME}: ERROR: directory exists: ${BRANCHDIR}" >&2
  exit 1
fi
if [ -e "${BRANCH_TMPDIR}" ]; then
  echo "${SCRIPT_NAME}: ERROR: directory exists: ${BRANCH_TMPDIR}" >&2
  exit 1
fi

# This clone shows no such branch, so ask the remote itself:  the clone may
# never have fetched the branch, or may not fetch it at all.
#
# Asking the remote does not change it.  This script creates nothing outside
# the new directory:  in particular, it does not push the new branch.
#
# `git_batch_ssh` disables the interactive prompts that would otherwise block
# this query forever when this script is run from another script or a CI job,
# as `is-deleted-branch` does for its own queries.
# A remote that this script cannot ask is not an error; the branch is created.
if [ -n "${REMOTE}" ] \
  && git_batch_ssh . ls-remote --exit-code "${REMOTE}" \
    "refs/heads/${BRANCHNAME}" > /dev/null 2>&1; then
  echo "${SCRIPT_NAME}: ERROR: branch ${BRANCHNAME} already exists on remote ${REMOTE}." >&2
  exit 1
fi

# The test above showed that ${BRANCH_TMPDIR} does not exist, and nothing
# between there and here creates it, so whatever the copy leaves at that
# location was created by this script and the traps may remove it, even if the
# copy is interrupted before it finishes.
TMPDIR_TO_CLEAN="${BRANCH_TMPDIR}"
if ! \cp -Rp -- . "${BRANCH_TMPDIR}"; then
  echo "${SCRIPT_NAME}: ERROR: cannot copy $(pwd) to ${BRANCH_TMPDIR}" >&2
  exit 1
fi
if ! (cd -- "${BRANCH_TMPDIR}" && git checkout -b "${BRANCHNAME}" -q); then
  echo "${SCRIPT_NAME}: ERROR in: (cd -- \"${BRANCH_TMPDIR}\" && git checkout -b \"${BRANCHNAME}\" -q)" >&2
  exit 1
fi

if ! mv -- "${BRANCH_TMPDIR}" "${BRANCHDIR}"; then
  echo "${SCRIPT_NAME}: ERROR in: mv -- \"${BRANCH_TMPDIR}\" \"${BRANCHDIR}\"" >&2
  exit 1
fi
TMPDIR_TO_CLEAN=""

echo "Success: created ${BRANCHDIR}"
