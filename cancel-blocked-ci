#!/usr/bin/env python3
"""Cancel the unfinished CI runs of blocked PRs.

Usage (run in the directory that holds the working copy directories):
  cancel-blocked-ci             # cancel the runs
  cancel-blocked-ci --dry-run   # report the runs that would be cancelled (alias: -n)

A PR is blocked if it depends on another open PR.

The builds of a blocked PR are those of its head branch that the PR or a push
started.  If the head branch is the repository's default branch (as for a PR that
merges the default branch into a release branch), they are only the builds that the
PR started.

The CI systems are GitHub Actions, Azure Pipelines, and CircleCI.  For Azure
Pipelines and CircleCI, only the builds of each blocked PR's head commit are
cancelled.

Cancelling a build requires credentials, as described in `ci_build.py`.

The exit status is 1 if finding or cancelling any build failed, and 0 otherwise.
"""

import argparse
import concurrent.futures
import functools
import importlib.machinery
import importlib.util
import json
import pathlib
import re
import shutil
import subprocess
import sys
import types

import ci_build
import request_util

PROGRAM = pathlib.Path(sys.argv[0]).name

# True if finding or cancelling any build failed.
failed = False


def report_failure(message):
    """Report that finding or cancelling a build failed, and make the exit status 1.

    Args:
        message: a description of the failure.
    """
    global failed
    failed = True
    print(message, file=sys.stderr)


def load_pr_status() -> types.ModuleType:
    """Import the pr-status script, whose name is not a legal module name.

    Returns:
        The imported module.
    """
    path = pathlib.Path(__file__).resolve().parent / "pr-status"
    if not path.exists():
        found = shutil.which("pr-status.py")
        if found is None:
            sys.exit(f"{PROGRAM}: cannot find pr-status or pr-status.py")
        path = pathlib.Path(found)
    loader = importlib.machinery.SourceFileLoader("pr_status", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


pr_status = load_pr_status()


# The statuses of unfinished GitHub Actions runs.
GITHUB_UNFINISHED_STATUSES = ["queued", "in_progress", "waiting", "requested", "pending"]
# The statuses of Azure Pipelines builds that have finished or are being cancelled.
AZURE_FINISHED_STATUSES = {"completed", "cancelling"}
# The statuses of unfinished CircleCI workflows.
CIRCLECI_UNFINISHED_STATUSES = {"running", "on_hold", "failing"}

# Matches a branch that holds a PR, such as "refs/pull/123/merge" or "pull/123".
PULL_BRANCH = re.compile(r"(?:refs/)?pull/(\d+)(?:/merge|/head)?")


def pr_name(label, ref):
    """Name a PR in output.

    Args:
        label: the name of the PR's repository in output (by default, the repository's
            name, such as "daikon").
        ref: the reference to the PR, such as "#555" or "daikon#555".

    Returns:
        ref, preceded by the repository's label if ref is a bare "#N".
    """
    return f"{label} {ref}" if ref.startswith("#") else ref


def blocked_prs(cfg):
    """Find the blocked PRs, as pr-status computes them from its config cfg.

    Args:
        cfg: the pr-status config, as pr-status-config.json holds it or as pr-status
            constructs it by default.

    Returns:
        For each repository, a tuple of its label, its GitHub slug (such as "ORG/REPO"),
        its default branch, and a list of the reference and gh JSON of each of its
        blocked PRs.
    """
    return [
        (
            m.repo.label,
            m.repo.gh,
            m.repo.default_branch,
            [(m.repo.ref(n), m.repo.prs[n]) for n in m.blocked()],
        )
        for m in pr_status.load_models(cfg, pairwise=False)
    ]


def concurrently(f, items):
    """Call f on each of the items, concurrently.

    Args:
        f: a function of one argument.
        items: the arguments for f.

    Returns:
        A list of the results, in the order of the items.

    Raises:
        Exception: if a call raises an exception; the first such exception, in the order
            of the items.  It is raised after the calls that have started have finished.
            The calls that have not started are cancelled.
    """  # ruff: ignore[docstring-extraneous-exception]  -- executor.map re-raises f's exceptions
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        return list(executor.map(f, items))


def unfinished_runs(gh):
    """Find the runs in the GitHub repository gh that have not completed.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".

    Returns:
        A map from (head repository owner, branch) to the unfinished runs of that branch.
    """
    runs = {}  # id -> run; a run whose status changes between queries appears in two
    for pages in concurrently(
        lambda status: request_util.gh_api(
            f"repos/{gh}/actions/runs?status={status}&per_page=100", paginate=True
        ),
        GITHUB_UNFINISHED_STATUSES,
    ):
        for page in pages:
            for r in page["workflow_runs"]:
                runs[r["id"]] = r
    result = {}
    for r in runs.values():
        result.setdefault((run_owner(r), r["head_branch"]), []).append(r)
    return result


def run_owner(r):
    """Find the owner of the repository whose branch the GitHub Actions run r tests.

    Args:
        r: the run, as the GitHub API describes it.

    Returns:
        The owner's login, or None if the repository is gone.
    """
    return (r["head_repository"] or {}).get("owner", {}).get("login")


def branch_name(branch):
    """Name a branch the same way, whatever the CI service.

    Args:
        branch: the branch, such as "main", "refs/heads/main", "pull/123", or
            "refs/pull/123/merge".

    Returns:
        "pull/N" if branch holds PR N, and otherwise branch without "refs/heads/".
    """
    if match := PULL_BRANCH.fullmatch(branch):
        return f"pull/{match[1]}"
    return branch.removeprefix("refs/heads/")


def pipeline_branch(p):
    """Find the branch of a CircleCI pipeline.

    Args:
        p: the pipeline, as the CircleCI API describes it.

    Returns:
        The pipeline's branch, such as "main" or "pull/123", or else its tag, or else None.
    """
    vcs = p.get("vcs") or {}
    return vcs.get("branch") or vcs.get("tag")


def github_build(gh, r):
    """Describe the GitHub Actions run r in the GitHub repository gh.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".
        r: the run, as the GitHub API describes it.

    Returns:
        The status, description, URL, and cancelling function of r.
        The cancelling function takes no arguments.
    """
    return (
        r["status"],
        f"run {r['id']} ({r['name']})",
        r["html_url"],
        unless_finished(
            lambda: request_util.run(["gh", "run", "cancel", "-R", gh, str(r["id"])]),
            lambda: (
                request_util.gh_api(f"repos/{gh}/actions/runs/{r['id']}")["status"] == "completed"
            ),
        ),
    )


def unless_finished(cancelling, finished):
    """Make a cancelling function that does not fail for a build that has finished.

    A build can finish after it is found and before it is cancelled.

    Args:
        cancelling: a function of no arguments that cancels the build.
        finished: a function of no arguments that returns True if the build has finished.

    Returns:
        A function of no arguments that calls cancelling.  If cancelling fails, the
        function raises the failure unless finished returns true.
    """

    def cancel():
        try:
            cancelling()
        except request_util.REQUEST_ERRORS:
            try:
                done = finished()
            except request_util.REQUEST_ERRORS:
                done = False
            if not done:
                raise

    return cancel


@functools.cache
def warn_if_no_circleci_token():
    """If there is no CircleCI token, warn (only once) that CircleCI will refuse to cancel."""
    if not ci_build.circleci_token():
        print(
            f"{PROGRAM}: no CircleCI token found in $CIRCLECI_CLI_TOKEN or in "
            + " or ".join(ci_build.CIRCLECI_CONFIGS)
            + ", so CircleCI will refuse to cancel workflows;"
            " create a personal API token and run `circleci setup`",
            file=sys.stderr,
        )


@functools.cache
def checks(gh, sha):
    """Find the check runs and commit statuses of commit sha in the GitHub repository gh.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".
        sha: the commit.

    Returns:
        A list of the status ("completed" if it has completed), name, and URL of each
        check run and commit status that has a URL.
    """
    result = []
    for page in request_util.gh_api(
        f"repos/{gh}/commits/{sha}/check-runs?per_page=100", paginate=True
    ):
        result.extend(
            (c["status"], c["name"], c["details_url"])
            for c in page["check_runs"]
            if c["details_url"]
        )
    for page in request_util.gh_api(f"repos/{gh}/commits/{sha}/status?per_page=100", paginate=True):
        result.extend(
            ("pending" if s["state"] == "pending" else "completed", s["context"], s["target_url"])
            for s in page["statuses"]
            if s["target_url"]
        )
    return result


def azure_build(status, org, project, build, name, url):
    """Describe an Azure Pipelines build.

    Args:
        status: the build's status, as GitHub names it, such as "queued" or "in_progress".
        org: the Azure DevOps organization.
        project: the Azure DevOps project.
        build: the ID of the build.
        name: a name for the build, such as its pipeline's name.
        url: the URL of the build's web page.

    Returns:
        The status, description, URL, and cancelling function of the build.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.azure_api(org, project, build)}?api-version=7.1"
    return (
        status,
        f"Azure Pipelines build {build} ({name})",
        url,
        unless_finished(
            lambda: ci_build.azure_request(
                "PATCH", api, ci_build.azure_headers(), {"status": "cancelling"}
            ),
            lambda: azure_build_state(org, project, build)[1],
        ),
    )


def circleci_build(status, workflow, name):
    """Describe a CircleCI workflow.

    Args:
        status: the workflow's status, such as "running" or "pending".
        workflow: the id of the workflow.
        name: a name for the workflow, such as its name or the name of one of its jobs.

    Returns:
        The status, description, URL, and cancelling function of the workflow.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}/cancel"

    def cancelling():
        warn_if_no_circleci_token()
        request_util.request("POST", api, ci_build.circleci_headers())

    return (
        status,
        f"CircleCI workflow {workflow} ({name})",
        f"https://app.circleci.com/workflow/{workflow}",
        unless_finished(cancelling, lambda: circleci_workflow_state(workflow)[1]),
    )


def is_default_branch(gh, default_branch, pr):
    """Return True if a PR's head branch is the default branch of its repository.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        default_branch: the repository's default branch.
        pr: the gh JSON of the PR.

    Returns:
        True if the PR's head branch is the repository's default branch.
    """
    return pr["owner"].lower() == gh.split("/")[0].lower() and pr["headRefName"] == default_branch


def blocked_pr_runs(pr, runs, on_default_branch):
    """Find the unfinished GitHub Actions runs of a blocked PR.

    The runs of the PR are the runs of its head branch that the PR or a push started.
    If the head branch is the repository's default branch, they are only the runs that
    the PR started.  A run that another open PR with the same head branch started is
    indistinguishable from a run that this PR started.

    Args:
        pr: the gh JSON of the PR.
        runs: the unfinished runs, as unfinished_runs returns them.
        on_default_branch: True if the PR's head branch is the repository's default branch.

    Returns:
        A list of the runs.
    """
    events = {"pull_request"} if on_default_branch else {"pull_request", "push"}
    return [r for r in runs.get((pr["owner"], pr["headRefName"]), []) if r["event"] in events]


def pr_branches(gh, pr, on_default_branch):
    """Find the branches whose builds are a PR's builds.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        pr: the gh JSON of the PR.
        on_default_branch: True if the PR's head branch is the repository's default branch.

    Returns:
        A set of the branches, named as branch_name names them:  "pull/N" for the PR's
        number N, and the PR's head branch if it is a branch of gh other than the
        default branch.
    """
    result = {f"pull/{pr['number']}"}
    if pr["owner"].lower() == gh.split("/")[0].lower() and not on_default_branch:
        result.add(pr["headRefName"])
    return result


def azure_build_state(org, project, build):
    """Find the branch of an Azure Pipelines build, and whether it has finished.

    Args:
        org: the Azure DevOps organization.
        project: the Azure DevOps project.
        build: the ID of the build.

    Returns:
        The build's source branch, such as "refs/heads/main" or "refs/pull/123/merge",
        and whether the build has finished or is being cancelled.
    """
    record = ci_build.azure_get(f"{ci_build.azure_api(org, project, build)}?api-version=7.1")
    return record["sourceBranch"], record["status"] in AZURE_FINISHED_STATUSES


def circleci_workflow_state(workflow):
    """Find the branch of a CircleCI workflow, and whether it has finished.

    Args:
        workflow: the id of the workflow.

    Returns:
        The branch of the workflow's pipeline, as pipeline_branch returns it, and
        whether the workflow has finished.
    """
    w = request_util.request(
        "GET", f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}", ci_build.circleci_headers()
    )
    finished = w["status"] not in CIRCLECI_UNFINISHED_STATUSES
    return circleci_pipeline_branch(w["pipeline_id"]), finished


@functools.cache
def circleci_pipeline_branch(pipeline):
    """Find the branch of the CircleCI pipeline with the given id.

    Args:
        pipeline: the id of the pipeline.

    Returns:
        The pipeline's branch, as pipeline_branch returns it.
    """
    return pipeline_branch(
        request_util.request(
            "GET", f"{ci_build.CIRCLECI_API}/v2/pipeline/{pipeline}", ci_build.circleci_headers()
        )
    )


def unfinished_other_builds(subject, gh, sha, branches):
    """Find the unfinished Azure Pipelines and CircleCI builds of commit sha on some branches.

    Args:
        subject: what the builds test, such as a PR, which a report of a problem names.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        sha: the commit.
        branches: the branches, named as branch_name names them.

    Returns:
        A list of the identifier and build of each build.  A build is its status,
        description, URL, and cancelling function, which takes no arguments.
    """
    # identifier -> build, and a function of no arguments that returns the build's branch
    # and whether the build has finished
    builds = {}
    jobs = []  # the status, name, and URL of each job whose URL names no workflow
    for state, name, url in checks(gh, sha):
        if state == "completed":
            continue
        if parsed := ci_build.parse_azure_url(url):
            org, project, build = parsed
            builds.setdefault(
                ("azure", org, str(build)),
                (
                    azure_build(state, org, project, build, name, url),
                    functools.partial(azure_build_state, org, project, build),
                ),
            )
        elif (parsed := ci_build.parse_circleci_url(url)) is not None:
            workflow, project, job = parsed
            if workflow is not None:
                builds.setdefault(("circleci", workflow), circleci_build_on(state, workflow, name))
            elif project is not None and job is not None:
                jobs.append((state, name, url))
            else:
                print(f"{subject}: no CircleCI workflow found for {url}", file=sys.stderr)
    for workflow, (state, name) in circleci_workflows_of_jobs(subject, jobs):
        builds.setdefault(("circleci", workflow), circleci_build_on(state, workflow, name))
    items = list(builds.items())
    result = []
    for (identifier, (build, _)), found in zip(
        items,
        concurrently(functools.partial(build_state, subject), list(builds.values())),
        strict=True,
    ):
        if found is None:  # build_state reported the failure.
            continue
        branch, finished = found
        # GitHub can show a build as unfinished after it finishes.
        if finished:
            continue
        if branch is None:
            print(f"{subject}: not cancelling {build[2]}, whose branch is unknown", file=sys.stderr)
        # Other branches can be at commit sha too.
        elif branch_name(branch) in branches:
            result.append((identifier, build))
    return result


def build_state(subject, build_and_state_of):
    """Find the branch of a build and whether it has finished, reporting any failure.

    Args:
        subject: what the build tests, such as a PR, which a report of a failure names.
        build_and_state_of: the build (its status, description, URL, and cancelling
            function) and a function of no arguments that returns its branch (None if it
            has none) and whether it has finished.

    Returns:
        The build's branch and whether it has finished, or None if finding them fails.
    """
    build, state_of = build_and_state_of
    try:
        return state_of()
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{subject}: failed to find the branch of {build[2]}: {request_util.failure(e)}"
        )
        return None


def circleci_build_on(status, workflow, name):
    """Describe a CircleCI workflow, and how to find its branch and whether it has finished.

    Args:
        status: the workflow's status, such as "running" or "pending".
        workflow: the id of the workflow.
        name: a name for the workflow, such as its name or the name of one of its jobs.

    Returns:
        The workflow, as circleci_build describes it, and a function of no arguments
        that returns its branch and whether it has finished.
    """
    return (
        circleci_build(status, workflow, name),
        functools.partial(circleci_workflow_state, workflow),
    )


def circleci_workflows_of_jobs(subject, jobs):
    """Find the CircleCI workflows of unfinished jobs, whose URLs name no workflow.

    Args:
        subject: what the jobs test, such as a PR, which a report of a problem names.
        jobs: the status, name, and URL of each job.

    Returns:
        A list of the id, and the status and name, of each workflow.
    """

    def lookup(url):
        """Find the workflow of a CircleCI job.

        Args:
            url: the URL of the job.

        Returns:
            The workflow id (None if there is none) and None, or None and the exception
            that the lookup raised.
        """
        try:
            return ci_build.circleci_workflow_of_url(url)[0], None
        except request_util.REQUEST_ERRORS as e:
            return None, e

    result = []
    failures = []
    for (state, name, url), (workflow, error) in zip(
        jobs, concurrently(lookup, [url for _, _, url in jobs]), strict=True
    ):
        if error is not None:
            failures.append(error)
        elif workflow is None:
            print(f"{subject}: no CircleCI workflow found for {url}", file=sys.stderr)
        else:
            result.append((workflow, (state, name)))
    if failures:
        report_failure(
            f"{subject}: failed to look up {len(failures)} CircleCI job(s):"
            f" {request_util.failure(failures[0])}"
        )
    return result


def blocked_pr_builds(label, gh, default_branch, runs, blocked):
    """Find the unfinished builds of a blocked PR.

    Args:
        label: the label of the PR's repository.
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        default_branch: the repository's default branch.
        runs: the unfinished GitHub Actions runs, as unfinished_runs returns them.
        blocked: the reference to the PR, such as "#555", and the gh JSON of the PR.

    Returns:
        A list of the identifier and build of each build.  A build is its status,
        description, URL, and cancelling function, which takes no arguments.
    """
    ref, pr = blocked
    on_default_branch = is_default_branch(gh, default_branch, pr)
    builds = [
        (("github", r["id"]), github_build(gh, r))
        for r in blocked_pr_runs(pr, runs, on_default_branch)
    ]
    try:
        builds += unfinished_other_builds(
            pr_name(label, ref), gh, pr["headRefOid"], pr_branches(gh, pr, on_default_branch)
        )
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{pr_name(label, ref)}: failed to find Azure Pipelines and CircleCI"
            f" builds: {request_util.failure(e)}"
        )
    return builds


def cancel(cancelling, url):
    """Call the cancelling function, reporting any failure.

    Args:
        cancelling: a function of no arguments that cancels the build.
        url: the URL of the build, which the report of a failure names.
    """
    try:
        cancelling()
    except request_util.REQUEST_ERRORS as e:
        report_failure(f"  failed to cancel {url}: {request_util.failure(e)}")


def handle(subject, build, dry_run):
    """Cancel, or if dry_run is true report, the build of subject.

    Args:
        subject: what the build tests, such as a PR.
        build: the status, description, URL, and cancelling function of the build.
        dry_run: True if the build should be reported but not cancelled.
    """
    status, description, url, cancelling = build
    print(f"{subject}: {'would cancel' if dry_run else 'cancelling'} {status} {description}")
    if not dry_run:
        cancel(cancelling, url)


def main():
    """Cancel, or with --dry-run report, the builds of blocked PRs."""
    parser = argparse.ArgumentParser(
        prog=PROGRAM, description=__doc__.splitlines()[0] if __doc__ else None
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="report the builds but do not cancel them"
    )
    dry_run = parser.parse_args().dry_run
    base = pathlib.Path.cwd()
    # The current directory holds the working copy directories; it is not one of them.
    toplevel = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], check=False, capture_output=True, text=True
    )
    if toplevel.returncode == 0:
        sys.exit(
            f"{PROGRAM}: {base} is in the git working copy {toplevel.stdout.strip()}; "
            f"run {PROGRAM} in the directory that holds the working copy directories"
        )
    if pathlib.Path(pr_status.CONFIG).exists():
        with pathlib.Path(pr_status.CONFIG).open() as f:
            cfg = json.load(f)
    else:
        try:
            cfg = pr_status.default_config(str(base))
        except pr_status.ConfigError as e:
            sys.exit(f"{PROGRAM}: {e}")
    try:
        repos = blocked_prs(cfg)
    except request_util.REQUEST_ERRORS as e:
        sys.exit(f"{PROGRAM}: failed to find the blocked PRs: {request_util.failure(e)}")
    for label, gh, default_branch, blocked in repos:
        try:
            runs = unfinished_runs(gh)
        except request_util.REQUEST_ERRORS as e:
            report_failure(
                f"{label}: failed to find unfinished GitHub Actions runs: {request_util.failure(e)}"
            )
            runs = {}
        handled = set()  # identifiers of the builds that have been cancelled or reported
        for (ref, _), builds in zip(
            blocked,
            concurrently(
                functools.partial(blocked_pr_builds, label, gh, default_branch, runs), blocked
            ),
            strict=True,
        ):
            for identifier, build in builds:
                if identifier not in handled:
                    handled.add(identifier)
                    handle(pr_name(label, ref), build, dry_run)
    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
