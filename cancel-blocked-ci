#!/usr/bin/env python3
"""Cancel the unfinished CI runs of blocked PRs, and redundant CI runs.

Usage (run in the directory that holds the PR status documents, as for pr-status):
  cancel-blocked-ci             # cancel the runs
  cancel-blocked-ci --dry-run   # report the runs that would be cancelled (alias: -n)

A PR is blocked if it depends on another open PR, as pr-status computes it from
pr-status-config.json or, if there is no pr-status-config.json, from the config that
pr-status constructs by default.  Excluded PRs are never blocked.

The builds of a blocked PR are those of its head branch that the PR or a push
started.  If the head branch is the repository's default branch (as for a PR that
merges the default branch into a release branch), they are only the GitHub Actions
runs that the PR started.

A build is redundant if a push or a pull request started it, and a more recent
build of the same workflow (for Azure Pipelines, of the same pipeline), for the
same event, is on the same branch and is running or queued to run -- for example,
when several pushes to the main branch each started a build.  A manual or
scheduled build is never redundant, because it can differ from a more recent one in
its inputs or its schedule.  Nor is a build redundant because of a more recent one
that waits for an approval or for a concurrency group (for Azure Pipelines, for a
check of a stage, such as an approval or an exclusive lock), because the more
recent one might never run.  The script cancels redundant builds in every repository that the
config describes.

The CI systems are GitHub Actions, Azure Pipelines, and CircleCI.  For Azure
Pipelines and CircleCI, only the builds of each blocked PR's head commit are
cancelled.  The Azure Pipelines projects of a repository are those that built
the head commit of its default branch or of any of its 5 most recently created
open PRs.  The CircleCI projects of a repository are those that built the head
commit of its default branch, and only their pipelines from the past day can be
redundant.

Cancelling a build requires credentials, as described in `ci_build.py`.

This script uses the `pr-status` script, which it finds in its own directory or, as
`pr-status.py`, on the PATH.
"""

import argparse
import collections
import concurrent.futures
import datetime as dt
import functools
import importlib.machinery
import importlib.util
import json
import operator
import pathlib
import re
import shutil
import subprocess
import sys
import types
import urllib.error
import urllib.parse

import ci_build

PROGRAM = pathlib.Path(sys.argv[0]).name


def load_pr_status() -> types.ModuleType:
    """Import the pr-status script, whose name is not a legal module name.

    Returns:
        The imported module.
    """
    path = pathlib.Path(__file__).resolve().parent / "pr-status"
    if not path.exists():
        found = shutil.which("pr-status.py")
        if found is None:
            sys.exit(f"{PROGRAM}: cannot find pr-status or pr-status.py")
        path = pathlib.Path(found)
    loader = importlib.machinery.SourceFileLoader("pr_status", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


pr_status = load_pr_status()


UNFINISHED = ["queued", "in_progress", "waiting", "requested", "pending"]

# The events, reasons, and trigger types of the GitHub Actions runs, Azure Pipelines
# builds, and CircleCI pipelines that a more recent build can make redundant:  those
# that a push or a pull request started.
GITHUB_REDUNDANT_EVENTS = {"push", "pull_request"}
AZURE_REDUNDANT_REASONS = {"individualCI", "batchedCI", "pullRequest"}
CIRCLECI_REDUNDANT_TRIGGERS = {"webhook"}
# The statuses of the GitHub Actions runs and CircleCI workflows that can make an
# older build redundant:  those that are running or queued to run, and not those that
# wait for an approval or for a concurrency group.
GITHUB_SUPERSEDING = {"requested", "queued", "in_progress"}
CIRCLECI_SUPERSEDING = {"running", "failing"}

# The statuses of unfinished CircleCI workflows.
CIRCLECI_UNFINISHED = {"running", "on_hold", "failing"}
# How long ago a CircleCI pipeline can have been created and still have an unfinished workflow.
CIRCLECI_WINDOW = dt.timedelta(days=1)
# The statuses of unfinished Azure Pipelines builds, and the corresponding GitHub statuses.
AZURE_UNFINISHED = {"inProgress": "in_progress", "notStarted": "queued"}
# A branch that holds a PR, such as "refs/pull/123/merge" or "pull/123".
PULL_BRANCH = re.compile(r"(?:refs/)?pull/(\d+)(?:/merge|/head)?")


def pr_name(label, ref):
    """Name a PR in output.

    Returns:
        ref, preceded by the repository's label unless ref already starts with it.
    """
    return ref if ref.startswith(label) else f"{label} {ref}"


def blocked_prs(cfg):
    """Find the blocked PRs, as pr-status computes them from its config cfg.

    Returns:
        For each repository, a tuple of its label, its GitHub name, its default branch,
        a list of the head commits of its 5 most recently created open PRs, and a list
        of the reference and gh JSON of each of its blocked PRs.
    """
    return [
        (
            m.repo.label,
            m.repo.gh,
            m.repo.default_branch,
            [m.repo.prs[n]["headRefOid"] for n in sorted(m.repo.prs)[-5:]],
            [(m.repo.ref(n), m.repo.prs[n]) for n in m.blocked()],
        )
        for m in pr_status.load_models(cfg, pairwise=False)
    ]


def concurrently(f, items):
    """Call f on each of the items, concurrently.

    If a call raises an exception, this raises the first such exception, in the order of
    the items.

    Returns:
        A list of the results, in the order of the items.
    """
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        return list(executor.map(f, items))


def unfinished_runs(gh):
    """Find the runs in the GitHub repository gh that have not completed.

    Returns:
        A map from (head repository owner, branch) to the unfinished runs of that branch.
    """
    runs = {}  # id -> run; a run whose status changes between queries appears in two
    for pages in concurrently(
        lambda status: ci_build.gh_api(
            f"repos/{gh}/actions/runs?status={status}&per_page=100", paginate=True
        ),
        UNFINISHED,
    ):
        for page in pages:
            for r in page["workflow_runs"]:
                runs[r["id"]] = r
    result = {}
    for r in runs.values():
        result.setdefault((run_owner(r), r["head_branch"]), []).append(r)
    return result


def run_owner(r):
    """Find the owner of the repository whose branch the GitHub Actions run r tests.

    Returns:
        The owner's login, or None if the repository is gone.
    """
    return (r["head_repository"] or {}).get("owner", {}).get("login")


def superseded(builds, key, order, can_supersede):
    """Find the builds that a more recent build with the same key makes redundant.

    Args:
        builds: the builds.
        key: a function from a build to what it must share with the builds that make
            it redundant.
        order: a function from a build to a value that is greater for more recent builds.
        can_supersede: a function from a build to whether it can make older builds
            redundant.

    Returns:
        A list of pairs of a redundant build and the most recent build with its key that
        can make it redundant.
    """
    groups = {}
    for b in builds:
        groups.setdefault(key(b), []).append(b)
    result = []
    for group in groups.values():
        if len(group) < 2:  # Avoid calling can_supersede, which can be costly.
            continue
        group.sort(key=order, reverse=True)
        latest = next((i for i, b in enumerate(group) if can_supersede(b)), len(group))
        result.extend((b, group[latest]) for b in group[latest + 1 :])
    return result


def branch_subject(label, branch):
    """Name a branch of the repository with the given label in output.

    Returns:
        A reference to the PR if branch holds a PR, and otherwise label and branch.
    """
    if match := PULL_BRANCH.fullmatch(branch):
        return f"{label}#{match[1]}"
    return f"{label} {branch.removeprefix('refs/heads/')}"


def redundant_runs(label, gh, runs):
    """Find the redundant unfinished GitHub Actions runs in the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        runs: a map from (head repository owner, branch) to the unfinished runs of that
            branch, as unfinished_runs returns it.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant run.
    """
    result = []
    for (owner, branch), branch_runs in runs.items():
        if not owner:  # Runs of different deleted forks are indistinguishable.
            continue
        name = branch if owner.lower() == gh.split("/")[0].lower() else f"{owner}:{branch}"
        for r, latest in superseded(
            [r for r in branch_runs if r["event"] in GITHUB_REDUNDANT_EVENTS],
            operator.itemgetter("workflow_id", "event"),
            operator.itemgetter("created_at"),
            lambda r: r["status"] in GITHUB_SUPERSEDING,
        ):
            result.append(
                (
                    ("github", r["id"]),
                    f"{label} {name}",
                    github_build(gh, r),
                    f", made redundant by run {latest['id']}",
                )
            )
    return result


def azure_projects(gh, pr_shas):
    """Find the Azure Pipelines projects that build the GitHub repository gh.

    Args:
        gh: the repository's GitHub name.
        pr_shas: the head commits of some of gh's open PRs.

    Returns:
        A set of the organization and project of each Azure Pipelines project that
        built the head commit of gh's default branch or of one of pr_shas, or the empty
        set if the Azure Pipelines app has no check suite for the head commit of the
        default branch.
    """
    suites = ci_build.gh_api(f"repos/{gh}/commits/HEAD/check-suites?per_page=100")
    if not any(s["app"]["slug"] == "azure-pipelines" for s in suites["check_suites"]):
        return set()
    return {
        parsed[:2]
        for sha_checks in concurrently(lambda sha: checks(gh, sha), ["HEAD", *pr_shas])
        for _, _, url in sha_checks
        if (parsed := ci_build.parse_azure_url(url))
    }


def azure_build_waits(org, project, build):
    """Determine whether an Azure Pipelines build waits for a check of a stage.

    A check is, for example, an approval or an exclusive lock.

    Returns:
        True if a check of a stage of the build is in progress.
    """
    timeline = ci_build.azure_get(
        f"{ci_build.azure_api(org, project, build)}/timeline?api-version=7.1"
    )
    return any(
        r.get("type", "").startswith("Checkpoint") and r.get("state") == "inProgress"
        for r in (timeline or {}).get("records") or []
    )


def redundant_azure_builds(label, gh, org, project):
    """Find the redundant unfinished builds of the GitHub repository gh in an Azure project.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        org: the Azure DevOps organization.
        project: the Azure DevOps project.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant build.
    """
    builds = ci_build.azure_get(
        f"{ci_build.azure_api(org, project)}?statusFilter={','.join(AZURE_UNFINISHED)}"
        f"&repositoryId={urllib.parse.quote(gh, safe='')}&repositoryType=GitHub"
        "&api-version=7.1"
    )["value"]
    return [
        (
            ("azure", org, str(b["id"])),
            branch_subject(label, b["sourceBranch"]),
            azure_build(
                AZURE_UNFINISHED.get(b["status"], b["status"]),
                org,
                project,
                str(b["id"]),
                b["definition"]["name"],
                b["_links"]["web"]["href"],
            ),
            f", made redundant by build {latest['id']}",
        )
        for b, latest in superseded(
            [b for b in builds if b["reason"] in AZURE_REDUNDANT_REASONS],
            lambda b: (b["definition"]["id"], b["reason"], b["sourceBranch"]),
            operator.itemgetter("id"),
            lambda b: not azure_build_waits(org, project, b["id"]),
        )
    ]


def redundant_circleci_workflows(label, gh):
    """Find the redundant unfinished CircleCI workflows of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant workflow.
    """
    projects = {
        # A URL without a project slug is of the project that GitHub's OAuth app connects.
        ci_build.circleci_project_of_url(url) or f"gh/{gh}"
        for _, _, url in checks(gh, "HEAD")
        if ci_build.parse_circleci_url(url) is not None
    }
    # the project, branch, and pipeline of each recent pipeline that can be redundant
    pipelines = [
        (project, branch, p)
        for project in sorted(projects)
        for branch, p in recent_pipelines(project)
    ]
    # A pipeline's workflows can be redundant only if its branch has another pipeline.
    counts = collections.Counter((project, branch) for project, branch, _ in pipelines)
    pipelines = [pbp for pbp in pipelines if counts[pbp[:2]] > 1]
    # the project, branch, pipeline, and workflow of each unfinished workflow
    workflows = [
        (project, branch, p, w)
        for (project, branch, p), pipeline_workflows in zip(
            pipelines,
            concurrently(lambda pbp: unfinished_workflows(pbp[2]["id"]), pipelines),
            strict=True,
        )
        for w in pipeline_workflows
    ]
    return [
        (
            ("circleci", w["id"]),
            branch_subject(label, branch),
            circleci_build(w["status"], w["id"], w["name"]),
            f", made redundant by workflow {latest[3]['id']}",
        )
        for (_, branch, _, w), latest in superseded(
            workflows,
            lambda pbpw: (pbpw[0], pbpw[1], pbpw[3]["name"]),
            lambda pbpw: (pbpw[2]["number"], pbpw[3]["created_at"]),
            lambda pbpw: pbpw[3]["status"] in CIRCLECI_SUPERSEDING,
        )
    ]


@functools.cache
def recent_pipelines(project):
    """Find the recent pipelines of a CircleCI project that a push or a pull request started.

    Args:
        project: the project slug, such as "gh/ORG/REPO".

    Returns:
        A list of the branch and pipeline of each pipeline from the past day that a push
        or a pull request started, most recent first.
    """
    cutoff = dt.datetime.now(dt.UTC) - CIRCLECI_WINDOW
    result = []
    # The pipelines are listed most recent first.
    for p in ci_build.circleci_items(f"/v2/project/{project}/pipeline"):
        if dt.datetime.fromisoformat(p["created_at"]) < cutoff:
            break
        vcs = p.get("vcs") or {}
        branch = vcs.get("branch") or vcs.get("tag")
        if branch and p["trigger"]["type"] in CIRCLECI_REDUNDANT_TRIGGERS:
            result.append((branch, p))
    return result


@functools.cache
def unfinished_workflows(pipeline):
    """Find the unfinished workflows of the CircleCI pipeline with the given id.

    Returns:
        A list of the unfinished workflows, or the empty list if the pipeline no longer
        exists.
    """
    try:
        return [
            w
            for w in ci_build.circleci_items(f"/v2/pipeline/{pipeline}/workflow")
            if w["status"] in CIRCLECI_UNFINISHED
        ]
    except urllib.error.HTTPError as e:
        if e.code == 404:  # The pipeline was deleted after it was listed.
            return []
        raise


def redundant_builds(label, gh, runs, pr_shas):
    """Find the redundant unfinished builds of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        runs: the unfinished GitHub Actions runs, as unfinished_runs returns them.
        pr_shas: the head commits of some of gh's open PRs, whose checks show which
            Azure Pipelines projects build gh.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant build.
    """
    result = redundant_runs(label, gh, runs)
    try:
        projects = azure_projects(gh, pr_shas)
    except ci_build.REQUEST_ERRORS as e:
        print(
            f"{label}: failed to find the Azure Pipelines projects: {ci_build.failure(e)}",
            file=sys.stderr,
        )
        projects = set()
    for org, project in sorted(projects):
        # A failure in one project does not stop the examination of the others.
        try:
            result += redundant_azure_builds(label, gh, org, project)
        except ci_build.REQUEST_ERRORS as e:  # ruff: ignore[try-except-in-loop]
            print(
                f"{label}: failed to find redundant Azure Pipelines builds in {org}/{project}:"
                f" {ci_build.failure(e)}",
                file=sys.stderr,
            )
    try:
        result += redundant_circleci_workflows(label, gh)
    except ci_build.REQUEST_ERRORS as e:
        print(
            f"{label}: failed to find redundant CircleCI workflows: {ci_build.failure(e)}",
            file=sys.stderr,
        )
    return result


def github_build(gh, r):
    """Describe the GitHub Actions run r in the GitHub repository gh.

    Returns:
        The status, description, URL, and cancelling function of r.
        The cancelling function takes no arguments.
    """
    return (
        r["status"],
        f"run {r['id']} ({r['name']})",
        r["html_url"],
        lambda: ci_build.run(["gh", "run", "cancel", "-R", gh, str(r["id"])]),
    )


@functools.cache
def warn_if_no_circleci_token():
    """If there is no CircleCI token, warn (only once) that CircleCI will refuse to cancel."""
    if not ci_build.circleci_token():
        print(
            f"{PROGRAM}: no CircleCI token found in $CIRCLECI_CLI_TOKEN or in "
            + " or ".join(ci_build.CIRCLECI_CONFIGS)
            + ", so CircleCI will refuse to cancel workflows;"
            " create a personal API token and run `circleci setup`",
            file=sys.stderr,
        )


@functools.cache
def checks(gh, sha):
    """Find the check runs and commit statuses of commit sha in the GitHub repository gh.

    Returns:
        A list of the status ("completed" if it has completed), name, and URL of each
        check run and commit status that has a URL.
    """
    result = []
    for page in ci_build.gh_api(f"repos/{gh}/commits/{sha}/check-runs?per_page=100", paginate=True):
        result.extend(
            (c["status"], c["name"], c["details_url"])
            for c in page["check_runs"]
            if c["details_url"]
        )
    status = ci_build.gh_api(f"repos/{gh}/commits/{sha}/status")
    result.extend(
        ("pending" if s["state"] == "pending" else "completed", s["context"], s["target_url"])
        for s in status["statuses"]
        if s["target_url"]
    )
    return result


def azure_build(status, org, project, build, name, url):
    """Describe Azure Pipelines build number build, of the pipeline with the given name.

    Returns:
        The status, description, URL, and cancelling function of the build.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.azure_api(org, project, build)}?api-version=7.1"
    return (
        status,
        f"Azure Pipelines build {build} ({name})",
        url,
        lambda: ci_build.request("PATCH", api, ci_build.azure_headers(), {"status": "cancelling"}),
    )


def circleci_build(status, workflow, name):
    """Describe the CircleCI workflow with the given id and name.

    Returns:
        The status, description, URL, and cancelling function of the workflow.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}/cancel"

    def cancelling():
        warn_if_no_circleci_token()
        ci_build.request("POST", api, ci_build.circleci_headers())

    return (
        status,
        f"CircleCI workflow {workflow} ({name})",
        f"https://app.circleci.com/workflow/{workflow}",
        cancelling,
    )


def is_default_branch(gh, default_branch, pr):
    """Determine whether a PR's head branch is the default branch of its repository.

    Args:
        gh: the GitHub name of the PR's repository.
        default_branch: the repository's default branch.
        pr: the gh JSON of the PR.

    Returns:
        True if the PR's head branch is the repository's default branch.
    """
    return pr["owner"].lower() == gh.split("/")[0].lower() and pr["headRefName"] == default_branch


def blocked_pr_runs(pr, runs, on_default_branch):
    """Find the unfinished GitHub Actions runs of a blocked PR.

    The runs of the PR are the runs of its head branch that the PR or a push started.
    If the head branch is the repository's default branch, they are only the runs that
    the PR started.  A run that another open PR with the same head branch started is
    indistinguishable from a run that this PR started.

    Args:
        pr: the gh JSON of the PR.
        runs: the unfinished runs, as unfinished_runs returns them.
        on_default_branch: whether the PR's head branch is the repository's default branch.

    Returns:
        A list of the runs.
    """
    events = {"pull_request"} if on_default_branch else GITHUB_REDUNDANT_EVENTS
    return [r for r in runs.get((pr["owner"], pr["headRefName"]), []) if r["event"] in events]


def unfinished_other_builds(gh, sha):
    """Find the Azure Pipelines and CircleCI builds of commit sha that have not completed.

    Returns:
        A list of the identifier and build of each build.  A build is its status,
        description, URL, and cancelling function, which takes no arguments.
    """
    builds = {}  # identifier -> build
    jobs = {}  # project slug -> status, name, and URL of each job whose URL names no workflow
    for state, name, url in checks(gh, sha):
        if state == "completed":
            continue
        if parsed := ci_build.parse_azure_url(url):
            org, project, build = parsed
            builds.setdefault(
                ("azure", org, str(build)), azure_build(state, org, project, build, name, url)
            )
        elif (parsed := ci_build.parse_circleci_url(url)) is not None:
            workflow, project, job = parsed
            if workflow is not None:
                builds.setdefault(("circleci", workflow), circleci_build(state, workflow, name))
            elif project is not None and job is not None:
                jobs.setdefault(project, []).append((state, name, url))
            else:
                print(f"  no CircleCI workflow found for {url}", file=sys.stderr)
    for project, project_jobs in jobs.items():
        for workflow, (state, name) in circleci_workflows_of_jobs(project, sha, project_jobs):
            builds.setdefault(("circleci", workflow), circleci_build(state, workflow, name))
    return list(builds.items())


def circleci_workflows_of_jobs(project, sha, jobs):
    """Find the CircleCI workflows of unfinished jobs of commit sha, whose URLs name no workflow.

    The workflows are the unfinished workflows of the project's recent pipelines of
    commit sha that a push or a pull request started; finding redundant workflows has
    usually already read the list of those pipelines.  Only if there is no such
    pipeline with an unfinished workflow is each job looked up.  So a job of another
    pipeline of commit sha, such as one that the API started, is found only if there
    is no such pipeline.

    Args:
        project: the project slug of the jobs.
        sha: the commit.
        jobs: the status, name, and URL of each job.

    Returns:
        A list of the id, and the status and name, of each workflow.
    """
    try:
        workflows = [
            w
            for _, p in recent_pipelines(project)
            if p["vcs"].get("revision") == sha
            for w in unfinished_workflows(p["id"])
        ]
    except ci_build.REQUEST_ERRORS as e:
        print(
            f"  failed to list the pipelines of {project}: {ci_build.failure(e)}", file=sys.stderr
        )
        workflows = []
    if workflows:
        return [(w["id"], (w["status"], w["name"])) for w in workflows]

    def lookup(url):
        try:
            return ci_build.circleci_workflow_of_url(url)[0], None
        except ci_build.REQUEST_ERRORS as e:
            return None, e

    result = []
    failures = []
    for (state, name, url), (workflow, error) in zip(
        jobs, concurrently(lookup, [url for _, _, url in jobs]), strict=True
    ):
        if error is not None:
            failures.append(error)
        elif workflow is None:
            print(f"  no CircleCI workflow found for {url}", file=sys.stderr)
        else:
            result.append((workflow, (state, name)))
    if failures:
        print(
            f"  failed to look up {len(failures)} CircleCI job(s) of {sha}:"
            f" {ci_build.failure(failures[0])}",
            file=sys.stderr,
        )
    return result


def cancel(cancelling, url):
    """Call the cancelling function, reporting any failure, with the URL of the build."""
    try:
        cancelling()
    except ci_build.REQUEST_ERRORS as e:
        print(f"  failed to cancel {url}: {ci_build.failure(e)}", file=sys.stderr)


def handle(subject, build, dry_run, reason=""):
    """Cancel, or if dry_run is true report, the build of subject.

    Args:
        subject: what the build tests, such as a PR or a branch.
        build: the status, description, URL, and cancelling function of the build.
        dry_run: whether to only report the build.
        reason: text to append to the report.
    """
    status, description, url, cancelling = build
    print(
        f"{subject}: {'would cancel' if dry_run else 'cancelling'} {status} {description}{reason}"
    )
    if not dry_run:
        cancel(cancelling, url)


def main():
    """Cancel, or with --dry-run report, the builds of blocked PRs and redundant builds."""
    parser = argparse.ArgumentParser(
        prog=PROGRAM, description=__doc__.splitlines()[0] if __doc__ else None
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="report the builds but do not cancel them"
    )
    dry_run = parser.parse_args().dry_run
    base = pathlib.Path.cwd()
    # The current directory holds the working copies; it is not one of them.
    toplevel = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], check=False, capture_output=True, text=True
    )
    if toplevel.returncode == 0:
        sys.exit(
            f"{PROGRAM}: {base} is in the git working copy {toplevel.stdout.strip()}; "
            f"run {PROGRAM} in the directory that holds the working copies"
        )
    if pathlib.Path(pr_status.CONFIG).exists():
        with pathlib.Path(pr_status.CONFIG).open() as f:
            cfg = json.load(f)
    else:
        try:
            cfg = pr_status.default_config(str(base))
        except SystemExit as e:
            # Name this program, not pr-status, in the error message.
            if isinstance(e.code, str):
                sys.exit(PROGRAM + ": " + e.code.removeprefix("pr-status.py: "))
            raise
    for label, gh, default_branch, pr_shas, blocked in blocked_prs(cfg):
        try:
            runs = unfinished_runs(gh)
        except ci_build.REQUEST_ERRORS as e:
            print(
                f"{label}: failed to find unfinished GitHub Actions runs: {ci_build.failure(e)}",
                file=sys.stderr,
            )
            runs = {}
        handled = set()  # identifiers of the builds that have been cancelled or reported
        for identifier, subject, build, reason in redundant_builds(label, gh, runs, pr_shas):
            handled.add(identifier)
            handle(subject, build, dry_run, reason)
        for ref, pr in blocked:
            on_default_branch = is_default_branch(gh, default_branch, pr)
            builds = [
                (("github", r["id"]), github_build(gh, r))
                for r in blocked_pr_runs(pr, runs, on_default_branch)
            ]
            if not on_default_branch:
                try:
                    builds += unfinished_other_builds(gh, pr["headRefOid"])
                except ci_build.REQUEST_ERRORS as e:
                    print(
                        f"{pr_name(label, ref)}: failed to find Azure Pipelines and CircleCI"
                        f" builds: {ci_build.failure(e)}",
                        file=sys.stderr,
                    )
            for identifier, build in builds:
                if identifier not in handled:
                    handled.add(identifier)
                    handle(pr_name(label, ref), build, dry_run)


if __name__ == "__main__":
    main()
