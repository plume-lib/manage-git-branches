#!/usr/bin/env python3
"""Cancel the unfinished CI builds of blocked PRs, and redundant CI builds.

Usage (run in the directory that holds the working copy directories):
  cancel-blocked-ci             # cancel the builds
  cancel-blocked-ci --dry-run   # report the builds that would be cancelled (alias: -n)

A PR is blocked if it depends on another open PR, as pr-status computes it from
pr-status-config.json or, if there is no pr-status-config.json, from the config that
pr-status constructs by default.  Excluded PRs are never blocked.

The builds of a blocked PR are those of its head branch that the PR or a push
started.  If the head branch is the repository's default branch (as for a PR that
merges the default branch into a release branch), they are only the builds that the
PR started.

A build is redundant if a push or a pull request started it, and a more recent
build of the same workflow (for Azure Pipelines, of the same pipeline), for the
same event, is on the same branch, tests a different commit, and is running or
queued to run -- for example, when several pushes to the main branch each started a
build.  A manual or scheduled build is never redundant, because it can differ from a
more recent one in its inputs or its schedule.  Nor is a build redundant because of
a more recent build of the same commit, such as one that labeling a PR started,
because the more recent one can run different jobs.  Nor is a build redundant
because of a more recent one that waits for an approval or for a concurrency group
(for Azure Pipelines, for a check of a stage, such as an approval or an exclusive
lock), because the more recent one might never run.  The script cancels redundant
builds in every repository that the config describes.

The CI systems are GitHub Actions, Azure Pipelines, and CircleCI.  For Azure
Pipelines and CircleCI, only the builds of each blocked PR's head commit are
cancelled.  The Azure Pipelines projects of a repository are those that built
the head commit of its default branch or of any of its 5 most recently created
open PRs.  The CircleCI projects of a repository are those that built the head
commit of its default branch, and only their pipelines from the past day can be
redundant.

Cancelling a build requires credentials, as described in `ci_build.py`.

The exit status is 1 if finding or cancelling any build failed, and 0 otherwise.

This script uses the `pr-status` script, which it finds in its own directory or, as
`pr-status.py`, on the PATH.
"""

import argparse
import collections
import collections.abc
import concurrent.futures
import dataclasses
import datetime as dt
import functools
import importlib.machinery
import importlib.util
import json
import operator
import pathlib
import re
import shutil
import subprocess
import sys
import types
import typing
import urllib.error
import urllib.parse

import ci_build
import request_util

PROGRAM = pathlib.Path(sys.argv[0]).name

# True if finding or cancelling any build failed.
failed = False


def report_failure(message):
    """Report that finding or cancelling a build failed, and make the exit status 1.

    Args:
        message: a description of the failure.
    """
    global failed
    failed = True
    print(message, file=sys.stderr)


def load_pr_status() -> types.ModuleType:
    """Import the pr-status script, whose name is not a legal module name.

    Returns:
        The imported module.
    """
    path = pathlib.Path(__file__).resolve().parent / "pr-status"
    if not path.exists():
        found = shutil.which("pr-status.py")
        if found is None:
            sys.exit(f"{PROGRAM}: cannot find pr-status or pr-status.py")
        path = pathlib.Path(found)
    loader = importlib.machinery.SourceFileLoader("pr_status", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


pr_status = load_pr_status()


# The statuses of unfinished GitHub Actions runs.
GITHUB_UNFINISHED_STATUSES = ["queued", "in_progress", "waiting", "requested", "pending"]
# The statuses of Azure Pipelines builds that have finished or are being cancelled.
AZURE_FINISHED_STATUSES = {"completed", "cancelling"}
# The statuses of unfinished CircleCI workflows.
CIRCLECI_UNFINISHED_STATUSES = {"running", "on_hold", "failing"}

# The events, reasons, and trigger types of the GitHub Actions runs, Azure Pipelines
# builds, and CircleCI pipelines that a more recent build can make redundant:  those
# that a push or a pull request started.
GITHUB_REDUNDANT_EVENTS = {"push", "pull_request"}
AZURE_REDUNDANT_REASONS = {"individualCI", "batchedCI", "pullRequest"}
CIRCLECI_REDUNDANT_TRIGGERS = {"webhook"}
# The statuses of the GitHub Actions runs and CircleCI workflows that can make an
# older build redundant:  those that are running or queued to run, and not those that
# wait for an approval or for a concurrency group.
GITHUB_SUPERSEDING = {"requested", "queued", "in_progress"}
CIRCLECI_SUPERSEDING = {"running", "failing"}

# How long ago a CircleCI pipeline can have been created and still have an unfinished workflow.
CIRCLECI_WINDOW = dt.timedelta(days=1)
# The statuses of unfinished Azure Pipelines builds, and the corresponding GitHub statuses.
AZURE_UNFINISHED = {"inProgress": "in_progress", "notStarted": "queued"}
# Matches a branch that holds a PR, such as "refs/pull/123/merge" or "pull/123".
PULL_BRANCH = re.compile(r"(?:refs/)?pull/(\d+)(?:/merge|/head)?")


def pr_name(label, ref):
    """Name a PR in output.

    Args:
        label: the name of the PR's repository in output (by default, the repository's
            name, such as "daikon").
        ref: the reference to the PR, such as "#555" or "daikon#555".

    Returns:
        ref, preceded by the repository's label if ref is a bare "#N".
    """
    return f"{label} {ref}" if ref.startswith("#") else ref


def blocked_prs(cfg):
    """Return the blocked PRs, as pr-status computes them from its config cfg.

    Args:
        cfg: the pr-status config, as pr-status-config.json holds it or as pr-status
            constructs it by default.

    Returns:
        For each repository, a tuple of its label, its GitHub slug (such as "ORG/REPO"),
        its default branch, a list of the head commits of its 5 most recently created
        open PRs, and a list of the name (as pr_name makes it) and dict (as pr-status
        makes it) of each of its blocked PRs.
    """
    return [
        (
            m.repo.label,
            m.repo.gh,
            m.repo.default_branch,
            [m.repo.prs[n]["headRefOid"] for n in sorted(m.repo.prs)[-5:]],
            [(pr_name(m.repo.label, m.repo.ref(n)), m.repo.prs[n]) for n in m.blocked()],
        )
        for m in pr_status.load_models(cfg, pairwise=False)
    ]


def concurrently(f, items):
    """Call f on each of the items, concurrently.

    Args:
        f: a function of one argument.
        items: the arguments for f.

    Returns:
        A list of the results, in the order of the items.

    Raises:
        Exception: if a call raises an exception; the first such exception, in the order
            of the items.  It is raised after the calls that have started have finished.
            The calls that have not started are cancelled.
    """  # ruff: ignore[docstring-extraneous-exception]  -- executor.map re-raises f's exceptions
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        return list(executor.map(f, items))


def unfinished_runs(gh):
    """Return the runs in the GitHub repository gh that have not completed.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".

    Returns:
        A map from (head repository owner, branch) to the unfinished runs of that branch.
    """
    # GitHub's API takes one status per query.  A run whose status changes between the
    # queries can appear in the results of two of them, so the runs are keyed by run id.
    # A run id is an integer, such as 123 in "https://github.com/ORG/REPO/actions/runs/123".
    runs = {}  # run id -> run
    for pages in concurrently(
        lambda status: request_util.gh_api(
            f"repos/{gh}/actions/runs?status={status}&per_page=100", paginate=True
        ),
        GITHUB_UNFINISHED_STATUSES,
    ):
        for page in pages:
            for r in page["workflow_runs"]:
                runs[r["id"]] = r
    result = {}
    for r in runs.values():
        result.setdefault((run_owner(r), r["head_branch"]), []).append(r)
    return result


def run_owner(r):
    """Return the owner of the repository whose branch the GitHub Actions run r tests.

    Args:
        r: the run, as a dict parsed from the GitHub API's JSON, with keys such as "id",
            "status", and "html_url".

    Returns:
        The owner's login, or None if the repository is gone.
    """
    return (r["head_repository"] or {}).get("owner", {}).get("login")


def superseded(builds, key, order, commit, can_supersede):
    """Return the builds that a more recent build with the same key makes redundant.

    A build is redundant if the most recent build with its key that can make older
    builds redundant is more recent than it and tests a different commit.

    Args:
        builds: the builds.
        key: a function from a build to what it must share with the builds that make
            it redundant.
        order: a function from a build to a value that is greater for more recent builds.
        commit: a function from a build to the commit that it tests.
        can_supersede: a function from a build to whether it can make older builds
            redundant.

    Returns:
        A list of pairs of a redundant build and the most recent build with its key that
        can make it redundant.
    """
    groups = {}
    for b in builds:
        groups.setdefault(key(b), []).append(b)
    result = []
    for group in groups.values():
        if len(group) < 2:  # Avoid calling can_supersede, which can be costly.
            continue
        group.sort(key=order, reverse=True)
        latest = next((i for i, b in enumerate(group) if can_supersede(b)), len(group))
        result.extend(
            (b, group[latest]) for b in group[latest + 1 :] if commit(b) != commit(group[latest])
        )
    return result


def branch_name(branch):
    """Name a branch the same way, whatever the CI service.

    Args:
        branch: the branch, such as "main", "refs/heads/main", "pull/123", or
            "refs/pull/123/merge".

    Returns:
        "pull/N" if branch holds PR N, and otherwise branch without "refs/heads/".
    """
    if match := PULL_BRANCH.fullmatch(branch):
        return f"pull/{match[1]}"
    return branch.removeprefix("refs/heads/")


def branch_subject(label, branch):
    """Name a branch of the repository with the given label in output.

    Args:
        label: the repository's label.
        branch: the branch, such as "main", "refs/heads/main", or "refs/pull/123/merge".

    Returns:
        A reference to the PR if branch holds a PR, and otherwise label and branch.
    """
    if match := PULL_BRANCH.fullmatch(branch):
        return f"{label}#{match[1]}"
    return f"{label} {branch.removeprefix('refs/heads/')}"


def redundant_runs(label, gh, runs):
    """Return the redundant unfinished GitHub Actions runs in the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        runs: a map from (head repository owner, branch) to the unfinished runs of that
            branch, as unfinished_runs returns it.

    Returns:
        A list of the subject, Build, and reason of each redundant run.
    """
    result = []
    for (owner, branch), branch_runs in runs.items():
        if not owner:  # Runs of different deleted forks are indistinguishable.
            continue
        name = branch if owner.lower() == gh.split("/")[0].lower() else f"{owner}:{branch}"
        for r, latest in superseded(
            [r for r in branch_runs if r["event"] in GITHUB_REDUNDANT_EVENTS],
            operator.itemgetter("workflow_id", "event"),
            operator.itemgetter("created_at"),
            operator.itemgetter("head_sha"),
            lambda r: r["status"] in GITHUB_SUPERSEDING,
        ):
            result.append(
                (
                    f"{label} {name}",
                    Build.from_github_actions_run(gh, r),
                    f", made redundant by run {latest['id']}",
                )
            )
    return result


def azure_projects(gh, pr_shas):
    """Return the Azure Pipelines projects that build the GitHub repository gh.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".
        pr_shas: the head commits of some of gh's open PRs.

    Returns:
        A set of the organization and project of each Azure Pipelines project that
        built the head commit of gh's default branch or of one of pr_shas.
    """
    return {
        parsed[:2]
        for sha_checks in concurrently(lambda sha: checks(gh, sha), ["HEAD", *pr_shas])
        for check in sha_checks
        if (parsed := ci_build.parse_azure_url(check.url))
    }


def azure_build_waits(org, project, build):
    """Return True if an Azure Pipelines build waits for a check of a stage.

    A check is, for example, an approval or an exclusive lock.

    Args:
        org: the Azure DevOps organization.
        project: the Azure DevOps project.
        build: the build's id, an integer such as 123 in ".../_build/results?buildId=123".

    Returns:
        True if a check of a stage of the build is in progress.
    """
    timeline = ci_build.azure_get(
        f"{ci_build.azure_api(org, project, build)}/timeline?api-version=7.1"
    )
    return any(
        (r.get("type") or "").startswith("Checkpoint") and r.get("state") == "inProgress"
        for r in (timeline or {}).get("records") or []
    )


def redundant_azure_builds(label, gh, org, project):
    """Return the redundant unfinished builds of the GitHub repository gh in an Azure project.

    Args:
        label: the repository's label.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        org: the Azure DevOps organization.
        project: the Azure DevOps project.

    Returns:
        A list of the subject, Build, and reason of each redundant build.
    """
    builds = ci_build.azure_get(
        f"{ci_build.azure_api(org, project)}?statusFilter={','.join(AZURE_UNFINISHED)}"
        f"&repositoryId={urllib.parse.quote(gh, safe='')}&repositoryType=GitHub"
        "&api-version=7.1"
    )["value"]
    return [
        (
            branch_subject(label, b["sourceBranch"]),
            Build.from_azure_pipelines_build(
                AZURE_UNFINISHED.get(b["status"], b["status"]),
                org,
                project,
                b["id"],
                b["definition"]["name"],
                b["_links"]["web"]["href"],
            ),
            f", made redundant by build {latest['id']}",
        )
        for b, latest in superseded(
            [b for b in builds if b["reason"] in AZURE_REDUNDANT_REASONS],
            lambda b: (b["definition"]["id"], b["reason"], b["sourceBranch"]),
            operator.itemgetter("id"),
            operator.itemgetter("sourceVersion"),
            lambda b: not azure_build_waits(org, project, b["id"]),
        )
    ]


def redundant_azure_builds_or_report(label, gh, org, project):
    """Return the redundant unfinished builds of gh in an Azure project, reporting any failure.

    Args:
        label: the repository's label.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        org: the Azure DevOps organization.
        project: the Azure DevOps project.

    Returns:
        A list of the subject, Build, and reason of each redundant build, or the
        empty list if Azure Pipelines does not provide them, in which case this function
        reports the failure.
    """
    try:
        return redundant_azure_builds(label, gh, org, project)
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{label}: failed to find redundant Azure Pipelines builds in {org}/{project}:"
            f" {request_util.failure(e)}"
        )
        return []


def redundant_circleci_workflows(label, gh):
    """Return the redundant unfinished CircleCI workflows of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub slug, such as "ORG/REPO".

    Returns:
        A list of the subject, Build, and reason of each redundant workflow.
    """
    projects = {
        # A URL without a project slug is of the project that GitHub's OAuth app connects.
        ci_build.circleci_project_of_url(check.url) or f"gh/{gh}"
        for check in checks(gh, "HEAD")
        if ci_build.parse_circleci_url(check.url) is not None
    }
    # the project, branch, and pipeline of each recent pipeline that can be redundant
    pipelines = [
        (project, branch, p)
        for project in sorted(projects)
        for branch, p in recent_pipelines(project)
    ]
    # A pipeline's workflows can be redundant only if its branch has another pipeline.
    counts = collections.Counter((project, branch) for project, branch, _ in pipelines)
    pipelines = [pbp for pbp in pipelines if counts[pbp[:2]] > 1]
    # the project, branch, pipeline, and workflow of each unfinished workflow
    workflows = [
        (project, branch, p, w)
        for (project, branch, p), pipeline_workflows in zip(
            pipelines,
            concurrently(lambda pbp: unfinished_workflows(pbp[2]["id"]), pipelines),
            strict=True,
        )
        for w in pipeline_workflows
    ]
    return [
        (
            branch_subject(label, branch),
            Build.from_circleci_workflow(w["status"], w["id"], w["name"]),
            f", made redundant by workflow {latest[3]['id']}",
        )
        for (_, branch, _, w), latest in superseded(
            workflows,
            lambda pbpw: (pbpw[0], pbpw[1], pbpw[3]["name"]),
            lambda pbpw: (pbpw[2]["number"], pbpw[3]["created_at"]),
            lambda pbpw: pbpw[2]["vcs"].get("revision"),
            lambda pbpw: pbpw[3]["status"] in CIRCLECI_SUPERSEDING,
        )
    ]


@functools.cache
def recent_pipelines(project):
    """Return the recent pipelines of a CircleCI project that a push or a pull request started.

    Args:
        project: the project slug, such as "gh/ORG/REPO".

    Returns:
        A list of the branch and pipeline of each pipeline from the past day that a push
        or a pull request started, most recent first.
    """
    cutoff = dt.datetime.now(dt.UTC) - CIRCLECI_WINDOW
    result = []
    # The pipelines are listed most recent first.
    for p in ci_build.circleci_items(f"/v2/project/{project}/pipeline"):
        if dt.datetime.fromisoformat(p["created_at"]) < cutoff:
            break
        branch = pipeline_branch(p)
        if branch and p["trigger"]["type"] in CIRCLECI_REDUNDANT_TRIGGERS:
            result.append((branch, p))
    return result


def pipeline_branch(p):
    """Return the branch of a CircleCI pipeline.

    Args:
        p: the pipeline, as a dict parsed from the CircleCI API's JSON, with keys such as
            "id" and "vcs".

    Returns:
        The pipeline's branch, such as "main" or "pull/123", or else its tag, or else None.
    """
    vcs = p.get("vcs") or {}
    return vcs.get("branch") or vcs.get("tag")


@functools.cache
def unfinished_workflows(pipeline):
    """Return the unfinished workflows of the CircleCI pipeline with the given id.

    Args:
        pipeline: the pipeline's id, a UUID such as "5034460f-c7c4-4c43-9457-de07e2029e7b"
            (not its number, such as 7 in a pipeline's URL).

    Returns:
        A list of the unfinished workflows, or the empty list if the pipeline no longer
        exists.
    """
    try:
        return [
            w
            for w in ci_build.circleci_items(f"/v2/pipeline/{pipeline}/workflow")
            if w["status"] in CIRCLECI_UNFINISHED_STATUSES
        ]
    except urllib.error.HTTPError as e:
        if e.code == 404:  # The pipeline was deleted after it was listed.
            return []
        raise


def redundant_builds(label, gh, runs, pr_shas):
    """Return the redundant unfinished builds of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        runs: the unfinished GitHub Actions runs, as unfinished_runs returns them.
        pr_shas: the head commits of some of gh's open PRs, whose checks show which
            Azure Pipelines projects build gh.

    Returns:
        A list of the subject, Build, and reason of each redundant build.
    """
    result = redundant_runs(label, gh, runs)
    try:
        projects = azure_projects(gh, pr_shas)
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{label}: failed to find the Azure Pipelines projects: {request_util.failure(e)}"
        )
        projects = set()
    for org, project in sorted(projects):
        result += redundant_azure_builds_or_report(label, gh, org, project)
    try:
        result += redundant_circleci_workflows(label, gh)
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{label}: failed to find redundant CircleCI workflows: {request_util.failure(e)}"
        )
    return result


@dataclasses.dataclass(frozen=True)
class Build:
    """A CI build:  a GitHub Actions run, an Azure Pipelines build, or a CircleCI workflow.

    Attributes:
        key: a tuple that distinguishes the build from every other build, such as
            ("github", RUN-ID), ("azure", ORG, BUILD-ID), or ("circleci", WORKFLOW-ID).
        status: the build's status, such as "queued", "in_progress", or "running".
        description: how output names the build, such as "run 123 (ci)".
        url: the URL of the build's web page.
        cancelling: a function of no arguments that cancels the build.
        state_function: a function of no arguments that returns the build's state:  its
            branch (None if it has none) and whether it has finished.  If the CI service
            does not provide them, it raises an exception in request_util.REQUEST_ERRORS.
    """

    key: tuple
    status: str
    description: str
    url: str
    cancelling: collections.abc.Callable[[], object]
    state_function: collections.abc.Callable[[], tuple[str | None, bool]]

    @classmethod
    def from_github_actions_run(cls, gh, r):
        """Make the Build of the GitHub Actions run r in the GitHub repository gh.

        Args:
            gh: the repository's GitHub slug, such as "ORG/REPO".
            r: the run, as a dict parsed from the GitHub API's JSON, with keys such as
                "id", "status", and "html_url".

        Returns:
            The Build of r.
        """
        api = f"repos/{gh}/actions/runs/{r['id']}"
        return cls(
            ("github", r["id"]),
            r["status"],
            f"run {r['id']} ({r['name']})",
            r["html_url"],
            lambda: request_util.run(["gh", "run", "cancel", "-R", gh, str(r["id"])]),
            lambda: (r["head_branch"], request_util.gh_api(api)["status"] == "completed"),
        )

    @classmethod
    def from_azure_pipelines_build(cls, status, org, project, build, name, url):
        """Make the Build of an Azure Pipelines build.

        Args:
            status: the build's status, as GitHub names it, such as "queued" or "in_progress".
            org: the Azure DevOps organization.
            project: the Azure DevOps project.
            build: the build's id, an integer such as 123 in ".../_build/results?buildId=123".
            name: a name for the build, such as its pipeline's name.
            url: the URL of the build's web page.

        Returns:
            The Build of the Azure Pipelines build.
        """
        api = f"{ci_build.azure_api(org, project, build)}?api-version=7.1"
        return cls(
            ("azure", org, str(build)),
            status,
            f"Azure Pipelines build {build} ({name})",
            url,
            lambda: ci_build.azure_request(
                "PATCH", api, ci_build.azure_headers(), {"status": "cancelling"}
            ),
            functools.partial(azure_build_state, org, project, build),
        )

    @classmethod
    def from_circleci_workflow(cls, status, workflow, name):
        """Make the Build of a CircleCI workflow.

        Args:
            status: the workflow's status, such as "running" or "pending".
            workflow: the workflow's id, a UUID such as the one after "/workflows/" in its URL.
            name: a name for the workflow, such as its name or the name of one of its jobs.

        Returns:
            The Build of the workflow.
        """
        api = f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}/cancel"

        def cancelling():
            warn_if_no_circleci_token()
            request_util.request("POST", api, ci_build.circleci_headers())

        return cls(
            ("circleci", workflow),
            status,
            f"CircleCI workflow {workflow} ({name})",
            f"https://app.circleci.com/workflow/{workflow}",
            cancelling,
            functools.partial(circleci_workflow_state, workflow),
        )

    def cancel(self):
        """Cancel the build, reporting any failure.

        A build can finish after it is found and before it is cancelled.  Failing to cancel
        a build that has finished is not a failure.
        """
        try:
            self.cancelling()
        except request_util.REQUEST_ERRORS as e:
            try:
                finished = self.state_function()[1]
            except request_util.REQUEST_ERRORS:
                finished = False
            if not finished:
                report_failure(f"  failed to cancel {self.url}: {request_util.failure(e)}")


@functools.cache
def warn_if_no_circleci_token():
    """If there is no CircleCI token, warn (only once) that CircleCI will refuse to cancel."""
    if not ci_build.circleci_token():
        print(
            f"{PROGRAM}: no CircleCI token found in $CIRCLECI_CLI_TOKEN or in "
            + " or ".join(ci_build.CIRCLECI_CONFIGS)
            + ", so CircleCI will refuse to cancel workflows;"
            " create a personal API token and run `circleci setup`",
            file=sys.stderr,
        )


class Check(typing.NamedTuple):
    """A check run or commit status of a commit, as GitHub reports a CI build or job.

    Attributes:
        status: the status, such as "queued" or "in_progress", or "completed" if the
            check has completed.
        name: the name of the check run or the context of the commit status.
        url: the URL of the check's details, such as the web page of a CI build or job.
    """

    status: str
    name: str
    url: str


@functools.cache
def checks(gh, sha):
    """Return the check runs and commit statuses of commit sha in the GitHub repository gh.

    Args:
        gh: the repository's GitHub slug, such as "ORG/REPO".
        sha: the commit, or "HEAD" for the head commit of the default branch.

    Returns:
        A list of the Check of each check run and commit status that has a URL.
    """
    result = []
    for page in request_util.gh_api(
        f"repos/{gh}/commits/{sha}/check-runs?per_page=100", paginate=True
    ):
        result.extend(
            Check(c["status"], c["name"], c["details_url"])
            for c in page["check_runs"]
            if c["details_url"]
        )
    for page in request_util.gh_api(f"repos/{gh}/commits/{sha}/status?per_page=100", paginate=True):
        result.extend(
            Check(
                "pending" if s["state"] == "pending" else "completed", s["context"], s["target_url"]
            )
            for s in page["statuses"]
            if s["target_url"]
        )
    return result


def is_from_repo(gh, pr):
    """Return True if a PR's head branch is in the repository gh, rather than in a fork.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        pr: the PR, as a dict that pr-status makes from the JSON of `gh pr list`, with
            keys such as "number", "headRefName", and "owner".

    Returns:
        True if the owner of the PR's head repository is gh's owner.
    """
    return pr["owner"].lower() == gh.split("/")[0].lower()


def is_on_default_branch(gh, default_branch, pr):
    """Return True if a PR is on the default branch of its repository.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        default_branch: the repository's default branch.
        pr: the PR, as a dict that pr-status makes from the JSON of `gh pr list`, with
            keys such as "number", "headRefName", and "owner".

    Returns:
        True if the PR's head branch is the repository's default branch.
    """
    return is_from_repo(gh, pr) and pr["headRefName"] == default_branch


def blocked_pr_runs(pr, runs, on_default_branch):
    """Return the unfinished GitHub Actions runs of a blocked PR.

    The runs of the PR are the runs of its head branch that the PR or a push started.
    If the head branch is the repository's default branch, they are only the runs that
    the PR started.  A run that another open PR with the same head branch started is
    indistinguishable from a run that this PR started.

    Args:
        pr: the PR, as a dict that pr-status makes from the JSON of `gh pr list`, with
            keys such as "number", "headRefName", and "owner".
        runs: the unfinished runs, as unfinished_runs returns them.
        on_default_branch: True if the PR's head branch is the repository's default branch.

    Returns:
        A list of the runs.
    """
    events = {"pull_request"} if on_default_branch else GITHUB_REDUNDANT_EVENTS
    return [r for r in runs.get((pr["owner"], pr["headRefName"]), []) if r["event"] in events]


def pr_branches(gh, default_branch, pr):
    """Return the branches whose builds are a PR's builds.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        default_branch: the repository's default branch.
        pr: the PR, as a dict that pr-status makes from the JSON of `gh pr list`, with
            keys such as "number", "headRefName", and "owner".

    Returns:
        A set of the branches, named as branch_name names them:  "pull/N" for the PR's
        number N, and the PR's head branch if it is a branch of gh other than the
        default branch.
    """
    result = {f"pull/{pr['number']}"}
    if is_from_repo(gh, pr) and pr["headRefName"] != default_branch:
        result.add(pr["headRefName"])
    return result


def azure_build_state(org, project, build):
    """Return the branch of an Azure Pipelines build, and whether it has finished.

    Args:
        org: the Azure DevOps organization.
        project: the Azure DevOps project.
        build: the build's id, an integer such as 123 in ".../_build/results?buildId=123".

    Returns:
        The build's source branch, such as "refs/heads/main" or "refs/pull/123/merge",
        and whether the build has finished or is being cancelled.
    """
    record = ci_build.azure_get(f"{ci_build.azure_api(org, project, build)}?api-version=7.1")
    return record["sourceBranch"], record["status"] in AZURE_FINISHED_STATUSES


def circleci_workflow_state(workflow):
    """Return the branch of a CircleCI workflow, and whether it has finished.

    Args:
        workflow: the workflow's id, a UUID such as the one after "/workflows/" in its URL.

    Returns:
        The branch of the workflow's pipeline, as pipeline_branch returns it, and
        whether the workflow has finished.
    """
    w = request_util.request(
        "GET", f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}", ci_build.circleci_headers()
    )
    finished = w["status"] not in CIRCLECI_UNFINISHED_STATUSES
    return circleci_pipeline_branch(w["pipeline_id"]), finished


@functools.cache
def circleci_pipeline_branch(pipeline):
    """Return the branch of a CircleCI pipeline.

    Args:
        pipeline: the pipeline's id, a UUID such as "5034460f-c7c4-4c43-9457-de07e2029e7b"
            (not its number, such as 7 in a pipeline's URL).

    Returns:
        The pipeline's branch, as pipeline_branch returns it.
    """
    return pipeline_branch(
        request_util.request(
            "GET", f"{ci_build.CIRCLECI_API}/v2/pipeline/{pipeline}", ci_build.circleci_headers()
        )
    )


def unfinished_other_builds(subject, gh, sha, branches):
    """Return the unfinished Azure Pipelines and CircleCI builds of commit sha on some branches.

    Args:
        subject: what the builds test, such as a PR; used for diagnostics.
        gh: the repository's GitHub slug, such as "ORG/REPO".
        sha: the commit.
        branches: the branches, named as branch_name names them.

    Returns:
        A list of the Build of each build.
    """
    builds = {}  # key -> Build

    def add(build):
        builds.setdefault(build.key, build)

    # project slug -> the Check of each job whose URL does not contain its workflow's id
    jobs = {}
    for status, name, url in checks(gh, sha):
        if status == "completed":
            continue
        if parsed := ci_build.parse_azure_url(url):
            org, project, build = parsed
            add(Build.from_azure_pipelines_build(status, org, project, build, name, url))
        elif (parsed := ci_build.parse_circleci_url(url)) is not None:
            workflow, project, job = parsed
            if workflow is not None:
                add(Build.from_circleci_workflow(status, workflow, name))
            elif project is not None and job is not None:
                jobs.setdefault(project, []).append(Check(status, name, url))
            else:
                print(f"{subject}: no CircleCI workflow found for {url}", file=sys.stderr)
    for project, project_jobs in jobs.items():
        for build in circleci_workflows_of_jobs(subject, project, sha, branches, project_jobs):
            add(build)
    candidates = list(builds.values())
    result = []
    for build, state in zip(
        candidates, concurrently(functools.partial(build_state, subject), candidates), strict=True
    ):
        if state is None:  # build_state reported the failure.
            continue
        branch, finished = state
        # GitHub can show a build as unfinished after it finishes.
        if finished:
            continue
        if branch is None:
            print(
                f"{subject}: not cancelling {build.url}, whose branch is unknown", file=sys.stderr
            )
        # Other branches can be at commit sha too.
        elif branch_name(branch) in branches:
            result.append(build)
    return result


def build_state(subject, build):
    """Return the state of a build:  its branch and whether it has finished.

    Args:
        subject: what the build tests, such as a PR; used for diagnostics.
        build: the Build.

    Returns:
        The build's branch (None if it has none) and whether it has finished, or None if
        the CI service does not provide them, in which case this function reports the
        failure.
    """
    try:
        return build.state_function()
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{subject}: failed to find the branch of {build.url}: {request_util.failure(e)}"
        )
        return None


def circleci_workflows_of_jobs(subject, project, sha, branches, jobs):
    """Return the CircleCI workflows that contain unfinished jobs of commit sha.

    A job's URL, such as "https://circleci.com/gh/ORG/REPO/123", can give the job's project
    and number but not the id of the workflow that contains the job.

    If the project has pipelines from the past day of commit sha on the branches, started
    by a push or a pull request, and those pipelines have unfinished workflows, then the
    result is those workflows, whether or not they contain the jobs.  Otherwise, the
    result is the workflows that contain the jobs, which can be on any branch.  So the
    workflow of a job in another pipeline of commit sha, such as one that the API
    started, is in the result only if there are no such pipelines.

    Args:
        subject: what the jobs test, such as a PR; used for diagnostics.
        project: the project slug of the jobs.
        sha: the commit.
        branches: the branches, named as branch_name names them.
        jobs: the Check of each job, whose URL does not contain its workflow's id.

    Returns:
        A list of the Build of each workflow.
    """
    try:
        workflows = [
            w
            for branch, p in recent_pipelines(project)
            if p["vcs"].get("revision") == sha and branch_name(branch) in branches
            for w in unfinished_workflows(p["id"])
        ]
    except request_util.REQUEST_ERRORS as e:
        print(
            f"{subject}: failed to list the pipelines of {project}: {request_util.failure(e)}",
            file=sys.stderr,
        )
        workflows = []
    if workflows:
        return [Build.from_circleci_workflow(w["status"], w["id"], w["name"]) for w in workflows]

    def lookup(url):
        """Return the workflow of a CircleCI job.

        Args:
            url: the URL of the job.

        Returns:
            The workflow id (None if there is none) and None, or None and the exception
            that the lookup raised.
        """
        try:
            return ci_build.circleci_workflow_of_url(url)[0], None
        except request_util.REQUEST_ERRORS as e:
            return None, e

    result = []
    failures = []
    for (status, name, url), (workflow, error) in zip(
        jobs, concurrently(lookup, [job.url for job in jobs]), strict=True
    ):
        if error is not None:
            failures.append(error)
        elif workflow is None:
            print(f"{subject}: no CircleCI workflow found for {url}", file=sys.stderr)
        else:
            result.append(Build.from_circleci_workflow(status, workflow, name))
    if failures:
        report_failure(
            f"{subject}: failed to look up {len(failures)} CircleCI job(s):"
            f" {request_util.failure(failures[0])}"
        )
    return result


def blocked_pr_builds(gh, default_branch, runs, blocked):
    """Return the unfinished builds of a blocked PR.

    Args:
        gh: the GitHub slug of the PR's repository, such as "ORG/REPO".
        default_branch: the repository's default branch.
        runs: the unfinished GitHub Actions runs, as unfinished_runs returns them.
        blocked: the PR's name, as pr_name makes it (used for diagnostics), and the PR, as
            a dict that pr-status makes from the JSON of `gh pr list`.

    Returns:
        A list of the Build of each build.
    """
    subject, pr = blocked
    on_default_branch = is_on_default_branch(gh, default_branch, pr)
    builds = [
        Build.from_github_actions_run(gh, r) for r in blocked_pr_runs(pr, runs, on_default_branch)
    ]
    try:
        builds += unfinished_other_builds(
            subject, gh, pr["headRefOid"], pr_branches(gh, default_branch, pr)
        )
    except request_util.REQUEST_ERRORS as e:
        report_failure(
            f"{subject}: failed to find Azure Pipelines and CircleCI builds:"
            f" {request_util.failure(e)}"
        )
    return builds


def handle(subject, build, dry_run, reason=""):
    """Cancel, or if dry_run is true report, the build of subject.

    Args:
        subject: what the build tests, such as a PR or a branch.
        build: the Build.
        dry_run: True if the build should be reported but not cancelled.
        reason: text to append to the report.
    """
    action = "would cancel" if dry_run else "cancelling"
    print(f"{subject}: {action} {build.status} {build.description}{reason}")
    if not dry_run:
        build.cancel()


def main():
    """Cancel, or with --dry-run report, the builds of blocked PRs and redundant builds."""
    parser = argparse.ArgumentParser(
        prog=PROGRAM, description=__doc__.splitlines()[0] if __doc__ else None
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="report the builds but do not cancel them"
    )
    dry_run = parser.parse_args().dry_run
    base = pathlib.Path.cwd()
    # The current directory holds the working copy directories; it is not one of them.
    toplevel = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], check=False, capture_output=True, text=True
    )
    if toplevel.returncode == 0:
        sys.exit(
            f"{PROGRAM}: {base} is in the git working copy {toplevel.stdout.strip()}; "
            f"run {PROGRAM} in the directory that holds the working copy directories"
        )
    if pathlib.Path(pr_status.CONFIG).exists():
        with pathlib.Path(pr_status.CONFIG).open() as f:
            cfg = json.load(f)
    else:
        try:
            cfg = pr_status.default_config(str(base))
        except pr_status.ConfigError as e:
            sys.exit(f"{PROGRAM}: {e}")
    try:
        repos = blocked_prs(cfg)
    except request_util.REQUEST_ERRORS as e:
        sys.exit(f"{PROGRAM}: failed to find the blocked PRs: {request_util.failure(e)}")
    for label, gh, default_branch, pr_shas, blocked in repos:
        try:
            runs = unfinished_runs(gh)
        except request_util.REQUEST_ERRORS as e:
            report_failure(
                f"{label}: failed to find unfinished GitHub Actions runs: {request_util.failure(e)}"
            )
            runs = {}
        handled = set()  # the keys of the builds that have been cancelled or reported
        for subject, build, reason in redundant_builds(label, gh, runs, pr_shas):
            if build.key in handled:
                continue
            handled.add(build.key)
            handle(subject, build, dry_run, reason)
        for (subject, _), builds in zip(
            blocked,
            concurrently(functools.partial(blocked_pr_builds, gh, default_branch, runs), blocked),
            strict=True,
        ):
            for build in builds:
                if build.key not in handled:
                    handled.add(build.key)
                    handle(subject, build, dry_run)
    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
