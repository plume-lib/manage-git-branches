#!/usr/bin/env python3
"""Cancel the unfinished CI runs of blocked PRs, and redundant CI runs.

Usage (run in the directory that holds the PR status documents, as for pr-status):
  cancel-blocked-ci             # cancel the runs
  cancel-blocked-ci --dry-run   # report the runs that would be cancelled (alias: -n)

A PR is blocked if it depends on another open PR, as pr-status computes it from
pr-status-config.json or, if there is no pr-status-config.json, from the config that
pr-status constructs by default.  Excluded PRs are never blocked.

A build is redundant if a push or a pull request started it, and a more recent
unfinished build of the same workflow (for Azure Pipelines, of the same pipeline),
for the same event, is on the same branch -- for example, when several pushes to
the main branch each started a build.  A manual or scheduled build is never
redundant, because it can differ from a more recent one in its inputs or its
schedule.  The script cancels redundant builds in every repository that the
config describes.

The CI systems are GitHub Actions, Azure Pipelines, and CircleCI.  For Azure
Pipelines and CircleCI, only the builds of each blocked PR's head commit are
cancelled.  The Azure Pipelines projects of a repository are those that built
the head commit of its default branch or of one of its 5 most recently created
open PRs.  A repository has a CircleCI project, gh/OWNER/REPO, if CircleCI built
the head commit of its default branch, and only the project's pipelines from the
past day can be redundant.

Cancelling a build requires credentials, as described in `ci_build.py`.

This script uses the `pr-status` script, which it finds in its own directory or, as
`pr-status.py`, on the PATH.
"""

import argparse
import concurrent.futures
import datetime as dt
import functools
import importlib.machinery
import importlib.util
import json
import operator
import pathlib
import re
import shutil
import sys
import types
import urllib.error
import urllib.parse

import ci_build

PROGRAM = pathlib.Path(sys.argv[0]).name


def load_pr_status() -> types.ModuleType:
    """Import the pr-status script, whose name is not a legal module name.

    Returns:
        The imported module.
    """
    path = pathlib.Path(__file__).resolve().parent / "pr-status"
    if not path.exists():
        found = shutil.which("pr-status.py")
        if found is None:
            sys.exit(f"{PROGRAM}: cannot find pr-status or pr-status.py")
        path = pathlib.Path(found)
    loader = importlib.machinery.SourceFileLoader("pr_status", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


pr_status = load_pr_status()


UNFINISHED = ["queued", "in_progress", "waiting", "requested", "pending"]

# The events, reasons, and trigger types of the GitHub Actions runs, Azure Pipelines
# builds, and CircleCI pipelines that a more recent build can make redundant:  those
# that a push or a pull request started.
GITHUB_REDUNDANT_EVENTS = {"push", "pull_request"}
AZURE_REDUNDANT_REASONS = {"individualCI", "batchedCI", "pullRequest"}
CIRCLECI_REDUNDANT_TRIGGERS = {"webhook"}

# The statuses of unfinished CircleCI workflows.
CIRCLECI_UNFINISHED = {"running", "on_hold", "failing"}
# How long ago a CircleCI pipeline can have been created and still have an unfinished workflow.
CIRCLECI_WINDOW = dt.timedelta(days=1)
# The statuses of unfinished Azure Pipelines builds, and the corresponding GitHub statuses.
AZURE_UNFINISHED = {"inProgress": "in_progress", "notStarted": "queued"}
# A branch that holds a PR, such as "refs/pull/123/merge" or "pull/123".
PULL_BRANCH = re.compile(r"(?:refs/)?pull/(\d+)(?:/merge|/head)?")


def pr_name(label, ref):
    """Name a PR in output.

    Returns:
        ref, preceded by the repository's label unless ref already starts with it.
    """
    return ref if ref.startswith(label) else f"{label} {ref}"


def blocked_prs(cfg):
    """Find the blocked PRs, as pr-status computes them from its config cfg.

    Returns:
        For each repository, a tuple of its label, its GitHub name, and a list of the
        reference and gh JSON of each of its blocked PRs.
    """
    return [
        (m.repo.label, m.repo.gh, [(m.repo.ref(n), m.repo.prs[n]) for n in m.blocked()])
        for m in pr_status.load_models(cfg, pairwise=False)
    ]


def concurrently(f, items):
    """Call f on each of the items, concurrently.

    If a call raises an exception, this raises the first such exception, in the order of
    the items.

    Returns:
        A list of the results, in the order of the items.
    """
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        return list(executor.map(f, items))


def unfinished_runs(gh):
    """Find the runs in the GitHub repository gh that have not completed.

    Returns:
        A map from (head repository owner, branch) to the unfinished runs of that branch.
    """
    runs = {}  # id -> run; a run whose status changes between queries appears in two
    for pages in concurrently(
        lambda status: ci_build.gh_api(
            f"repos/{gh}/actions/runs?status={status}&per_page=100", paginate=True
        ),
        UNFINISHED,
    ):
        for page in pages:
            for r in page["workflow_runs"]:
                runs[r["id"]] = r
    result = {}
    for r in runs.values():
        result.setdefault((run_owner(r), r["head_branch"]), []).append(r)
    return result


def run_owner(r):
    """Find the owner of the repository whose branch the GitHub Actions run r tests.

    Returns:
        The owner's login, or None if the repository is gone.
    """
    return (r["head_repository"] or {}).get("owner", {}).get("login")


def superseded(builds, key, order):
    """Find the builds that a more recent build with the same key makes redundant.

    Args:
        builds: the builds.
        key: a function from a build to what it must share with the builds that make
            it redundant.
        order: a function from a build to a value that is greater for more recent builds.

    Returns:
        A list of pairs of a redundant build and the most recent build with its key.
    """
    groups = {}
    for b in builds:
        groups.setdefault(key(b), []).append(b)
    result = []
    for group in groups.values():
        group.sort(key=order, reverse=True)
        result.extend((b, group[0]) for b in group[1:])
    return result


def branch_subject(label, branch):
    """Name a branch of the repository with the given label in output.

    Returns:
        A reference to the PR if branch holds a PR, and otherwise label and branch.
    """
    if match := PULL_BRANCH.fullmatch(branch):
        return f"{label}#{match[1]}"
    return f"{label} {branch.removeprefix('refs/heads/')}"


def redundant_runs(label, gh, runs):
    """Find the redundant unfinished GitHub Actions runs in the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        runs: a map from (head repository owner, branch) to the unfinished runs of that
            branch, as unfinished_runs returns it.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant run.
    """
    result = []
    for (owner, branch), branch_runs in runs.items():
        if not owner:  # Runs of different deleted forks are indistinguishable.
            continue
        name = branch if owner == gh.split("/")[0] else f"{owner}:{branch}"
        for r, latest in superseded(
            [r for r in branch_runs if r["event"] in GITHUB_REDUNDANT_EVENTS],
            operator.itemgetter("workflow_id", "event"),
            operator.itemgetter("created_at"),
        ):
            result.append(
                (
                    ("github", r["id"]),
                    f"{label} {name}",
                    github_build(gh, r),
                    f", made redundant by run {latest['id']}",
                )
            )
    return result


def azure_projects(gh):
    """Find the Azure Pipelines projects that build the GitHub repository gh.

    Returns:
        A set of the organization and project of each Azure Pipelines project that
        built the head commit of gh's default branch or of one of the 5 most recently
        created open PRs, or the empty set if the Azure Pipelines app has no check suite
        for the head commit of the default branch.
    """
    suites = ci_build.gh_api(f"repos/{gh}/commits/HEAD/check-suites?per_page=100")
    if not any(s["app"]["slug"] == "azure-pipelines" for s in suites["check_suites"]):
        return set()
    shas = ["HEAD"] + [
        pr["headRefOid"]
        for pr in json.loads(
            ci_build.run(["gh", "pr", "list", "-R", gh, "--limit", "5", "--json", "headRefOid"])
        )
    ]
    for sha in shas:
        projects = {
            parsed[:2] for _, _, url in checks(gh, sha) if (parsed := ci_build.parse_azure_url(url))
        }
        if projects:
            return projects
    return set()


def redundant_azure_builds(label, gh, org, project):
    """Find the redundant unfinished builds of the GitHub repository gh in an Azure project.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        org: the Azure DevOps organization.
        project: the Azure DevOps project.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant build.
    """
    builds = ci_build.azure_get(
        f"{ci_build.azure_api(org, project)}?statusFilter={','.join(AZURE_UNFINISHED)}"
        f"&repositoryId={urllib.parse.quote(gh, safe='')}&repositoryType=GitHub"
        "&api-version=7.1"
    )["value"]
    return [
        (
            ("azure", org, str(b["id"])),
            branch_subject(label, b["sourceBranch"]),
            azure_build(
                AZURE_UNFINISHED.get(b["status"], b["status"]),
                org,
                project,
                str(b["id"]),
                b["definition"]["name"],
                b["_links"]["web"]["href"],
            ),
            f", made redundant by build {latest['id']}",
        )
        for b, latest in superseded(
            [b for b in builds if b["reason"] in AZURE_REDUNDANT_REASONS],
            lambda b: (b["definition"]["id"], b["reason"], b["sourceBranch"]),
            operator.itemgetter("id"),
        )
    ]


def redundant_circleci_workflows(label, gh):
    """Find the redundant unfinished CircleCI workflows of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant workflow.
    """
    if not any(ci_build.parse_circleci_url(url) is not None for _, _, url in checks(gh, "HEAD")):
        return []  # not a CircleCI project
    cutoff = dt.datetime.now(dt.UTC) - CIRCLECI_WINDOW
    pipelines = []  # the branch and pipeline of each recent pipeline that can be redundant
    # The pipelines are listed most recent first.
    for p in ci_build.circleci_items(f"/v2/project/gh/{gh}/pipeline"):
        if dt.datetime.fromisoformat(p["created_at"]) < cutoff:
            break
        vcs = p.get("vcs") or {}
        branch = vcs.get("branch") or vcs.get("tag")
        if branch and p["trigger"]["type"] in CIRCLECI_REDUNDANT_TRIGGERS:
            pipelines.append((branch, p))
    # the branch, pipeline, and workflow of each unfinished workflow
    workflows = [
        (branch, p, w)
        for (branch, p), pipeline_workflows in zip(
            pipelines,
            concurrently(lambda bp: unfinished_workflows(bp[1]), pipelines),
            strict=True,
        )
        for w in pipeline_workflows
    ]
    return [
        (
            ("circleci", w["id"]),
            branch_subject(label, branch),
            circleci_build(w["status"], w["id"], w["name"]),
            f", made redundant by workflow {latest[2]['id']}",
        )
        for (branch, _, w), latest in superseded(
            workflows,
            lambda bpw: (bpw[0], bpw[1]["trigger"]["type"], bpw[2]["name"]),
            lambda bpw: (bpw[1]["number"], bpw[2]["created_at"]),
        )
    ]


def unfinished_workflows(pipeline):
    """Find the unfinished workflows of a CircleCI pipeline.

    Returns:
        A list of the unfinished workflows, or the empty list if the pipeline no longer
        exists.
    """
    try:
        return [
            w
            for w in ci_build.circleci_items(f"/v2/pipeline/{pipeline['id']}/workflow")
            if w["status"] in CIRCLECI_UNFINISHED
        ]
    except urllib.error.HTTPError as e:
        if e.code == 404:  # The pipeline was deleted after it was listed.
            return []
        raise


def redundant_builds(label, gh, runs):
    """Find the redundant unfinished builds of the GitHub repository gh.

    Args:
        label: the repository's label.
        gh: the repository's GitHub name.
        runs: the unfinished GitHub Actions runs, as unfinished_runs returns them.

    Returns:
        A list of the identifier, subject, build, and reason of each redundant build.
    """
    result = redundant_runs(label, gh, runs)
    try:
        for org, project in azure_projects(gh):
            result += redundant_azure_builds(label, gh, org, project)
    except ci_build.REQUEST_ERRORS as e:
        print(
            f"{label}: failed to find redundant Azure Pipelines builds: {ci_build.failure(e)}",
            file=sys.stderr,
        )
    try:
        result += redundant_circleci_workflows(label, gh)
    except ci_build.REQUEST_ERRORS as e:
        print(
            f"{label}: failed to find redundant CircleCI workflows: {ci_build.failure(e)}",
            file=sys.stderr,
        )
    return result


def github_build(gh, r):
    """Describe the GitHub Actions run r in the GitHub repository gh.

    Returns:
        The status, description, URL, and cancelling function of r.
        The cancelling function takes no arguments.
    """
    return (
        r["status"],
        f"run {r['id']} ({r['name']})",
        r["html_url"],
        lambda: ci_build.run(["gh", "run", "cancel", "-R", gh, str(r["id"])]),
    )


@functools.cache
def warn_if_no_circleci_token():
    """If there is no CircleCI token, warn (only once) that CircleCI will refuse to cancel."""
    if not ci_build.circleci_token():
        print(
            f"{PROGRAM}: no CircleCI token found in $CIRCLECI_CLI_TOKEN or in "
            + " or ".join(ci_build.CIRCLECI_CONFIGS)
            + ", so CircleCI will refuse to cancel workflows;"
            " create a personal API token and run `circleci setup`",
            file=sys.stderr,
        )


@functools.cache
def checks(gh, sha):
    """Find the check runs and commit statuses of commit sha in the GitHub repository gh.

    Returns:
        A list of the status ("completed" if it has completed), name, and URL of each
        check run and commit status that has a URL.
    """
    result = []
    for page in ci_build.gh_api(f"repos/{gh}/commits/{sha}/check-runs?per_page=100", paginate=True):
        result.extend(
            (c["status"], c["name"], c["details_url"])
            for c in page["check_runs"]
            if c["details_url"]
        )
    status = ci_build.gh_api(f"repos/{gh}/commits/{sha}/status")
    result.extend(
        ("pending" if s["state"] == "pending" else "completed", s["context"], s["target_url"])
        for s in status["statuses"]
        if s["target_url"]
    )
    return result


def azure_build(status, org, project, build, name, url):
    """Describe Azure Pipelines build number build, of the pipeline with the given name.

    Returns:
        The status, description, URL, and cancelling function of the build.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.azure_api(org, project, build)}?api-version=7.1"
    return (
        status,
        f"Azure Pipelines build {build} ({name})",
        url,
        lambda: ci_build.request("PATCH", api, ci_build.azure_headers(), {"status": "cancelling"}),
    )


def circleci_build(status, workflow, name):
    """Describe the CircleCI workflow with the given id and name.

    Returns:
        The status, description, URL, and cancelling function of the workflow.
        The cancelling function takes no arguments.
    """
    api = f"{ci_build.CIRCLECI_API}/v2/workflow/{workflow}/cancel"

    def cancelling():
        warn_if_no_circleci_token()
        ci_build.request("POST", api, ci_build.circleci_headers())

    return (
        status,
        f"CircleCI workflow {workflow} ({name})",
        f"https://app.circleci.com/workflow/{workflow}",
        cancelling,
    )


def unfinished_other_builds(gh, sha):
    """Find the Azure Pipelines and CircleCI builds of commit sha that have not completed.

    Returns:
        A list of the identifier and build of each build.  A build is its status,
        description, URL, and cancelling function, which takes no arguments.
    """
    builds = {}  # identifier -> build
    for state, name, url in checks(gh, sha):
        if state == "completed":
            continue
        if parsed := ci_build.parse_azure_url(url):
            org, project, build = parsed
            builds.setdefault(
                ("azure", org, str(build)), azure_build(state, org, project, build, name, url)
            )
        elif ci_build.parse_circleci_url(url) is not None:
            try:
                workflow, _ = ci_build.circleci_workflow_of_url(url)
            except ci_build.REQUEST_ERRORS as e:
                print(f"  failed to look up {url}: {ci_build.failure(e)}", file=sys.stderr)
                continue
            if workflow is None:
                print(f"  no CircleCI workflow found for {url}", file=sys.stderr)
                continue
            builds.setdefault(("circleci", workflow), circleci_build(state, workflow, name))
    return list(builds.items())


def cancel(cancelling, url):
    """Call the cancelling function, reporting any failure, with the URL of the build."""
    try:
        cancelling()
    except ci_build.REQUEST_ERRORS as e:
        print(f"  failed to cancel {url}: {ci_build.failure(e)}", file=sys.stderr)


def handle(subject, build, dry_run, reason=""):
    """Cancel, or if dry_run is true report, the build of subject.

    Args:
        subject: what the build tests, such as a PR or a branch.
        build: the status, description, URL, and cancelling function of the build.
        dry_run: whether to only report the build.
        reason: text to append to the report.
    """
    status, description, url, cancelling = build
    print(
        f"{subject}: {'would cancel' if dry_run else 'cancelling'} {status} {description}{reason}"
    )
    if not dry_run:
        cancel(cancelling, url)


def main():
    """Cancel, or with --dry-run report, the builds of blocked PRs and redundant builds."""
    parser = argparse.ArgumentParser(
        prog=PROGRAM, description=__doc__.splitlines()[0] if __doc__ else None
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="report the builds but do not cancel them"
    )
    dry_run = parser.parse_args().dry_run
    if pathlib.Path(pr_status.CONFIG).exists():
        with pathlib.Path(pr_status.CONFIG).open() as f:
            cfg = json.load(f)
    else:
        cfg = pr_status.default_config(str(pathlib.Path.cwd()))
    for label, gh, blocked in blocked_prs(cfg):
        runs = unfinished_runs(gh)
        handled = set()  # identifiers of the builds that have been cancelled or reported
        for identifier, subject, build, reason in redundant_builds(label, gh, runs):
            handled.add(identifier)
            handle(subject, build, dry_run, reason)
        for ref, pr in blocked:
            builds = [
                (("github", r["id"]), github_build(gh, r))
                for r in runs.get((pr["owner"], pr["headRefName"]), [])
            ]
            builds += unfinished_other_builds(gh, pr["headRefOid"])
            for identifier, build in builds:
                if identifier not in handled:
                    handled.add(identifier)
                    handle(pr_name(label, ref), build, dry_run)


if __name__ == "__main__":
    main()
