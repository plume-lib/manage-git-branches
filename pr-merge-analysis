#!/usr/bin/env bash
# Report, for the open pull requests of a GitHub repository:
#  * which PRs conflict with master,
#  * which PRs contain all the non-merge commits of another PR and that PR's
#    changes, and
#  * which pairs of PRs conflict with each other.
#
# Usage: pr-merge-analysis [--no-pairwise] [--default-branch BRANCH] [--prune] REPO_DIR OWNER/REPO [PR_NUMBER...]
#   REPO_DIR is a local clone, into which the PR heads are fetched
#   (as refs/remotes/pr/N) along with master (as refs/remotes/csm/master).
#   The PR numbers, such as 123, are those of open PRs; if none is given, gh
#   lists all the open PRs.
#   --no-pairwise omits the pairwise conflicts, the most expensive section.
#   --default-branch names the branch that this script calls "master" (default:
#   the repository's default branch).  It is fetched as refs/remotes/csm/master.
#   --prune states that the given PR numbers are all the open PRs, so that the
#   cache and the refs/remotes/pr/N refs can be pruned (see below).
#
# Results are cached in .pr-merge-analysis-cache.tsv in the current directory
# (or in $PR_MERGE_ANALYSIS_CACHE, if set), keyed by OWNER/REPO and commit SHAs,
# so a check is recomputed only when a branch moves.  Several repositories can
# share the cache file.  When the run covers all the open PRs (no PR number is
# given, or --prune is given), it removes the cache lines of OWNER/REPO that
# refer to a commit that is no longer the head of an open PR or master, and it
# keeps the lines of other repositories.  It also deletes the refs
# refs/remotes/pr/N of the PRs that are not open.  Runs at the same time do not
# corrupt the cache, but one run's pruning can discard the lines that another
# run adds, which a later run then recomputes.
# Cache lines, each of which starts with the GitHub slug OWNER/REPO:
#   OWNER/REPO<TAB>merge<TAB>SHA1<TAB>SHA2<TAB>clean|conflict<TAB>conflicting files
#     (SHA1 < SHA2, so the order of the two branches does not matter)
#   OWNER/REPO<TAB>contains<TAB>MASTER_SHA<TAB>A_SHA<TAB>B_SHA<TAB>yes|no
#   OWNER/REPO<TAB>net-changes<TAB>MASTER_SHA<TAB>A_SHA<TAB>B_SHA<TAB>EXCLUDED<TAB>yes|no
#     (EXCLUDED is the comma-separated heads of the PRs whose commits are not
#     among B_SHA's own commits, as own_commits_excluded sets it)
#
# Requires Git 2.38 or later, gh, and Bash 4.4 or later as the first "bash" on
# the PATH.  On macOS, /bin/bash is Bash 3.2, so put a newer Bash, such as
# Homebrew's, earlier on the PATH.

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] \
  || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "$0: needs Bash 4.4 or later as the first \"bash\" on the PATH, but is running Bash ${BASH_VERSION:-unknown}" >&2
  exit 2
fi

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

require_git 38 'for git merge-tree --write-tree'

set -o pipefail
# Prints its arguments as an error message, and exits with status 1.
die() {
  echo "$0: $*" >&2
  exit 1
}
usage() {
  echo "usage: $0 [--no-pairwise] [--default-branch BRANCH] [--prune] REPO_DIR OWNER/REPO [PR_NUMBER...]" >&2
  exit 2
}
PAIRWISE=yes
DEFAULT_BRANCH=
PRUNE=no
while true; do
  case "$1" in
    --no-pairwise)
      PAIRWISE=no
      shift
      ;;
    --default-branch)
      [ $# -ge 2 ] || usage
      DEFAULT_BRANCH=$2
      shift 2
      ;;
    --prune)
      PRUNE=yes
      shift
      ;;
    *) break ;;
  esac
done
[ $# -ge 2 ] || usage
G=(git -C "$1")
# The GitHub slug, such as "plume-lib/manage-git-branches", that starts each of
# this repository's cache lines.
REPO=$2
CACHE="${PR_MERGE_ANALYSIS_CACHE:-$PWD/.pr-merge-analysis-cache.tsv}"
# Resolve any symbolic links, so that pruning replaces the file that a link
# names rather than the link.
links=0
while [ -L "$CACHE" ]; do
  links=$((links + 1))
  [ $links -le 40 ] || die "too many levels of symbolic links: $CACHE"
  link=$(readlink -- "$CACHE") || die "cannot read symbolic link: $CACHE"
  case $link in
    /*) CACHE=$link ;;
    *) CACHE=$(dirname -- "$CACHE")/$link ;;
  esac
done
touch "$CACHE" || exit 1
# The standard error of "git merge-tree", which merge_result keeps apart from
# its standard output.
MERGE_TREE_ERR=$(mktemp) || exit 1
# A directory that holds, for each commit, the names of the files that its own
# commits change, as own_files writes them.
OWN_FILES_DIR=$(mktemp -d) || exit 1
# The pruned cache, before it replaces the cache.
NEW_CACHE=
trap 'rm -rf "$MERGE_TREE_ERR" "$OWN_FILES_DIR" ${NEW_CACHE:+"$NEW_CACHE"}' EXIT

if [ $# -gt 2 ]; then
  # Validating the numbers also keeps the unquoted uses of $P from
  # glob-expanding them.
  for n in "${@:3}"; do
    [[ $n =~ ^[1-9][0-9]*$ ]] || die "not a pull request number: $n"
  done
  P=$(printf '%s\n' "${@:3}" | sort -nu)
else
  # Unlike "gh pr list", which stops at its --limit, this lists every open PR,
  # as pruning requires.
  P=$(gh api --paginate "repos/$REPO/pulls?state=open&per_page=100" --jq '.[].number' | sort -nu) \
    || exit 1
  PRUNE=yes
fi
# Fetch only the open PRs; refs/pull/*/head would also fetch every closed PR.
# The ref is named "master" whatever the default branch, so that callers need
# not know it.  The remote's HEAD is its default branch.
MASTER_SOURCE=HEAD
[ -z "$DEFAULT_BRANCH" ] || MASTER_SOURCE=refs/heads/$DEFAULT_BRANCH
REFSPECS=("+$MASTER_SOURCE:refs/remotes/csm/master")
for n in $P; do REFSPECS+=("+refs/pull/$n/head:refs/remotes/pr/$n"); done
# Authenticate as gh does, so that a private repository can be fetched, and never
# prompt for a username.
GIT_TERMINAL_PROMPT=0 "${G[@]}" -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
  fetch -q "https://github.com/$REPO.git" "${REFSPECS[@]}" || exit 1
MSHA=$("${G[@]}" rev-parse refs/remotes/csm/master) || exit 1

# Matches a commit's object ID, which is a SHA-1 or SHA-256 hash in hexadecimal.
OID_RE='^[0-9a-f]{40}([0-9a-f]{24})?$'
# Matches "-" or a comma-separated list of object IDs, as in the EXCLUDED field
# of a "net-changes" cache line.
EXCLUDED_RE='^(-|[0-9a-f]{40}([0-9a-f]{24})?(,[0-9a-f]{40}([0-9a-f]{24})?)*)$'
# OWN maps a commit to one of its non-merge commits that is not in master, or to
# the empty string if it has none.  EXCLUDED maps a commit to the value that
# own_commits_excluded sets RESULT to.  MERGE_BASE maps two commits, as in "SHA1
# SHA2", to the value that merge_base sets RESULT to.  OWN_START maps a commit to
# the value that own_start sets RESULT to.  OWN_CHANGES_FILES maps a commit to
# "yes" if its own commits change at least one file, otherwise to "no";
# own_files sets it.
declare -A SHA CACHED CURRENT OWN EXCLUDED MERGE_BASE OWN_START OWN_CHANGES_FILES
CURRENT[$MSHA]=1
REFS=()
for n in $P; do REFS+=("refs/remotes/pr/$n"); done
if [ -n "$P" ]; then
  # "git rev-parse" prints an argument that it cannot resolve, so its exit
  # status and each line must be checked.
  shas=$("${G[@]}" rev-parse "${REFS[@]}") || die "git rev-parse failed for the fetched PRs"
  mapfile -t shas <<< "$shas"
  [ ${#shas[@]} -eq ${#REFS[@]} ] \
    || die "git rev-parse printed ${#shas[@]} lines for ${#REFS[@]} PRs"
  i=0
  for n in $P; do
    SHA[$n]=${shas[i++]}
    [[ ${SHA[$n]} =~ $OID_RE ]] || die "cannot resolve PR $n: ${SHA[$n]}"
    CURRENT[${SHA[$n]}]=1
  done
fi
# Prints the complete lines of the cache whose first field is this repository's
# slug, if $1 is 1, or is not, if $1 is 0.  A last line that lacks its newline,
# such as one that another run is still writing, is incomplete, so it is not
# printed.
cache_lines() {
  # The appended line "x" is the last record, either alone or after an
  # incomplete line, so awk prints every record but the last.
  { cat "$CACHE" && echo x; } | awk -F '\t' -v repo="$REPO" -v same="$1" \
    'NR > 1 && (prev_repo == repo) == same { print prev } { prev = $0; prev_repo = $1 }'
}
own_lines=$(cache_lines 1) || die "cannot read the cache: $CACHE"
# Read only the well-formed lines.
while IFS=$'\t' read -r _ kind k1 k2 k3 rest; do
  if [ "$kind" = merge ] && [[ $k1 =~ $OID_RE && $k2 =~ $OID_RE ]] \
    && [[ $k3 = clean || $k3 = conflict ]]; then
    CACHED["merge $k1 $k2"]="$k3	$rest"
  elif [ "$kind" = contains ] && [[ $k1 =~ $OID_RE && $k2 =~ $OID_RE && $k3 =~ $OID_RE ]] \
    && [[ $rest = yes || $rest = no ]]; then
    CACHED["contains $k1 $k2 $k3"]="$rest"
  elif [ "$kind" = net-changes ] && [[ $k1 =~ $OID_RE && $k2 =~ $OID_RE && $k3 =~ $OID_RE ]] \
    && [[ ${rest%%	*} =~ $EXCLUDED_RE ]] && [[ ${rest#*	} = yes || ${rest#*	} = no ]]; then
    CACHED["net-changes $k1 $k2 $k3 ${rest%%	*}"]="${rest#*	}"
  fi
done <<< "$own_lines"

# These functions set RESULT rather than printing it, because a command
# substitution per call would fork a subshell for each of thousands of pairs.

# Sets RESULT to "clean" or "conflict<TAB>files".
merge_result() {
  local x=$1 y=$2
  [[ $x > $y ]] && {
    local t=$x
    x=$y
    y=$t
  }
  local key="merge $x $y"
  if [ -z "${CACHED[$key]+set}" ]; then
    local out code status files
    # Standard error is kept apart, so that a warning, such as one about
    # merge.renameLimit, does not precede the tree's object ID or appear among
    # the files.
    out=$("${G[@]}" merge-tree --write-tree --name-only "$x" "$y" 2> "$MERGE_TREE_ERR")
    code=$?
    # A conflict yields exit status 1 and standard output that starts with the
    # tree's object ID.  Any other failure, including exit status 1 with other
    # output, as for an argument that is not a commit, is an error.
    if [ $code -eq 1 ] && ! [[ ${out%%$'\n'*} =~ $OID_RE ]]; then
      code=error
    fi
    case $code in
      0)
        status=clean
        files=
        ;;
      1)
        status=conflict
        files=$(echo "$out" | sed -n '2,/^$/p' | tr '\n' ' ' | sed 's/ *$//')
        ;;
      *)
        echo "$0: git merge-tree $x $y failed:" >&2
        cat "$MERGE_TREE_ERR" >&2
        [ -z "$out" ] || echo "$out" >&2
        exit 1
        ;;
    esac
    CACHED[$key]="$status	$files"
    printf '%s\tmerge\t%s\t%s\t%s\t%s\n' "$REPO" "$x" "$y" "$status" "$files" >> "$CACHE"
  fi
  RESULT=${CACHED[$key]}
}

# Sets RESULT to "yes" if commit $1 contains every non-merge commit of $2 that
# is not in master (and there is at least one such commit), otherwise to "no".
commits_result() {
  local key="contains $MSHA $1 $2"
  if [ -z "${CACHED[$key]+set}" ]; then
    local ok=no missing
    # The non-merge commits of $2 that are not in master, which depend only on
    # $2, and those of them that are not in $1.  A failure is an error, not an
    # answer to cache.
    if [ -z "${OWN[$2]+set}" ]; then
      OWN[$2]=$("${G[@]}" rev-list --no-merges -n1 "$2" "^$MSHA") \
        || die "git rev-list $2 ^$MSHA failed"
    fi
    if [ -n "${OWN[$2]}" ]; then
      missing=$("${G[@]}" rev-list --no-merges -n1 "$2" "^$MSHA" "^$1") \
        || die "git rev-list $2 ^$MSHA ^$1 failed"
      [ -n "$missing" ] || ok=yes
    fi
    CACHED[$key]=$ok
    printf '%s\tcontains\t%s\t%s\t%s\t%s\n' "$REPO" "$MSHA" "$1" "$2" "$ok" >> "$CACHE"
  fi
  RESULT=${CACHED[$key]}
}

# The own commits of commit $1 are its non-merge commits that are in neither
# master nor the head of a PR whose commits $1 contains, as commits_result
# determines, unless that PR's head also contains $1's commits.  For example,
# if PR B's branch was created from PR X's branch, then B's own commits exclude
# X's commits.  A PR whose non-merge commits are the same as $1's does not
# exclude them, because then $1 would have no own commits.

# Sets RESULT to the comma-separated heads of the PRs whose commits are not
# among the own commits of commit $1, as in "SHA1,SHA2", or to "-" if there are
# none.
own_commits_excluded() {
  if [ -z "${EXCLUDED[$1]+set}" ]; then
    local n excluded=
    for n in $P; do
      [ "${SHA[$n]}" != "$1" ] || continue
      commits_result "$1" "${SHA[$n]}"
      [ "$RESULT" = yes ] || continue
      commits_result "${SHA[$n]}" "$1"
      [ "$RESULT" = yes ] || excluded+=,${SHA[$n]}
    done
    excluded=${excluded#,}
    EXCLUDED[$1]=${excluded:--}
  fi
  RESULT=${EXCLUDED[$1]}
}

# Sets RESULT to the merge base of commits $1 and $2, or to the empty string if
# they have none.
merge_base() {
  local key="$1 $2" base status
  if [ -z "${MERGE_BASE[$key]+set}" ]; then
    base=$("${G[@]}" merge-base "$1" "$2")
    status=$?
    [ $status -le 1 ] || die "git merge-base $1 $2 failed"
    MERGE_BASE[$key]=$base
  fi
  RESULT=${MERGE_BASE[$key]}
}

# Sets RESULT to a commit whose tree merges commits $1, $2, and so on, or to the
# empty string if there are none.  Where the commits conflict, a file holds
# conflict markers, so it differs from each version that resolves the conflict.
# The commit is one of the given commits if the others are its ancestors;
# otherwise it is a new merge commit, which no ref names.
merge_commits() {
  local out status tree cur x
  local -a independent
  RESULT=
  [ $# -gt 0 ] || return 0
  # The given commits that are not ancestors of others.
  out=$("${G[@]}" merge-base --independent "$@") || die "git merge-base --independent $* failed"
  mapfile -t independent <<< "$out"
  cur=${independent[0]}
  for x in "${independent[@]:1}"; do
    out=$("${G[@]}" merge-tree --write-tree "$cur" "$x" 2> "$MERGE_TREE_ERR")
    status=$?
    tree=${out%%$'\n'*}
    # As in merge_result, a conflict yields exit status 1 and standard output
    # that starts with the tree's object ID.
    if [ $status -gt 1 ] || ! [[ $tree =~ $OID_RE ]]; then
      cat "$MERGE_TREE_ERR" >&2
      [ -z "$out" ] || echo "$out" >&2
      die "git merge-tree $cur $x failed"
    fi
    # A fixed author, committer, and date, so that the same merge yields the
    # same commit, and so that a repository without user.name can make it.
    cur=$(GIT_AUTHOR_NAME=pr-merge-analysis GIT_AUTHOR_EMAIL=pr-merge-analysis \
      GIT_AUTHOR_DATE='@0 +0000' GIT_COMMITTER_NAME=pr-merge-analysis \
      GIT_COMMITTER_EMAIL=pr-merge-analysis GIT_COMMITTER_DATE='@0 +0000' \
      "${G[@]}" commit-tree --no-gpg-sign -p "$cur" -p "$x" -m "pr-merge-analysis merge" "$tree") \
      || die "git commit-tree $tree failed"
  done
  RESULT=$cur
}

# Sets the array START_BASES to the merge bases of commit $1 with master and
# with the heads of the PRs whose commits are not among the own commits of
# commit $2 (see own_commits_excluded), omitting a merge base that does not
# exist.  For example, if PR B's branch was created from PR X's branch, then
# for B and B they are B's merge base with master and X's head.
start_bases() {
  own_commits_excluded "$2"
  local excluded=$RESULT x
  START_BASES=()
  merge_base "$MSHA" "$1"
  [ -z "$RESULT" ] || START_BASES+=("$RESULT")
  if [ "$excluded" != - ]; then
    for x in ${excluded//,/ }; do
      merge_base "$1" "$x"
      [ -z "$RESULT" ] || START_BASES+=("$RESULT")
    done
  fi
}

# Sets RESULT to the commit that the own commits of commit $1 start from, or to
# the empty string if there is none.  Its tree merges the commits that
# start_bases finds for $1 and $1.  For example, if PR B's branch was created
# from PR X's branch, then B's own commits start from X's head; if B then merged
# a newer master, they start from the merge of X's head and that master.
own_start() {
  if [ -z "${OWN_START[$1]+set}" ]; then
    start_bases "$1" "$1"
    merge_commits "${START_BASES[@]}"
    OWN_START[$1]=$RESULT
  fi
  RESULT=${OWN_START[$1]}
}

# Sets the array DIFF_NAMES to the names of those of files $3, $4, and so on
# that differ between commits $1 and $2.  There must be at least one file.
diff_names() {
  local x=$1 y=$2
  shift 2
  # --literal-pathspecs, so that a file name is not taken for a glob pattern.
  "${G[@]}" --literal-pathspecs diff --name-only --no-renames -z "$x" "$y" -- "$@" \
    > "$OWN_FILES_DIR/diff" || die "git diff $x $y failed"
  mapfile -d '' DIFF_NAMES < "$OWN_FILES_DIR/diff"
}

# Writes to file "$OWN_FILES_DIR/$1" the names of the files that the own commits
# of commit $1 change, both sides of a rename included, and that differ between
# $1 and the commit that own_start says those commits start from.  Each name is
# followed by a NUL.  The names are separated by NUL, because a file name can
# contain a newline.  A file whose changes a later own commit undid, as when
# they moved to another PR, is not among them, unless own_start finds no
# commit.  A file on which the merge in own_start conflicts is among them.  A
# file is not among them if $1 merged a master that already makes the same
# change, as when the PR that $1 was created from landed.  Also sets
# OWN_CHANGES_FILES[$1].
own_files() {
  [ -z "${OWN_CHANGES_FILES[$1]+set}" ] || return 0
  own_commits_excluded "$1"
  local -a exclude=() all names=()
  local -A seen=()
  local x
  if [ "$RESULT" != - ]; then
    for x in ${RESULT//,/ }; do exclude+=("^$x"); done
  fi
  "${G[@]}" log --no-merges --no-renames --name-only -z --format= "$1" "^$MSHA" "${exclude[@]}" \
    > "$OWN_FILES_DIR/$1.tmp" || die "git log $1 ^$MSHA ${exclude[*]} failed"
  # Remove the empty names and the duplicates.
  mapfile -d '' all < "$OWN_FILES_DIR/$1.tmp"
  for x in "${all[@]}"; do
    [ -z "$x" ] || [ -n "${seen[$x]+set}" ] || {
      seen[$x]=1
      names+=("$x")
    }
  done
  if [ ${#names[@]} -eq 0 ]; then
    : > "$OWN_FILES_DIR/$1"
    OWN_CHANGES_FILES[$1]=no
    return 0
  fi
  own_start "$1"
  if [ -n "$RESULT" ]; then
    diff_names "$RESULT" "$1" "${names[@]}"
    names=("${DIFF_NAMES[@]}")
  fi
  if [ ${#names[@]} -eq 0 ]; then
    : > "$OWN_FILES_DIR/$1"
  else
    printf '%s\0' "${names[@]}" > "$OWN_FILES_DIR/$1"
  fi
  OWN_CHANGES_FILES[$1]=yes
}

# Sets RESULT to "no" if commit $1 lacks commit $2's changes, otherwise to
# "yes".  $1 has $2's change to a file that own_files lists for $2 if $1's
# version of the file is the same as $2's, or if it differs from the version in
# each commit that start_bases finds for $1 and $2, so that $1 changes the file
# further and might build on $2's change.  $1 lacks $2's changes if the own
# commits of $2 change at least one file, and $1 has none of $2's changes.  For
# example, $1 lacks $2's changes if $1 merged $2 and then reverted $2's
# changes, so that $1's diff against master contains nothing of $2, or if later
# own commits of $2 undid all of $2's changes.  But $1 does not lack the changes
# of a $2 whose own commits change no file, such as a PR that only merges other
# PRs, because $2's merges can resolve conflicts between them.
changes_result() {
  own_commits_excluded "$2"
  local excluded=$RESULT
  local key="net-changes $MSHA $1 $2 $excluded"
  if [ -z "${CACHED[$key]+set}" ]; then
    local ok=yes base n
    local -a files
    own_files "$2"
    mapfile -d '' files < "$OWN_FILES_DIR/$2"
    if [ "${OWN_CHANGES_FILES[$2]}" = yes ]; then
      ok=no
      if [ ${#files[@]} -gt 0 ]; then
        n=${#files[@]}
        # The files whose versions in $1 are not $2's.
        diff_names "$2" "$1" "${files[@]}"
        files=("${DIFF_NAMES[@]}")
        if [ ${#files[@]} -lt "$n" ]; then
          ok=yes
        else
          start_bases "$1" "$2"
          for base in "${START_BASES[@]}"; do
            # Keep the files whose versions in $1 also differ from base's.
            diff_names "$base" "$1" "${files[@]}"
            files=("${DIFF_NAMES[@]}")
            [ ${#files[@]} -gt 0 ] || break
          done
          [ ${#files[@]} -eq 0 ] || ok=yes
        fi
      fi
    fi
    CACHED[$key]=$ok
    printf '%s\tnet-changes\t%s\t%s\t%s\t%s\t%s\n' "$REPO" "$MSHA" "$1" "$2" "$excluded" "$ok" >> "$CACHE"
  fi
  RESULT=${CACHED[$key]}
}

# Sets RESULT to "yes" if commits_result and changes_result both set it to
# "yes" for commits $1 and $2, otherwise to "no".
contains_result() {
  commits_result "$1" "$2"
  [ "$RESULT" = no ] || changes_result "$1" "$2"
}

echo "## master conflicts"
for n in $P; do
  merge_result "$MSHA" "${SHA[$n]}"
  [ "${RESULT%%	*}" = conflict ] && echo "$n: ${RESULT#*	}"
done
echo "## containment (A contains all non-merge commits of B, and B's changes)"
for a in $P; do for b in $P; do
  [ "$a" = "$b" ] && continue
  contains_result "${SHA[$a]}" "${SHA[$b]}"
  [ "$RESULT" = yes ] && echo "$a contains $b"
done; done
if [ $PAIRWISE = yes ]; then
  echo "## pairwise conflicts"
  for a in $P; do for b in $P; do
    [ "$a" -lt "$b" ] || continue
    merge_result "${SHA[$a]}" "${SHA[$b]}"
    [ "${RESULT%%	*}" = conflict ] && echo "$a vs $b: ${RESULT#*	}"
  done; done
fi

# Prune the refs and the cache to the open PRs and current commits.  A run on
# only some of the open PRs does not know the other PRs, so it must not prune.
[ $PRUNE = yes ] || exit 0
declare -A OPEN_REF
for ref in "${REFS[@]}"; do OPEN_REF[$ref]=1; done
refs=$("${G[@]}" for-each-ref --format='%(refname)' refs/remotes/pr/) \
  || die "git for-each-ref refs/remotes/pr/ failed"
STALE=()
while read -r ref; do
  [ -z "$ref" ] || [ -n "${OPEN_REF[$ref]+set}" ] || STALE+=("delete $ref")
done <<< "$refs"
if [ ${#STALE[@]} -gt 0 ]; then
  printf '%s\n' "${STALE[@]}" | "${G[@]}" update-ref --stdin \
    || die "git update-ref failed to delete the refs of closed PRs"
fi
# A file of its own, so that runs at the same time do not write the same file.
NEW_CACHE=$(mktemp "$CACHE.XXXXXX") || exit 1
# Give it the cache's permissions, rather than mktemp's 0600.
cp -p "$CACHE" "$NEW_CACHE" || exit 1
{
  for key in "${!CACHED[@]}"; do
    # shellcheck disable=SC2206 # A key is words without glob characters; "read <<<" would be slow.
    k=($key)
    if [ "${k[0]}" = merge ]; then
      if [ -n "${CURRENT[${k[1]}]+set}" ] && [ -n "${CURRENT[${k[2]}]+set}" ]; then
        printf '%s\tmerge\t%s\t%s\t%s\n' "$REPO" "${k[1]}" "${k[2]}" "${CACHED[$key]}"
      fi
    elif [ "${k[1]}" = "$MSHA" ] && [ -n "${CURRENT[${k[2]}]+set}" ] && [ -n "${CURRENT[${k[3]}]+set}" ]; then
      if [ "${k[0]}" = contains ]; then
        printf '%s\tcontains\t%s\t%s\t%s\t%s\n' "$REPO" "${k[1]}" "${k[2]}" "${k[3]}" "${CACHED[$key]}"
      else
        current=yes
        if [ "${k[4]}" != - ]; then
          for x in ${k[4]//,/ }; do
            [ -n "${CURRENT[$x]+set}" ] || current=no
          done
        fi
        [ $current = no ] \
          || printf '%s\tnet-changes\t%s\t%s\t%s\t%s\t%s\n' "$REPO" "${k[1]}" "${k[2]}" "${k[3]}" "${k[4]}" "${CACHED[$key]}"
      fi
    fi
  done
  # The other repositories' lines, read last, just before the new cache replaces
  # the cache, so that pruning discards as few as possible of the lines that
  # other runs add meanwhile.
  cache_lines 0 || die "cannot read the cache: $CACHE"
} > "$NEW_CACHE" && mv "$NEW_CACHE" "$CACHE"
