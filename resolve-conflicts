#!/bin/sh

# Updates the dependency chains of pull requests that have merge conflicts,
# asking an AI agent for help, as `git-push-to` does.
#
# Usage:
#   resolve-conflicts [--nocompile] [--claude | --codex] [-C DIR]
#
# Run it in the directory that holds the working copy directories, as for
# `pr-status`, or pass that directory with "-C".
#
# This script does the following:
#  * run `pr-status`, which regenerates the dependency document and records the
#    dependency chains with conflicts (the chains of the document's section
#    "Dependency chains with conflicts"),
#  * run `git-push-to` on each chain that `pr-status
#    --print-conflicting-push-chains` prints, adding the "--claude" option (or
#    "--codex"; see `git-push-to`, under "Asking an AI agent") and any
#    "--nocompile" option; a chain that fails does not stop the others,
#  * if every chain succeeded, start over, until no chain has conflicts.
# It fails if a chain fails, or if chains with conflicts remain after
# ${max_rounds} rounds.

script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

# The number of times to run `pr-status` and the chains that it lists.
max_rounds=3

usage() {
  echo "Usage: ${SCRIPT_NAME} [--nocompile] [--claude | --codex] [-C DIR]" >&2
  exit 1
}

agent_option='--claude'
nocompile_option=''
while [ "$#" -ge 1 ]; do
  case "$1" in
    --nocompile) nocompile_option='--nocompile' ;;
    --claude | --codex) agent_option="$1" ;;
    -C)
      if [ "$#" -lt 2 ]; then usage; fi
      if ! cd -- "$2"; then
        echo "${SCRIPT_NAME}: cannot cd to $2" >&2
        exit 1
      fi
      shift
      ;;
    *) usage ;;
  esac
  shift
done

pr_status="${SCRIPT_DIR}/pr-status"
if [ ! -x "${pr_status}" ]; then
  echo "${SCRIPT_NAME}: cannot find pr-status in ${SCRIPT_DIR}" >&2
  exit 1
fi

# Each chain is split into directories, which must not be expanded as patterns.
set -f

newline='
'
tab='	'
round=1
while :; do
  if ! "${pr_status}"; then
    echo "${SCRIPT_NAME}: ${pr_status} failed in $(pwd)" >&2
    exit 1
  fi
  # One chain per line, its directories separated by tabs.
  if ! chains="$("${pr_status}" --print-conflicting-push-chains)"; then
    echo "${SCRIPT_NAME}: ${pr_status} --print-conflicting-push-chains failed in $(pwd)" >&2
    exit 1
  fi
  num_chains=0
  if [ -n "${chains}" ]; then
    num_chains="$(printf '%s\n' "${chains}" | wc -l | tr -d ' ')"
  fi

  if [ "${num_chains}" -eq 0 ]; then
    echo "${SCRIPT_NAME}: no dependency chain has conflicts"
    exit 0
  fi
  if [ "${round}" -gt "${max_rounds}" ]; then
    echo "${SCRIPT_NAME}: ${num_chains} dependency chains still have conflicts after ${max_rounds} rounds" >&2
    exit 1
  fi

  num_failed=0
  saved_ifs="${IFS}"
  IFS="${newline}"
  for chain in ${chains}; do
    IFS="${tab}"
    # shellcheck disable=SC2086 # Split the chain into directories.
    set -- ${chain}
    IFS="${saved_ifs}"
    echo "${SCRIPT_NAME}: git-push-to ${agent_option} ${nocompile_option} $*"
    # The chain does not read this script's standard input.
    # shellcheck disable=SC2086 # ${nocompile_option} is empty or one word.
    if ! "${SCRIPT_DIR}"/git-push-to "${agent_option}" ${nocompile_option} "$@" < /dev/null; then
      echo "${SCRIPT_NAME}: the chain failed: $*" >&2
      num_failed=$((num_failed + 1))
    fi
  done
  IFS="${saved_ifs}"

  if [ "${num_failed}" -ne 0 ]; then
    echo "${SCRIPT_NAME}: ${num_failed} of ${num_chains} dependency chains failed" >&2
    exit 1
  fi
  round=$((round + 1))
done
