#!/bin/sh

# Updates the dependency chains of pull requests that have merge conflicts,
# asking an AI agent for help, as `git-push-to` does.
#
# Usage:
#   resolve-conflicts [--nocompile] [--claude | --codex] [-C DIR]
#
# Run it in the directory that holds the working copy directories, as for
# `pr-status`, or pass that directory with "-C".
#
# This script does the following:
#  * run `pr-status`, which regenerates the dependency document and records the
#    dependency chains with conflicts (the chains of the document's section
#    "Dependency chains with conflicts", which omit a PR whose head commit is
#    old; see "dormant_after_days" in pr-status-config.md),
#  * run `git-push-to` on each chain that `pr-status
#    --print-conflicting-push-chains` prints, adding the "--claude" option (or
#    "--codex"; see `git-push-to`, under "Asking an AI agent") and any
#    "--nocompile" option; a chain that fails does not stop the others, but
#    a chain is skipped if a chain that failed or was skipped would have
#    pushed into the chain's first directory, because then that directory's
#    branch lacks the updates that the chain would push from it,
#  * add the "--no-pull-first" option for each chain whose first directory an
#    earlier chain since `pr-status` ran pulled, so that all of those chains
#    merge the same commit of it (see `git-push-to`, under "Several chains"),
#  * if every chain succeeded, start over, until no chain has conflicts.
# It fails if a chain fails, or if chains with conflicts remain after
# ${max_rounds} rounds.  It ends with a summary of the chains that failed or
# that have changes by an AI agent or by a hook to review, each with what
# `git-push-to --summary` wrote for it, as in
#   * myrepo-branch-main myrepo-branch-feature myrepo-branch-part2 (failed)
#       in /home/me/myrepo-branch-feature: claude also changed: README.md
#       failed to push myrepo-branch-feature into myrepo-branch-part2, while building
# The diagnostics above the summary give the details.

script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

# The number of times to run `pr-status` and the chains that it lists.
max_rounds=3

usage() {
  echo "Usage: ${SCRIPT_NAME} [--nocompile] [--claude | --codex] [-C DIR]" >&2
  exit 1
}

agent_option='--claude'
nocompile_option=''
while [ "$#" -ge 1 ]; do
  case "$1" in
    --nocompile) nocompile_option='--nocompile' ;;
    --claude | --codex) agent_option="$1" ;;
    -C)
      if [ "$#" -lt 2 ]; then usage; fi
      if ! cd -- "$2"; then
        echo "${SCRIPT_NAME}: cannot cd to $2" >&2
        exit 1
      fi
      shift
      ;;
    *) usage ;;
  esac
  shift
done

pr_status="${SCRIPT_DIR}/pr-status"
if [ ! -x "${pr_status}" ]; then
  echo "${SCRIPT_NAME}: cannot find pr-status in ${SCRIPT_DIR}" >&2
  exit 1
fi

# Each chain is split into directories, which must not be expanded as patterns.
set -f

# Holds the summary that each run of `git-push-to` writes.
make_temp_dir
work="${temp_dir}"
push_summary="${work}/summary"

newline='
'
tab='	'

# For each run of `git-push-to` that failed or that noted changes to
# review, in every round, a line "* " followed by the chain, then each line
# of the summary that it wrote, indented.
summary=''

## Prints ${summary}, if it is not empty, as a diagnostic.
print_summary() {
  if [ -n "${summary}" ]; then
    echo "${SCRIPT_NAME}: the dependency chains that failed or that have changes to review:" >&2
    printf '%s' "${summary}" >&2
  fi
}

round=1
while :; do
  if ! "${pr_status}"; then
    print_summary
    echo "${SCRIPT_NAME}: ${pr_status} failed in $(pwd)" >&2
    exit 1
  fi
  # One chain per line, its directories separated by tabs.
  if ! chains="$("${pr_status}" --print-conflicting-push-chains)"; then
    print_summary
    echo "${SCRIPT_NAME}: ${pr_status} --print-conflicting-push-chains failed in $(pwd)" >&2
    exit 1
  fi
  # Count the chains as the loop below splits them.
  num_chains=0
  saved_ifs="${IFS}"
  IFS="${newline}"
  for chain in ${chains}; do
    num_chains=$((num_chains + 1))
  done
  IFS="${saved_ifs}"

  if [ "${num_chains}" -eq 0 ]; then
    print_summary
    echo "${SCRIPT_NAME}: no dependency chain has conflicts"
    exit 0
  fi
  if [ "${round}" -gt "${max_rounds}" ]; then
    print_summary
    echo "${SCRIPT_NAME}: ${num_chains} dependency chains still have conflicts after ${max_rounds} rounds" >&2
    exit 1
  fi

  num_failed=0
  num_skipped=0
  # The directories that a chain that failed or was skipped would have pushed
  # into (every directory of the chain but the first), each followed by a
  # newline.
  stale_dirs="${newline}"
  # The first directories that this round's chains so far pulled; see
  # `is_pulled_first_dir`.
  pulled_first_dirs=''
  IFS="${newline}"
  for chain in ${chains}; do
    IFS="${tab}"
    # shellcheck disable=SC2086 # Split the chain into directories.
    set -- ${chain}
    IFS="${saved_ifs}"
    case "${stale_dirs}" in
      *"${newline}$1${newline}"*)
        echo "${SCRIPT_NAME}: skipped the chain, because an earlier chain did not update its first directory: $*" >&2
        num_skipped=$((num_skipped + 1))
        summary="${summary}* $* (skipped)${newline}"
        shift
        for dir in "$@"; do stale_dirs="${stale_dirs}${dir}${newline}"; done
        continue
        ;;
    esac
    if is_pulled_first_dir "$1"; then
      no_pull_first_option='--no-pull-first'
    else
      no_pull_first_option=''
    fi
    echo "${SCRIPT_NAME}: in $(pwd): git-push-to ${agent_option} ${nocompile_option} ${no_pull_first_option} $*"
    : > "${push_summary}"
    # The chain does not read this script's standard input.
    # shellcheck disable=SC2086 # Each option is empty or one word.
    "${SCRIPT_DIR}"/git-push-to "${agent_option}" ${nocompile_option} ${no_pull_first_option} \
      --summary "${push_summary}" "$@" < /dev/null
    push_status=$?
    # `git-push-to` exits with status 2 if it failed before it pulled the
    # first directory, which a later chain then pulls.
    if [ "${push_status}" -ne 2 ]; then
      add_pulled_first_dir "$1"
    fi
    push_lines="$(sed -e 's/^/    /' -- "${push_summary}")"
    if [ "${push_status}" -ne 0 ]; then
      echo "${SCRIPT_NAME}: the chain failed: $*" >&2
      num_failed=$((num_failed + 1))
      if [ -z "${push_lines}" ]; then
        push_lines="    (git-push-to failed with status ${push_status} and named no step in its summary)"
      fi
      summary="${summary}* $* (failed)${newline}${push_lines}${newline}"
      shift
      for dir in "$@"; do stale_dirs="${stale_dirs}${dir}${newline}"; done
    elif [ -n "${push_lines}" ]; then
      summary="${summary}* $*${newline}${push_lines}${newline}"
    fi
  done
  IFS="${saved_ifs}"

  if [ "${num_failed}" -ne 0 ]; then
    print_summary
    if [ "${num_skipped}" -ne 0 ]; then
      echo "${SCRIPT_NAME}: ${num_failed} of ${num_chains} dependency chains failed, and ${num_skipped} were skipped" >&2
    else
      echo "${SCRIPT_NAME}: ${num_failed} of ${num_chains} dependency chains failed" >&2
    fi
    exit 1
  fi
  round=$((round + 1))
done
