#!/bin/sh

# Runs `crreview-resolve` once for each open pull request that you opened and
# that is checked out in a working copy directory of the directory that holds
# the working copy directories.  `crreview-resolve` addresses the unresolved
# CodeRabbit review comments on the pull request of the current branch, then
# pushes and resolves the comments' review threads; it is in
# https://github.com/mernst/mdedots/blob/main/share/crreview-resolve .
#
# Usage:
#   crreview-resolve-all [--dry-run] [--agent claude|codex] [-C DIR]
#
# The directory that holds the working copy directories is DIR, or the
# current directory.  A working copy directory is an entry of it that is the
# top level of a git working tree whose HEAD is a branch.  This command
# ignores entries whose names start with ".", symbolic links, which could
# name a working tree twice, and directories that are not the top level of a
# working tree, such as an ordinary directory inside a clone.  It examines
# the working copy directories in the order of the C locale, in which, for
# example, "Z" precedes "a", so that the order does not depend on the user's
# locale.
#
# A working copy directory holds a pull request if the pull request's head is
# the branch that `git push` in the directory pushes the directory's branch
# to, as `pr_repositories` in common-functions.sh determines it.  A branch of
# the same name in another repository, even the upstream repository of a
# fork, does not count.  A directory is skipped if it holds no open pull
# request, for example because its clone has no GitHub remote or because its
# branch is the default branch, or if someone else opened its pull request.
# Addressing the comments on another person's pull request is that person's
# job, and the push would usually be refused, after the AI agent session had
# run.
#
# If several directories hold the same pull request, `crreview-resolve` runs
# in only one of them, so that it does not address the same comments twice:
# the first one whose HEAD is the pull request's head commit, or else the
# first one.  A directory whose HEAD is an older commit would make commits
# that the push rejects.
#
# `crreview-resolve` runs in one directory at a time, because each run can
# start an AI agent session.  A run that finds no CodeRabbit comments to
# address starts no session.  This command continues after a run fails, and
# at the end it lists the directories where `crreview-resolve` failed.
#
#   --dry-run  run nothing; just print each directory where this command
#              would run `crreview-resolve`, and its pull request
#   --agent    the AI agent, which is passed to `crreview-resolve`
#   -C DIR     the directory that holds the working copy directories
#
# The exit status is 0 if every run of `crreview-resolve` succeeded and the
# pull request of every working copy directory could be determined, and 1
# otherwise.  It is 2 for a usage error.

SCRIPT_NAME="$(basename -- "$0")"

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

usage() {
  echo "Usage: ${SCRIPT_NAME} [--dry-run] [--agent claude|codex] [-C DIR]"
}

dry_run=false
agent=""
agent_given=false
base_arg="."
while [ "$#" -ne 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --agent)
      if [ "$#" -lt 2 ]; then
        usage >&2
        exit 2
      fi
      agent="$2"
      agent_given=true
      shift 2
      ;;
    --agent=*)
      agent="${1#--agent=}"
      agent_given=true
      shift
      ;;
    -C)
      if [ "$#" -lt 2 ]; then
        usage >&2
        exit 2
      fi
      base_arg="$2"
      shift 2
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
if [ "${agent_given}" = true ]; then
  case "${agent}" in
    claude | codex) ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
fi
if ! base="$(physical_path "${base_arg}")"; then
  echo "${SCRIPT_NAME}: cannot change to directory ${base_arg}" >&2
  exit 2
fi
if [ "${dry_run}" = false ] && ! command -v crreview-resolve > /dev/null; then
  echo "${SCRIPT_NAME}: crreview-resolve is not on the PATH;" \
    "get it from https://github.com/mernst/mdedots/blob/main/share/crreview-resolve" >&2
  exit 1
fi
if [ "${agent_given}" = true ]; then
  set -- --agent "${agent}"
else
  set --
fi

if ! work="$(mktemp -d "${TMPDIR:-/tmp}/${SCRIPT_NAME}.XXXXXX")" || [ -z "${work}" ]; then
  echo "${SCRIPT_NAME}: cannot create a temporary directory" >&2
  exit 1
fi
trap 'rm -rf "${work}"' EXIT
trap 'rm -rf "${work}"; trap - INT; kill -s INT "$$"' INT
trap 'rm -rf "${work}"; trap - TERM; kill -s TERM "$$"' TERM

# The GitHub login of the user, such as "octocat".
if ! me="$(with_timeout "${github_query_seconds}" gh api user --jq .login < /dev/null)" \
  || [ -z "${me}" ]; then
  echo "${SCRIPT_NAME}: cannot determine your GitHub login" >&2
  exit 1
fi

tab="$(printf '\t')"
status=0

working_copy_directories "${base}" > "${work}/entries"

# Find each working copy directory's pull request.  Each line of
# ${work}/holders is a pull request's URL, its head commit, the directory's
# HEAD commit, and the directory.  The loop reads the entries from file
# descriptor 3, so that its commands can use the standard input.
: > "${work}/holders"
while IFS= read -r dir <&3; do
  path="${base}/${dir}"
  branch="$(current_branch "${path}")" || continue
  pr_repositories "${path}" "${branch}" || continue
  # `gh pr list --head` matches a branch of that name in any repository, so
  # select the pull request whose head repository is ${pr_head_repo}.  The
  # repository is named with its host, which overrides ${GH_REPO}.
  if ! prs="$(gh_query "cannot find the pull request of ${dir}" \
    gh pr list -R "github.com/${pr_base_repo}" \
    --head "${pr_head_branch}" --state open --json headRepositoryOwner,author,headRefOid,url \
    --jq '.[] | "\(.headRepositoryOwner.login) \(.author.login) \(.headRefOid) \(.url)"')"; then
    status=1
    continue
  fi
  pr="$(printf '%s\n' "${prs}" \
    | awk -v owner="${pr_head_repo%%/*}" 'tolower($1) == tolower(owner) { print $2, $3, $4; exit }')"
  if [ -z "${pr}" ]; then continue; fi
  author="${pr%% *}"
  pr="${pr#* }"
  pr_oid="${pr%% *}"
  url="${pr#* }"
  if [ "${author}" != "${me}" ]; then
    echo "${SCRIPT_NAME}: skipping ${dir}, whose pull request ${url} is by ${author}"
    continue
  fi
  printf '%s\t%s\t%s\t%s\n' "${url}" "${pr_oid}" "$(git -C "${path}" rev-parse HEAD)" "${dir}" \
    >> "${work}/holders"
done 3< "${work}/entries"

# Choose one directory for each pull request.  Each line of ${work}/plan is
# "skip", a URL, a directory, and the directory chosen for the URL; or "run",
# a URL, and the chosen directory.  The "run" lines are in the order of the
# chosen directories.
awk -F "${tab}" '
  {
    n++
    url[n] = $1
    dir[n] = $4
    if (!($1 in chosen)) {
      order[++urls] = $1
      chosen[$1] = $4
    }
    if ($2 == $3 && !($1 in current)) {
      current[$1] = $4
    }
  }
  END {
    for (i = 1; i <= urls; i++) {
      if (order[i] in current) {
        chosen[order[i]] = current[order[i]]
      }
    }
    for (i = 1; i <= n; i++) {
      if (dir[i] != chosen[url[i]]) {
        printf "skip\t%s\t%s\t%s\n", url[i], dir[i], chosen[url[i]]
      }
    }
    for (i = 1; i <= n; i++) {
      if (dir[i] == chosen[url[i]]) {
        printf "run\t%s\t%s\n", url[i], dir[i]
      }
    }
  }' "${work}/holders" > "${work}/plan"

# The directories where `crreview-resolve` failed, one per line.
failed=""
while IFS="${tab}" read -r action url dir chosen <&3; do
  if [ "${action}" = skip ]; then
    echo "${SCRIPT_NAME}: skipping ${dir}, whose pull request ${url} is also in ${chosen}"
    continue
  fi
  if [ "${dry_run}" = true ]; then
    echo "Would run crreview-resolve in ${dir} for ${url}"
    continue
  fi
  echo "===== ${dir}: ${url}"
  if ! (cd -- "${base}/${dir}" && crreview-resolve "$@"); then
    failed="${failed}${dir}
"
    status=1
  fi
done 3< "${work}/plan"

if [ -n "${failed}" ]; then
  echo "${SCRIPT_NAME}: crreview-resolve failed in:" >&2
  printf '%s' "${failed}" >&2
fi
exit "${status}"
