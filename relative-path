#!/bin/sh

# Prints the pathname of TARGET, relative to BASE.
#
# Usage:
#   relative-path BASE TARGET
#
# BASE and TARGET are pathnames of existing files or directories.  Either may
# be absolute or relative to the current directory.  The output is a relative
# pathname:  interpreting it with respect to BASE yields TARGET.
#
# This is a portable version of `realpath -e --relative-to=BASE TARGET`.  The
# `--relative-to` option is a GNU extension that the BSD and macOS versions of
# `realpath` do not support.  Like `realpath -e` and unlike plain `realpath`,
# this script rejects a pathname that does not resolve to an existing file,
# such as a symbolic link whose target does not exist.

script_path="$0"
case "${script_path}" in
  -*) script_path="./${script_path}" ;;
esac
SCRIPT_NAME="$(basename "${script_path}")"

if [ "$#" -ne 2 ]; then
  echo "Usage: ${SCRIPT_NAME} BASE TARGET" >&2
  exit 1
fi

# Prints the absolute pathname of $1, with symbolic links resolved.
# `realpath` would be simpler, but POSIX added it only in 2024 and some systems
# still lack it -- which is the same reason this script exists -- whereas `cd`,
# `pwd -P`, and `readlink` are what the rest of this package already relies on.
canonicalize() {
  # `cd` below resolves every symbolic link in the pathname, but only if the
  # final component names a directory, so resolve a final symbolic link here.
  canonical="$1"
  canonical_links=0
  while [ -L "${canonical}" ]; do
    canonical_links=$((canonical_links + 1))
    if [ "${canonical_links}" -gt 40 ]; then
      return 1
    fi
    if ! canonical_link="$(readlink -- "${canonical}")"; then
      return 1
    fi
    case "${canonical_link}" in
      /*) canonical="${canonical_link}" ;;
      *) canonical="$(dirname -- "${canonical}")/${canonical_link}" ;;
    esac
  done
  if [ -d "${canonical}" ]; then
    # `cd` writes its own diagnostic when it fails; discard it, because the
    # caller writes a better one.
    (CDPATH='' cd -- "${canonical}" && pwd -P) 2> /dev/null
    return
  fi
  if ! canonical_dir="$( (CDPATH='' cd -- "$(dirname -- "${canonical}")" && pwd -P) 2> /dev/null )"; then
    return 1
  fi
  # `pwd -P` prints "/" for the root directory, where appending "/" too would
  # produce "//name" rather than "/name".
  case "${canonical_dir}" in
    */) printf '%s%s\n' "${canonical_dir}" "$(basename -- "${canonical}")" ;;
    *) printf '%s/%s\n' "${canonical_dir}" "$(basename -- "${canonical}")" ;;
  esac
}

# The `[ -e ... ]` tests reject a pathname whose final component does not
# exist, including a symbolic link whose target does not exist.  `realpath -e`
# would do so, but `-e` is a GNU extension.
if ! [ -e "$1" ] || ! base="$(canonicalize "$1")" || [ -z "${base}" ]; then
  echo "${SCRIPT_NAME}: cannot canonicalize: $1" >&2
  exit 1
fi
if ! [ -e "$2" ] || ! target="$(canonicalize "$2")" || [ -z "${target}" ]; then
  echo "${SCRIPT_NAME}: cannot canonicalize: $2" >&2
  exit 1
fi

# TARGET with exactly one trailing "/".  Comparing that against the pattern
# "${prefix}"/* makes TARGET match its own directory prefix, and makes the loop
# below terminate at the root directory, where ${prefix} is the empty string.
target_slash="${target%/}/"

# Walk up from BASE until reaching a directory that contains TARGET, recording
# one ".." for each level.
up=""
common="${base}"
while :; do
  prefix="${common%/}"
  case "${target_slash}" in
    "${prefix}"/*) break ;;
  esac
  up="../${up}"
  common="$(dirname "${common}")"
done

# The part of TARGET that is below the common ancestor.
down="${target_slash#"${prefix}"/}"

result="${up}${down}"
result="${result%/}"
if [ -z "${result}" ]; then
  result="."
fi

printf '%s\n' "${result}"
