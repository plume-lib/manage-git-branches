#!/bin/sh

# Removes a branch directory:  a directory that holds a branch's working tree,
# or one that holds nothing of value.  Refuses when the removal would lose
# work.
#
# Usage:
#   git-remove-branch-directory [--force] [--force-uncommitted]
#                               [--force-unpushed] [--repository DIR]
#                               [--] DIRECTORY...
#
# Each DIRECTORY is one of the kinds of directory that `git-orphaned-branches`
# reports:
#
#  * A linked worktree, such as `git-new-branch` and `git-checkout-branch`
#    make.  It is removed with `git worktree remove --force`, and its branch
#    is deleted from the repository that it shares, so that the branch name
#    can be used again.
#  * The top level of a clone, such as `git-new-branch --copy` makes.  It is
#    removed with `rm -rf`, which destroys the clone's objects and refs along
#    with its files, so nothing that `rm -rf` would lose is recoverable
#    afterward.
#  * A directory that is no repository at all.  It is removed with `rm -rf`.
#
# Two checks therefore ask, first, whether anything would be lost:
#
#  * Uncommitted changes to tracked files, waived by `--force-uncommitted`.
#    Untracked and ignored files do not count:  a branch directory is full of
#    build output, and refusing on account of that would refuse nearly every
#    directory and make this command useless.
#  * Commits that no other ref holds, waived by `--force-unpushed`.
#    For a clone, the question is about every ref of the clone, not just the
#    branch that is checked out, because `rm -rf` takes all of them with it:
#    a clone with an unpushed commit on a branch that nobody has looked at in
#    a year is exactly what this check exists to catch, and so are a stash
#    entry and a commit made on a detached HEAD, which no branch names at
#    all.  A commit counts as held if a remote-tracking ref or a tag holds it.
#    A bare repository is asked the same question:  it holds no working tree,
#    so the first check has nothing to ask about, but its objects are its own.
#    For a linked worktree, the question is about its HEAD and its branch,
#    which are all that the removal deletes, and a commit also counts as held
#    if another branch holds it.  Its commits remain in the shared repository
#    until `git gc`, so `git fsck --lost-found` can recover them for a while.
#    For a clone and a linked worktree, the question is also asked of every
#    checked-out submodule, about every ref, because the submodule's
#    repository goes with the directory.
#
# `--force` waives both.  Each refusal names the check, says how much would be
# lost, and quotes the flag that waives it; each waiver says on standard error
# what it overrode, so that a user who forces a removal still learns what they
# destroyed.  This `--force` is unrelated to the `--force` that this command
# passes to `git worktree remove`, which keeps git from refusing a worktree
# that holds modified or untracked files; the checks above have already
# decided what is safe to delete.
#
# A check that cannot run refuses as well.  When `git status` or `git rev-list`
# fails -- on a corrupt index, for instance -- its silence means that the
# answer is unknown, not that there is nothing to lose, and none of the
# `--force` flags waives such a refusal:  each of those waives a loss that this
# command has measured and named.
#
# Some refusals cannot be waived, because they are certainly mistakes:
#  * the main working tree of a repository that has a linked worktree
#    registered, since removing it removes the repository that every one of
#    those worktrees depends on;
#  * a linked worktree that is locked, whether or not its directory exists,
#    since `git worktree lock` is the user's own statement that it must not
#    be removed;
#  * the current directory, or an ancestor of it; and
#  * any other working tree whose `.git` is a file, such as a submodule's
#    working tree, which is `git submodule deinit`'s to remove.
#
# A DIRECTORY that no longer exists is accepted if it is still registered as
# a worktree:  one that was removed with `rm -rf` leaves behind its
# registration and its branch, which keep the branch name from being used
# again.  This command removes both, after the check for unpushed commits.
# `--repository DIR` names a working tree of the repository that the
# worktree belonged to; it defaults to the current directory, if that is a
# working tree.  A DIRECTORY that is not registered there is an error, as it
# is when no repository is given, so that a mistyped name fails wherever this
# command is run.
#
# This command never runs `git worktree prune`, which would remove every
# registration whose directory is missing, including that of a worktree that
# the user moved with `mv` and has not repaired, which cannot be repaired
# afterward.  It removes only the one registration that it was asked about.
#
# The exit status is 0 if every DIRECTORY was removed and 1 if any was not; a
# refusal for one DIRECTORY does not stop the others, since a caller passes a
# whole list.  This command says nothing when it succeeds.
#
# This command requires git 2.31 or later.
#
# This command does not ask whether the branch was deleted in its remote.
# `git-orphaned-branches` and `is-deleted-branch` answer that question, and a
# user who names a directory has already decided.

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

if [ ! -r "${SCRIPT_DIR}/remote-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/remote-functions.sh" >&2
  exit 1
fi
# shellcheck source=remote-functions.sh
. "${SCRIPT_DIR}/remote-functions.sh"

# Without this, every check below would ask about whatever repository the
# caller happened to be working in, rather than about the directory that
# `rm -rf` is about to take:  a directory with uncommitted changes and unpushed
# commits would be classified and cleared by the answers of some other, clean
# repository.
#
# $GIT_INDEX_FILE names the index alone, and the uncommitted-changes check is
# the one that reads an index.  A modified tracked file is still caught through
# a foreign index, because it differs from whatever the index holds, but work
# that exists *only* in the index is not:  a file that was created and staged
# and never committed is absent from the foreign index, so it is untracked
# there, and `--untracked-files=no` then says nothing about it.  Such a
# directory would be removed, silently and with exit status 0.
unset_git_location_variables

usage() {
  echo "Usage: ${SCRIPT_NAME} [--force] [--force-uncommitted] [--force-unpushed] [--repository DIR] [--] DIRECTORY..." >&2
}

force_uncommitted=0
force_unpushed=0
repository=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)
      force_uncommitted=1
      force_unpushed=1
      ;;
    --force-uncommitted) force_uncommitted=1 ;;
    --force-unpushed) force_unpushed=1 ;;
    --repository)
      if [ "$#" -lt 2 ]; then
        echo "${SCRIPT_NAME}: --repository needs an argument" >&2
        usage
        exit 1
      fi
      repository="$2"
      shift
      ;;
    --)
      shift
      break
      ;;
    -?*)
      echo "${SCRIPT_NAME}: unrecognized option: $1" >&2
      usage
      exit 1
      ;;
    *) break ;;
  esac
  shift
done

if [ "$#" -eq 0 ]; then
  echo "${SCRIPT_NAME}: no directory to remove" >&2
  usage
  exit 1
fi

# For `git rev-parse --path-format=absolute`.
require_git 31

# Prints the absolute pathname of directory $1, with symbolic links resolved.
# `realpath` would be simpler, but POSIX added it only in 2024 and some
# systems still lack it, whereas `cd` and `pwd -P` are portable.  `cd` writes
# its own diagnostic on failure; discard it, because the callers below write a
# better one.
absolute_path() {
  (CDPATH='' cd -- "$1" && pwd -P) 2> /dev/null
}

# Prints the number of lines of $1, which is 0 for the empty string.
line_count() {
  printf '%s' "$1" | grep -c '' || true
}

# Prints the number of linked worktrees of the repository in directory $1
# whose directory still exists.
#
# `git worktree list --porcelain` prints the main working tree first and each
# linked worktree after it, one `worktree PATH` line per entry.  A pathname
# that contains a newline cannot be represented in that format; git offers
# `-z` for that, which needs git 2.36, and a newline in the pathname of a
# repository is pathological.
#
# A registration whose directory is gone protects nothing:  removing the
# repository cannot break a working tree that does not exist, and
# `git worktree prune` would drop the registration.  git lists such an entry
# all the same, marked prunable, so test each one.  `live_dependent_worktree`
# in `git-orphaned-branches` applies the same test, and the two must agree:
# otherwise a stale registration makes a directory that that command lists one
# that this command refuses, with a refusal that no flag can waive.
live_linked_worktrees() {
  git -C "$1" worktree list --porcelain 2> /dev/null \
    | sed -n 's/^worktree //p' \
    | (
      # Discard the main working tree, which is $1 itself.  Only a linked
      # worktree depends on the repository that removing $1 would take.
      if ! IFS= read -r live_linked_main; then
        echo 0
        exit 0
      fi
      : "${live_linked_main}"
      live_linked_count=0
      while IFS= read -r live_linked_dir; do
        if [ -d "${live_linked_dir}" ]; then
          live_linked_count=$((live_linked_count + 1))
        fi
      done
      echo "${live_linked_count}"
    )
}

# Prints the administrative directory of the worktree at the absolute
# pathname $2, within the common git directory $1, or nothing if no
# registration names that worktree.
#
# The administrative directory cannot be derived from the worktree's
# basename, which differs from it after a `git worktree move`, and
# `git worktree list` does not name it.  Each one holds a `gitdir` file that
# names its worktree's `.git`, which is the mapping that git itself follows.
#
# With `worktree.useRelativePaths`, that name is relative to the
# administrative directory.  The worktree is missing, so resolve its parent,
# which may still exist; if that fails, the entry does not match.
worktree_admin_dir() {
  for worktree_admin_gitdir in "$1"/worktrees/*/gitdir; do
    if [ ! -f "${worktree_admin_gitdir}" ]; then
      continue
    fi
    worktree_admin_entry="$(dirname -- "${worktree_admin_gitdir}")"
    worktree_admin_target="$(cat -- "${worktree_admin_gitdir}")"
    case "${worktree_admin_target}" in
      /*) ;;
      *)
        worktree_admin_wt="$(dirname -- "${worktree_admin_target}")"
        if ! worktree_admin_parent="$(absolute_path \
          "${worktree_admin_entry}/$(dirname -- "${worktree_admin_wt}")")" \
          || [ -z "${worktree_admin_parent}" ]; then
          continue
        fi
        worktree_admin_target="${worktree_admin_parent%/}/$(basename -- "${worktree_admin_wt}")/.git"
        ;;
    esac
    if [ "${worktree_admin_target}" = "$2/.git" ]; then
      printf '%s\n' "${worktree_admin_entry}"
      return 0
    fi
  done
}

# Checks whether removing a linked worktree would lose commits, and sets
# ${remove_refusals} to 1 if the removal must not proceed.  $1 is the common
# git directory of the worktree's repository, $2 the commit that the
# worktree's HEAD names, $3 its branch (empty for a detached HEAD), and $4 the
# worktree's pathname, for the messages.
#
# The removal deletes the worktree's HEAD and its branch, and nothing else, so
# ask about those alone:  a commit that another branch, a remote-tracking ref,
# or a tag holds is not lost.  Not `--all`, which in a repository with
# worktrees includes every worktree's HEAD -- among them the HEAD of the
# worktree being removed -- so that the count is always 0.  `--exclude`
# applies only to the option that follows it, and a pattern for `--branches`
# omits `refs/heads/`.
check_worktree_unpushed() {
  if [ -n "$3" ]; then
    set -- "$1" "$2" "$3" "$4" "refs/heads/$3" "--exclude=$3"
  else
    set -- "$1" "$2" "$3" "$4"
  fi
  check_worktree_unpushed_dir="$4"
  check_worktree_unpushed_count="$(git --git-dir="$1" rev-list --count "$2" \
    ${5:+"$5"} --not ${6:+"$6"} --branches --tags --remotes 2> /dev/null)"
  if [ -z "${check_worktree_unpushed_count}" ]; then
    echo "${SCRIPT_NAME}: refusing to remove ${check_worktree_unpushed_dir}: cannot tell whether it holds commits that no other ref holds" >&2
    remove_refusals=1
  elif [ "${check_worktree_unpushed_count}" -gt 0 ]; then
    if [ "${force_unpushed}" -eq 0 ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${check_worktree_unpushed_dir}: ${check_worktree_unpushed_count} commit(s) are on no other branch, remote-tracking ref, or tag; re-run with --force-unpushed" >&2
      remove_refusals=1
    else
      echo "${SCRIPT_NAME}: ${check_worktree_unpushed_dir}: --force-unpushed: deleting ${check_worktree_unpushed_count} commit(s) that are on no other branch, remote-tracking ref, or tag; until \`git gc\` runs, \`git fsck --lost-found\` can recover them" >&2
    fi
  fi
}

# Asks each checked-out submodule of the working tree $1, recursively, the
# question that the check of a clone asks:  does it hold commits that no
# remote-tracking ref and no tag holds?  Sets remove_refusals to 1 if the
# removal must not proceed.
#
# A submodule's git directory lies in the git directory of the working tree
# that holds it, or in the submodule's own working tree, so removing that
# working tree destroys the submodule's repository, whatever kind of working
# tree it is.  The checks of the superproject do not see those commits:
# `git status` reports a submodule whose HEAD differs from the commit that the
# superproject records, but not a commit on a submodule branch that is not
# checked out, nor a commit that the superproject records but that was never
# pushed from the submodule.  `git submodule foreach` visits only checked-out
# submodules; the git directory of one that `git submodule deinit` has
# removed from the working tree is not asked about.
check_submodules_unpushed() {
  # shellcheck disable=SC2016 # The expansions are for the inner shell.
  if ! check_submodules_counts="$(git -C "$1" submodule --quiet foreach \
    --recursive 'count="$(git rev-list --count --all --not --remotes --tags)" \
      && printf "%s %s\n" "${count}" "${displaypath}"' 2> /dev/null)"; then
    echo "${SCRIPT_NAME}: refusing to remove $1: cannot tell whether its submodules hold commits that no other ref holds" >&2
    remove_refusals=1
    return
  fi
  check_submodules_total="$(printf '%s\n' "${check_submodules_counts}" \
    | awk '{ n += $1 } END { print n + 0 }')"
  check_submodules_paths="$(printf '%s\n' "${check_submodules_counts}" \
    | awk '$1 > 0 { sub(/^[0-9]+ /, ""); printf "%s%s", sep, $0; sep = ", " }')"
  if [ "${check_submodules_total}" -gt 0 ]; then
    if [ "${force_unpushed}" -eq 0 ]; then
      echo "${SCRIPT_NAME}: refusing to remove $1: ${check_submodules_total} commit(s) in submodule(s) ${check_submodules_paths} are on no remote-tracking ref or tag; re-run with --force-unpushed" >&2
      remove_refusals=1
    else
      echo "${SCRIPT_NAME}: $1: --force-unpushed: deleting ${check_submodules_total} commit(s) in submodule(s) ${check_submodules_paths} that are on no remote-tracking ref or tag" >&2
    fi
  fi
}

# Deletes the branch $2, which a removed linked worktree had checked out, from
# the repository whose common git directory is $1, if the branch still names
# the commit $3.  Prints a diagnostic and returns 1 if it cannot.
#
# `update-ref` rather than `git branch --delete`, because it takes a full
# refname, so a branch name that begins with "-" cannot be read as an option.
# Unlike `git branch --delete`, it leaves the branch's configuration, such as
# its upstream, which a new branch of the same name would inherit; remove that
# too.  The section is absent for a branch that has no configuration.
delete_worktree_branch() {
  if [ -z "$2" ]; then
    return 0
  fi
  if ! git --git-dir="$1" update-ref -d "refs/heads/$2" "$3"; then
    echo "${SCRIPT_NAME}: cannot delete the branch $2" >&2
    return 1
  fi
  git --git-dir="$1" config --remove-section "branch.$2" > /dev/null 2>&1 || true
}

# Cleans up after the linked worktree $1, which no longer exists:  removes its
# registration and deletes its branch, unless the check for unpushed commits
# refuses.  The facts come from the repository that ${repository} names, or
# from the current directory's, because without the directory nothing else
# can supply them.  Prints a diagnostic and returns 1 if it does not finish.
remove_missing_worktree() {
  if ! missing_repository="$(git -C "${repository:-.}" rev-parse \
    --show-toplevel 2> /dev/null)" || [ -z "${missing_repository}" ]; then
    echo "${SCRIPT_NAME}: no such directory: $1" >&2
    if [ -z "${repository}" ]; then
      echo "${SCRIPT_NAME}: to clean up after a worktree whose directory is gone, run this command in a working tree of its repository, or name one with --repository" >&2
    else
      echo "${SCRIPT_NAME}: --repository ${repository} is not a working tree" >&2
    fi
    return 1
  fi
  # A registration names an absolute pathname, with symbolic links resolved,
  # so make $1 one.  Its parent may still exist even though $1 does not.
  missing_parent="$(dirname -- "$1")"
  missing_base="$(basename -- "$1")"
  if missing_parent_real="$(absolute_path "${missing_parent}")" \
    && [ -n "${missing_parent_real}" ]; then
    missing_dir="${missing_parent_real%/}/${missing_base}"
  else
    case "$1" in
      /*) missing_dir="$1" ;;
      *) missing_dir="$(pwd -P)/$1" ;;
    esac
  fi

  # The entry of `git worktree list --porcelain` for ${missing_dir}:  a
  # `worktree` line, then `HEAD`, then `branch` or `detached`, then a blank
  # line.  A missing worktree is still listed, with its branch.  The
  # directory reaches awk through the environment rather than `-v`, which
  # would interpret a backslash in it as an escape.
  missing_entry="$(git -C "${missing_repository}" worktree list --porcelain \
    | missing_dir="${missing_dir}" awk '
        $0 == "worktree " ENVIRON["missing_dir"] { found = 1; next }
        found && $0 == "" { exit }
        found { print }')"
  if [ -z "${missing_entry}" ]; then
    echo "${SCRIPT_NAME}: no such directory, and no worktree registered there in ${missing_repository}: $1" >&2
    return 1
  fi
  missing_head="$(printf '%s\n' "${missing_entry}" | sed -n 's/^HEAD //p')"
  missing_branch="$(printf '%s\n' "${missing_entry}" \
    | sed -n 's|^branch refs/heads/||p')"
  if ! missing_common="$(git -C "${missing_repository}" rev-parse \
    --path-format=absolute --git-common-dir)" || [ -z "${missing_common}" ]; then
    echo "${SCRIPT_NAME}: cannot determine the repository of ${missing_repository}" >&2
    return 1
  fi
  missing_admin="$(worktree_admin_dir "${missing_common}" "${missing_dir}")"
  if [ -z "${missing_admin}" ]; then
    echo "${SCRIPT_NAME}: refusing to clean up after ${missing_dir}: cannot find its administrative directory in ${missing_common}/worktrees" >&2
    return 1
  fi
  # A lock is what keeps a worktree that is missing only for now -- one on
  # removable media that is not mounted -- from being cleaned up.
  if [ -f "${missing_admin}/locked" ]; then
    missing_lock_reason="$(cat -- "${missing_admin}/locked" 2> /dev/null)"
    echo "${SCRIPT_NAME}: refusing to clean up after ${missing_dir}: it is locked${missing_lock_reason:+ (${missing_lock_reason})}; run \`git worktree unlock\` first" >&2
    return 1
  fi

  # There is no working tree to hold uncommitted changes, but the branch is
  # about to go.
  remove_refusals=0
  if [ -z "${missing_head}" ]; then
    echo "${SCRIPT_NAME}: refusing to clean up after ${missing_dir}: cannot determine its HEAD" >&2
    return 1
  fi
  check_worktree_unpushed "${missing_common}" "${missing_head}" \
    "${missing_branch}" "${missing_dir}"
  if [ "${remove_refusals}" -ne 0 ]; then
    return 1
  fi

  if ! rm -rf -- "${missing_admin}"; then
    echo "${SCRIPT_NAME}: cannot remove: ${missing_admin}" >&2
    return 1
  fi
  delete_worktree_branch "${missing_common}" "${missing_branch}" "${missing_head}"
}

# Removes directory $1, unless one of the checks refuses.  Prints a diagnostic
# and returns 1 if it does not remove the directory.
remove_branch_directory() {
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then
    remove_missing_worktree "$1"
    return
  fi
  if [ ! -d "$1" ] || [ -L "$1" ]; then
    # A symbolic link, even one to a directory, names something that this
    # command was not asked to remove:  `rm -rf` would remove the link and
    # leave the directory.
    echo "${SCRIPT_NAME}: not a directory: $1" >&2
    return 1
  fi
  if ! remove_dir="$(absolute_path "$1")"; then
    echo "${SCRIPT_NAME}: cannot canonicalize: $1" >&2
    return 1
  fi
  if [ -z "${remove_dir}" ]; then
    echo "${SCRIPT_NAME}: cannot canonicalize: $1" >&2
    return 1
  fi

  # Refusing to remove the current directory, or an ancestor of it, cannot be
  # waived:  the shell would be left in a directory that no longer exists, and
  # an ancestor holds more than the directory that was named.
  remove_cwd="$(pwd -P)"
  case "${remove_cwd}" in
    "${remove_dir}" | "${remove_dir%/}"/*)
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: it is the current directory or an ancestor of it" >&2
      return 1
      ;;
  esac

  # Classify the directory.  Only the top level of a working tree is a working
  # tree here:  a subdirectory of one is not a branch directory, though the
  # check below still applies to it, because `rm -rf` would take its tracked
  # files with it.
  remove_toplevel="$(git -C "${remove_dir}" rev-parse --show-toplevel 2> /dev/null)"
  if [ -n "${remove_toplevel}" ]; then
    remove_toplevel="$(absolute_path "${remove_toplevel}")"
  fi
  if [ "${remove_toplevel}" = "${remove_dir}" ]; then
    remove_kind='working-tree'
  elif [ -n "${remove_toplevel}" ]; then
    remove_kind='within-working-tree'
  else
    # Not a repository at all, or a bare repository.  A bare repository holds
    # no working tree, so the uncommitted check below has nothing to ask
    # about, but its refs and objects are its own and `rm -rf` takes every one
    # of them, so the unpushed check applies to it exactly as it does to a
    # clone.  Classifying it as `other`, which is checked for nothing, would
    # remove a repository that holds the only copy of its commits and say
    # nothing.
    #
    # `--is-bare-repository` answers about the repository that contains
    # ${remove_dir}, not only about ${remove_dir} itself, which is what this
    # check wants:  removing a directory inside a bare repository, `objects`
    # for instance, loses those commits as surely as removing the repository
    # directory does.  `git rev-parse --absolute-git-dir` would tell the two
    # apart, but it needs git 2.13, which `live_superproject` in
    # `git-orphaned-branches` does not assume.  `--is-bare-repository` is as
    # old as `rev-parse`, and the distinction it does not draw is one that
    # this check does not need.
    remove_bare="$(git -C "${remove_dir}" rev-parse --is-bare-repository \
      2> /dev/null)"
    if [ "${remove_bare}" = 'true' ]; then
      remove_kind='bare-repository'
    elif [ -e "${remove_dir}/.git" ] || [ -L "${remove_dir}/.git" ]; then
      # A `.git` that git cannot use, typically the `.git` file of a worktree
      # whose administrative directory is gone because the worktree was moved
      # with `mv` and its registration then pruned.  Git can no longer say
      # what the directory holds, so neither check can be made, and `other`
      # would remove it unchecked.  No flag waives this refusal, because the
      # flags waive the outcome of a check that was made.
      remove_gitfile="$(sed -n 's/^gitdir: //p' -- "${remove_dir}/.git" 2> /dev/null)"
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: its .git${remove_gitfile:+ names ${remove_gitfile}, which} is not a git directory that git can use, so its uncommitted and unpushed work cannot be checked; if it is a worktree that was moved, \`git worktree repair ${remove_dir}\` in its repository may reconnect it, and otherwise inspect it and remove it with \`rm -rf\`" >&2
      return 1
    else
      remove_kind='other'
    fi
  fi

  if [ "${remove_kind}" = 'working-tree' ] && [ ! -d "${remove_dir}/.git" ]; then
    # A working tree whose `.git` is a file.  A linked worktree's git
    # directory differs from its common git directory, which is the
    # repository that it shares.  A submodule's working tree, and the working
    # tree of a repository made with `--separate-git-dir`, have a `.git` file
    # too, but their two git directories are equal:  comparing the git
    # directory with the top level alone would classify them as clones and
    # `rm -rf` them.  A linked worktree of a submodule's repository is no
    # branch directory either.
    remove_gitdir="$(git -C "${remove_dir}" rev-parse --path-format=absolute \
      --git-dir 2> /dev/null)"
    remove_common="$(git -C "${remove_dir}" rev-parse --path-format=absolute \
      --git-common-dir 2> /dev/null)"
    remove_superproject="$(git -C "${remove_dir}" rev-parse \
      --show-superproject-working-tree 2> /dev/null)"
    # Each refusal says which kind of working tree this is, because the
    # remedies differ.
    if [ -z "${remove_gitdir}" ] || [ -z "${remove_common}" ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: its .git is a file, but git cannot determine its git directory" >&2
      return 1
    fi
    if [ -n "${remove_superproject}" ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: it is a submodule's working tree, in ${remove_superproject}, which \`git submodule deinit\` and \`git rm\` there remove" >&2
      return 1
    fi
    if [ "${remove_gitdir}" = "${remove_common}" ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: it is the working tree of a repository whose git directory, ${remove_gitdir}, lies elsewhere, not a linked worktree; removing it would leave that repository behind" >&2
      return 1
    fi
    remove_kind='linked-worktree'
    # Read everything that the removal will destroy now, because afterward
    # the information is gone.
    remove_branch="$(git -C "${remove_dir}" symbolic-ref --quiet HEAD 2> /dev/null)"
    remove_branch="${remove_branch#refs/heads/}"
    remove_head="$(git -C "${remove_dir}" rev-parse --verify --quiet HEAD)"
    if [ -z "${remove_head}" ]; then
      if [ -n "${remove_branch}" ]; then
        echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: its branch ${remove_branch} has no commit yet, so its work cannot be checked; inspect it and run \`git worktree remove --force ${remove_dir}\`" >&2
      else
        echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: cannot determine its HEAD" >&2
      fi
      return 1
    fi
    # `git worktree lock` writes `locked`, holding the reason if one was
    # given, in the worktree's own git directory.  The removal below falls
    # back to `rm -rf` when `git worktree remove` fails, so without this test
    # a lock, which makes git refuse, would be overridden silently.
    if [ -f "${remove_gitdir}/locked" ]; then
      remove_lock_reason="$(cat -- "${remove_gitdir}/locked" 2> /dev/null)"
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: it is locked${remove_lock_reason:+ (${remove_lock_reason})}; run \`git worktree unlock\` first" >&2
      return 1
    fi
  fi

  if [ "${remove_kind}" = 'working-tree' ]; then
    # Removing the main working tree removes the repository that every linked
    # worktree of it depends on, so refuse however orphaned this directory's
    # own branch is.  This refusal cannot be waived.  It overlaps deliberately
    # with the filter in `git-orphaned-branches`, which keeps such a directory
    # out of the list:  this one refuses it even when a user names it.
    remove_worktrees="$(live_linked_worktrees "${remove_dir}")"
    if [ "${remove_worktrees}" -gt 0 ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: it holds the repository of ${remove_worktrees} linked worktree(s), which removing it would break" >&2
      return 1
    fi
  fi

  # The checks.  Both are gathered before anything is removed, because
  # afterward the information is gone.
  remove_refusals=0

  if [ "${remove_kind}" = 'working-tree' ] \
    || [ "${remove_kind}" = 'linked-worktree' ] \
    || [ "${remove_kind}" = 'within-working-tree' ]; then
    # Uncommitted changes to tracked files.  `--untracked-files=no` is the
    # point:  a branch directory inherits build output and other untracked
    # files, and refusing on account of those would refuse nearly every
    # directory.  For a directory within a working tree, ask only about that
    # directory, which is all that the removal would take.
    remove_status_failed=0
    if [ "${remove_kind}" != 'within-working-tree' ]; then
      remove_modified="$(git -C "${remove_dir}" status --porcelain \
        --untracked-files=no --ignore-submodules=none 2> /dev/null)" || remove_status_failed=1
    else
      remove_modified="$(git -C "${remove_dir}" status --porcelain \
        --untracked-files=no --ignore-submodules=none -- . 2> /dev/null)" || remove_status_failed=1
    fi
    remove_modified_count="$(line_count "${remove_modified}")"
    if [ "${remove_status_failed}" -ne 0 ]; then
      # `git status` failed, so its empty output says nothing about the
      # working tree.  Reading it as "no modified files" would remove a
      # directory whose tracked files are modified -- and for a directory
      # within a working tree this is the only check there is.  Refuse, as
      # the unpushed check below refuses when its command answers nothing.
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: cannot tell whether it holds uncommitted changes to tracked files" >&2
      remove_refusals=1
    elif [ "${remove_modified_count}" -gt 0 ]; then
      if [ "${force_uncommitted}" -eq 0 ]; then
        echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: ${remove_modified_count} tracked file(s) have uncommitted changes; re-run with --force-uncommitted" >&2
        remove_refusals=1
      else
        echo "${SCRIPT_NAME}: ${remove_dir}: --force-uncommitted: deleting ${remove_modified_count} tracked file(s) with uncommitted changes" >&2
      fi
    fi
  fi

  if [ "${remove_kind}" = 'working-tree' ] \
    || [ "${remove_kind}" = 'bare-repository' ]; then
    # Commits that no remote-tracking ref and no tag holds.  `rm -rf` destroys
    # the whole repository, so ask about every ref, not just the checked-out
    # branch.
    # `--all` is what makes that so:  it covers HEAD, and so a commit made on
    # a detached HEAD, and every ref below `refs/`, and so a stash entry --
    # each of them work that no branch names and that removing this directory
    # would lose as surely as a commit on an unpushed branch.  `--branches`
    # would ask only about `refs/heads`, and a clone whose only unpushed work
    # is stashed would pass both checks, since stashing leaves the working
    # tree clean and the other check sees nothing either.
    # This is the question that matters -- would removing this directory lose
    # commits? -- and it needs no upstream configuration, unlike
    # `git branch --delete`'s merged-into-upstream test.  A remote-tracking
    # ref counts as holding the commits, which is right:  those commits are in
    # the remote.
    # A tag counts as holding them too.  With this code, work that a local tag
    # alone names is not caught; however, a commit is nearly always also on a
    # branch, HEAD, or the stash, and each of those still counts.
    remove_unpushed="$(git -C "${remove_dir}" rev-list --count --all \
      --not --remotes --tags 2> /dev/null)"
    if [ -z "${remove_unpushed}" ]; then
      echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: cannot tell whether it holds commits that no other ref holds" >&2
      remove_refusals=1
    elif [ "${remove_unpushed}" -gt 0 ]; then
      if [ "${force_unpushed}" -eq 0 ]; then
        echo "${SCRIPT_NAME}: refusing to remove ${remove_dir}: ${remove_unpushed} commit(s) are on no remote-tracking ref or tag; re-run with --force-unpushed" >&2
        remove_refusals=1
      else
        echo "${SCRIPT_NAME}: ${remove_dir}: --force-unpushed: deleting ${remove_unpushed} commit(s) that are on no remote-tracking ref or tag" >&2
      fi
    fi
  fi

  if [ "${remove_kind}" = 'linked-worktree' ]; then
    check_worktree_unpushed "${remove_common}" "${remove_head}" \
      "${remove_branch}" "${remove_dir}"
  fi

  if [ "${remove_kind}" = 'working-tree' ] \
    || [ "${remove_kind}" = 'linked-worktree' ]; then
    check_submodules_unpushed "${remove_dir}"
  fi

  if [ "${remove_refusals}" -ne 0 ]; then
    return 1
  fi

  if [ "${remove_kind}" = 'linked-worktree' ]; then
    # `--force`, because git refuses to remove a worktree that holds any
    # modification, including the ignored build output that these
    # directories are full of; the checks above have decided what is safe.
    # If git cannot remove it -- its registration names some other path,
    # say, because it was moved with `mv`, or it holds submodules, which git
    # never removes -- remove the directory and the one administrative
    # directory that is its own, rather than pruning.  That administrative
    # directory holds the submodules' repositories, which
    # `check_submodules_unpushed` has asked about.
    if ! git --git-dir="${remove_common}" worktree remove --force \
      "${remove_dir}" > /dev/null 2>&1; then
      if ! rm -rf -- "${remove_dir}" || ! rm -rf -- "${remove_gitdir}"; then
        echo "${SCRIPT_NAME}: cannot remove: ${remove_dir}" >&2
        return 1
      fi
    fi
    delete_worktree_branch "${remove_common}" "${remove_branch}" "${remove_head}"
    return
  fi

  # A clone's refs, and a non-repository's nothing, go with the directory.
  if ! rm -rf -- "${remove_dir}"; then
    echo "${SCRIPT_NAME}: cannot remove: ${remove_dir}" >&2
    return 1
  fi
  return 0
}

status=0
for directory in "$@"; do
  if ! remove_branch_directory "${directory}"; then
    status=1
  fi
done
exit "${status}"
