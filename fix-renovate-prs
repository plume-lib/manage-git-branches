#!/bin/sh

# For each open pull request that Renovate opened and whose CI fails, in a
# GitHub repository that a working copy directory of the directory that holds
# the working copy directories is a clone of, runs Claude Code to make the
# pull request's CI pass, or to report that that is impossible.  Then pushes
# Claude's commits to the pull request's branch, or posts Claude's explanation
# of why the CI cannot pass as a comment on the pull request.  At the end, it
# prints the URL of each pull request that it acted on, because a human must
# review what Claude did.
#
# Usage:
#   fix-renovate-prs [--dry-run] [-C DIR]
#
# The directory that holds the working copy directories is DIR, or the
# current directory.  A working copy directory is an entry of it that is the
# top level of a git working tree.  This command ignores entries whose names
# start with ".", symbolic links, which could name a working tree twice, and
# directories that are not the top level of a working tree, such as an
# ordinary directory inside a clone.  It examines the working copy
# directories in the order of the C locale, in which, for example, "Z"
# precedes "a", so that the order does not depend on the user's locale.
#
# A working copy directory's repository is the GitHub repository that
# `git fetch` in the directory fetches from, as `fetch_remote` in
# common-functions.sh determines it.  A clone of a fork, PROJECT-fork-ORG,
# therefore yields the fork, whose pull requests are rarely Renovate's; the
# pull requests of the upstream repository are examined only if a clone of
# the upstream repository is a working copy directory.  Each repository is
# examined once, even if several directories are clones of it.
#
# A Renovate pull request is one that the GitHub App "renovate" opened, from
# a branch of the repository itself.  Its CI is:
#  * running, if some check has not finished.  Such a pull request is skipped.
#  * waiting, otherwise, if some check's conclusion is "action required":  it
#    waits for a human, for example to approve a deployment.  Such a pull
#    request is skipped.
#  * failing, otherwise, if some check failed:  its conclusion is "failure",
#    "startup failure", or "timed out", or its state is "error" or
#    "failure".  A cancelled check is not a failure.
#  * passing, otherwise.  Such a pull request is skipped.
# A failing pull request is also skipped if a comment that this command
# posted says that its CI cannot pass at its current head commit.  After
# Renovate updates the pull request, this command tries it again.
#
# For each failing pull request, this command:
#  1. Runs `rerun-failed-ci` on it, which reruns the CI jobs whose failure
#     appears to be transient, such as a network error.  If it reran a job,
#     or if the CI is no longer failing afterward, the pull request is
#     skipped; run this command again after the checks finish.
#  2. Finds or makes the directory for the pull request's branch.  That is a
#     working copy directory whose branch `git push` pushes to the pull
#     request's branch, if there is one, and otherwise a new sibling
#     directory, PROJECT-branch-BRANCH, that `git-checkout-branch --no-pull`
#     makes in a clone of the repository, without changing the clone's
#     working tree.  A clone whose name does not contain "-branch-" is
#     preferred.  The directory must have no uncommitted changes to tracked
#     files.  This command fetches the pull request's branch into it, and
#     then:
#      * If its HEAD is the pull request's head commit or an ancestor of it,
#        this command fast-forwards it to the head commit.
#      * If its HEAD has commits on top of the head commit, such as those of
#        an earlier run of this command that were not pushed, Claude is told
#        to build on them, and they are pushed along with Claude's commits.
#      * If its HEAD has diverged from the head commit, as after Renovate
#        rewrites the branch, this command resets it to the head commit, if
#        every commit of HEAD either was once on the pull request's branch,
#        as the reflog of the directory's remote-tracking branch shows, or is
#        one that an earlier run of this command left unpushed.  Claude is
#        told about the latter, so that it can reuse their changes.  The
#        reset loses no commit:  this command keeps the commits that it left
#        unpushed in the ref refs/fix-renovate-prs/LOCALBRANCH, where
#        LOCALBRANCH is the directory's branch, until it pushes a fix.
#      * Otherwise, the pull request is skipped and reported.
#  3. Runs Claude Code non-interactively in that directory, with permission to
#     run any command (`--permission-mode bypassPermissions`), because making
#     the CI pass usually requires building and testing the project.  Claude
#     is told to commit its changes, including any new files, and not to
#     push.  Claude is told not to upgrade the JDK that the project uses, and
#     to report that the CI cannot pass if the only fix is to upgrade it.  It
#     writes its outcome to a file:  either that it made the CI pass, or that
#     the CI cannot pass, and why.  The outcome's first line that is not
#     blank says which; white space and the Markdown characters "*", "_",
#     "#", and "`" in it are ignored.
#  4. If Claude made the CI pass, the directory has commits that the pull
#     request does not, and Claude left no new file uncommitted, pushes the
#     commits to the pull request's branch, with
#     `git push`.  Renovate does not rebase or update a branch that someone
#     else has pushed to.  If Claude reported that the CI cannot pass, posts
#     Claude's explanation as a comment on the pull request.  Commits that
#     Claude made then are not pushed, but they remain in the directory.
# Claude runs for at most MANAGE_GIT_BRANCHES_RENOVATE_TIMEOUT seconds (by
# default, 7200); 0 means no limit.  The pull requests are handled one at a
# time.  This command continues after one of them fails.
#
# Claude's session can do anything that the user can, including pushing and
# commenting, which its instructions forbid but which nothing prevents.  Its
# instructions include text that Renovate wrote, such as the pull request's
# title, and Claude reads CI logs and the release notes of new dependency
# versions, any of which could contain instructions.  The new dependency
# versions themselves run during the build, as they do in CI.
#
# The last thing that this command prints is the list of pull requests that
# it acted on, grouped by what it did.  Each line is a pull request's URL and
# its directory.  For a pull request whose CI jobs were rerun, the directory
# is the one that a later run of this command would use.  It is marked
# "(not made yet)" if it does not exist yet, and "(exists, but does not push
# to the pull request's branch)" if something exists at that path but it is
# not a working copy directory from which `git push` pushes to the pull
# request's branch, so that a later run would not use it.  This command also
# lists the pull requests that it could not handle, each with an explanation
# that names its directory if this command found or made one.
#
#   --dry-run  run nothing, push nothing, and post nothing; just print each
#              failing pull request and the directory where Claude would run.
#              `rerun-failed-ci --dry-run` reports what it would rerun.
#   -C DIR     the directory that holds the working copy directories
#
# The exit status is 0 if every pull request that this command examined was
# handled, and 1 otherwise.  It is 2 for a usage error.
#
# This command needs `gh`, authenticated to GitHub with permission to push to
# the repositories, `claude`, and Python 3.9 or later for `rerun-failed-ci`.

SCRIPT_NAME="$(basename -- "$0")"

# Resolve $0 through any symbolic links, so that ${SCRIPT_DIR} is the
# directory that contains this package's other files even when this script is
# invoked through a symbolic link from elsewhere, such as ~/bin.
script_path="$0"
case "${script_path}" in
  */*) ;;
  *)
    # The shell found this script on the PATH, so "${script_path}" is a bare
    # command name.  Interpreting it as a file name would resolve it relative
    # to the current directory and make ${SCRIPT_DIR} the current directory.
    script_path="$(command -v -- "${script_path}")"
    case "${script_path}" in
      */*) ;;
      *)
        echo "$(basename -- "$0"): cannot find this script on the PATH: $0" >&2
        exit 1
        ;;
    esac
    ;;
esac
script_links=0
while [ -L "${script_path}" ]; do
  script_links=$((script_links + 1))
  if [ "${script_links}" -gt 40 ]; then
    echo "$(basename -- "$0"): too many levels of symbolic links: $0" >&2
    exit 1
  fi
  if ! script_link="$(readlink -- "${script_path}")"; then
    echo "$(basename -- "$0"): cannot read symbolic link: ${script_path}" >&2
    exit 1
  fi
  case "${script_link}" in
    /*) script_path="${script_link}" ;;
    *) script_path="$(dirname -- "${script_path}")/${script_link}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${script_path}")" && pwd -P)"

if [ ! -r "${SCRIPT_DIR}/common-functions.sh" ]; then
  echo "${SCRIPT_NAME}: cannot read ${SCRIPT_DIR}/common-functions.sh" >&2
  exit 1
fi
# shellcheck source=common-functions.sh
. "${SCRIPT_DIR}/common-functions.sh"

usage() {
  echo "Usage: ${SCRIPT_NAME} [--dry-run] [-C DIR]"
}

dry_run=false
base_arg="."
while [ "$#" -ne 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -C)
      if [ "$#" -lt 2 ]; then
        usage >&2
        exit 2
      fi
      base_arg="$2"
      shift 2
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
if ! base="$(physical_path "${base_arg}")"; then
  echo "${SCRIPT_NAME}: cannot change to directory ${base_arg}" >&2
  exit 2
fi
time_limit="${MANAGE_GIT_BRANCHES_RENOVATE_TIMEOUT:-7200}"
case "${time_limit}" in
  *[!0-9]*)
    echo "${SCRIPT_NAME}: MANAGE_GIT_BRANCHES_RENOVATE_TIMEOUT is not a number of seconds: ${time_limit}" >&2
    exit 2
    ;;
esac
if ! command -v gh > /dev/null; then
  echo "${SCRIPT_NAME}: gh is not on the PATH" >&2
  exit 1
fi
if [ "${dry_run}" = false ] && ! agent_available claude; then
  exit 1
fi

make_temp_dir
work="${temp_dir}"

tab="$(printf '\t')"
status=0

# The text of a comment that says that the CI of a pull request cannot pass
# at the head commit COMMIT is followed by a line that this function prints.
# Usage: impossible_marker COMMIT
impossible_marker() {
  printf '<!-- %s: CI cannot pass at %s -->\n' "${SCRIPT_NAME}" "$1"
}

# A jq function definition, which must precede the filters below that use it.
# The function `check_state` maps a check of a pull request's
# `statusCheckRollup`, as a dict parsed from the GitHub API's JSON with keys
# such as "__typename", "status", "conclusion", and "state", to its state:
# "running", "waiting", "failing", or "passing".  A check run has the "__typename"
# "CheckRun" and a commit status has "StatusContext".
check_state_def='def check_state:
    if .__typename == "CheckRun" then
      if .status != "COMPLETED" then "running"
      elif .conclusion == "ACTION_REQUIRED" then "waiting"
      elif (.conclusion | IN("FAILURE", "STARTUP_FAILURE", "TIMED_OUT")) then "failing"
      else "passing" end
    else
      if (.state | IN("PENDING", "EXPECTED")) then "running"
      elif (.state | IN("ERROR", "FAILURE")) then "failing"
      else "passing" end
    end;'

# A jq filter that maps a pull request, as a dict parsed from the GitHub API's
# JSON with the key "statusCheckRollup", to the state of its CI:  "running",
# "waiting", "failing", or "passing".
ci_state_jq='[.statusCheckRollup[]? | check_state]
  | if index("running") then "running" elif index("waiting") then "waiting"
    elif index("failing") then "failing" else "passing" end'

# A jq filter that maps a pull request, as a dict parsed from the GitHub API's
# JSON with the key "statusCheckRollup", to a line for each failing check:
# two spaces, the check's name, a colon and a space, and the check's URL.
failed_checks_jq='.statusCheckRollup[]? | select(check_state == "failing")
  | if .__typename == "CheckRun" then "  \(.name): \(.detailsUrl // "")"
    else "  \(.context): \(.targetUrl // "")" end'

# The lists of pull requests for the final report.  Each is a sequence of
# lines, each of which is a pull request's URL, then two spaces and its
# directory, or, in ${problems}, an explanation.
pushed=""
commented=""
reran=""
problems=""

# Usage: problem URL EXPLANATION [DIRECTORY]
# Records that the pull request URL could not be handled, for the reason
# EXPLANATION, and prints EXPLANATION.  If DIRECTORY is given and is not
# empty, EXPLANATION is extended to say that claude did not run in DIRECTORY,
# such as "cannot read its checks, so claude did not run in /path/to/dir".
problem() {
  problem_explanation="$2"
  if [ -n "${3:-}" ]; then
    problem_explanation="${problem_explanation}, so claude did not run in $3"
  fi
  printf '%s: %s: %s\n' "${SCRIPT_NAME}" "$1" "${problem_explanation}" >&2
  problems="${problems}$1  ${problem_explanation}
"
  status=1
}

working_copy_directories "${base}" > "${work}/entries"

# Find each working copy directory's repository, and the branch, if any,
# that `git push` in it pushes to.  Each line of ${work}/clones is a
# GitHub slug ORG/REPO, then 0 if the directory's name contains "-branch-"
# and 1 otherwise, then the directory.  Each line of ${work}/holders is the
# GitHub slug of the repository that `git push` pushes the directory's branch
# to, the branch there, the directory's remote for that repository, and the
# directory.  The loop reads the entries from file descriptor 3, so that its
# commands can use the standard input.
: > "${work}/clones"
: > "${work}/holders"
while IFS= read -r dir <&3; do
  path="${base}/${dir}"
  branch="$(current_branch "${path}")" || branch=""
  remote="$(fetch_remote "${path}" "${branch}")"
  if [ -n "${remote}" ]; then
    # `git remote get-url` applies `url.BASE.insteadOf`, which can map a
    # GitHub URL to a mirror; the configured URL still names GitHub.
    slug="$(github_slug "$(git -C "${path}" remote get-url "${remote}" 2> /dev/null)")"
    if [ -z "${slug}" ]; then
      slug="$(github_slug "$(git -C "${path}" config --get "remote.${remote}.url")")"
    fi
    if [ -n "${slug}" ]; then
      case "${dir}" in
        *-branch-*) preferred=0 ;;
        *) preferred=1 ;;
      esac
      printf '%s\t%s\t%s\n' "${slug}" "${preferred}" "${dir}" >> "${work}/clones"
    fi
  fi
  if [ -n "${branch}" ] && push_destination "${path}" "${branch}"; then
    printf '%s\t%s\t%s\t%s\n' "${push_destination_repo}" "${push_destination_branch}" "${push_destination_remote}" "${dir}" \
      >> "${work}/holders"
  fi
done 3< "${work}/entries"

# Choose one clone of each repository:  the first one whose name does not
# contain "-branch-", or else the first one.  Each line of ${work}/repos is a
# GitHub slug and the chosen directory, in the order of the directories'
# first appearance.
awk -F "${tab}" '
  !($1 in chosen) { order[++n] = $1; chosen[$1] = $3; preferred[$1] = $2 }
  $2 == 1 && preferred[$1] == 0 { chosen[$1] = $3; preferred[$1] = 1 }
  END { for (i = 1; i <= n; i++) printf "%s\t%s\n", order[i], chosen[order[i]] }
' "${work}/clones" > "${work}/repos"

# List the failing Renovate pull requests.  Each line of ${work}/failing is a
# GitHub slug, the chosen clone, the pull request's URL, its head branch, and
# its head commit.
: > "${work}/failing"
while IFS="${tab}" read -r slug clone <&3; do
  if ! prs="$(gh_query "cannot list the Renovate pull requests of ${slug}" \
    gh pr list -R "github.com/${slug}" --app renovate --state open --limit 200 \
    --json url,headRefName,headRefOid,isCrossRepository,statusCheckRollup \
    --jq "${check_state_def} .[] | select(.isCrossRepository | not) | [.url, .headRefName, .headRefOid, (${ci_state_jq})] | @tsv")"; then
    problem "https://github.com/${slug}" "cannot list its Renovate pull requests"
    continue
  fi
  printf '%s\n' "${prs}" | while IFS="${tab}" read -r url head_branch head_oid ci; do
    case "${ci}" in
      failing)
        printf '%s\t%s\t%s\t%s\t%s\n' "${slug}" "${clone}" "${url}" "${head_branch}" "${head_oid}" \
          >> "${work}/failing"
        ;;
      running) echo "${SCRIPT_NAME}: skipping ${url}, whose CI is running" ;;
      waiting) echo "${SCRIPT_NAME}: skipping ${url}, whose CI waits for a human to act" ;;
      *) ;;
    esac
  done
done 3< "${work}/repos"

# Usage: sync_directory URL DIRECTORY OID REMOTE BRANCH LOCALBRANCH
# Makes the working copy directory DIRECTORY, whose branch is LOCALBRANCH,
# ready for work on a pull request whose head branch is the branch BRANCH of
# DIRECTORY's remote REMOTE and whose head commit is OID, as step 2 of the
# comment at the top of this file describes.  Sets ${unpushed} to the number
# of commits of the resulting HEAD that OID does not have, and ${earlier} to
# the commits that an earlier run of this command left unpushed and that the
# reset moved HEAD away from, one per line, each as two spaces, its hash, a
# space, and its subject, or to nothing if there are none.  Calls `problem`
# and returns 1 if DIRECTORY cannot be made ready.  URL is the pull request's
# URL; used for diagnostics.
sync_directory() {
  if [ -n "$(git -C "$2" status --porcelain --untracked-files=no)" ]; then
    problem "$1" "$2 has uncommitted changes"
    return 1
  fi
  # The fetch of BRANCH updates the remote-tracking branch, whose reflog
  # records each commit that BRANCH has had.  OID is fetched by itself if
  # BRANCH no longer has it.
  git_batch_ssh "$2" fetch -q "$4" "refs/heads/$5" < /dev/null
  if ! git -C "$2" cat-file -e "$3^{commit}" 2> /dev/null \
    && ! git_batch_ssh "$2" fetch -q "$4" "$3" < /dev/null; then
    problem "$1" "cannot fetch the pull request's head commit $3 into $2"
    return 1
  fi
  unpushed=0
  earlier=""
  if [ "$(git -C "$2" rev-parse HEAD)" = "$3" ]; then
    return 0
  fi
  if git -C "$2" merge-base --is-ancestor HEAD "$3"; then
    if ! git -C "$2" merge -q --ff-only "$3" < /dev/null; then
      problem "$1" "cannot fast-forward $2 to the pull request's head commit $3"
      return 1
    fi
    return 0
  fi
  if git -C "$2" merge-base --is-ancestor "$3" HEAD; then
    unpushed="$(git -C "$2" rev-list --count "$3..HEAD")"
    return 0
  fi
  # HEAD has diverged from OID.  List the commits of HEAD that the
  # remote-tracking branch never had, at any of the values that its reflog
  # records.  The reflog's oldest entry records the value before it, too,
  # which is the one that `git clone` gave the branch, because `git clone`
  # writes no reflog for a remote-tracking branch.  If the remote-tracking
  # branch does not exist, the list is every commit of HEAD.
  sync_ref="refs/remotes/$4/$5"
  sync_had="$(git -C "$2" log -g --format=%H "${sync_ref}" 2> /dev/null)"
  sync_entries="$(printf '%s' "${sync_had}" | grep -c .)"
  if ! sync_local="$({
    printf '%s\n' "${sync_had}"
    git -C "$2" rev-parse --verify --quiet "${sync_ref}@{${sync_entries}}"
    git -C "$2" rev-parse --verify --quiet "${sync_ref}"
  } | sed -n -e 's/^\(..*\)$/^\1/p' | git -C "$2" rev-list --stdin HEAD)"; then
    problem "$1" "cannot list the commits of $2 that the pull request's branch never had"
    return 1
  fi
  # Such commits are this command's own if HEAD is where an earlier run left
  # it; then they are kept in that run's ref, and the reset can leave them.
  if [ -n "${sync_local}" ]; then
    if [ "$(git -C "$2" rev-parse HEAD)" \
      != "$(git -C "$2" rev-parse --verify --quiet "refs/fix-renovate-prs/$6")" ]; then
      problem "$1" "$2 has diverged from the pull request's head commit $3, and it has commits that the pull request's branch never had; move them onto $3, or remove $2 with git-remove-branch-directory"
      return 1
    fi
    earlier="$(printf '%s\n' "${sync_local}" | git -C "$2" log --no-walk=unsorted --stdin --format='  %H %s')"
  fi
  if ! git -C "$2" reset -q --keep "$3" < /dev/null; then
    problem "$1" "cannot reset $2 to the pull request's head commit $3"
    return 1
  fi
}

# Usage: prompt URL SLUG BRANCH CHECKS OUTCOME OID UNPUSHED EARLIER
# Prints the instructions for Claude for a pull request URL in the GitHub
# repository SLUG, whose head branch is BRANCH, whose failed checks are
# CHECKS, one per line, and whose head commit is OID.  OUTCOME is the file to
# which Claude writes its outcome, UNPUSHED is the number of commits on top
# of OID in the current directory, and EARLIER is the commits, one per line,
# that an earlier run left unpushed on an older head commit, as
# `sync_directory` sets ${earlier}.
prompt() {
  printf '%s\n' "The current directory is a clone of the GitHub repository $2, on the branch
$3.  That branch is the head branch of the pull request $1, which Renovate
opened to update dependencies.  The pull request's CI fails.  These checks
failed:
$4
"
  if [ "$7" -ne 0 ]; then
    printf '%s\n' "The current branch has commits that the pull request does not have yet,
such as commits of an earlier attempt at this task that were not pushed;
\`git log $6..HEAD\` shows them.  Build on them:  keep those that help, and
undo any others with new commits.
"
  fi
  if [ -n "$8" ]; then
    printf '%s\n' "An earlier attempt at this task, on an older head commit of the pull
request, made these commits, which were not pushed and are not on the
current branch:
$8
If their changes still help, reuse them, for example with \`git cherry-pick\`.
"
  fi
  printf '%s\n' "Your task is to make the pull request's CI pass, or to determine that that
is impossible.

* Find out why each check failed, for example with \`gh pr checks $1\` and
  \`gh run view --log-failed\`.
* Fix the problem by changing this repository, such as its code, build
  files, or configuration, so that it works with the updated dependencies.
  Do not revert, downgrade, or exclude any of the dependency updates that the
  pull request makes, and do not disable, skip, or weaken tests or checks.
  Do not upgrade the JDK that the project builds with, runs on, or targets,
  for example by raising a Java version in build files, CI configuration,
  or toolchain settings, even if a new dependency version requires a newer
  JDK.  If the only way to make the CI pass is one of those, the task is
  impossible.
* Where practical, run the failing CI commands locally before and after the
  fix, to confirm that the fix works.
* Commit your changes on the current branch, including every new file that
  the fix needs, with a commit message that says what the problem was and
  how the commit fixes it.  Do not push, do not
  switch branches, and do not amend, rebase, or reset commits.  Do not
  comment on the pull request or change it in any other way, and do not
  change any directory other than this one.  The program that started you
  pushes your commits.
* The task is impossible if, for example, a failure is caused by something
  outside the repository, such as an outage or a missing secret, or by a bug
  in a new dependency version that the repository cannot reasonably work
  around.
* Finally, write the file $5.  Its first line must be exactly FIXED or
  IMPOSSIBLE.  The rest of the file is Markdown for the human who reviews
  the pull request.  For FIXED, say what was wrong and what you changed.
  For IMPOSSIBLE, say why the CI cannot pass and what a human could do,
  such as wait for a fixed release of the dependency, close the pull
  request, or configure Renovate to skip the version; it is posted as a
  comment on the pull request.  If you fixed some failures but not others,
  write IMPOSSIBLE; your commits are then kept but not pushed."
}

count=0
while IFS="${tab}" read -r slug clone url head_branch head_oid <&3; do
  count=$((count + 1))
  echo "===== ${url}"

  # The directory, if any, whose branch `git push` pushes to the pull
  # request's branch.
  holder="$(awk -F "${tab}" -v repo="${slug}" -v branch="${head_branch}" \
    'tolower($1) == tolower(repo) && $2 == branch { print $3 "\t" $4; exit }' "${work}/holders")"
  if [ -n "${holder}" ]; then
    branch_dir="${holder#*"${tab}"}"
  else
    branch_dir="${clone%%-branch-*}-branch-$(branch_dir_name "${head_branch}")"
  fi
  branch_path="${base}/${branch_dir}"
  # The state of ${branch_path}:  "usable" if `git push` in it pushes to the
  # pull request's branch, "blocked" if something else exists at that path,
  # such as a file or a working copy directory for another branch, and
  # "absent" if nothing does.
  if [ -n "${holder}" ]; then
    dir_state=usable
  elif [ -e "${branch_path}" ] || [ -L "${branch_path}" ]; then
    dir_state=blocked
  else
    dir_state=absent
  fi

  # Skip a pull request whose CI was already reported impossible at this
  # commit.
  if ! comments="$(gh_query "cannot read the comments of ${url}" \
    gh pr view "${url}" --json comments --jq '.comments[].body')"; then
    problem "${url}" "cannot read its comments" "${holder:+${branch_path}}"
    continue
  fi
  if printf '%s\n' "${comments}" | grep -q -x -F -- "$(impossible_marker "${head_oid}")"; then
    echo "${SCRIPT_NAME}: skipping ${url}, whose CI was reported impossible to fix at ${head_oid}"
    continue
  fi

  if [ "${dry_run}" = true ]; then
    case "${dir_state}" in
      usable) echo "Would run claude in ${branch_dir} for ${url}" ;;
      blocked) echo "Would not run claude for ${url}, because ${branch_dir} exists but does not push to the pull request's branch" ;;
      absent) echo "Would run claude in a new directory ${branch_dir}, made in ${clone}, for ${url}" ;;
    esac
    "${SCRIPT_DIR}/rerun-failed-ci" --dry-run "${url}" < /dev/null
    continue
  fi

  # Rerun the transient failures.  GitHub might not show a rerun job as
  # running until some time after the rerun, so skip the pull request if a
  # job was rerun, whatever its checks say.  Then skip it if its CI is
  # running, as it might be after a rerun by someone else.
  "${SCRIPT_DIR}/rerun-failed-ci" --exit-3-if-reran "${url}" < /dev/null
  case "$?" in
    0) ;;
    3)
      echo "${SCRIPT_NAME}: skipping ${url}, whose transient CI failures were rerun"
      case "${dir_state}" in
        usable) note="" ;;
        blocked) note=" (exists, but does not push to the pull request's branch)" ;;
        absent) note=" (not made yet)" ;;
      esac
      reran="${reran}${url}  ${branch_path}${note}
"
      continue
      ;;
    *) echo "${SCRIPT_NAME}: rerun-failed-ci failed for ${url}; continuing" >&2 ;;
  esac
  # The first line is the state of the CI, and the rest are the failed
  # checks, for Claude's instructions.
  if ! checks="$(gh_query "cannot read the checks of ${url}" \
    gh pr view "${url}" --json statusCheckRollup \
    --jq "${check_state_def} (${ci_state_jq}), (${failed_checks_jq})")"; then
    problem "${url}" "cannot read its checks" "${holder:+${branch_path}}"
    continue
  fi
  ci="$(printf '%s\n' "${checks}" | sed -n -e 1p)"
  checks="$(printf '%s\n' "${checks}" | sed -e 1d)"
  case "${ci}" in
    running)
      echo "${SCRIPT_NAME}: skipping ${url}, whose CI is running"
      continue
      ;;
    waiting)
      echo "${SCRIPT_NAME}: skipping ${url}, whose CI waits for a human to act"
      continue
      ;;
    passing)
      echo "${SCRIPT_NAME}: skipping ${url}, whose CI now passes"
      continue
      ;;
    *) ;;
  esac

  # Find or make the directory, and bring it to the pull request's head.
  if [ "${dir_state}" = blocked ]; then
    problem "${url}" "${branch_path} exists but does not push to the pull request's branch"
    continue
  fi
  if [ "${dir_state}" = absent ]; then
    if ! (cd -- "${base}/${clone}" && "${SCRIPT_DIR}/git-checkout-branch" --no-pull "${head_branch}") < /dev/null; then
      problem "${url}" "git-checkout-branch --no-pull ${head_branch} failed in ${base}/${clone}"
      continue
    fi
  fi
  local_branch="$(current_branch "${branch_path}")"
  if [ -z "${local_branch}" ] || ! push_destination "${branch_path}" "${local_branch}" \
    || [ "$(printf '%s\n' "${push_destination_repo}" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s\n' "${slug}" | tr '[:upper:]' '[:lower:]')" ] \
    || [ "${push_destination_branch}" != "${head_branch}" ]; then
    problem "${url}" "git push in ${branch_path} does not push to the pull request's branch"
    continue
  fi
  push_to="${push_destination_remote}"
  if ! sync_directory "${url}" "${branch_path}" "${head_oid}" "${push_to}" "${head_branch}" "${local_branch}"; then
    continue
  fi
  # The ref that keeps the commits that this command leaves unpushed.
  unpushed_ref="refs/fix-renovate-prs/${local_branch}"

  # Run Claude.
  outcome="${work}/outcome-${count}.md"
  agent_session_ids=""
  agent_session_agent=claude
  agent_session_command="claude --resume"
  agent_session_dir="${branch_path}"
  # The file is not in the branch directory, where a later unattended
  # Claude session would find it, and might commit it.
  agent_session_todo="${base}/${agent_todo_file}"
  session="$(new_uuid)"
  if [ -n "${session}" ]; then
    agent_session_ids="${session}"
  else
    echo "${SCRIPT_NAME}: cannot make a UUID to name claude's session, so no command will be able to continue it" >&2
  fi
  if ! (cd -- "${branch_path}" && untracked_files) > "${work}/untracked-before"; then
    problem "${url}" "cannot list the untracked files of ${branch_path}"
    continue
  fi
  start="$(date +%s)"
  # The UUID contains no character that field splitting or globbing would
  # change, so the unquoted expansion is one option and its value.
  # shellcheck disable=SC2086
  prompt "${url}" "${slug}" "${head_branch}" "${checks}" "${outcome}" "${head_oid}" "${unpushed}" "${earlier}" \
    | (cd -- "${branch_path}" && run_with_time_limit "${time_limit}" \
      claude -p --permission-mode bypassPermissions ${session:+--session-id ${session}})
  claude_status=$?
  # Keep any commits that the branch has on top of the pull request's head,
  # in case they are not pushed.  The ref keeps commits that an earlier run
  # left unpushed if the branch has none.
  if [ "$(git -C "${branch_path}" rev-parse "refs/heads/${local_branch}")" != "${head_oid}" ]; then
    git -C "${branch_path}" update-ref "${unpushed_ref}" "refs/heads/${local_branch}"
  fi
  if [ "${claude_status}" -ne 0 ]; then
    if [ "${time_limit}" -ne 0 ] && [ "$(($(date +%s) - start))" -ge "${time_limit}" ]; then
      problem "${url}" "claude did not finish within ${time_limit} seconds in ${branch_path}; set MANAGE_GIT_BRANCHES_RENOVATE_TIMEOUT to change the limit"
    else
      problem "${url}" "claude failed with status ${claude_status} in ${branch_path}"
    fi
    report_agent_session "Make the CI of ${url} pass"
    continue
  fi

  # Check Claude's work.  ${result} is the first line of the outcome that is
  # not blank, without white space and Markdown emphasis, and ${explanation}
  # is the lines after it.
  result="$(awk '{ line = $0; gsub(/[[:space:]*_#`]/, "", line) } line != "" { print line; exit }' \
    "${outcome}" 2> /dev/null)"
  explanation="$(awk 'found { print; next } { line = $0; gsub(/[[:space:]*_#`]/, "", line) } line != "" { found = 1 }' \
    "${outcome}" 2> /dev/null)"
  if [ "$(current_branch "${branch_path}")" != "${local_branch}" ]; then
    problem "${url}" "claude switched ${branch_path} away from branch ${local_branch}"
    report_agent_session "Make the CI of ${url} pass"
    continue
  fi
  if ! git -C "${branch_path}" merge-base --is-ancestor "${head_oid}" HEAD; then
    problem "${url}" "claude rewrote the pull request's commits in ${branch_path}"
    report_agent_session "Make the CI of ${url} pass"
    continue
  fi
  new_commits="$(git -C "${branch_path}" rev-list --count "${head_oid}..HEAD")"
  case "${result}" in
    FIXED)
      if [ "${new_commits}" -eq 0 ]; then
        problem "${url}" "claude reported a fix but committed nothing in ${branch_path}"
        report_agent_session "Make the CI of ${url} pass"
        continue
      fi
      if [ -n "$(git -C "${branch_path}" status --porcelain --untracked-files=no)" ]; then
        problem "${url}" "claude reported a fix but left uncommitted changes in ${branch_path}"
        report_agent_session "Make the CI of ${url} pass"
        continue
      fi
      if ! (cd -- "${branch_path}" && untracked_files) > "${work}/untracked-after"; then
        problem "${url}" "cannot list the untracked files of ${branch_path}, so it was not pushed"
        continue
      fi
      new_files="$(LC_ALL=C sort "${work}/untracked-before" > "${work}/untracked-before.sorted" \
        && LC_ALL=C sort "${work}/untracked-after" | LC_ALL=C comm -13 "${work}/untracked-before.sorted" -)"
      if [ -n "${new_files}" ]; then
        problem "${url}" "claude reported a fix but left new files uncommitted in ${branch_path}:
${new_files}"
        report_agent_session "Make the CI of ${url} pass"
        continue
      fi
      # Pushing to the branch of a pull request that has been closed would
      # recreate the branch.  A push that is not a fast-forward, as after
      # Renovate rewrites the branch, is refused.
      if ! state="$(gh_query "cannot read the state of ${url}" \
        gh pr view "${url}" --json state --jq .state)"; then
        problem "${url}" "cannot read its state, so ${branch_path} was not pushed"
        continue
      fi
      if [ "${state}" != OPEN ]; then
        problem "${url}" "it is no longer open, so ${branch_path} was not pushed"
        continue
      fi
      if ! git_batch_ssh "${branch_path}" push -q -- "${push_to}" "HEAD:refs/heads/${head_branch}" < /dev/null; then
        problem "${url}" "git push failed in ${branch_path}"
        continue
      fi
      git -C "${branch_path}" update-ref -d "${unpushed_ref}"
      pushed="${pushed}${url}  ${branch_path}
"
      ;;
    IMPOSSIBLE)
      {
        echo "Claude Code, run by \`${SCRIPT_NAME}\`, could not make this pull request's CI pass:"
        echo
        printf '%s\n' "${explanation}"
        echo
        impossible_marker "${head_oid}"
      } > "${work}/comment.md"
      if ! gh_query "cannot comment on ${url}" \
        gh pr comment "${url}" --body-file "${work}/comment.md" > /dev/null; then
        problem "${url}" "cannot post the explanation that claude wrote in ${branch_path}:
${explanation}"
        continue
      fi
      if [ "${new_commits}" -eq 0 ]; then
        commented="${commented}${url}  ${branch_path}
"
      else
        commented="${commented}${url}  ${branch_path} (${new_commits} unpushed commits)
"
      fi
      ;;
    *)
      problem "${url}" "claude did not write FIXED or IMPOSSIBLE as the first line of its outcome that is not blank, in ${branch_path}"
      report_agent_session "Make the CI of ${url} pass"
      continue
      ;;
  esac
  if [ -n "${session}" ]; then
    echo "${SCRIPT_NAME}: to continue claude's session:  cd $(shell_word "${branch_path}") && claude --resume ${session}"
  fi
done 3< "${work}/failing"

if [ "${dry_run}" = true ]; then
  exit "${status}"
fi
echo
if [ "${count}" -eq 0 ] && [ -z "${problems}" ]; then
  echo "${SCRIPT_NAME}: found no failing Renovate pull requests"
fi
if [ -n "${reran}" ]; then
  echo "Reran transient CI failures; run ${SCRIPT_NAME} again after CI finishes:"
  printf '%s' "${reran}"
fi
if [ -n "${problems}" ]; then
  echo "Could not handle; a human must look:"
  printf '%s' "${problems}"
fi
if [ -n "${commented}" ]; then
  echo "Commented that CI cannot pass; review the comments:"
  printf '%s' "${commented}"
fi
if [ -n "${pushed}" ]; then
  echo "Pushed fixes; review them:"
  printf '%s' "${pushed}"
fi
exit "${status}"
